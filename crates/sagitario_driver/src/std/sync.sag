//! `std::sync`: values that threads share safely (docs/spec/11-standard-library.md#stdsync).
//!
//! A lock or an atomic cell belongs to the runtime. Each class holds it in a private `fn()` field
//! whose environment the runtime creates, so that ARC frees it with the class's instance.

extern "C" {
  fn sag_sync_mutex_new() -> fn();
  fn sag_sync_mutex_lock(mutex: fn());
  fn sag_sync_mutex_unlock(mutex: fn());
  fn sag_sync_atomic_new(value: u64) -> fn();
  fn sag_sync_atomic_load(cell: fn()) -> u64;
  fn sag_sync_atomic_store(cell: fn(), value: u64);
  fn sag_sync_atomic_swap(cell: fn(), value: u64) -> u64;
  fn sag_sync_atomic_add(cell: fn(), delta: u64, subtract: bool, bits: u32, is_signed: bool) -> u64;
  fn sag_sync_atomic_compare_exchange(cell: fn(), expected: u64, desired: u64, actual: *mut u64) -> bool;
}

/// A value that threads share, changed by one thread at a time. `T` must be `Send`, so that what
/// `get` returns can go on living in any thread.
pub class Mutex<T: Send> {
  prv const lock: fn();
  prv var value: T;

  pub fn new(self, value: T) {
    self.lock = unsafe { sag_sync_mutex_new() };
    self.value = value;
  }

  /// A copy of the value.
  pub fn get(self) -> T {
    unsafe { sag_sync_mutex_lock(self.lock) };
    const value = self.value;
    unsafe { sag_sync_mutex_unlock(self.lock) };
    value
  }

  /// Replaces the value.
  pub fn set(self, value: T) {
    unsafe { sag_sync_mutex_lock(self.lock) };
    self.value = value;
    unsafe { sag_sync_mutex_unlock(self.lock) };
  }

  /// Replaces the value with what `f` returns for it, while no other thread can use the mutex,
  /// and returns the new value. `f` must not use this mutex: that panics.
  pub fn update(self, f: fn(T) -> T) -> T {
    unsafe { sag_sync_mutex_lock(self.lock) };
    const next = f(self.value);
    self.value = next;
    unsafe { sag_sync_mutex_unlock(self.lock) };
    next
  }
}

/// A `bool` that threads read and change at once.
pub class AtomicBool {
  prv const cell: fn();

  pub fn new(self, value: bool) {
    self.cell = unsafe { sag_sync_atomic_new(if value { 1 } else { 0 }) };
  }

  pub fn load(self) -> bool {
    unsafe { sag_sync_atomic_load(self.cell) } != 0
  }

  pub fn store(self, value: bool) {
    unsafe { sag_sync_atomic_store(self.cell, if value { 1 } else { 0 }) };
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: bool) -> bool {
    unsafe { sag_sync_atomic_swap(self.cell, if value { 1 } else { 0 }) } != 0
  }

  /// Stores `desired` if the value is `expected`: `Ok(expected)` if it did, `Err(actual)` if not.
  pub fn compare_exchange(self, expected: bool, desired: bool) -> Result<bool, bool> {
    var actual = [0u64; 1];
    const exchanged = unsafe {
      sag_sync_atomic_compare_exchange(self.cell, if expected { 1 } else { 0 }, if desired { 1 } else { 0 }, actual.as_mut_ptr())
    };

    if exchanged { Ok(expected) } else { Err(actual[0] != 0) }
  }
}

/// An `i32` that threads read and change at once.
pub class AtomicI32 {
  prv const cell: fn();

  pub fn new(self, value: i32) {
    self.cell = unsafe { sag_sync_atomic_new(value as u64) };
  }

  pub fn load(self) -> i32 {
    const bits = unsafe { sag_sync_atomic_load(self.cell) };
    bits as i32
  }

  pub fn store(self, value: i32) {
    unsafe { sag_sync_atomic_store(self.cell, value as u64) };
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: i32) -> i32 {
    const bits = unsafe { sag_sync_atomic_swap(self.cell, value as u64) };
    bits as i32
  }

  /// Adds `n` and returns the previous value; the sum wraps around at the limits of `i32`.
  pub fn fetch_add(self, n: i32) -> i32 {
    const bits = unsafe { sag_sync_atomic_add(self.cell, n as u64, false, 32, true) };
    bits as i32
  }

  /// Subtracts `n` and returns the previous value; the difference wraps around at the limits of
  /// `i32`.
  pub fn fetch_sub(self, n: i32) -> i32 {
    const bits = unsafe { sag_sync_atomic_add(self.cell, n as u64, true, 32, true) };
    bits as i32
  }

  /// Stores `desired` if the value is `expected`: `Ok(expected)` if it did, `Err(actual)` if not.
  pub fn compare_exchange(self, expected: i32, desired: i32) -> Result<i32, i32> {
    var actual = [0u64; 1];
    const exchanged = unsafe { sag_sync_atomic_compare_exchange(self.cell, expected as u64, desired as u64, actual.as_mut_ptr()) };

    if exchanged { Ok(expected) } else { Err(actual[0] as i32) }
  }
}

