// Constants at the limits of every integer type, float constants, casts and the errors of
// computing them.

const I8_MIN: i8 = -128;
const I8_MAX: i8 = 127;
const I16_MIN: i16 = -32768;
const I32_MIN: i32 = -2147483648;
const I64_MIN: i64 = -9223372036854775808;
const I64_MAX: i64 = 9223372036854775807;
const U64_MAX: u64 = 18446744073709551615;
const USIZE_MAX: usize = 18446744073709551615;
const ISIZE_MIN: isize = -9223372036854775808;

const SUM: u64 = U64_MAX - 1 + 1;
const PRODUCT: i64 = -4611686018427387904 * 2;
const QUOTIENT: i32 = -7 / 2;
const REMAINDER: i32 = -7 % 2;
const NEGATED: i64 = -(I64_MAX);

const WRAP_U8: u8 = 300 as u8;
const WRAP_I8: i8 = 200u8 as i8;
const WRAP_NEG: u8 = -1 as u8;
const WRAP_U64: u64 = I64_MIN as u64;
const WRAP_I64: i64 = U64_MAX as i64;
const WRAP_U16: u16 = -70000 as u16;
const FROM_CHAR: u8 = 'é' as u8;
const FROM_BOOL: i32 = true as i32;
const TO_CHAR: char = 65u8 as char;

const SATURATE_HIGH: i8 = 1000.5 as i8;
const SATURATE_LOW: i8 = -1000.5 as i8;
const SATURATE_U: u64 = 1e30 as u64;
const SATURATE_NEG: u32 = -3.7 as u32;
const TRUNCATE: i64 = -2.9 as i64;
const BIG_FLOAT: f64 = U64_MAX as f64;
const NEGATIVE_FLOAT: f64 = I64_MIN as f64;

const THIRD: f64 = 1.0 / 3.0;
const SMALL: f32 = 0.1;
const WIDENED: f64 = SMALL as f64;
const NARROWED: f32 = THIRD as f32;
const TINY: f64 = 0.000000000000000000001;
const HUGE: f64 = 1e300;
const NEGATIVE_ZERO: f64 = -0.0;
const FLOAT_REM: f64 = 7.5 % 2.0;

const COMPARE_INT: bool = I64_MIN < 0 && U64_MAX > 0;
const COMPARE_STRING: bool = "abc" < "abd";
const COMPARE_CHAR: bool = 'a' <= 'b';
const COMPARE_BOOL: bool = false < true;
const TEXT: String = "a" + "b" + "\n\t\"";

const TOO_BIG: u8 = 256;
const TOO_SMALL: i8 = -129;
const NEGATIVE_UNSIGNED: u32 = -1;
const OVERFLOW: u64 = U64_MAX + 1;
const OVERFLOW_MUL: u64 = U64_MAX * U64_MAX;
const UNDERFLOW: i64 = I64_MIN - 1;
const BEYOND_U64: u64 = 18446744073709551616;
const DIVIDE: i32 = 1 / 0;
const INFINITE: f64 = 1e308 * 10.0;
const F32_INFINITE: f32 = 1e39;
const WRONG_OPERAND: bool = !1;
const MISMATCH: i32 = 1 + 2.0;
const BAD_CAST: bool = 1 as bool;
const CHAR_CAST: char = 300 as char;

fn main() {
  println(`${I8_MIN} ${U64_MAX} ${THIRD} ${TEXT}`);
}
