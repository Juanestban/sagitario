// The flow analysis: definite assignment, `const` assigned twice, unreachable code, the binding
// warnings, initializers that leave fields unassigned, `match` exhaustiveness, methods that
// modify `self`, and threads with captures that are not `Send`.

use std::thread;

enum Light {
  Red,
  Yellow,
  Green,
}

struct Point {
  pub x: i32;

  pub fn bump(self) {
    self.x += 1;
  }

  pub fn twice(self) {
    self.bump();
    self.bump();
  }
}

class Shape {
  pub const width: i32;
  pub var height: i32;
  pub const area: i32;

  pub fn new(self, width: i32) {
    self.width = width;

    if width > 0 {
      self.height = 1;
    }

    self.describe();
    self.width = 2;
  }

  pub fn describe(self) {}
}

fn flows(flag: bool) -> i32 {
  const later: i32;
  var maybe: i32;
  var never_changed = 1;
  const unused = 2;
  const _quiet = 3;

  if flag {
    maybe = 1;
  }

  println(`${maybe}`);
  later = 1;
  later = 2;
  flag = false;

  for i in 0..3 {
    i = 4;
  }

  match Some(1) {
    Some(n) => {
      n = 2;
    }
    None => {}
  }

  return never_changed;

  println("unreachable");
}

fn exhaustive(light: Light, value: Option<Option<bool>>, number: i32, text: String) -> i32 {
  const point = Point { x: 1 };

  point.twice();

  match light {
    Light::Red => 1,
    Light::Red => 2,
  };

  match value {
    Some(Some(true)) => 1,
    None => 2,
  };

  match number {
    1 | 2 => 3,
    -5 => 4,
  };

  match text {
    "a" => 1,
    _ => 2,
    "b" => 3,
  }
}

fn threads() {
  const list = List::from([1, 2]);
  const text = "ok";
  const handle = thread::spawn(() => println(`${list.len()} ${text}`));
  const named = thread::spawn(threads);
  const spawn = thread::spawn;
}

fn main() {
  println(`${flows(true)} ${exhaustive(Light::Green, None, 1, "a")}`);
  threads();
}
