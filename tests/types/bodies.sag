// Inference, generics, closures, collections and the errors of expressions.

struct Pair<A, B> {
  pub first: A;
  pub second: B;

  pub fn swap(self) -> Pair<B, A> {
    Pair { first: self.second, second: self.first }
  }

  pub fn set_first(self, value: A) {
    self.first = value;
  }
}

enum Tree<T> {
  Leaf(T),
  Node { left: List<Tree<T>>, value: T },
}

fn identity<T>(value: T) -> T {
  value
}

fn apply<T, U>(value: T, f: fn(T) -> U) -> U {
  f(value)
}

class Counter {
  pub var count: i32;
  pub var on_change: Option<fn(i32)>;

  pub fn new(self) {
    self.count = 0;
    self.on_change = None;
  }
}

fn main() {
  var deferred;

  deferred = 3;

  const pair = Pair { first: 1, second: "one" };
  const swapped = pair.swap();
  var mutable = Pair { first: 1u8, second: true };

  mutable.set_first(2);

  const leaf = Tree::Leaf(1.5);
  const node: Tree<i64> = Tree::Node { left: new List(), value: 2 };
  const same = identity<String>("x");
  const length = apply("text", (s) => s.len());
  const nothing: Option<i32> = None;
  const ok: Result<i32, String> = Ok(1);
  const mapped = ok.map((v) => v * 2).unwrap_or(0);
  const chained = nothing.and_then((v) => Some(v + 1)).filter((v) => v > 0);
  const numbers = List::from([1, 2, 3]);
  const doubled = numbers.map((n) => n * 2).filter((n) => n > 2).collect();
  const total = numbers.fold(0, (acc, n) => acc + n);
  const range = (0..10).rev().take(3).collect();
  const map = new Map<String, i32>();

  map.insert("a", 1);

  for entry in map {
    println(`${entry.key} ${entry.value}`);
  }

  for c in "abc".chars() {
    println(`${c}`);
  }

  const counter = new Counter();

  counter.on_change = Some((value: i32) => println(`${value}`));
  counter.count += 1;

  const builder = new StringBuilder();

  builder.append("x");

  const parsed = "12".parse_i32();
  const found = "abc".find("b");
  const ordering = 1.5.total_compare(2.5);
  const equal = 3.equals(3);
  const block_value = {
    const inner = 4;
    inner * 2
  };
  const looped = loop {
    break 5;
  };
  const casted = 300 as u8;
  const array = [0u8; 4];
  const pointer = array.as_ptr();

  println(`${deferred} ${swapped.first} ${same} ${length} ${mapped} ${total} ${block_value} ${looped} ${casted}`);

  const wrong: i32 = "text";
  const overflow: u8 = 256;
  const negative: u32 = -1;
  const unknown = nothing.unwrap_or("x");
  const bad_call = identity(1, 2);
  const not_callable = 3(4);
  const missing_field = pair.third;
  const missing_method = numbers.push_back(1);
  const bad_compare = leaf == leaf;
  const bad_cast = "x" as i32;
  const bad_index = 3[0];
  const no_infer = new List();
  const lambda_infer = (x) => x;
  const bad_try = numbers?;

  if 1 {
    println("never");
  }

  while true {
    break 1;
  }

  continue;
}

fn returns() -> i32 {
  return;
}

fn wrong_return() -> String {
  1
}
