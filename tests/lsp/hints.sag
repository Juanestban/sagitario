// Inlay hints, hover on a type that could not be inferred, and completion inside `env!("`
// (docs/adr/0112-language-server-packages-and-inlay-hints.md).
pub fn main() {
  const count = 3;
  var names: List<String> = new List();
  const double = (x: i32) => x * 2;
  const parsed = List::from([1, 2]).iter().map((n) => n + 1).collect();

  for name in names {
    println(name);
  }

  if let Some(first) = parsed.first() {
    println(f"{first} {count} {double(1)}");
  }

  const lost = missing();
  const home = env!("SAG_LSP_NO_SUCH_");
}
