// Completion of members, paths and names, also while the code being typed does not compile.

use std::fs;

struct Point {
  pub x: i32;
  pub y: i32;

  pub fn sum(self) -> i32 {
    self.x + self.y
  }
}

class Counter {
  pub var count: i64;
  pub var label: String;

  pub fn new(self) {
    self.count = 0;
    self.label = "clicks";
  }

  pub fn origin(self) -> Point {
    Point { x: 0, y: 0 }
  }
}

pub fn main() {
  const point = Point { x: 1, y: 2 };
  const counter = new Counter();
  const sum = point.sum();
  const length = counter.label.len();
  const exists = fs::exists("x");
  const angle: f64 = 0.5;
  const turn = angle.atan2(1.0);

  println(`${sum} ${length} ${exists} ${turn} ${total(&[1, 2])} ${moved(&point)}`);
}

fn total(values: &[i32]) -> usize {
  values.len()
}

fn moved(point: &Point) -> i32 {
  point.x
}

/// A module-level constant, offered with its type.
const LIMIT: i32 = 10;

/// A static, offered with its type.
static FRAMES: i64 = 0;
@thread_local static var SCRATCH: i32 = 0;

/// A global variable of C, offered with its type.
extern "C" {
  static var c_counter: i32;
}

/// Loads `std::hint`, whose `black_box` is completed after `std::hint::`.
fn kept() -> i32 {
  std::hint::black_box(1)
}

/// A tuple, whose elements are completed by their indices after `pair.`.
fn first_of(pair: (i32, String)) -> i32 {
  pair.0
}

/// Static functions of an interface, completed after `Origin::` and after `T::`, defaults included
/// (docs/adr/0094-conversions-and-defaults.md, Q631).
interface Zero {
  fn zero() -> Self;
  fn label() -> String { "zero" }
}

struct Origin impl Zero {
  pub x: i32;

  pub fn zero() -> Origin { Origin { x: 0 } }
}

fn zeros<T: Zero>() -> String {
  const _origin = Origin::label();

  T::label()
}

/// Loads `std::process`, whose `exit` and `abort` are completed after `std::process::`.
fn own_id() -> u32 {
  std::process::id()
}

/// Constants of a type, completed after `Limits::` and `Self::` with its static functions
/// (docs/adr/0099-associated-and-composite-constants.md, Q687).
struct Limits {
  pub const MAX: i64 = 99;

  pub fn max() -> i64 {
    Self::MAX
  }
}

fn limit() -> i64 {
  Limits::MAX
}
