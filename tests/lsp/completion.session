// Completion of members, paths and names, also in code that does not compile.
{"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"processId": null, "capabilities": {}}}
{"jsonrpc": "2.0", "method": "initialized", "params": {}}
{"jsonrpc": "2.0", "method": "textDocument/didOpen", "params": {"textDocument": {"uri": "{uri}", "languageId": "sagitario", "version": 1, "text": {text:completion.sag}}}}
{"jsonrpc": "2.0", "id": 10, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 30, "character": 20}}}
{"jsonrpc": "2.0", "id": 11, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 31, "character": 25}}}
{"jsonrpc": "2.0", "id": 12, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 31, "character": 31}}}
{"jsonrpc": "2.0", "id": 13, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 32, "character": 21}}}
{"jsonrpc": "2.0", "id": 14, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 32, "character": 2}}}
{"jsonrpc": "2.0", "method": "textDocument/didChange", "params": {"textDocument": {"uri": "{uri}", "version": 2}, "contentChanges": [{"text": {text:completion_typing.txt}}]}}
{"jsonrpc": "2.0", "id": 15, "method": "textDocument/completion", "params": {"textDocument": {"uri": "{uri}"}, "position": {"line": 35, "character": 19}}}
{"jsonrpc": "2.0", "id": 16, "method": "shutdown"}
{"jsonrpc": "2.0", "method": "exit"}
