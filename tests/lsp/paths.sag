// Paths: the modules, functions and types of `use` declarations and of paths, their hover and
// their definitions in another file, semantic tokens, and the types of the language in completion.

use std::fs;
use pkg::paths_util;
use pkg::paths_util::{Meters, double};

pub fn main() {
  const length = Meters { value: double(2) };
  const half: i32 = paths_util::half(4);

  println(`${length.value} ${half} ${fs::exists("x")}`);
}

// Inside the braces of a format string: a parameter, a variable, fields, methods and functions.
fn describe(meters: Meters, count: i32) -> String {
  const total = count + 1;

  f"{meters.value} m, {total} items, {double(count) * 2} doubled, {meters.value.abs()}"
}
