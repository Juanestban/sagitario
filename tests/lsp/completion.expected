{"jsonrpc":"2.0","id":12,"result":{"isIncomplete":false,"items":[{"label":"len","kind":2,"detail":"fn len(self) -> usize","documentation":{"kind":"markdown","value":"The number of bytes of the text, which is UTF-8."},"sortText":"0len"},{"label":"is_empty","kind":2,"detail":"fn is_empty(self) -> bool","documentation":{"kind":"markdown","value":"Whether the text has no characters."},"sortText":"0is_empty"},{"label":"contains","kind":2,"detail":"fn contains(self, pattern: String) -> bool","documentation":{"kind":"markdown","value":"Whether `pattern` is part of the text."},"sortText":"0contains"},{"label":"starts_with","kind":2,"detail":"fn starts_with(self, prefix: String) -> bool","documentation":{"kind":"markdown","value":"Whether the text starts with `prefix`."},"sortText":"0starts_with"},{"label":"ends_with","kind":2,"detail":"fn ends_with(self, suffix: String) -> bool","documentation":{"kind":"markdown","value":"Whether the text ends with `suffix`."},"sortText":"0ends_with"},{"label":"find","kind":2,"detail":"fn find(self, pattern: String) -> Option<usize>","documentation":{"kind":"markdown","value":"The byte index of the first `pattern` in the text, or `None`."},"sortText":"0find"},{"label":"trim","kind":2,"detail":"fn trim(self) -> String","documentation":{"kind":"markdown","value":"The text without whitespace at its start and end."},"sortText":"0trim"},{"label":"trim_start","kind":2,"detail":"fn trim_start(self) -> String","documentation":{"kind":"markdown","value":"The text without whitespace at its start."},"sortText":"0trim_start"},{"label":"trim_end","kind":2,"detail":"fn trim_end(self) -> String","documentation":{"kind":"markdown","value":"The text without whitespace at its end."},"sortText":"0trim_end"},{"label":"to_ascii_uppercase","kind":2,"detail":"fn to_ascii_uppercase(self) -> String","documentation":{"kind":"markdown","value":"The text with its ASCII letters in uppercase."},"sortText":"0to_ascii_uppercase"},{"label":"to_ascii_lowercase","kind":2,"detail":"fn to_ascii_lowercase(self) -> String","documentation":{"kind":"markdown","value":"The text with its ASCII letters in lowercase."},"sortText":"0to_ascii_lowercase"},{"label":"replace","kind":2,"detail":"fn replace(self, from: String, to: String) -> String","documentation":{"kind":"markdown","value":"The text with every `from` replaced by `to`."},"sortText":"0replace"},{"label":"repeat","kind":2,"detail":"fn repeat(self, count: usize) -> String","documentation":{"kind":"markdown","value":"The text repeated `count` times."},"sortText":"0repeat"},{"label":"substring","kind":2,"detail":"fn substring(self, start: usize, end: usize) -> String","documentation":{"kind":"markdown","value":"The bytes from `start` to `end`, which must be on character boundaries; panics otherwise."},"sortText":"0substring"},{"label":"as_ptr","kind":2,"detail":"fn as_ptr(self) -> *const u8","documentation":{"kind":"markdown","value":"A pointer to the bytes of the text, for C; they hold no NUL at the end, see `CString`."},"sortText":"0as_ptr"},{"label":"chars","kind":2,"detail":"fn chars(self) -> DoubleEndedIter<char>","documentation":{"kind":"markdown","value":"`text.chars()` outside of `for`."},"sortText":"0chars"},{"label":"bytes","kind":2,"detail":"fn bytes(self) -> DoubleEndedIter<u8>","documentation":{"kind":"markdown","value":"`text.bytes()` outside of `for`."},"sortText":"0bytes"},{"label":"split","kind":2,"detail":"fn split(self, separator: String) -> List<String>","documentation":{"kind":"markdown","value":"The parts of `text` between occurrences of `separator`; an empty separator splits it into\ncharacters."},"sortText":"0split"},{"label":"lines","kind":2,"detail":"fn lines(self) -> List<String>","documentation":{"kind":"markdown","value":"The lines of `text`, without their `\\n` or `\\r\\n`; a final line break does not start a new\nline."},"sortText":"0lines"},{"label":"rfind","kind":2,"detail":"fn rfind(self, pattern: String) -> Option<usize>","documentation":{"kind":"markdown","value":"`text.rfind(pattern)`: the byte index of the last match."},"sortText":"0rfind"},{"label":"split_whitespace","kind":2,"detail":"fn split_whitespace(self) -> List<String>","documentation":{"kind":"markdown","value":"The pieces of `text` between runs of Unicode white space, without empty ones."},"sortText":"0split_whitespace"},{"label":"splitn","kind":2,"detail":"fn splitn(self, count: usize, separator: String) -> List<String>","documentation":{"kind":"markdown","value":"`text.splitn(count, separator)`: at most `count` pieces, the last holding the rest."},"sortText":"0splitn"},{"label":"rsplit","kind":2,"detail":"fn rsplit(self, separator: String) -> List<String>","documentation":{"kind":"markdown","value":"`text.rsplit(separator)`: the pieces of `split`, from the last one."},"sortText":"0rsplit"},{"label":"split_once","kind":2,"detail":"fn split_once(self, separator: String) -> Option<(String, String)>","documentation":{"kind":"markdown","value":"The text before and after the first separator, or `None`."},"sortText":"0split_once"},{"label":"rsplit_once","kind":2,"detail":"fn rsplit_once(self, separator: String) -> Option<(String, String)>","documentation":{"kind":"markdown","value":"The text before and after the last separator, or `None`."},"sortText":"0rsplit_once"},{"label":"strip_prefix","kind":2,"detail":"fn strip_prefix(self, prefix: String) -> Option<String>","documentation":{"kind":"markdown","value":"The text without `prefix`, or `None` if it does not start with it."},"sortText":"0strip_prefix"},{"label":"strip_suffix","kind":2,"detail":"fn strip_suffix(self, suffix: String) -> Option<String>","documentation":{"kind":"markdown","value":"The text without `suffix`, or `None` if it does not end with it."},"sortText":"0strip_suffix"},{"label":"char_indices","kind":2,"detail":"fn char_indices(self) -> DoubleEndedIter<(usize, char)>","documentation":{"kind":"markdown","value":"Each character of `text` with the byte index where it starts."},"sortText":"0char_indices"},{"label":"matches","kind":2,"detail":"fn matches(self, pattern: String) -> List<String>","documentation":{"kind":"markdown","value":"The matches of `pattern` in `text`, from the first, without overlapping."},"sortText":"0matches"},{"label":"replacen","kind":2,"detail":"fn replacen(self, from: String, to: String, count: usize) -> String","documentation":{"kind":"markdown","value":"`text.replacen(from, to, count)`: the first `count` matches replaced."},"sortText":"0replacen"},{"label":"to_uppercase","kind":2,"detail":"fn to_uppercase(self) -> String","documentation":{"kind":"markdown","value":"The text in uppercase, by Unicode's rules."},"sortText":"0to_uppercase"},{"label":"to_lowercase","kind":2,"detail":"fn to_lowercase(self) -> String","documentation":{"kind":"markdown","value":"As Rust's, a capital sigma at the end of a word becomes the final `ς`: one with a cased\ncharacter before it and none after it."},"sortText":"0to_lowercase"},{"label":"parse_i8","kind":2,"detail":"fn parse_i8(self) -> Result<i8, String>","documentation":{"kind":"markdown","value":"The text as an `i8`, or an error saying why it is not one."},"sortText":"0parse_i8"},{"label":"parse_i16","kind":2,"detail":"fn parse_i16(self) -> Result<i16, String>","documentation":{"kind":"markdown","value":"The text as an `i16`, or an error saying why it is not one."},"sortText":"0parse_i16"},{"label":"parse_i32","kind":2,"detail":"fn parse_i32(self) -> Result<i32, String>","documentation":{"kind":"markdown","value":"The text as an `i32`, or an error saying why it is not one."},"sortText":"0parse_i32"},{"label":"parse_i64","kind":2,"detail":"fn parse_i64(self) -> Result<i64, String>","documentation":{"kind":"markdown","value":"The text as an `i64`, or an error saying why it is not one."},"sortText":"0parse_i64"},{"label":"parse_isize","kind":2,"detail":"fn parse_isize(self) -> Result<isize, String>","documentation":{"kind":"markdown","value":"The text as an `isize`, or an error saying why it is not one."},"sortText":"0parse_isize"},{"label":"parse_u8","kind":2,"detail":"fn parse_u8(self) -> Result<u8, String>","documentation":{"kind":"markdown","value":"The text as a `u8`, or an error saying why it is not one."},"sortText":"0parse_u8"},{"label":"parse_u16","kind":2,"detail":"fn parse_u16(self) -> Result<u16, String>","documentation":{"kind":"markdown","value":"The text as a `u16`, or an error saying why it is not one."},"sortText":"0parse_u16"},{"label":"parse_u32","kind":2,"detail":"fn parse_u32(self) -> Result<u32, String>","documentation":{"kind":"markdown","value":"The text as a `u32`, or an error saying why it is not one."},"sortText":"0parse_u32"},{"label":"parse_u64","kind":2,"detail":"fn parse_u64(self) -> Result<u64, String>","documentation":{"kind":"markdown","value":"The text as a `u64`, or an error saying why it is not one."},"sortText":"0parse_u64"},{"label":"parse_usize","kind":2,"detail":"fn parse_usize(self) -> Result<usize, String>","documentation":{"kind":"markdown","value":"The text as a `usize`, or an error saying why it is not one."},"sortText":"0parse_usize"},{"label":"parse_f32","kind":2,"detail":"fn parse_f32(self) -> Result<f32, String>","documentation":{"kind":"markdown","value":"The text as an `f32`, or an error saying why it is not one."},"sortText":"0parse_f32"},{"label":"parse_f64","kind":2,"detail":"fn parse_f64(self) -> Result<f64, String>","documentation":{"kind":"markdown","value":"The text as an `f64`, or an error saying why it is not one."},"sortText":"0parse_f64"},{"label":"to_string","kind":2,"detail":"fn to_string(self) -> String","documentation":{"kind":"markdown","value":"The value as text, as `{}` formats it."},"sortText":"0to_string"},{"label":"into","kind":2,"detail":"fn into(self) -> U","documentation":{"kind":"markdown","value":"The value converted into the type expected, through `From`."},"sortText":"1into"},{"label":"try_into","kind":2,"detail":"fn try_into(self) -> Result<U, E>","documentation":{"kind":"markdown","value":"The value converted into the type expected, through `TryFrom`, or why it cannot be."},"sortText":"1try_into"}]}}
{"jsonrpc":"2.0","id":13,"result":{"isIncomplete":false,"items":[{"label":"read_to_string","kind":3,"detail":"fn read_to_string(path: String) -> Result<String, Error>","documentation":{"kind":"markdown","value":"The whole file at `path`. A file that is not UTF-8 is an error of kind `InvalidData`."}},{"label":"read","kind":3,"detail":"fn read(path: String) -> Result<List<u8>, Error>","documentation":{"kind":"markdown","value":"The bytes of the file at `path`, such as an image or SPIR-V code."}},{"label":"write","kind":3,"detail":"fn write(path: String, text: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Writes `text` to the file at `path`, creating it or replacing its contents."}},{"label":"write_bytes","kind":3,"detail":"fn write_bytes(path: String, bytes: &[u8]) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Writes `bytes` to the file at `path`, creating it or replacing its contents: the counterpart of\n`read`."}},{"label":"append","kind":3,"detail":"fn append(path: String, text: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Writes `text` at the end of the file at `path`, creating it if needed."}},{"label":"exists","kind":3,"detail":"fn exists(path: String) -> bool","documentation":{"kind":"markdown","value":"Whether `path` names a file, a directory or anything else that exists."}},{"label":"is_file","kind":3,"detail":"fn is_file(path: String) -> bool"},{"label":"is_dir","kind":3,"detail":"fn is_dir(path: String) -> bool"},{"label":"create_dir","kind":3,"detail":"fn create_dir(path: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Creates the directory `path`; its parent must exist."}},{"label":"create_dir_all","kind":3,"detail":"fn create_dir_all(path: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Creates the directory `path` and the missing ones above it. A directory that already exists\nis not an error."}},{"label":"remove_dir","kind":3,"detail":"fn remove_dir(path: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Removes the directory `path`, which must be empty."}},{"label":"remove_file","kind":3,"detail":"fn remove_file(path: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Removes the file at `path`."}},{"label":"rename","kind":3,"detail":"fn rename(from: String, to: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Moves `from` to `to`, replacing `to` if it is a file that exists."}},{"label":"copy","kind":3,"detail":"fn copy(from: String, to: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Copies the file `from` to `to`, replacing `to` if it exists."}},{"label":"read_dir","kind":3,"detail":"fn read_dir(path: String) -> Result<List<String>, Error>","documentation":{"kind":"markdown","value":"The names of the entries of the directory `path`, without `.` and `..`, sorted by their\nbytes."}},{"label":"current_dir","kind":3,"detail":"fn current_dir() -> Result<String, Error>","documentation":{"kind":"markdown","value":"The current working directory, as an absolute path."}},{"label":"File","kind":7,"documentation":{"kind":"markdown","value":"An open file, as Rust's `File`: it reads and writes where its position is, and closes when\nits last reference goes, or earlier with `close`, which reports what the system says."}},{"label":"OpenOptions","kind":22,"documentation":{"kind":"markdown","value":"How `open` opens a file, as Rust's `OpenOptions`: each method gives the options with one set."}},{"label":"Metadata","kind":22,"documentation":{"kind":"markdown","value":"What a path names, as Rust's `Metadata`: its size, its kind, whether it is read-only, and its\ntimes, where the system has them."}},{"label":"metadata","kind":3,"detail":"fn metadata(path: String) -> Result<Metadata, Error>","documentation":{"kind":"markdown","value":"What `path` names, following a symbolic link."}},{"label":"symlink_metadata","kind":3,"detail":"fn symlink_metadata(path: String) -> Result<Metadata, Error>","documentation":{"kind":"markdown","value":"What `path` names, a symbolic link itself and not what it names."}},{"label":"remove_dir_all","kind":3,"detail":"fn remove_dir_all(path: String) -> Result<(), Error>","documentation":{"kind":"markdown","value":"Removes a directory with everything in it, as Rust's. A symbolic link is removed itself, not\nwhat it names; a path that names a file is an error."}},{"label":"canonicalize","kind":3,"detail":"fn canonicalize(path: String) -> Result<String, Error>","documentation":{"kind":"markdown","value":"The absolute path of `path`, with `.`, `..` and symbolic links resolved, as Rust's: on Windows\nit starts with `\\\\?\\`."}}]}}
{"jsonrpc":"2.0","id":14,"result":{"isIncomplete":false,"items":[{"label":"length","kind":6,"detail":"usize"},{"label":"sum","kind":6,"detail":"i32"},{"label":"counter","kind":6,"detail":"Counter"},{"label":"point","kind":6,"detail":"Point"},{"label":"Point","kind":22},{"label":"Counter","kind":7},{"label":"main","kind":3,"detail":"fn main()"},{"label":"total","kind":3,"detail":"fn total(values: &[i32]) -> usize"},{"label":"moved","kind":3,"detail":"fn moved(point: &Point) -> i32"},{"label":"LIMIT","kind":21,"detail":"const LIMIT: i32","documentation":{"kind":"markdown","value":"A module-level constant, offered with its type."}},{"label":"FRAMES","kind":6,"detail":"static FRAMES: i64","documentation":{"kind":"markdown","value":"A static, offered with its type."}},{"label":"SCRATCH","kind":6,"detail":"@thread_local static var SCRATCH: i32"},{"label":"c_counter","kind":6,"detail":"extern static var c_counter: i32"},{"label":"kept","kind":3,"detail":"fn kept() -> i32","documentation":{"kind":"markdown","value":"Loads `std::hint`, whose `black_box` is completed after `std::hint::`."}},{"label":"first_of","kind":3,"detail":"fn first_of(pair: (i32, String)) -> i32","documentation":{"kind":"markdown","value":"A tuple, whose elements are completed by their indices after `pair.`."}},{"label":"Zero","kind":8,"documentation":{"kind":"markdown","value":"Static functions of an interface, completed after `Origin::` and after `T::`, defaults included."}},{"label":"Origin","kind":22},{"label":"zeros","kind":3,"detail":"fn zeros() -> String"},{"label":"own_id","kind":3,"detail":"fn own_id() -> u32","documentation":{"kind":"markdown","value":"Loads `std::process`, whose `exit` and `abort` are completed after `std::process::`."}},{"label":"Limits","kind":22,"documentation":{"kind":"markdown","value":"Constants of a type, completed after `Limits::` and `Self::` with its static functions."}},{"label":"limit","kind":3,"detail":"fn limit() -> i64"},{"label":"fs","kind":9},{"label":"Error","kind":8,"documentation":{"kind":"markdown","value":"The interface of error values."}},{"label":"Ordering","kind":13,"documentation":{"kind":"markdown","value":"The result of comparing two values."}},{"label":"min","kind":3,"detail":"fn min(a: T, b: T) -> T","documentation":{"kind":"markdown","value":"The smaller of two values, `a` when they are equal, as Rust's `cmp::min`. Floats,\nwhich are not `Ord`, have their own `min`."}},{"label":"max","kind":3,"detail":"fn max(a: T, b: T) -> T","documentation":{"kind":"markdown","value":"The larger of two values, `b` when they are equal, as Rust's `cmp::max`."}},{"label":"Eq","kind":8,"documentation":{"kind":"markdown","value":"Values that can be compared for equality. Integers, `bool`, `char` and `String` implement\nit."}},{"label":"Ord","kind":8,"documentation":{"kind":"markdown","value":"Values with a total order. Integers, `bool`, `char` and `String` implement it."}},{"label":"Hash","kind":8,"documentation":{"kind":"markdown","value":"Values that can be keys of a `Map`: equal values must have the same hash. Integers, `bool`,\n`char` and `String` implement it."}},{"label":"Display","kind":8,"documentation":{"kind":"markdown","value":"Values with a text for people: a format string interpolates them, `f\"{value}\"`, with this text. Numbers, `bool`, `char` and `String`\nimplement it."}},{"label":"Add","kind":8,"documentation":{"kind":"markdown","value":"`a + b` for values of a type other than numbers and `String`, with a right operand of type\n`Rhs` and a result of type `Out`. Numbers implement\nthe arithmetic interfaces with their own type, and `String` implements `Add<String, String>`."}},{"label":"Sub","kind":8,"documentation":{"kind":"markdown","value":"`a - b`."}},{"label":"Mul","kind":8,"documentation":{"kind":"markdown","value":"`a * b`."}},{"label":"Div","kind":8,"documentation":{"kind":"markdown","value":"`a / b`."}},{"label":"Rem","kind":8,"documentation":{"kind":"markdown","value":"`a % b`."}},{"label":"Neg","kind":8,"documentation":{"kind":"markdown","value":"`-a`. Signed integers and floats implement it."}},{"label":"BitAnd","kind":8,"documentation":{"kind":"markdown","value":"`a & b` for values of a type other than integers and `bool`, as `Add`. Integers and `bool` implement the bitwise interfaces\nwith their own type, and the shifts with a `u32` amount."}},{"label":"BitOr","kind":8,"documentation":{"kind":"markdown","value":"`a | b`."}},{"label":"BitXor","kind":8,"documentation":{"kind":"markdown","value":"`a ^ b`."}},{"label":"Shl","kind":8,"documentation":{"kind":"markdown","value":"`a << b`."}},{"label":"Shr","kind":8,"documentation":{"kind":"markdown","value":"`a >> b`."}},{"label":"Not","kind":8,"documentation":{"kind":"markdown","value":"`!a`."}},{"label":"From","kind":8,"documentation":{"kind":"markdown","value":"A value of the implementing type made from a `T`, without failing, as Rust's `From`: `Celsius::from(f)`. Every type is `From`\nitself. Numbers are `From` the narrower ones that fit them, `u32` and `u64` from `char`,\n`char` from `u8` and `String` from `char`."}},{"label":"Into","kind":8,"documentation":{"kind":"markdown","value":"A value converted into a `U`, as Rust's `Into`. The compiler implements it for every\ntype `U` is `From`; programs implement `From` instead: `const f: Fahrenheit = c.into();`."}},{"label":"TryFrom","kind":8,"documentation":{"kind":"markdown","value":"A value of the implementing type made from a `T`, or the error `E`: integers try every\nother integer type, with Rust's message, and `char` tries `u32`."}},{"label":"TryInto","kind":8,"documentation":{"kind":"markdown","value":"A value converted into a `U`, or the error `E`: the compiler implements it for every type `U`\nis `TryFrom`."}},{"label":"Drop","kind":8,"documentation":{"kind":"markdown","value":"What a class does when its last strong reference goes, before its fields are released, as\nSwift's `deinit`: closing a file, a socket or a\nlock. Only classes implement it; it is never called directly, and `drop` must not keep `self`."}},{"label":"Iterable","kind":8,"documentation":{"kind":"markdown","value":"What `for` iterates over, as Rust's `IntoIterator`:\n`for x in value` runs over `value.iter()`. Lists, arrays and iterators implement it."}},{"label":"FromIterator","kind":8,"documentation":{"kind":"markdown","value":"What `collect()` makes, as Rust's `FromIterator`: `const set: Bag = values.collect();`\ncalls `Bag::from_iter`. Lists, maps, strings and `Result<List<T>, E>` implement it."}},{"label":"Index","kind":8,"documentation":{"kind":"markdown","value":"`value[index]` for a type other than lists, arrays and slices, as Rust's `Index`. A reference cannot be a result, so `index`\ngives the value: a copy of a struct, the same instance of a class."}},{"label":"IndexMut","kind":8,"documentation":{"kind":"markdown","value":"`value[index] = new`, `value[index] += x` and `value[index].field = x`, as Rust's `IndexMut`:\nthe compiler reads the element with `index`, changes it, and writes it back with `index_set`."}},{"label":"Default","kind":8,"documentation":{"kind":"markdown","value":"The value a type starts from, as Rust's `Default`: `0` for numbers, `false`, `'\\0'`, `\"\"`, empty collections, `None`, and for tuples and\narrays the default of each element. A struct or enum written after `@default` has the default\nof each field, or the variant marked `@default`: `Config::default()`, `T::default()`."}},{"label":"Send","kind":8,"documentation":{"kind":"markdown","value":"Values that can cross to another thread: those\nno other thread can change. The compiler infers which types are `Send`; no type names it\nafter `impl`, and it is only a bound (`T: Send`), not a type."}},{"label":"Entry","kind":22,"documentation":{"kind":"markdown","value":"A key and its value, as a `Map` lists them."}},{"label":"Iter","kind":7,"documentation":{"kind":"markdown","value":"A lazy sequence of values: each call to `next` computes the following one."}},{"label":"DoubleEndedIter","kind":7,"documentation":{"kind":"markdown","value":"An iterator that can also give its last value: Rust's `DoubleEndedIterator`. `list.iter()`,\nthe iterators of arrays, slices, ranges and strings give one."}},{"label":"Map","kind":7,"documentation":{"kind":"markdown","value":"A hash map from keys to values that keeps the order in which keys were first inserted. Removed entries leave a hole in `items` and a tombstone in\n`slots` until the table is rebuilt."}},{"label":"Task","kind":7,"documentation":{"kind":"markdown","value":"The task of a call to an `async fn` or of `task::sleep`: its result,\nonce it has finished, and the functions that resume the tasks awaiting it until then. It has\nno public members: `await`, `std::task` and the code the compiler generates for `async fn` use\nthe private ones."}},{"label":"HashSet","kind":7,"documentation":{"kind":"markdown","value":"A set of values without repeats, as Rust's `HashSet`, on a `Map` of its values, so it keeps\nthe order in which values were first inserted. The\noperations between two sets give iterators of copies of the elements, since Rust's lend both."}},{"label":"Some","kind":20},{"label":"None","kind":20},{"label":"Ok","kind":20},{"label":"Err","kind":20},{"label":"std","kind":9},{"label":"i8","kind":22},{"label":"i16","kind":22},{"label":"i32","kind":22},{"label":"i64","kind":22},{"label":"isize","kind":22},{"label":"u8","kind":22},{"label":"u16","kind":22},{"label":"u32","kind":22},{"label":"u64","kind":22},{"label":"usize","kind":22},{"label":"f32","kind":22},{"label":"f64","kind":22},{"label":"bool","kind":22},{"label":"char","kind":22},{"label":"String","kind":22},{"label":"StringBuilder","kind":22},{"label":"List","kind":22},{"label":"Option","kind":22},{"label":"Result","kind":22},{"label":"abstract","kind":14},{"label":"as","kind":14},{"label":"async","kind":14},{"label":"await","kind":14},{"label":"break","kind":14},{"label":"class","kind":14},{"label":"const","kind":14},{"label":"continue","kind":14},{"label":"else","kind":14},{"label":"enum","kind":14},{"label":"extends","kind":14},{"label":"extern","kind":14},{"label":"false","kind":14},{"label":"fn","kind":14},{"label":"for","kind":14},{"label":"if","kind":14},{"label":"impl","kind":14},{"label":"in","kind":14},{"label":"interface","kind":14},{"label":"let","kind":14},{"label":"loop","kind":14},{"label":"match","kind":14},{"label":"new","kind":14},{"label":"override","kind":14},{"label":"pkg","kind":14},{"label":"prv","kind":14},{"label":"pub","kind":14},{"label":"return","kind":14},{"label":"self","kind":14},{"label":"Self","kind":14},{"label":"static","kind":14},{"label":"struct","kind":14},{"label":"super","kind":14},{"label":"true","kind":14},{"label":"union","kind":14},{"label":"unsafe","kind":14},{"label":"use","kind":14},{"label":"var","kind":14},{"label":"weak","kind":14},{"label":"where","kind":14},{"label":"while","kind":14},{"label":"zod","kind":14},{"label":"print","kind":3},{"label":"println","kind":3},{"label":"eprintln","kind":3},{"label":"panic","kind":3},{"label":"assert","kind":3},{"label":"assert_eq","kind":3},{"label":"assert_ne","kind":3},{"label":"unreachable","kind":3},{"label":"todo","kind":3},{"label":"include!","kind":3,"detail":"include!(\"file.sag\"): puts the items of a file in the module","insertText":"include!(\"${1:file.sag}\");","insertTextFormat":2},{"label":"include_str!","kind":3,"detail":"include_str!(\"file\"): the text of a file, read when the program is compiled","insertText":"include_str!(\"${1:file}\")","insertTextFormat":2},{"label":"include_bytes!","kind":3,"detail":"include_bytes!(\"file\"): the bytes of a file, as a `[u8; N]`","insertText":"include_bytes!(\"${1:file}\")","insertTextFormat":2},{"label":"concat!","kind":3,"detail":"concat!(a, b, ...): literals joined into one string literal","insertText":"concat!(${1})","insertTextFormat":2},{"label":"env!","kind":3,"detail":"env!(\"NAME\"): an environment variable of the compiler, read when the program is compiled","insertText":"env!(\"${1:NAME}\")","insertTextFormat":2}]}}
