,"detail":"fn min(self) -> Option<i32>","documentation":{"kind":"markdown","value":"The first of the smallest elements, as Rust's `Iterator::min`."},"sortText":"0min"},{"label":"max","kind":2,"detail":"fn max(self) -> Option<i32>","documentation":{"kind":"markdown","value":"The last of the largest elements, as Rust's `Iterator::max`."},"sortText":"0max"},{"label":"sort","kind":2,"detail":"fn sort(self)","documentation":{"kind":"markdown","value":"Sorts the elements in place, in ascending order."},"sortText":"0sort"},{"label":"sort_by","kind":2,"detail":"fn sort_by(self, compare: fn(i32, i32) -> Ordering)","documentation":{"kind":"markdown","value":"Sorts the elements in place, by `compare`."},"sortText":"0sort_by"},{"label":"sort_by_key","kind":2,"detail":"fn sort_by_key(self, key: fn(i32) -> K)","documentation":{"kind":"markdown","value":"Stable, by the key each element gives, which is computed once per comparison as Rust's."},"sortText":"0sort_by_key"},{"label":"reverse","kind":2,"detail":"fn reverse(self)","documentation":{"kind":"markdown","value":"Reverses the order of the elements in place."},"sortText":"0reverse"},{"label":"fill","kind":2,"detail":"fn fill(self, value: i32)","documentation":{"kind":"markdown","value":"Sets every element to `value`."},"sortText":"0fill"},{"label":"swap","kind":2,"detail":"fn swap(self, a: usize, b: usize)","documentation":{"kind":"markdown","value":"Swaps two elements; an index past the end panics."},"sortText":"0swap"},{"label":"copy_from_slice","kind":2,"detail":"fn copy_from_slice(self, source: &[i32])","documentation":{"kind":"markdown","value":"Copies `source`, which must have as many elements, into `items`."},"sortText":"0copy_from_slice"},{"label":"into","kind":2,"detail":"fn into(self) -> U","documentation":{"kind":"markdown","value":"The value converted into the type expected, through `From`."},"sortText":"1into"},{"label":"try_into","kind":2,"detail":"fn try_into(self) -> Result<U, E>","documentation":{"kind":"markdo