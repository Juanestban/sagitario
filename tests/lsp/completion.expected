{"jsonrpc":"2.0","id":26,"result":{"isIncomplete":false,"items":[{"label":"MIN","kind":21,"detail":"const MIN: i32","documentation":{"kind":"markdown","value":"The smallest value of `i32`."}},{"label":"MAX","kind":21,"detail":"const MAX: i32","documentation":{"kind":"markdown","value":"The largest value of `i32`."}},{"label":"from","kind":3,"detail":"fn from(value: U) -> i32","documentation":{"kind":"markdown","value":"`value` as `i32`, when every value of its type fits."}},{"label":"try_from","kind":3,"detail":"fn try_from(value: U) -> Result<i32, String>","documentation":{"kind":"markdown","value":"`value` as `i32`, or an error if it does not fit."}},{"label":"default","kind":3,"detail":"fn default() -> i32","documentation":{"kind":"markdown","value":"Zero."}},{"label":"from_le_bytes","kind":3,"detail":"fn from_le_bytes(bytes: [u8; N]) -> i32","documentation":{"kind":"markdown","value":"The integer of the bytes, least significant first."}},{"label":"from_be_bytes","kind":3,"detail":"fn from_be_bytes(bytes: [u8; N]) -> i32","documentation":{"kind":"markdown","value":"The integer of the bytes, most significant first."}},{"label":"from_ne_bytes","kind":3,"detail":"fn from_ne_bytes(bytes: [u8; N]) -> i32","documentation":{"kind":"markdown","value":"The integer of the bytes, in the order of the target."}},{"label":"from_str_radix","kind":3,"detail":"fn from_str_radix(text: String, radix: u32) -> Result<i32, String>","documentation":{"kind":"markdown","value":"The integer `text` writes in base `radix`."}}]}}
