 f64","sortText":"0exp"},{"label":"exp2","kind":2,"detail":"fn exp2(self) -> f64","sortText":"0exp2"},{"label":"ln","kind":2,"detail":"fn ln(self) -> f64","sortText":"0ln"},{"label":"log2","kind":2,"detail":"fn log2(self) -> f64","sortText":"0log2"},{"label":"log10","kind":2,"detail":"fn log10(self) -> f64","sortText":"0log10"},{"label":"sin","kind":2,"detail":"fn sin(self) -> f64","sortText":"0sin"},{"label":"cos","kind":2,"detail":"fn cos(self) -> f64","sortText":"0cos"},{"label":"tan","kind":2,"detail":"fn tan(self) -> f64","sortText":"0tan"},{"label":"asin","kind":2,"detail":"fn asin(self) -> f64","sortText":"0asin"},{"label":"acos","kind":2,"detail":"fn acos(self) -> f64","sortText":"0acos"},{"label":"atan","kind":2,"detail":"fn atan(self) -> f64","sortText":"0atan"},{"label":"sinh","kind":2,"detail":"fn sinh(self) -> f64","sortText":"0sinh"},{"label":"cosh","kind":2,"detail":"fn cosh(self) -> f64","sortText":"0cosh"},{"label":"tanh","kind":2,"detail":"fn tanh(self) -> f64","sortText":"0tanh"},{"label":"to_degrees","kind":2,"detail":"fn to_degrees(self) -> f64","sortText":"0to_degrees"},{"label":"to_radians","kind":2,"detail":"fn to_radians(self) -> f64","sortText":"0to_radians"},{"label":"is_nan","kind":2,"detail":"fn is_nan(self) -> bool","sortText":"0is_nan"},{"label":"is_infinite","kind":2,"detail":"fn is_infinite(self) -> bool","sortText":"0is_infinite"},{"label":"is_finite","kind":2,"detail":"fn is_finite(self) -> bool","sortText":"0is_finite"},{"label":"into","kind":2,"detail":"fn into(self) -> U","documentation":{"kind":"markdown","value":"The value converted into the type expected, through `From`."},"sortText":"1into"},{"label":"try_into","kind":2,"detail":"fn try_into(self) -> Result<U, E>","documentation":{"kind":"markdown","value":"The value converted into the type expected, through `TryFrom`, or why it cannot be."},"sortText":"1try_into"}]}}
