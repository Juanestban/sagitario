// A shift by the width of the type or more panics in debug builds, as in Rust
// (docs/adr/0088-bitwise-operators-and-integer-methods.md, Q577).
// expect-panic: attempt to shift left with overflow
fn shift(value: u32, amount: u32) -> u32 {
  value << amount
}

fn main() {
  println(f"{shift(1, 31)}");
  println(f"{shift(1, 32)}");
}
