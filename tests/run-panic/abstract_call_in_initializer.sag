// An abstract method called while its class's initializer runs has no implementation yet.
// expect-panic: called the abstract method `sound` of `Animal` while initializing it

abstract class Animal {
  pub var greeting: String;

  pub fn new() {
    self.greeting = "";
    self.greeting = self.sound();
  }

  pub abstract fn sound(self) -> String;
}

class Dog extends Animal {
  pub fn new() {
    zod.new();
  }

  pub override fn sound(self) -> String {
    "woof"
  }
}

fn main() {
  const dog = new Dog();
  println(dog.greeting);
}
