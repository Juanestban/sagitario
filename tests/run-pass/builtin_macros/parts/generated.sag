// Items put in the root module by `include!`, as a build script's bindings would be.
use std::math;

pub const GENERATED_LIMIT: i32 = 12;

pub fn generated_twice(x: i32) -> i32 {
  x * 2
}

/// A module-level item of the file uses an import of its own.
fn generated_root() -> f64 {
  math::sqrt(81.0)
}

pub fn generated_summary() -> String {
  f"{generated_twice(GENERATED_LIMIT)} {generated_root()}"
}
