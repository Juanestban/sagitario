// Functions with return values, if/else as values, loops, break values and continue.
// expect-stdout: fizzbuzz: 1 2 Fizz 4 Buzz Fizz 7 8 Fizz Buzz 11 Fizz 13 14 FizzBuzz
// expect-stdout: fib(30) = 832040
// expect-stdout: sum 0..=100 = 5050
// expect-stdout: first square above 50: 8
// expect-stdout: sign: -1 0 1
// expect-stdout: u8 range: 256 iterations
// expect-stdout: odd: 1 3 5 7 9
fn fizz(n: i32) -> String {
  if n % 15 == 0 { "FizzBuzz" } else if n % 3 == 0 { "Fizz" } else if n % 5 == 0 { "Buzz" } else { `${n}` }
}

fn fib(n: u32) -> u64 {
  var a: u64 = 0;
  var b: u64 = 1;

  for _i in 0..n {
    const next = a + b;
    a = b;
    b = next;
  }

  a
}

fn first_square_above(limit: u32) -> u32 {
  var n: u32 = 0;

  loop {
    n += 1;

    if n * n > limit {
      break n;
    }
  }
}

fn sign(x: i32) -> i32 {
  if x < 0 {
    return -1;
  }

  if x == 0 { 0 } else { 1 }
}

pub fn main() {
  var line = "fizzbuzz:";

  for i in 1..=15 {
    line = `${line} ${fizz(i)}`;
  }

  println(line);
  println(`fib(30) = ${fib(30)}`);

  var sum = 0;

  for i in 0..=100 {
    sum += i;
  }

  println(`sum 0..=100 = ${sum}`);
  println(`first square above 50: ${first_square_above(50)}`);
  println(`sign: ${sign(-5)} ${sign(0)} ${sign(7)}`);

  var count = 0;

  for _b in 0u8..=255u8 {
    count += 1;
  }

  println(`u8 range: ${count} iterations`);

  var odd = "odd:";
  var k = 0;

  while k < 10 {
    k += 1;

    if k % 2 == 0 {
      continue;
    }

    odd = `${odd} ${k}`;
  }

  println(odd);
}
