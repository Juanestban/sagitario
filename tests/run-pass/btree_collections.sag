// `std::collections::BTreeMap` and `BTreeSet`: a B-tree checked against a map and a sorted list
// over thousands of insertions and removals, the methods of `Map` in the order of the keys, the
// ordered ones, ranges, sets in order, comparison, order and hash by their entries, their debug
// forms, `for` and `collect` (docs/adr/0095-collections.md, Q649, Q650 and Q652).
// expect-stdout: true 3000
// expect-stdout: {"ada": 5, "bob": 3, "eve": 1} 3 Some(5) None 5 true
// expect-stdout: [("ada", 5), ("bob", 3)] [("bob", 3), ("eve", 1)] [("ada", 5)] [1, 3, 5] ["eve", "bob", "ada"]
// expect-stdout: Some(("ada", 5)) Some(("eve", 1)) Some(("ada", 5)) {"bob": 3, "eve": 1}
// expect-stdout: Some(13) true 10 false 2
// expect-stdout: {1, 3, 5} [5, 3, 1] [1, 3, 5, 7] [3, 5] [1] [1, 7] true true
// expect-stdout: Some(1) Some(5) [2, 3] [1, 2] [4, 5] true false true 1
// expect-stdout: ada5 bob3 eve1 4
// expect-stdout: {
// expect-stdout:     1: "a",
// expect-stdout: }

use std::collections::{BTreeMap, BTreeSet};

/// A generator of numbers that repeat, as `(seed * 1103515245 + 12345) % 2^31`.
class Numbers {
  pub var seed: i64;

  pub fn new(self, seed: i64) {
    self.seed = seed;
  }

  pub fn next(self, limit: i64) -> i64 {
    self.seed = (self.seed * 1103515245 + 12345) % 2147483648;
    self.seed % limit
  }
}

/// Whether the map holds the entries of `reference`, in the order of their keys.
fn agrees(map: BTreeMap<i64, i64>, reference: Map<i64, i64>) -> bool {
  const keys: List<i64> = reference.keys().collect();

  keys.sort();

  const expected: List<(i64, i64)> = keys.iter().map((key) => (key, reference.get(key).unwrap())).collect();
  const actual: List<(i64, i64)> = map.iter().collect();

  map.len() == reference.len() && actual == expected
}

fn total<T: Iterable<i32>>(values: T) -> i32 {
  var sum = 0;

  for value in values {
    sum += value;
  }

  sum
}

fn main() {
  const map = new BTreeMap<i64, i64>();
  const reference = new Map<i64, i64>();
  const numbers = new Numbers(7);
  var ok = true;
  var steps = 0i64;

  for _ in 0..3000 {
    const key = numbers.next(500);

    if numbers.next(3) == 0 {
      ok = ok && map.remove(key) == reference.remove(key);
    } else {
      ok = ok && map.insert(key, steps) == reference.insert(key, steps);
    }

    steps += 1;

    if steps % 250 == 0 {
      ok = ok && agrees(map, reference);
    }
  }

  // Emptying the tree walks every way a node can lose keys.
  for key in 0..500 {
    ok = ok && map.remove(key as i64) == reference.remove(key as i64);
  }

  println(f"{ok && map.is_empty()} {steps}");

  const scores = BTreeMap::from(List::from([("bob", 3), ("eve", 1), ("ada", 5)]));

  println(f"{scores:?} {scores.len()} {scores.get("ada"):?} {scores.get("zed"):?} {scores["ada"]} {scores.contains_key("eve")}");
  println(f"{scores.range("a", "c").collect():?} {scores.range_from("b").collect():?} {scores.range_to("b").collect():?} {scores.values().rev().collect():?} {scores.keys().rev().collect():?}");

  const popped = BTreeMap::from(List::from([("bob", 3), ("eve", 1), ("ada", 5)]));

  println(f"{popped.first_key_value():?} {popped.last_key_value():?} {popped.pop_first():?} {popped:?}");

  const counts = BTreeMap::from(List::from([(1, 10), (2, 20)]));

  counts.upsert(1, 0, (n) => n + 3);
  counts.upsert(3, 0, (n) => n + 3);
  counts.retain((key, _value) => key != 2);

  const same = BTreeMap::from(List::from([(3, 0), (1, 13)]));
  const keyed = new Map<BTreeMap<i32, i32>, i32>();

  keyed.insert(same, 2);
  println(f"{counts.get(1):?} {counts == same} {counts.get_or_insert(9, 10)} {counts == same} {keyed.get(BTreeMap::from(List::from([(1, 13), (3, 0)]))).unwrap_or(0)}");

  const set = BTreeSet::from(List::from([5, 1, 3, 1]));
  const other = BTreeSet::from(List::from([7, 3, 5]));

  println(f"{set:?} {set.iter().rev().collect():?} {set.union(other).collect():?} {set.intersection(other).collect():?} {set.difference(other).collect():?} {set.symmetric_difference(other).collect():?} {set == BTreeSet::from(List::from([3, 5, 1]))} {set < other}");

  const ranged = BTreeSet::from(List::from([1, 2, 3, 4, 5]));
  const built: BTreeSet<i32> = List::from([4, 4]).iter().collect();

  println(f"{ranged.first():?} {ranged.last():?} {ranged.range(2, 4).collect():?} {ranged.range_to(3).collect():?} {ranged.range_from(4).collect():?} {built.is_subset(ranged)} {ranged.is_subset(built)} {ranged.insert(9) && !ranged.insert(9)} {ranged.pop_first().unwrap_or(0)}");

  const visited = new List<String>();

  for (name, score) in scores {
    visited.push(f"{name}{score}");
  }

  println(f"{visited.join(" ")} {total(built)}");

  const one = BTreeMap::from(List::from([(1, "a")]));

  println(f"{one:#?}");
}
