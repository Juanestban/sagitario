//! Functions, parameters, comments and string escapes.
// expect-stdout: Hello, Sagitario!
// expect-stdout: tab:	end
// expect-stdout: quote: "q" and \ backslash
// expect-stdout: unicode: ñandú 😀
// expect-stdout: same line
// expect-stdout: last
// expect-exit: 0

/// Prints a greeting.
fn greet(name: String) {
  print("Hello, ");
  print(name);
  println("!");
}

/* Block comments /* nest */ like in Rust. */
fn show(text: String, unused: u8) {
  println(text);
}

pub fn main() {
  greet("Sagitario");
  show("tab:\tend", 255);
  println("quote: \"q\" and \\ backslash");
  println("unicode: ñandú \u{1F600}");
  print("same ");
  print("line\n");
  eprintln("this goes to stderr");
  1_000;
  2.5f32;
  'x';
  true;
  println("last")
}
