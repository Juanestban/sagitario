// `main` returning `Err` prints the error to stderr and exits with code 1, after releasing it.
// expect-stdout: checking 1
// expect-stdout: checking 2
// expect-exit: 1
fn check(n: i32) -> Result<i32, String> {
  if n > 1 {
    return Err(`${n} is too big`);
  }

  Ok(n)
}

pub fn main() -> Result<(), String> {
  for i in 1..5 {
    println(`checking ${i}`);
    check(i)?;
  }

  Ok(())
}
