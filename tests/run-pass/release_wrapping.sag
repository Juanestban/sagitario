// In release builds integer overflow wraps instead of panicking.
// sag-flags: --release
// expect-stdout: 4 -128 -128
// expect-stdout: -128 0 -2147483648
pub fn main() {
  var x: u8 = 250;

  for _i in 0..10 {
    x += 1;
  }

  var y: i8 = 127;
  y += 1;

  println(`${x} ${y} ${-y}`);

  const z: i32 = -2147483648;

  println(`${y.abs()} ${2i8.pow(8)} ${z.abs()}`);
}
