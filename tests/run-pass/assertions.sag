// Assertions that hold do nothing; `unreachable` fits where any type is expected
// (docs/adr/0093-everyday-methods.md, Q618).
// expect-stdout: all held -1 0

fn sign(n: i32) -> i32 {
  if n > 0 { 1 } else if n < 0 { -1 } else if n == 0 { 0 } else { unreachable() }
}

fn main() {
  assert(1 + 1 == 2);
  assert_eq(sign(-5), -1);
  assert_ne("a", "b");
  assert_eq((1, "x"), (1, "x"));
  assert_eq(Some(3).ok_or("none"), Ok(3));
  println(f"all held {sign(-2)} {sign(0)}");
}
