// The adapters and consumers of iterators of ADR-0093, increment 5, `peek`, `DoubleEndedIter` with
// `rev` and `next_back`, and `collect` into what the context expects (docs/adr/0093-everyday-methods.md,
// Q626-Q628).
// expect-stdout: [(0, "a"), (1, "bb"), (2, "ccc")] [("a", 10), ("bb", 20), ("ccc", 30)]
// expect-stdout: [1, 2, 7, 8] ['a', 'b', 'b', 'c', 'c', 'c']
// expect-stdout: [1, 2, 3] [4, 5] [1, 2]
// expect-stdout: [1, 2, 3, 1, 2, 3, 1] 55 120 4
// expect-stdout: Some("a") Some("ccc") Some("ccc") Some("ccc")
// expect-stdout: Some(1) Some("ccc") Some(13) ([3, 6], [1, 2, 4, 5])
// expect-stdout: ([1, 2], ['a', 'b']) [1, 2, 3]
// expect-stdout: [1, 3]
// expect-stdout: Some(2) Some(2) Some(2) [4, 6]
// expect-stdout: ["ccc", "bb", "a"] [25, 16, 9, 4, 1] [9, 6, 3, 0]
// expect-stdout: ['o', 'l', 'l', 'é', 'h'] [(3, 'b'), (1, 'ñ'), (0, 'a')]
// expect-stdout: Some(1) Some(6) Some(2) Some(5) [3, 4]
// expect-stdout: Some(1) Some(2) Some(1) None
// expect-stdout: 9 [0, 2, 4, 6] [1, 2, 0, 2, 4]
// expect-stdout: hi abbccc {"Ada": 36} Ok([1, 2]) Err("invalid digit found in string")
// expect-stdout: [1, 2, 3] 3

fn evens(limit: i32) -> Iter<i32> {
  (0..limit).filter((n) => n % 2 == 0)
}

fn main() {
  const words = List::from(["a", "bb", "ccc"]);

  println(f"{words.iter().enumerate().collect():?} {words.iter().zip((1..10).map((n) => n * 10)).collect():?}");
  println(f"{(1..3).chain(7..9).collect():?} {words.iter().flat_map((w) => w.chars()).collect():?}");
  println(f"{(1..10).take_while((n) => n < 4).collect():?} {(1..6).skip_while((n) => n < 4).collect():?} {List::from(["1", "2", "x", "3"]).iter().map_while((s) => s.parse_i32().ok()).collect():?}");
  println(f"{(1..4).cycle().take(7).collect():?} {(1..=10).sum()} {(1..=5).product()} {List::from([1.5, 2.5]).iter().sum()}");
  println(f"{words.iter().min():?} {words.iter().max():?} {words.iter().max_by_key((w) => w.len()):?} {words.iter().min_by((a, b) => b.compare(a)):?}");
  println(f"{words.iter().position((w) => w == "bb"):?} {words.iter().last():?} {(10..20).nth(3):?} {(1..7).partition((n) => n % 3 == 0):?}");
  println(f"{List::from([(1, 'a'), (2, 'b')]).iter().unzip():?} {List::from([List::from([1]), List::from([2, 3])]).iter().flatten().collect():?}");
  println(f"{List::from([Some(1), None, Some(3)]).iter().flatten().collect():?}");

  const peeking = (1..4).map((n) => n * 2);

  println(f"{peeking.peek():?} {peeking.peek():?} {peeking.next():?} {peeking.collect():?}");
  println(f"{words.iter().rev().collect():?} {(1..=5).rev().map((n) => n * n).collect():?} {(0..10).filter((n) => n % 3 == 0).rev().collect():?}");
  println(f"{"héllo".chars().rev().collect():?} {"añb".char_indices().rev().collect():?}");

  const both = (1..=6).map((n) => n);

  println(f"{both.next():?} {both.next_back():?} {both.next():?} {both.next_back():?} {both.collect():?}");

  // What `peek` read ahead is the last value `next_back` gives.
  const peeked = (1..=2).map((n) => n);

  println(f"{peeked.peek():?} {peeked.next_back():?} {peeked.next_back():?} {peeked.next():?}");

  var total = 0;

  for (index, word) in words.iter().enumerate().inspect((_pair) => {}) {
    total += index as i32 + word.len() as i32;
  }

  println(f"{total} {evens(7).collect():?} {(1..3).chain(evens(5)).collect():?}");

  const text: String = List::from(['h', 'i']).iter().collect();
  const joined: String = words.iter().collect();
  const ages: Map<String, i32> = List::from([("Ada", 36)]).iter().collect();
  const parsed: Result<List<i32>, String> = List::from(["1", "2"]).iter().map((s) => s.parse_i32()).collect();
  const failed: Result<List<i32>, String> = List::from(["1", "x"]).iter().map((s) => s.parse_i32()).collect();

  println(f"{text} {joined} {ages:?} {parsed:?} {failed:?}");

  const extended = List::from([1]);

  extended.extend(List::from([2, 3]).iter());
  println(f"{extended:?} {List::from([1, 2, 3]).enumerate().map((pair) => pair.0).sum()}");
}
