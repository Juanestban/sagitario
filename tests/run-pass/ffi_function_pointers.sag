// C function pointers (docs/adr/0078-ffi-without-c-shims.md, increment 1): `qsort` calling a
// comparison written in Sagitario, C functions and `extern "C" fn`s as values, calls through
// pointers and through fields, `Option` as a nullable pointer, conversions and `unsafe fn`.
// expect-stdout: 1 3 5 7 9
// expect-stdout: 42 8
// expect-stdout: false 0
// expect-stdout: true 6
// expect-stdout: 100 5 8
// expect-stdout: 12 20
use std::ffi::{c_int, c_void};

extern "C" {
  fn qsort(base: *mut c_void, count: usize, size: usize, compare: extern "C" fn(*const c_void, *const c_void) -> c_int);
  fn abs(value: c_int) -> c_int;
}

extern "C" fn by_value(a: *const c_void, b: *const c_void) -> c_int {
  const x = unsafe { *(a as *const i32) };
  const y = unsafe { *(b as *const i32) };

  if x < y { -1 } else if x > y { 1 } else { 0 }
}

extern "C" fn twice(x: i32) -> i32 {
  x * 2
}

/// Halves `x`; the caller must pass an even number.
unsafe fn halve(x: i32) -> i32 {
  x / 2
}

/// Exported, and a C function pointer like any `extern "C" fn`.
@export("demo_triple")
unsafe extern "C" fn triple(x: i32) -> i32 {
  x * 3
}

@repr(C)
struct Callbacks {
  pub on_value: Option<extern "C" fn(i32) -> i32>;
  pub scale: i32;
}

struct Scaler {
  pub apply: extern "C" fn(i32) -> i32;
}

class Counter {
  pub var count: i32;

  pub fn new(self) {
    self.count = 0;
  }

  /// Adds `n`; the caller must keep the count from overflowing.
  pub unsafe fn add(self, n: i32) {
    self.count += n;
  }
}

fn apply(f: extern "C" fn(i32) -> i32, x: i32) -> i32 {
  f(x)
}

fn applied_or_zero(f: Option<extern "C" fn(i32) -> i32>, x: i32) -> i32 {
  match f {
    Some(found) => found(x),
    None => 0,
  }
}

fn main() {
  var numbers = [5, 3, 9, 1, 7];

  unsafe {
    qsort(numbers.as_mut_ptr() as *mut c_void, numbers.len(), 4, by_value);
  }

  println(`${numbers[0]} ${numbers[1]} ${numbers[2]} ${numbers[3]} ${numbers[4]}`);

  const doubled = apply(twice, 21);
  const absolute: unsafe extern "C" fn(c_int) -> c_int = abs;
  const positive = unsafe { absolute(-8) };

  println(`${doubled} ${positive}`);

  var callbacks = Callbacks { on_value: None, scale: 3 };

  println(`${callbacks.on_value.is_some()} ${applied_or_zero(callbacks.on_value, 1)}`);

  callbacks.on_value = Some(twice);

  if let Some(f) = callbacks.on_value {
    println(`${callbacks.on_value.is_some()} ${f(callbacks.scale)}`);
  }

  const address = twice as usize;
  const back = unsafe { address as extern "C" fn(i32) -> i32 };
  const half = unsafe { halve(10) };
  const safe_as_unsafe: unsafe extern "C" fn(i32) -> i32 = twice;
  const eight = unsafe { safe_as_unsafe(4) };

  println(`${back(50)} ${half} ${eight}`);

  const scaler = Scaler { apply: twice };
  const tripled = unsafe { triple(4) };
  const counter = new Counter();

  unsafe { counter.add(scaler.apply(10)); }

  println(`${tripled} ${counter.count}`);
}
