// Lists and arrays compare, order and hash by their elements, and maps compare by their entries
// in any order (docs/adr/0093-everyday-methods.md, Q623).
// expect-stdout: true true true true Greater
// expect-stdout: true true true
// expect-stdout: Some("cell") false
// expect-stdout: [[1], [1, 5], [2]] true
// expect-stdout: true
// expect-stdout: false true

fn main() {
  const a = List::from([1, 2, 3]);
  const b = List::from([1, 2, 3]);
  const c = List::from([1, 2]);

  println(f"{a == b} {a != c} {c < a} {List::from([1, 3]) > a} {a.compare(c):?}");
  println(f"{[1, 2] == [1, 2]} {[3, 1] > [2, 9]} {List::from(["x"]) == List::from(["x"])}");

  const grid = new Map<List<i32>, String>();

  grid.insert(List::from([0, 1]), "cell");
  println(f"{grid.get(List::from([0, 1])):?} {grid.contains_key(List::from([1, 0]))}");

  const lists = List::from([List::from([2]), List::from([1, 5]), List::from([1])]);

  lists.sort();
  println(f"{lists:?} {lists.contains(List::from([1, 5]))}");

  const first = new Map<String, i32>();
  const second = new Map<String, i32>();

  first.insert("a", 1);
  first.insert("b", 2);
  second.insert("b", 2);
  second.insert("a", 1);
  println(f"{first == second}");
  second.insert("a", 3);
  println(f"{first == second} {first != second}");
  assert_eq(List::from([(1, "x")]), List::from([(1, "x")]));
  assert_eq([Some(1), None], [Some(1), None]);
}
