// The methods of lists, arrays and slices of ADR-0093, increment 3: those of slices are written
// once and lent arrays and lists (docs/adr/0093-everyday-methods.md, Q622 and Q624).
// expect-stdout: [5, 3, 8, 1, 9, 2] Some(1) Some(9) true
// expect-stdout: [5, 3, 8, 1, 9, 2, 7, 7] []
// expect-stdout: [5, 3, 8, 1, 9]
// expect-stdout: [5, 3, 8] [1, 9] [2, 3]
// expect-stdout: Ok(2) Err(2) Ok(3)
// expect-stdout: ["a", "bb", "ccc"]
// expect-stdout: [2, 1, 1] [[1, 2], [2, 3], [3, 4], [4, 5]] [[1, 2], [3, 4], [5]]
// expect-stdout: [1, 2, 3]
// expect-stdout: true 0
// expect-stdout: true
// expect-stdout: [4, 4, 4]
// expect-stdout: [1, 2, 3, 4] true Some(3) Ok(2) Some(4)
// expect-stdout: [9, 9, 9, 9] 36
// expect-stdout: [1, 2, 3]
// expect-stdout: [5, 6]
// expect-stdout: [(1, "a"), (2, "b")]

fn total(values: &[i32]) -> i32 {
  var sum = 0;

  for value in values {
    sum += value;
  }

  sum
}

fn shuffle(values: &mut [i32]) {
  values.reverse();
  values.swap(0, 1);
}

fn main() {
  const list = List::from([5, 3, 8, 1]);

  list.extend(List::from([9, 2]).iter());
  println(f"{list:?} {list.min():?} {list.max():?} {list.contains(8)}");

  const other = List::from([7, 7]);

  list.append(other);
  println(f"{list:?} {other:?}");
  list.retain((n) => n != 7);
  list.truncate(5);
  println(f"{list:?}");

  const tail = list.split_off(3);
  const drained = List::from([1, 2, 3, 4, 5]).drain(1, 3);

  println(f"{list:?} {tail:?} {drained:?}");

  const sorted = List::from([1, 3, 5, 7]);

  println(f"{sorted.binary_search(5):?} {sorted.binary_search(4):?} {sorted.binary_search_by((n) => n.compare(7)):?}");

  const words = List::from(["ccc", "a", "bb"]);

  words.sort_by_key((w) => w.len());
  println(f"{words:?}");

  const dups = List::from([1, 1, 2, 2, 2, 1]);

  dups.dedup();
  dups.swap(0, 1);
  println(f"{dups:?} {List::from([1, 2, 3, 4, 5]).windows(2).collect():?} {List::from([1, 2, 3, 4, 5]).chunks(2).collect():?}");
  println(f"{List::from([List::from([1]), List::from([2, 3])]).concat():?}");

  const room: List<String> = List::with_capacity(10);

  println(f"{room.capacity() >= 10} {room.len()}");
  room.reserve(50);
  println(f"{room.capacity() >= 50}");

  const filled = List::from([0, 0, 0]);

  filled.fill(4);
  println(f"{filled:?}");

  var numbers = [4, 1, 3, 2];

  numbers.sort();
  println(f"{numbers:?} {numbers.contains(3)} {numbers.index_of(4):?} {numbers.binary_search(3):?} {numbers.max():?}");
  numbers.reverse();
  numbers.fill(9);
  numbers.swap(0, 3);
  println(f"{numbers:?} {total(&numbers)}");

  var more = [3, 1, 2];

  shuffle(&mut more);
  println(f"{more:?}");

  var target = [0, 0];

  target.copy_from_slice(&[5, 6]);
  println(f"{target:?}");

  const pairs = List::from([(2, "b"), (1, "a")]);

  pairs.sort_by_key((pair) => pair.0);
  println(f"{pairs:?}");
}
