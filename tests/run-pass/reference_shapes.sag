// F1 reference program: enums with data and exhaustive `match`.
// expect-stdout: circle r=1: 3.14159
// expect-stdout: rect 2x3: 6
// expect-stdout: square 4: 16
// expect-stdout: point: 0
// expect-stdout: largest: square 4
// expect-stdout: total: 25.14159
enum Shape {
  Circle(f64),
  Rect { w: f64, h: f64 },
  Point,

  pub fn area(self) -> f64 {
    match self {
      Shape::Circle(r) => 3.14159 * r * r,
      Shape::Rect { w, h } => w * h,
      Shape::Point => 0.0,
    }
  }

  pub fn describe(self) -> String {
    match self {
      Shape::Circle(r) => `circle r=${r}`,
      Shape::Rect { w, h } if w == h => `square ${w}`,
      Shape::Rect { w, h } => `rect ${w}x${h}`,
      Shape::Point => "point",
    }
  }
}

fn main() {
  const shapes = [Shape::Circle(1.0), Shape::Rect { w: 2.0, h: 3.0 }, Shape::Rect { w: 4.0, h: 4.0 }, Shape::Point];
  var total = 0.0;
  var largest = Shape::Point;

  for shape in shapes {
    const area = shape.area();
    println(`${shape.describe()}: ${area}`);
    total += area;
    if area > largest.area() {
      largest = shape;
    }
  }

  println(`largest: ${largest.describe()}`);
  println(`total: ${total}`);
}
