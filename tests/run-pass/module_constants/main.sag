// Module-level constants (docs/spec/03-memory.md#module-level-constants): literals, arithmetic,
// comparisons, casts, other constants (also from other modules, imported or named in full),
// negative limits, and `include_str` with a text longer than the string literals C compilers
// must accept.
// expect-stdout: 3.14159 6.28318 sagitario z true 44 -128 0.5
// expect-stdout: 100 60000 207
// expect-stdout: línea uno
// expect-stdout: línea dos
// expect-stdout: 10600 200 row 00199 of a file longer than any C string literal
// expect-stdout: 3 limit 207

use pkg::config::limits;
use pkg::config::limits::MAX_USERS;

const PI: f64 = 3.14159;
const TAU: f64 = PI * 2.0;
const NAME: String = "sag" + "itario";
const LETTER: char = 'z';
const ENABLED: bool = MAX_USERS > 10 && !false;
const SMALL: u8 = 300i32 as u8;
const MIN: i8 = -128;
const HALF: f32 = 0.5;
const NOTES: String = include_str("data/notes.txt");
const BIG: String = include_str("data/big.txt");
const RETRIES: usize = 3;

pub fn main() {
  println(`${PI} ${TAU} ${NAME} ${LETTER} ${ENABLED} ${SMALL} ${MIN} ${HALF}`);
  println(`${MAX_USERS} ${limits::TIMEOUT_MS} ${limits::LIMIT}`);
  print(NOTES);

  const rows = BIG.lines().collect();

  println(`${BIG.len()} ${rows.len()} ${rows.last().unwrap()}`);

  var attempts = 0;

  for _ in 0..RETRIES {
    attempts += 1;
  }

  println(`${attempts} limit ${limits::LIMIT}`);
}
