struct Point {
  pub x: i32;
}

struct Loose impl Ord { //~ ERROR E0329
  pub value: i32;

  pub fn compare(self, other: Loose) -> Ordering {
    self.value.compare(other.value)
  }
}

fn takes(_list: List) {} //~ ERROR E0318

