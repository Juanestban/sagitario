struct Counter {
  pub count: i32;

  pub fn new() -> Self {
    Self { count: 0 }
  }

  // Modifies `self`, so it can only be called on mutable values.
  pub fn increment(self) {
    self.count += 1;
  }

  // Modifies `self` through `increment`.
  pub fn increment_twice(self) {
    self.increment();
    self.increment();
  }

  pub fn get(self) -> i32 {
    self.count
  }
}

fn reset(counter: Counter) {
  counter.count = 0; //~ ERROR E0312
}

pub fn main() {
  const fixed = Counter::new();
  println(`${fixed.get()}`);
  fixed.count = 1; //~ ERROR E0312
  fixed.increment(); //~ ERROR E0313
  fixed.increment_twice(); //~ ERROR E0313
  Counter::new().increment(); //~ ERROR E0313
  Counter::new().count = 2; //~ ERROR E0307
  const values = [1, 2, 3];
  values[0] = 4; //~ ERROR E0312
  for counter in [Counter::new()] {
    counter.increment(); //~ ERROR E0313
  }
  reset(fixed);
}
