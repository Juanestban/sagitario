enum Shape {
  Circle(f64),
  Rect { w: f64, h: f64 },
  Empty,
}

fn area(shape: Shape) -> f64 {
  match shape { //~ ERROR E0319
    Shape::Circle(r) => r,
    Shape::Empty => 0.0,
  }
}

fn label(value: Option<bool>) -> String {
  match value { //~ ERROR E0319
    Some(true) => "yes",
    None => "none",
  }
}

fn unreachable(n: i32) -> i32 {
  match n {
    _ => 0,
    1 => 1, //~ WARN W0004
  }
}

fn shapes(shape: Shape) {
  match shape {
    Shape::Circle(_, _) => {} //~ ERROR E0320
    Shape::Rect { w } => println(`${w}`), //~ ERROR E0315
    Shape::Empty(_) => {} //~ ERROR E0320
    Shape::Circle => {} //~ ERROR E0320
    Some(_) => {} //~ ERROR E0300
    Shape::Rect { w: x, .. } | Shape::Circle(y) => println(`${x}`), //~ ERROR E0206, ERROR E0206
    _ => {}
  }
}

fn literals(n: i32, text: String) {
  match n {
    1.5 => {} //~ ERROR E0320
    'a' => {} //~ ERROR E0300
    _ => {}
  }

  match text {
    "a" => {} //~ ERROR E0900
    _ => {}
  }
}

pub fn main() {
  println(`${area(Shape::Empty)} ${label(None)} ${unreachable(1)}`);
  shapes(Shape::Empty);
  literals(1, "a");
}
