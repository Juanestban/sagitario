// `std::collections::VecDeque` (docs/adr/0095-collections.md, Q648).
use std::collections::VecDeque;

struct Plain {
  pub x: i32;
}

fn main() {
  const plain = VecDeque::from(List::from([Plain { x: 1 }]));
  const other = VecDeque::from(List::from([Plain { x: 2 }]));
  const _equal = plain == other; //~ ERROR E0310
  const numbers = VecDeque::from(List::from([1]));

  numbers.push_back("a"); //~ ERROR E0300

  const _found = numbers.contains(1); //~ ERROR E0316
}
