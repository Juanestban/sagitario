// `rev` needs two ends, and the methods given by the kind of the values check it
// (docs/adr/0093-everyday-methods.md, Q626-Q628).
fn main() {
  const _a = (0..5).take(2).rev(); //~ ERROR E0316
  const _b = List::from(["a"]).iter().sum(); //~ ERROR E0316
  const _c = (0..3).unzip(); //~ ERROR E0316
  const _d = (0..3).flatten(); //~ ERROR E0316
  const _e = List::from([1.5]).iter().max(); //~ ERROR E0330
  const _f: Option<i32> = (0..3).collect(); //~ ERROR E0300
}
