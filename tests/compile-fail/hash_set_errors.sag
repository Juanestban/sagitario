// `HashSet` (docs/adr/0095-collections.md, Q647).

fn main() {
  const _floats = new HashSet<f64>(); //~ ERROR E0330
  const words = HashSet::from(List::from(["a"]));
  const others = HashSet::from(List::from(["b"]));

  words.insert(1); //~ ERROR E0300

  const _ordered = words < others; //~ ERROR E0310
  const _array = HashSet::from([1, 2]); //~ ERROR E0311
}
