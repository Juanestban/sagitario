use std::thread;
use std::thread::JoinHandle;

class Counter {
  pub var count: i32;

  pub fn new(self) {
    self.count = 0;
  }
}

class Node {
  pub weak var parent: Option<Node>;

  pub fn new(self) {
    self.parent = None;
  }
}

/// `const` fields only, but a subclass adds a `var` one: a `Base` may be a `Derived`.
class Base {
  pub const id: i32;

  pub fn new(self) {
    self.id = 1;
  }
}

class Derived extends Base {
  pub var extra: i32;

  pub fn new(self) {
    zod.new();
    self.extra = 2;
  }
}

struct Inventory {
  pub items: List<i32>;
}

interface Named {
  fn name(self) -> String;
}

struct Label impl Named {
  pub text: String;

  pub fn name(self) -> String {
    self.text
  }
}

struct Token impl Send { //~ ERROR E0329
  pub id: i32;
}

interface Shareable extends Send {} //~ ERROR E0329

fn needs_send<T: Send>(value: T) -> T {
  value
}

fn not_bounded<T>(value: T) -> JoinHandle<i32> {
  thread::spawn(() => { //~ ERROR E0332
    const _copy = value;
    1
  })
}

fn as_type(_value: Send) {} //~ ERROR E0329

fn work() -> i32 {
  1
}

pub fn main() {
  const items = List::from([1, 2]);
  const counter = new Counter();
  const node = new Node();
  const base: Base = new Base();
  const builder = new StringBuilder();
  const inventory = Inventory { items: List::from([1]) };
  const named: Named = Label { text: "a" };
  const f = () => 1;

  const _a = thread::spawn(() => items.len()); //~ ERROR E0332
  const _b = thread::spawn(() => counter.count); //~ ERROR E0332
  const _c = thread::spawn(() => node.parent.is_some()); //~ ERROR E0332
  const _d = thread::spawn(() => base.id); //~ ERROR E0332
  const _e = thread::spawn(() => builder.len()); //~ ERROR E0332
  const _g = thread::spawn(() => inventory.items.len()); //~ ERROR E0332
  const _h = thread::spawn(() => named.name()); //~ ERROR E0332
  const _i = thread::spawn(() => f()); //~ ERROR E0332
  const _j = thread::spawn(f); //~ ERROR E0333
  const _k = JoinHandle::spawn(f); //~ ERROR E0333
  const _l = thread::spawn; //~ ERROR E0333
  const _m = thread::spawn(work);
  const _n = not_bounded(1);
  const _values: List<Send> = new List(); //~ ERROR E0329

  needs_send(items); //~ ERROR E0330
  needs_send("text");
}
