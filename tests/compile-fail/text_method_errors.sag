// The static functions of `String` and `char`, and the arguments of the methods of text
// (docs/adr/0093-everyday-methods.md, Q620 and Q621).
fn main() {
  const _a = String::from_utf9(List::from([1u8])); //~ ERROR E0200
  const _b = char::from_hex(1); //~ ERROR E0200
  const _c = "x".split_once(1); //~ ERROR E0300
  const _d = "x".rfind_all("x"); //~ ERROR E0316
  const _e = String::from_utf8("text"); //~ ERROR E0300
  const builder = new StringBuilder();
  builder.insert("0", "x"); //~ ERROR E0300
}
