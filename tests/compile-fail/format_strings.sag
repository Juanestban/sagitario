// Format strings write braces as `{{` and `}}`, and interpolate an expression in each `{...}`
// (docs/adr/0082-format-strings.md, Q520 and Q521).
fn main() {
  const name = "Ada";
  const _a = f"closing } alone"; //~ ERROR E0007
  const _b = f"empty {} braces"; //~ ERROR E0007
  const _c = f"{name} is {name.len()} bytes";
}
