// `@link_name` in the generated C (docs/adr/0108-link-names.md): a symbol that is a C identifier is
// declared by its own name; one holding `$` is declared under another name with an assembler label
// naming it, whose macros the FFI unit defines once; and a C global with a link name.
use std::ffi::{c_char, c_int};

extern "C" {
  @link_name("abs")
  fn absolute(value: c_int) -> c_int;
  @link_name("readdir$INODE64")
  fn read_entry(dir: *mut u8) -> *const u8;
  @link_name("sys_count$2")
  static var count: c_int;
  @link_name("environ")
  static environment: *const *const c_char;
}

pub fn main() {
  unsafe {
    count = absolute(-2);
    println(f"{read_entry(0 as *mut u8).is_null()} {environment.is_null()} {count}");
  }
}
