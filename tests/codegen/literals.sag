// Constants as C literals: integers at the limits of their types, floats at their extremes and
// negative zero, characters outside ASCII, strings escaping quotes, backslashes, trigraphs and
// control and non-ASCII bytes, and strings too long for a C literal, used twice.

const I64_MIN: i64 = -9223372036854775808;
const U64_MAX: u64 = 18446744073709551615;
const I8_MIN: i8 = -128;
const F64_MAX: f64 = 1.7976931348623157e308;
const F64_TINY: f64 = 5e-324;
const F32_MAX: f32 = 3.4028235e38;
const NEGATIVE_ZERO: f64 = -0.0;
const WHOLE: f64 = 3.0;
const THIRD: f32 = 1.0 / 3.0;

const CHUNK: String = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-+";
const BLOCK: String = CHUNK + CHUNK + CHUNK + CHUNK + CHUNK + CHUNK + CHUNK + CHUNK;
const LONG: String = BLOCK + BLOCK + BLOCK + BLOCK + BLOCK + BLOCK + BLOCK + BLOCK + "!";

fn chars() -> List<char> {
  List::from(['a', '\0', '\n', '\x7F', 'é', '\u{1F600}', '?', '\'', '\\'])
}

pub fn main() {
  println(`${I64_MIN} ${U64_MAX} ${I8_MIN} ${-1i64} ${0i64}`);
  println(`${F64_MAX} ${F64_TINY} ${F32_MAX} ${NEGATIVE_ZERO} ${WHOLE} ${THIRD}`);
  println(`${1.0 / 0.0} ${-1.0 / 0.0} ${0.5f32 / 0.0f32}`);

  for c in chars() {
    print(`${c as u32} `);
  }

  println("");
  println("quote \" backslash \\ trigraphs ??= ??/ ??( tab\t nul\0 del\x7F é 😀 $");
  println(`template \$ ??! \`${LONG.len()}\``);
  println(`${LONG.len()} ${LONG.len() + 1} ${LONG == LONG + ""}`);
  println(LONG);
}
