//! Lowering of lists, iterators and the prelude interfaces on primitives
//! (docs/spec/02-types.md#arrays-and-lists, docs/spec/08-closures.md#iterators, ADR-0034). The
//! port of `sagitario_sir::collections`.

use pkg::ast::{BinaryOp, Block, Expr, ExprKind, UnaryOp};
use pkg::resolve::{ParamOwner, Res, TypeItem};
use pkg::sir::{Callee, Lowering, Operand, Place, Projection, Rvalue, SliceSource, Stmt, TemplatePiece, bool_operand, int_operand, local_place, project, unit_operand};
use pkg::sir::interfaces;
use pkg::sir::matching;
use pkg::sir::mono;
use pkg::types::{FloatTy, IntTy, NamedRef, Subst, Type, TypeKind};
use pkg::types;
use pkg::types::typed::{BuiltinMethod, ListMethod};

fn usize_type() -> Type {
  types::int(IntTy::Usize)
}

fn usize_const(value: u64) -> Operand {
  int_operand(value, false, IntTy::Usize)
}

fn runtime(function: String) -> Callee {
  Callee::Runtime { function: function, located: false }
}

fn bool_type() -> Type {
  types::of(TypeKind::Bool)
}

/// A value that stays valid while the rest of the expression runs.
fn stable(lw: Lowering, ty: Type, value: Operand) -> Operand {
  match value {
    Operand::Place(_) => lw.owned_copy(ty, value),
    _ => value,
  }
}

/// `List::from(array)`: the elements are retained for the new list.
pub fn list_from(lw: Lowering, ty: Type, args: List<Expr>) -> Result<Operand, String> {
  if args.len() != 1 {
    return Err("`List::from` without one argument");
  }

  const array = args[0];
  const array_ty = lw.type_of(array)?;
  const value = lw.expr(array)?;

  Ok(list_from_array(lw, ty, array_ty, value))
}

fn list_from_array(lw: Lowering, list_ty: Type, array_ty: Type, value: Operand) -> Operand {
  if lw.managed(array_ty) {
    lw.emit(Stmt::Retain(value));
  }

  lw.new_value(list_ty, Rvalue::ListFromArray { array: value, array_ty: array_ty })
}

/// The place of `list[index]`.
pub fn list_elem_place(lw: Lowering, base: Expr, index: Expr, ty: Type) -> Result<Place, String> {
  const list_ty = lw.type_of(base)?;
  const list_value = lw.expr(base)?;
  const list = stable(lw, list_ty, list_value);
  const position = lw.expr(index)?;
  const place = lw.operand_place(list, list_ty)?;

  Ok(project(place, Projection::ListElem { index: position, elem: ty }, ty))
}

/// The element at `index` of `list` (of element type `elem`) as a new place.
fn elem_of(lw: Lowering, list: Operand, list_ty: Type, index: Operand, elem: Type) -> Result<Place, String> {
  const place = lw.operand_place(list, list_ty)?;

  Ok(project(place, Projection::ListElem { index: index, elem: elem }, elem))
}

fn list_len(lw: Lowering, list: Operand) -> Operand {
  lw.new_value(usize_type(), Rvalue::ListLen(list))
}

fn binary_value(lw: Lowering, result: Type, op: BinaryOp, ty: Type, lhs: Operand, rhs: Operand) -> Operand {
  lw.new_value(result, Rvalue::Binary { op: op, ty: ty, lhs: lhs, rhs: rhs })
}

/// A method of `List` implemented by the compiler.
pub fn list_method(lw: Lowering, method: ListMethod, ty: Type, receiver: Expr, args: List<Expr>) -> Result<Operand, String> {
  const list_ty = lw.type_of(receiver)?;
  const elem = match list_ty.kind {
    TypeKind::List(found) => found,
    _ => return Err("list method on a value that is not a list"),
  };
  const list_value = lw.expr(receiver)?;
  const list = stable(lw, list_ty, list_value);
  const operands: List<Operand> = new List();
  var params: List<Type> = new List();

  match method {
    ListMethod::Push => {
      params = List::from([elem]);
    }
    ListMethod::Get | ListMethod::Remove => {
      params = List::from([usize_type()]);
    }
    ListMethod::Insert => {
      params = List::from([usize_type(), elem]);
    }
    _ => {}
  }

  var index = 0usize;

  while index < args.len() && index < params.len() {
    const value = lw.operand_as(args[index], params[index])?;

    operands.push(lw.owned_copy(params[index], value));
    index += 1;
  }

  match method {
    ListMethod::Len => Ok(list_len(lw, list)),
    ListMethod::IsEmpty => {
      const len = list_len(lw, list);

      Ok(binary_value(lw, bool_type(), BinaryOp::Eq, usize_type(), len, usize_const(0)))
    }
    ListMethod::Push | ListMethod::Insert => {
      const value = match operands.pop() {
        Some(found) => found,
        None => return Err("list method without its value"),
      };

      // The list takes a reference.
      if lw.managed(elem) {
        lw.emit(Stmt::Retain(value));
      }

      match operands.pop() {
        Some(position) => lw.emit(Stmt::ListInsert { list: list, index: position, value: value }),
        None => lw.emit(Stmt::ListPush { list: list, value: value }),
      }

      Ok(unit_operand())
    }
    ListMethod::Pop => {
      const len = list_len(lw, list);
      const cond = binary_value(lw, bool_type(), BinaryOp::Gt, usize_type(), len, usize_const(0));
      const dest = lw.temp(ty);
      const then_mark = lw.open_buffer();
      // The element moves out of the list into the `Some`.
      const popped = lw.temp(elem);

      lw.emit(Stmt::Assign { dest: popped, value: Rvalue::ListPop(list) });
      lw.emit(Stmt::Assign { dest: dest, value: Rvalue::Variant { index: 1, fields: List::from([Operand::Local(popped)]) } });

      const then_body = lw.close_buffer(then_mark);
      const else_mark = lw.open_buffer();

      lw.emit(Stmt::Assign { dest: dest, value: Rvalue::Variant { index: 0, fields: new List() } });

      const else_body = lw.close_buffer(else_mark);

      lw.emit(Stmt::If { cond: cond, then_body: then_body, else_body: else_body });

      Ok(lw.owned_result(Some(dest)))
    }
    ListMethod::Get | ListMethod::First | ListMethod::Last => {
      const len = list_len(lw, list);
      var position: Option<Operand> = None;
      var is_get = false;

      match method {
        ListMethod::Get => {
          is_get = true;
          position = match operands.pop() {
            Some(found) => Some(found),
            None => return Err("`get` without an index"),
          };
        }
        ListMethod::First => {
          position = Some(usize_const(0));
        }
        // `len - 1`, computed once the list is known not to be empty.
        _ => {}
      }

      var cond_value = Rvalue::Binary { op: BinaryOp::Gt, ty: usize_type(), lhs: len, rhs: usize_const(0) };

      if is_get {
        if let Some(found) = position {
          cond_value = Rvalue::Binary { op: BinaryOp::Lt, ty: usize_type(), lhs: found, rhs: len };
        }
      }

      const cond = lw.new_value(bool_type(), cond_value);
      const dest = lw.temp(ty);
      const then_mark = lw.open_buffer();
      const chosen = match position {
        Some(found) => found,
        None => binary_value(lw, usize_type(), BinaryOp::Sub, usize_type(), len, usize_const(1)),
      };
      const place = elem_of(lw, list, list_ty, chosen, elem)?;
      const some = matching::variant(lw, ty, 1, List::from([Operand::Place(place)]));

      store_moved(lw, dest, some);

      const then_body = lw.close_buffer(then_mark);
      const else_mark = lw.open_buffer();

      lw.emit(Stmt::Assign { dest: dest, value: Rvalue::Variant { index: 0, fields: new List() } });

      const else_body = lw.close_buffer(else_mark);

      lw.emit(Stmt::If { cond: cond, then_body: then_body, else_body: else_body });

      Ok(lw.owned_result(Some(dest)))
    }
    ListMethod::Remove => {
      const position = match operands.pop() {
        Some(found) => found,
        None => return Err("`remove` without an index"),
      };

      Ok(lw.new_value(elem, Rvalue::ListRemove { list: list, index: position }))
    }
    ListMethod::Clear => {
      lw.emit(Stmt::ListClear(list));

      Ok(unit_operand())
    }
    ListMethod::Reverse => {
      lw.emit(Stmt::ListReverse(list));

      Ok(unit_operand())
    }
  }
}

/// Moves a new value (a pending temporary) into `dest`, which takes over its reference.
fn store_moved(lw: Lowering, dest: u32, value: Operand) {
  if let Operand::Local(local) = value {
    var position = lw.pending.len();

    while position > 0 {
      position -= 1;

      if lw.pending[position] == local {
        lw.pending.remove(position);
        lw.emit(Stmt::Assign { dest: dest, value: Rvalue::Use(value) });

        return;
      }
    }
  }

  lw.store(dest, value);
}

/// A method implemented by the prelude function `function`, called with the receiver first.
pub fn prelude_method(lw: Lowering, value: Expr, function: u32, ty: Type, receiver: Expr, args: List<Expr>) -> Result<Operand, String> {
  const subst = mono::call_subst(lw, value.id, function, None);
  const params = match lw.typed.sig(function) {
    Some(sig) => types::substitute_sig(sig, subst).params,
    None => new List(),
  };
  const target = mono::instance(lw, function, subst);
  const receiver_ty = lw.type_of(receiver)?;
  const first = params.first().unwrap_or(types::error());
  var lent = false;

  // An array or a list calling a method of slices is lent as a slice of all its elements
  // (docs/adr/0093-everyday-methods.md, Q624).
  if let TypeKind::Slice { .. } = first.kind {
    lent = match receiver_ty.kind {
      TypeKind::Array { .. } | TypeKind::List(_) => true,
      _ => false,
    };
  }

  var receiver_value = if lent { lw.slice(receiver, first)? } else { lw.expr(receiver)? };

  // Arrays become lists.
  if let TypeKind::Array { .. } = receiver_ty.kind {
    if !lent {
      receiver_value = list_from_array(lw, first, receiver_ty, receiver_value);
    }
  }

  const operands = List::from([receiver_value]);
  var index = 0usize;

  while index < args.len() && index + 1 < params.len() {
    operands.push(lw.operand_as(args[index], params[index + 1])?);
    index += 1;
  }

  Ok(lw.call(Callee::Fn(target), operands, ty))
}

/// The receiver of an `Iter` method called on a list or array, as an iterator.
pub fn iter_of(lw: Lowering, receiver: Expr, to_iter: u32, args: List<Type>) -> Result<Operand, String> {
  // In generic code, the element type is in terms of the instance's parameters.
  const substituted: List<Type> = new List();

  for arg in args {
    substituted.push(types::substitute(arg, lw.subst));
  }

  const subst = Subst::of(ParamOwner::Fn(to_iter), substituted);
  var params: List<Type> = new List();
  var ret = types::error();

  if let Some(sig) = lw.typed.sig(to_iter) {
    const found = types::substitute_sig(sig, subst);

    params = found.params;
    ret = found.ret;
  }

  const target = mono::instance(lw, to_iter, subst);
  const receiver_ty = lw.type_of(receiver)?;
  var receiver_value = lw.expr(receiver)?;

  if let TypeKind::Array { .. } = receiver_ty.kind {
    if let Some(list_ty) = params.first() {
      receiver_value = list_from_array(lw, list_ty, receiver_ty, receiver_value);
    }
  }

  Ok(lw.call(Callee::Fn(target), List::from([receiver_value]), ret))
}

/// `start..end` used as a value, or reversed with `rev()`.
pub fn range_iter(lw: Lowering, range: Expr, reverse: bool, ty: Type) -> Result<Operand, String> {
  var start: Option<Expr> = None;
  var end: Option<Expr> = None;
  var inclusive = false;

  if let ExprKind::Range { start: found_start, end: found_end, inclusive: found_inclusive } = range.kind {
    start = Some(found_start);
    end = Some(found_end);
    inclusive = found_inclusive;
  }

  const start_expr = match start {
    Some(found) => found,
    None => return Err("`rev` of something other than a range"),
  };
  const end_expr = end.unwrap_or(start_expr);
  const function = match lw.typed.ranges.get(range.id) {
    Some(found) => found,
    None => return Err("range without its function"),
  };
  const target = mono::instance(lw, function, Subst::empty());
  const int_ty = lw.type_of(start_expr)?;
  const start_value = lw.operand_as(start_expr, int_ty)?;
  const end_value = lw.operand_as(end_expr, int_ty)?;

  Ok(lw.call(Callee::Fn(target), List::from([start_value, end_value, bool_operand(inclusive), bool_operand(reverse)]), ty))
}

/// `a.total_compare(b)` on floats.
pub fn total_compare(lw: Lowering, ty: Type, receiver: Expr, args: List<Expr>) -> Result<Operand, String> {
  const float = lw.type_of(receiver)?;

  if args.len() != 1 {
    return Err("`total_compare` without one argument");
  }

  const lhs = lw.expr(receiver)?;
  const rhs = lw.operand_as(args[0], float)?;
  const is_f32 = match float.kind {
    TypeKind::Float(FloatTy::F32) => true,
    _ => false,
  };
  const function = if is_f32 { "sag_f32_total_compare" } else { "sag_f64_total_compare" };
  const order = lw.new_value(types::int(IntTy::I32), Rvalue::Call { callee: runtime(function), args: List::from([lhs, rhs]) });

  Ok(ordering(lw, ty, order))
}

/// An `Ordering` from the sign of `order` (an `i32`): `Less` (0), `Equal` (1) or `Greater` (2).
fn ordering(lw: Lowering, ty: Type, order: Operand) -> Operand {
  const zero = int_operand(0, false, IntTy::I32);
  const dest = lw.temp(ty);
  const less = binary_value(lw, bool_type(), BinaryOp::Lt, types::int(IntTy::I32), order, zero);
  const equal = binary_value(lw, bool_type(), BinaryOp::Eq, types::int(IntTy::I32), order, zero);
  const inner = Stmt::If { cond: equal, then_body: set_variant(dest, 1), else_body: set_variant(dest, 2) };

  lw.emit(Stmt::If { cond: less, then_body: set_variant(dest, 0), else_body: List::from([inner]) });

  Operand::Local(dest)
}

fn set_variant(dest: u32, index: u32) -> List<Stmt> {
  List::from([Stmt::Assign { dest: dest, value: Rvalue::Variant { index: index, fields: new List() } }])
}

fn is_primitive(ty: Type) -> bool {
  match ty.kind {
    TypeKind::Int(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String => true,
    _ => false,
  }
}

/// Whether `function` is `to_string` of `Display`.
fn is_display(lw: Lowering, function: u32) -> bool {
  match lw.resolution.owner(function) {
    Some(TypeItem::Interface(id)) => same_option(id, lw.typed.prelude.display),
    _ => false,
  }
}

fn same_option(id: u32, found: Option<u32>) -> bool {
  match found {
    Some(other) => other == id,
    None => false,
  }
}

/// Whether `function` is a method of the prelude's `Eq`, `Ord` or `Hash`, called on an integer,
/// `bool`, `char` or `String`.
pub fn is_primitive_method(lw: Lowering, function: u32, receiver_ty: Type) -> bool {
  const numeric = match receiver_ty.kind {
    TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::String => true,
    _ => false,
  };

  if numeric && operator_of(lw, function).is_some() {
    return true;
  }

  // `to_string` of numbers, `bool`, `char` and `String` is their interpolation.
  if is_display(lw, function) {
    return match receiver_ty.kind {
      TypeKind::Float(_) => true,
      _ => is_primitive(receiver_ty),
    };
  }

  const tuple = match receiver_ty.kind {
    TypeKind::Tuple(_) | TypeKind::Option(_) | TypeKind::Result { .. } | TypeKind::List(_) | TypeKind::Array { .. } => true,
    TypeKind::Class(named) => is_map(lw, named),
    _ => false,
  };

  if !is_primitive(receiver_ty) && !tuple {
    return false;
  }

  match lw.resolution.owner(function) {
    Some(TypeItem::Interface(id)) => same_option(id, lw.typed.prelude.eq) || same_option(id, lw.typed.prelude.ord) || same_option(id, lw.typed.prelude.hash),
    _ => false,
  }
}

/// The operator whose interface declares `function`: `Neg` as `None` inside, and the others as
/// their binary operator (docs/adr/0081-operator-overloading.md).
fn operator_of(lw: Lowering, function: u32) -> Option<Option<BinaryOp>> {
  const id = match lw.resolution.owner(function) {
    Some(TypeItem::Interface(found)) => found,
    _ => return None,
  };
  const prelude = lw.typed.prelude;

  if same_option(id, prelude.add) {
    Some(Some(BinaryOp::Add))
  } else if same_option(id, prelude.sub) {
    Some(Some(BinaryOp::Sub))
  } else if same_option(id, prelude.mul) {
    Some(Some(BinaryOp::Mul))
  } else if same_option(id, prelude.div) {
    Some(Some(BinaryOp::Div))
  } else if same_option(id, prelude.rem) {
    Some(Some(BinaryOp::Rem))
  } else if same_option(id, prelude.neg) {
    Some(None)
  } else {
    None
  }
}

/// An operator's method on a number or a `String`, reached through a type parameter: the
/// operator itself, with its checks (`lhs` is the receiver's value).
pub fn primitive_operator(lw: Lowering, function: u32, receiver_ty: Type, lhs: Operand, args: List<Expr>) -> Result<Operand, String> {
  match operator_of(lw, function) {
    Some(Some(op)) => {
      if args.len() != 1 {
        return Err("binary operator without one argument");
      }

      const rhs = lw.operand_as(args[0], receiver_ty)?;

      Ok(pkg::sir::strings::binary(lw, op, receiver_ty, lhs, rhs))
    }
    Some(None) => Ok(lw.new_value(receiver_ty, Rvalue::Unary { op: UnaryOp::Neg, ty: receiver_ty, operand: lhs })),
    None => Err("primitive operator of another interface"),
  }
}

/// `equals`, `compare` or `hash` on an integer, `bool`, `char` or `String`, or an operator on a
/// number or a `String`.
pub fn primitive_method(lw: Lowering, function: u32, ty: Type, receiver: Expr, args: List<Expr>) -> Result<Operand, String> {
  const receiver_ty = lw.type_of(receiver)?;
  const lhs = lw.expr(receiver)?;

  if is_display(lw, function) {
    return Ok(lw.new_value(types::string(), Rvalue::Template(List::from([TemplatePiece::Value { ty: receiver_ty, value: lhs }]))));
  }

  if operator_of(lw, function).is_some() {
    return primitive_operator(lw, function, receiver_ty, lhs, args);
  }

  const interface_id = match lw.resolution.owner(function) {
    Some(TypeItem::Interface(id)) => Some(id),
    _ => None,
  };
  const is_hash = match interface_id {
    Some(id) => same_option(id, lw.typed.prelude.hash),
    None => lw.typed.prelude.hash.is_none(),
  };

  if is_hash {
    return value_hash(lw, receiver_ty, lhs);
  }

  if args.len() != 1 {
    return Err("comparison without one argument");
  }

  const rhs = lw.operand_as(args[0], receiver_ty)?;
  const is_eq = match interface_id {
    Some(id) => same_option(id, lw.typed.prelude.eq),
    None => lw.typed.prelude.eq.is_none(),
  };

  if is_eq {
    return values_equal(lw, receiver_ty, lhs, rhs);
  }

  values_order(lw, ty, receiver_ty, lhs, rhs)
}

// ---- `Eq`, `Ord` and `Hash` of values the compiler compares itself ----------------------------
//
// Primitives compare with C's operators, and tuples element by element, the first one first
// (docs/adr/0092-tuples.md, Q611); the elements of other types call their own methods.

/// The method of a prelude interface, by the interface's id.
fn interface_method(lw: Lowering, id: Option<u32>) -> Result<u32, String> {
  const found = match id {
    Some(interface_id) => lw.typed.interface_def(interface_id),
    None => None,
  };

  match found {
    Some(def) => match def.methods.first() {
      Some(method) => Ok(method),
      None => Err("prelude interface without a method"),
    },
    None => Err("prelude interface missing"),
  }
}

/// The method `id` of a prelude interface on the value `receiver` of type `ty`, with `args`.
fn element_call(lw: Lowering, id: Option<u32>, ty: Type, receiver: Operand, args: List<Operand>, result: Type) -> Result<Operand, String> {
  const found = interfaces::concrete_method(lw, interface_method(lw, id)?, ty);

  if found.by_ref {
    return Err("an element compared through a method that modifies `self`");
  }

  const all = List::from([receiver]);

  for arg in args {
    all.push(arg);
  }

  Ok(lw.call(found.callee, all, result))
}

/// The element `index` of the tuple `value`, of type `ty`.
fn element(lw: Lowering, value: Operand, ty: Type, index: usize, elem: Type) -> Result<Operand, String> {
  Ok(Operand::Place(project(lw.operand_place(value, ty)?, Projection::Field(index), elem)))
}

/// Whether `lhs` and `rhs`, of type `ty`, are equal: a `bool`.
pub fn values_equal(lw: Lowering, ty: Type, lhs: Operand, rhs: Operand) -> Result<Operand, String> {
  if is_primitive(ty) {
    return Ok(pkg::sir::strings::binary(lw, BinaryOp::Eq, ty, lhs, rhs));
  }

  if is_option_or_result(ty) {
    return variants_equal(lw, ty, lhs, rhs);
  }

  if let Some(result) = collection_call(lw, "equals", ty, List::from([lhs, rhs]), bool_type())? {
    return Ok(result);
  }

  const elems = match ty.kind {
    TypeKind::Tuple(found) => found,
    _ => return element_call(lw, lw.typed.prelude.eq, ty, lhs, List::from([rhs]), bool_type()),
  };
  const result = lw.temp(bool_type());

  for index in 0..elems.len() {
    // Each element is compared only while the earlier ones were equal.
    const mark = lw.open_buffer();
    const left = element(lw, lhs, ty, index, elems[index])?;
    const right = element(lw, rhs, ty, index, elems[index])?;
    const equal = values_equal(lw, elems[index], left, right)?;

    lw.emit(Stmt::Assign { dest: result, value: Rvalue::Use(equal) });

    const body = lw.close_buffer(mark);

    if index == 0 {
      for statement in body {
        lw.emit(statement);
      }
    } else {
      lw.emit(Stmt::If { cond: Operand::Local(result), then_body: body, else_body: new List() });
    }
  }

  Ok(Operand::Local(result))
}

/// The `Ordering` of `lhs` against `rhs`, of type `ty`; `ordering_ty` is `Ordering`.
pub fn values_order(lw: Lowering, ordering_ty: Type, ty: Type, lhs: Operand, rhs: Operand) -> Result<Operand, String> {
  if is_primitive(ty) {
    const i32_type = types::int(IntTy::I32);
    var order = unit_operand();

    if types::is_string(ty) {
      order = lw.new_value(i32_type, Rvalue::Call { callee: runtime("sag_string_cmp"), args: List::from([lhs, rhs]) });
    } else {
      // -1, 0 or 1 from two comparisons.
      const less = binary_value(lw, bool_type(), BinaryOp::Lt, ty, lhs, rhs);
      const greater = binary_value(lw, bool_type(), BinaryOp::Gt, ty, lhs, rhs);
      const less_int = lw.new_value(i32_type, Rvalue::Cast { from: bool_type(), to: i32_type, operand: less });
      const greater_int = lw.new_value(i32_type, Rvalue::Cast { from: bool_type(), to: i32_type, operand: greater });

      order = binary_value(lw, i32_type, BinaryOp::Sub, i32_type, greater_int, less_int);
    }

    return Ok(ordering(lw, ordering_ty, order));
  }

  if is_option_or_result(ty) {
    return variants_order(lw, ordering_ty, ty, lhs, rhs);
  }

  if let Some(result) = collection_call(lw, "compare", ty, List::from([lhs, rhs]), ordering_ty)? {
    return Ok(result);
  }

  const elems = match ty.kind {
    TypeKind::Tuple(found) => found,
    _ => return element_call(lw, lw.typed.prelude.ord, ty, lhs, List::from([rhs]), ordering_ty),
  };
  const result = lw.temp(ordering_ty);

  for index in 0..elems.len() {
    // The first element that differs decides; `Equal` is variant 1.
    const mark = lw.open_buffer();
    const left = element(lw, lhs, ty, index, elems[index])?;
    const right = element(lw, rhs, ty, index, elems[index])?;
    const order = values_order(lw, ordering_ty, elems[index], left, right)?;

    lw.emit(Stmt::Assign { dest: result, value: Rvalue::Use(order) });

    const body = lw.close_buffer(mark);

    if index == 0 {
      for statement in body {
        lw.emit(statement);
      }
    } else {
      const equal = matching::tag_is(lw, local_place(result, ordering_ty), 1)?;

      lw.emit(Stmt::If { cond: equal, then_body: body, else_body: new List() });
    }
  }

  Ok(Operand::Local(result))
}

/// Whether a class type is the prelude's `Map`.
pub fn is_map(lw: Lowering, class_ref: NamedRef) -> bool {
  match lw.typed.prelude.map {
    Some(map) => map == class_ref.id,
    None => false,
  }
}

/// `equals`, `compare` or `hash` of lists, arrays and maps: the prelude's `slice_<action>` on
/// slices of all their elements, or `map_equals` (docs/adr/0093-everyday-methods.md, Q623).
/// `None` for other types.
fn collection_call(lw: Lowering, action: String, ty: Type, values: List<Operand>, result: Type) -> Result<Option<Operand>, String> {
  var elem = types::error();
  var name = "slice_" + action;
  var args: List<Type> = new List();

  match ty.kind {
    TypeKind::List(found) | TypeKind::Array { elem: found, .. } => {
      elem = found;
      args = List::from([found]);
    }
    TypeKind::Class(named) => {
      if !is_map(lw, named) || action != "equals" {
        return Ok(None);
      }

      name = "map_equals";
      args = named.args;
    }
    _ => return Ok(None),
  }

  const function = match lw.resolution.prelude_fn(name) {
    Some(found) => found,
    None => return Err("`" + name + "` is missing from the prelude"),
  };
  const operands: List<Operand> = new List();

  for value in values {
    // Lists and arrays are lent as slices of all their elements.
    operands.push(match ty.kind {
      TypeKind::List(_) => lw.new_value(types::of(TypeKind::Slice { mutable: false, elem: elem }), Rvalue::Slice { source: SliceSource::List(value), elem: elem, range: None }),
      TypeKind::Array { len, .. } => {
        const place = lw.operand_place(value, ty)?;

        lw.new_value(types::of(TypeKind::Slice { mutable: false, elem: elem }), Rvalue::Slice { source: SliceSource::Array { place: place, len: len }, elem: elem, range: None })
      }
      _ => value,
    });
  }

  const target = mono::instance(lw, function, Subst::of(ParamOwner::Fn(function), args));

  Ok(Some(lw.call(Callee::Fn(target), operands, result)))
}

fn is_option_or_result(ty: Type) -> bool {
  match ty.kind {
    TypeKind::Option(_) | TypeKind::Result { .. } => true,
    _ => false,
  }
}

/// The value held by the variant `variant` of an `Option` or a `Result`.
fn held(lw: Lowering, value: Operand, ty: Type, variant: u32, held_ty: Type) -> Result<Operand, String> {
  Ok(Operand::Place(project(lw.operand_place(value, ty)?, Projection::VariantField { variant: variant, field: 0 }, held_ty)))
}

/// Each variant of an `Option` or a `Result` with the type of the value it holds.
fn holding_variants(lw: Lowering, ty: Type) -> List<VariantHolding> {
  const result: List<VariantHolding> = new List();

  if let Some(variants) = lw.layouts.variants(ty) {
    for index in 0..variants.len() {
      if let Some(held_ty) = variants[index].first() {
        result.push(VariantHolding { variant: index as u32, ty: held_ty });
      }
    }
  }

  result
}

struct VariantHolding {
  pub variant: u32;
  pub ty: Type;
}

/// `Option` and `Result` are equal when they are the same variant holding equal values
/// (docs/adr/0093-everyday-methods.md, Q619).
fn variants_equal(lw: Lowering, ty: Type, lhs: Operand, rhs: Operand) -> Result<Operand, String> {
  const left_tag = matching::tag(lw, lhs, ty)?;
  const right_tag = matching::tag(lw, rhs, ty)?;
  const result = lw.temp(bool_type());

  lw.emit(Stmt::Assign { dest: result, value: Rvalue::Binary { op: BinaryOp::Eq, ty: pkg::sir::tag_type(), lhs: left_tag, rhs: right_tag } });

  for holding in holding_variants(lw, ty) {
    const mark = lw.open_buffer();
    const left = held(lw, lhs, ty, holding.variant, holding.ty)?;
    const right = held(lw, rhs, ty, holding.variant, holding.ty)?;
    const equal = values_equal(lw, holding.ty, left, right)?;

    lw.emit(Stmt::Assign { dest: result, value: Rvalue::Use(equal) });

    const body = lw.close_buffer(mark);
    const this_variant = binary_value(lw, bool_type(), BinaryOp::Eq, pkg::sir::tag_type(), left_tag, int_operand(holding.variant as u64, false, IntTy::U32));
    const both = lw.temp(bool_type());

    lw.emit(Stmt::Assign { dest: both, value: Rvalue::Use(bool_operand(false)) });
    lw.emit(Stmt::If { cond: Operand::Local(result), then_body: List::from([Stmt::Assign { dest: both, value: Rvalue::Use(this_variant) }]), else_body: new List() });
    lw.emit(Stmt::If { cond: Operand::Local(both), then_body: body, else_body: new List() });
  }

  Ok(Operand::Local(result))
}

/// The order of `Option` and `Result` values: by variant, as they are declared (`None` before
/// `Some`, `Ok` before `Err`), then by the values they hold.
fn variants_order(lw: Lowering, ordering_ty: Type, ty: Type, lhs: Operand, rhs: Operand) -> Result<Operand, String> {
  const left_tag = matching::tag(lw, lhs, ty)?;
  const right_tag = matching::tag(lw, rhs, ty)?;
  const order = values_order(lw, ordering_ty, types::int(IntTy::U32), left_tag, right_tag)?;
  const result = lw.temp(ordering_ty);

  lw.emit(Stmt::Assign { dest: result, value: Rvalue::Use(order) });

  for holding in holding_variants(lw, ty) {
    const mark = lw.open_buffer();
    const left = held(lw, lhs, ty, holding.variant, holding.ty)?;
    const right = held(lw, rhs, ty, holding.variant, holding.ty)?;
    const inner = values_order(lw, ordering_ty, holding.ty, left, right)?;

    lw.emit(Stmt::Assign { dest: result, value: Rvalue::Use(inner) });

    const body = lw.close_buffer(mark);
    const equal = matching::tag_is(lw, local_place(result, ordering_ty), 1)?;
    const this_variant = binary_value(lw, bool_type(), BinaryOp::Eq, pkg::sir::tag_type(), left_tag, int_operand(holding.variant as u64, false, IntTy::U32));
    const both = lw.temp(bool_type());

    lw.emit(Stmt::Assign { dest: both, value: Rvalue::Use(bool_operand(false)) });
    lw.emit(Stmt::If { cond: equal, then_body: List::from([Stmt::Assign { dest: both, value: Rvalue::Use(this_variant) }]), else_body: new List() });
    lw.emit(Stmt::If { cond: Operand::Local(both), then_body: body, else_body: new List() });
  }

  Ok(Operand::Local(result))
}

/// The hash of an `Option` or a `Result`: its variant's, with the hash of the value it holds.
fn variants_hash(lw: Lowering, ty: Type, value: Operand) -> Result<Operand, String> {
  const u64_type = types::int(IntTy::U64);
  const tag = matching::tag(lw, value, ty)?;
  const bits = lw.new_value(u64_type, Rvalue::Cast { from: types::int(IntTy::U32), to: u64_type, operand: tag });
  const result = lw.temp(u64_type);

  lw.emit(Stmt::Assign { dest: result, value: Rvalue::Call { callee: runtime("sag_hash_u64"), args: List::from([bits]) } });

  for holding in holding_variants(lw, ty) {
    const mark = lw.open_buffer();
    const part = value_hash(lw, holding.ty, held(lw, value, ty, holding.variant, holding.ty)?)?;
    const mixed = binary_value(lw, u64_type, BinaryOp::BitXor, u64_type, Operand::Local(result), part);

    lw.emit(Stmt::Assign { dest: result, value: Rvalue::Call { callee: runtime("sag_hash_u64"), args: List::from([mixed]) } });

    const body = lw.close_buffer(mark);
    const this_variant = binary_value(lw, bool_type(), BinaryOp::Eq, pkg::sir::tag_type(), tag, int_operand(holding.variant as u64, false, IntTy::U32));

    lw.emit(Stmt::If { cond: this_variant, then_body: body, else_body: new List() });
  }

  Ok(Operand::Local(result))
}

/// The hash of `value`, of type `ty`: a `u64`. A tuple mixes the hash of each element into the
/// hash of those before it.
pub fn value_hash(lw: Lowering, ty: Type, value: Operand) -> Result<Operand, String> {
  const u64_type = types::int(IntTy::U64);

  if types::is_string(ty) {
    return Ok(lw.new_value(u64_type, Rvalue::Call { callee: runtime("sag_string_hash"), args: List::from([value]) }));
  }

  if is_primitive(ty) {
    const bits = lw.new_value(u64_type, Rvalue::Cast { from: ty, to: u64_type, operand: value });

    return Ok(lw.new_value(u64_type, Rvalue::Call { callee: runtime("sag_hash_u64"), args: List::from([bits]) }));
  }

  if is_option_or_result(ty) {
    return variants_hash(lw, ty, value);
  }

  if let Some(result) = collection_call(lw, "hash", ty, List::from([value]), u64_type)? {
    return Ok(result);
  }

  const elems = match ty.kind {
    TypeKind::Tuple(found) => found,
    _ => return element_call(lw, lw.typed.prelude.hash, ty, value, new List(), u64_type),
  };
  var hash = int_operand(elems.len() as u64, false, IntTy::U64);

  for index in 0..elems.len() {
    const part = value_hash(lw, elems[index], element(lw, value, ty, index, elems[index])?)?;
    const mixed = binary_value(lw, u64_type, BinaryOp::BitXor, u64_type, hash, part);

    hash = lw.new_value(u64_type, Rvalue::Call { callee: runtime("sag_hash_u64"), args: List::from([mixed]) });
  }

  Ok(hash)
}

/// `for var in iter` over a list, an iterator or a map; `false` for other iterables.
pub fn for_collection(lw: Lowering, variable: u32, iter: Expr, body: Block) -> Result<bool, String> {
  const iter_ty = lw.type_of(iter)?;

  if let TypeKind::List(elem) = iter_ty.kind {
    for_list(lw, variable, iter, iter_ty, elem, body)?;

    return Ok(true);
  }

  if let TypeKind::Slice { elem, .. } = iter_ty.kind {
    for_slice(lw, variable, iter, iter_ty, elem, body)?;

    return Ok(true);
  }

  var source = unit_operand();

  match lw.typed.map_args(iter_ty) {
    Some(map_args) => {
      // The entries of a map.
      const entry = lw.typed.entry_type(map_args[0], map_args[1]);
      const iter_of_entries = lw.typed.iter_type(entry);
      const map = lw.expr(iter)?;
      const class_ref = match iter_ty.kind {
        TypeKind::Class(found) => found,
        _ => return Err("map that is not a class"),
      };
      const entries = match lw.resolution.type_function(lw.package, TypeItem::Class(class_ref.id), "entries") {
        Some(found) => found,
        None => return Err("`Map` without `entries`"),
      };
      const target = mono::instance(lw, entries, Subst::of(ParamOwner::Item(TypeItem::Class(class_ref.id)), class_ref.args));

      source = lw.call(Callee::Fn(target), List::from([map]), iter_of_entries);
    }
    None => {
      if lw.typed.iter_elem(iter_ty).is_none() {
        return Ok(false);
      }

      source = lw.expr(iter)?;
    }
  }

  for_iter(lw, variable, source, body)?;

  Ok(true)
}

/// The loop over a slice, whose length cannot change: `var` owns a copy of each element.
fn for_slice(lw: Lowering, variable: u32, iter: Expr, slice_ty: Type, elem: Type, body: Block) -> Result<(), String> {
  const value = lw.expr(iter)?;
  const slice_local = lw.temp(slice_ty);

  // The slice, and a list it views, stay alive during the loop.
  lw.store(slice_local, value);
  lw.pending.push(slice_local);

  const index = lw.temp(usize_type());

  lw.emit(Stmt::Assign { dest: index, value: Rvalue::Use(usize_const(0)) });

  const slice = Operand::Local(slice_local);
  const mark = lw.open_loop(None);
  const len = lw.call(Callee::Runtime { function: "sag_slice_len", located: false }, List::from([slice]), usize_type());
  const more = binary_value(lw, bool_type(), BinaryOp::Lt, usize_type(), Operand::Local(index), len);

  lw.emit(Stmt::If { cond: more, then_body: new List(), else_body: List::from([Stmt::Break]) });

  const place = project(local_place(slice_local, slice_ty), Projection::SliceElem { index: Operand::Local(index), elem: elem }, elem);

  lw.store(variable, Operand::Place(place));
  lw.emit(Stmt::Assign { dest: index, value: Rvalue::Binary { op: BinaryOp::Add, ty: usize_type(), lhs: Operand::Local(index), rhs: usize_const(1) } });
  loop_var_body(lw, variable, body)?;

  const loop_body = lw.close_loop(mark);

  lw.emit(Stmt::Loop(loop_body));

  Ok(())
}

/// The loop over a list: the length is read at every step, and `var` owns a copy of each element.
fn for_list(lw: Lowering, variable: u32, iter: Expr, list_ty: Type, elem: Type, body: Block) -> Result<(), String> {
  const value = lw.expr(iter)?;
  const list_local = lw.temp(list_ty);

  // The list stays alive during the loop.
  lw.store(list_local, value);
  lw.pending.push(list_local);

  const index = lw.temp(usize_type());

  lw.emit(Stmt::Assign { dest: index, value: Rvalue::Use(usize_const(0)) });

  const list = Operand::Local(list_local);
  const mark = lw.open_loop(None);
  const len = lw.new_value(usize_type(), Rvalue::ListLen(list));
  const more = binary_value(lw, bool_type(), BinaryOp::Lt, usize_type(), Operand::Local(index), len);

  lw.emit(Stmt::If { cond: more, then_body: new List(), else_body: List::from([Stmt::Break]) });

  const place = elem_of(lw, list, list_ty, Operand::Local(index), elem)?;

  lw.store(variable, Operand::Place(place));
  lw.emit(Stmt::Assign { dest: index, value: Rvalue::Binary { op: BinaryOp::Add, ty: usize_type(), lhs: Operand::Local(index), rhs: usize_const(1) } });
  loop_var_body(lw, variable, body)?;

  const loop_body = lw.close_loop(mark);

  lw.emit(Stmt::Loop(loop_body));

  Ok(())
}

/// The loop over an iterator: `next` is called until it returns `None`.
fn for_iter(lw: Lowering, variable: u32, source: Operand, body: Block) -> Result<(), String> {
  const source_local = match source {
    Operand::Local(local) => local,
    _ => return Err("iterator without a local"),
  };
  const iter_ty = lw.local_type(source_local);
  const class_ref = match iter_ty.kind {
    TypeKind::Class(found) => found,
    _ => return Err("iterator that is not a class"),
  };
  const elem = class_ref.args.first().unwrap_or(types::error());
  const iter = lw.temp(iter_ty);

  // The iterator stays alive during the loop.
  lw.store(iter, source);
  lw.pending.push(iter);

  // A `DoubleEndedIter<T>` inherits `next` from `Iter<T>`, with the same argument.
  var owner = class_ref.id;

  if lw.typed.is_double_iter(iter_ty) {
    owner = lw.typed.prelude.iter.unwrap_or(owner);
  }

  const next = match lw.resolution.type_function(lw.package, TypeItem::Class(owner), "next") {
    Some(found) => found,
    None => return Err("`Iter` without `next`"),
  };
  const target = mono::instance(lw, next, Subst::of(ParamOwner::Item(TypeItem::Class(owner)), class_ref.args));
  const option_ty = types::option(elem);
  const mark = lw.open_loop(None);
  // Not pending: the value moves into `var`.
  const option = lw.temp(option_ty);

  lw.emit(Stmt::Assign { dest: option, value: Rvalue::Call { callee: Callee::Fn(target), args: List::from([Operand::Local(iter)]) } });

  const place = local_place(option, option_ty);
  const more = matching::tag_is(lw, place, 1)?;

  lw.emit(Stmt::If { cond: more, then_body: new List(), else_body: List::from([Stmt::Break]) });

  const inner = project(place, Projection::VariantField { variant: 1, field: 0 }, elem);

  lw.emit(Stmt::Assign { dest: variable, value: Rvalue::Use(Operand::Place(inner)) });
  loop_var_body(lw, variable, body)?;

  const loop_body = lw.close_loop(mark);

  lw.emit(Stmt::Loop(loop_body));

  Ok(())
}

/// The body of a loop whose variable owns its value: released at the end of each iteration, and
/// by `break` and `continue`.
fn loop_var_body(lw: Lowering, variable: u32, body: Block) -> Result<(), String> {
  const owned: List<u32> = if lw.managed(lw.local_type(variable)) { List::from([variable]) } else { new List() };

  lw.scopes.push(owned);
  lw.block_into(body, None)?;

  for local in lw.scopes.pop().unwrap_or(new List()) {
    lw.emit(Stmt::Release(local));
  }

  Ok(())
}

/// `for var in (a..b).rev()` or `(a..b).step_by(n)`: a counting loop, without an iterator; `false`
/// for other iterables.
pub fn for_range_method(lw: Lowering, variable: u32, iter: Expr, body: Block) -> Result<bool, String> {
  var receiver: Option<Expr> = None;
  var method_name = "";
  var args: List<Expr> = new List();

  if let ExprKind::MethodCall { receiver: found, method, args: found_args } = iter.kind {
    receiver = Some(found);
    method_name = method.name;
    args = found_args;
  }

  const range = match receiver {
    Some(found) => found,
    None => return Ok(false),
  };
  var start_expr: Option<Expr> = None;
  var end_expr: Option<Expr> = None;
  var inclusive = false;

  if let ExprKind::Range { start, end, inclusive: found_inclusive } = range.kind {
    start_expr = Some(start);
    end_expr = Some(end);
    inclusive = found_inclusive;
  }

  const start_found = match start_expr {
    Some(found) => found,
    None => return Ok(false),
  };
  const end_found = end_expr.unwrap_or(start_found);
  const reverse = match lw.typed.builtin_methods.get(iter.id) {
    Some(BuiltinMethod::RangeRev) => true,
    _ => false,
  };
  const step_by = method_name == "step_by" && lw.typed.method_calls.contains_key(iter.id);

  if !reverse && !step_by {
    return Ok(false);
  }

  const start_ty = lw.type_of(start_found)?;
  const int_ty = match start_ty.kind {
    TypeKind::Int(found) => found,
    _ => return Err("range without an integer type"),
  };
  const start_value = lw.operand_as(start_found, types::int(int_ty))?;
  const start = lw.new_value(types::int(int_ty), Rvalue::Use(start_value));
  const end_value = lw.operand_as(end_found, types::int(int_ty))?;
  const end = lw.new_value(types::int(int_ty), Rvalue::Use(end_value));
  var step: Option<Operand> = None;

  if step_by {
    if let Some(step_expr) = args.first() {
      const step_value = lw.operand_as(step_expr, usize_type())?;

      step = Some(lw.new_value(usize_type(), Rvalue::Use(step_value)));
    }
  }

  const mark = lw.open_loop(None);

  lw.block_into(body, None)?;

  const loop_body = lw.close_loop(mark);

  lw.emit(Stmt::ForRange { variable: variable, ty: int_ty, start: start, end: end, inclusive: inclusive, reverse: reverse, step: step, body: loop_body });

  Ok(true)
}

/// Whether a call expression is `List::from(...)`.
pub fn is_list_from(lw: Lowering, callee: Expr) -> bool {
  match lw.resolution.paths.get(callee.id) {
    Some(Res::Builtin(name)) => name == "List::from",
    _ => false,
  }
}
