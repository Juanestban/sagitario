//! C11 code generation from SIR (docs/architecture.md#c-code-generation), the port of
//! `sagitario_codegen_c`. The output is strict, portable C11 that includes
//! `sagitario_runtime.h`; integer arithmetic, negation, indexing and float-to-integer casts go
//! through runtime helpers so the generated C has no undefined behavior.

use pkg::ast::{BinaryOp, UnaryOp};
use pkg::ast;
use pkg::sir::{
  Callee, ClassInstance, Const, ExternDecl, FieldAt, Function, ItableEntry, Layouts, Operand, PanicMessage, Place, Program, Projection, Rvalue, SliceSource, Stmt,
  TemplatePiece, extern_static_getter, static_getter, type_key,
};
use pkg::types::{FloatTy, IntTy, NamedRef, Type, TypeKind};
use pkg::types;

pub const RUNTIME_HEADER: String = "sagitario_runtime.h";

/// The C translation units of a program.
pub struct GeneratedC {
  /// The program, which includes the runtime header.
  pub program: String;
  /// The calls into C and the exported functions, compiled apart; `None` without FFI.
  pub ffi: Option<String>;
  /// The calls into C of the standard library, compiled apart from the program's, whose
  /// declarations of the same C functions may have other types; `None` without them.
  pub std_ffi: Option<String>;
  /// Whether the program uses `std::thread` or `std::sync`.
  pub threads: bool;
  /// Whether the program uses the sockets of `std::net`, which Windows has in Winsock
  /// (docs/adr/0100-networking.md, Q698).
  pub sockets: bool;
}

/// The longest string literal every C11 compiler accepts (5.2.4.1).
const MAX_LITERAL: usize = 4095;

pub fn generate(program: Program) -> GeneratedC {
  const generator = new Generator(program);
  const order = generator.aggregate_order(program);
  var threads = false;
  var sockets = false;

  for index in 0..program.externs.len() {
    const decl = program.externs[index];

    if decl.in_std && decl.symbol == "WSAStartup" && calls_extern(program, index as u32) {
      sockets = true;
    }

    if decl.runtime && decl.symbol == "sag_thread_prepare" {
      threads = true;
    }

    // `std::task` declares it for every program using tasks; only one calling `spawn_blocking`
    // needs threads (docs/adr/0073-spawn-blocking.md).
    if decl.runtime && decl.symbol == "sag_task_spawn_blocking" && calls_extern(program, index as u32) {
      threads = true;
    }
  }

  // C may call an `extern "C" fn` of the program on a thread of its own
  // (docs/adr/0078-ffi-without-c-shims.md, Q475).
  if passes_c_callbacks(program) {
    threads = true;
  }

  // `_Atomic` fields and fences need `<stdatomic.h>`, which the runtime includes for threads
  // (docs/adr/0087-atomic-storage-and-std-sync.md, Q569).
  for instance in program.classes {
    for field in instance.fields {
      if let TypeKind::Atomic(_) = field.kind {
        threads = true;
      }
    }
  }

  if calls_builtin(program, "Atomic::fence") {
    threads = true;
  }

  generator.out.append("/* Generated by sag. Do not edit. */\n");

  if threads {
    generator.out.append("#define SAG_THREADS 1\n");
  }

  generator.out.append("#include \"" + RUNTIME_HEADER + "\"\n\n");
  generator.type_definitions(order);

  for index in 0..program.externs.len() {
    const decl = program.externs[index];

    if !decl.runtime {
      generator.out.append(generator.extern_prototype(index, decl) + ";\n");
    }
  }

  for index in 0..program.functions.len() {
    const function = program.functions[index];

    if !function.template {
      generator.out.append(linkage(function) + generator.signature(index as u32, function) + ";\n");
    }
  }

  generator.out.append("\n");

  // The arrays of long strings go here, once every function is generated.
  const head = generator.out.to_string();

  generator.out = new StringBuilder();
  generator.list_support();
  generator.class_support(order);
  generator.debug_closure(program);
  generator.interface_support(program);
  generator.closure_support(program);
  generator.statics(program);
  generator.debug_support(program);

  for index in 0..program.functions.len() {
    const function = program.functions[index];

    if !function.template {
      generator.function(index as u32, function);
    }
  }

  generator.entry_point(program);

  const text = head + generator.long_string_definitions() + generator.fn_pointer_conversions() + generator.zeroed_definitions() + generator.out.to_string();

  GeneratedC { program: text, ffi: generator.ffi_unit(program, false), std_ffi: generator.ffi_unit(program, true), threads: threads, sockets: sockets }
}

/// A field of a class, with how the C reads it from `v`.
struct DebugField {
  pub name: String;
  pub ty: Type;
  pub access: String;
  pub is_weak: bool;
}

/// What a struct, a variant or a class writes: a field with its label (none when positional), or
/// `(weak)` for a weak field, whose `access` is empty.
struct DebugItem {
  pub label: String;
  pub ty: Type;
  pub access: String;
}

fn debug_position(all: List<Type>, ty: Type) -> Option<usize> {
  for index in 0..all.len() {
    if types::same_type(all[index], ty) {
      return Some(index);
    }
  }

  None
}

fn is_map(program: Program, class_ref: NamedRef) -> bool {
  match program.map_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

fn is_hash_set(program: Program, class_ref: NamedRef) -> bool {
  match program.hash_set_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

fn is_vec_deque(program: Program, class_ref: NamedRef) -> bool {
  match program.vec_deque_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

fn is_btree_map(program: Program, class_ref: NamedRef) -> bool {
  match program.btree_map_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

fn is_btree_set(program: Program, class_ref: NamedRef) -> bool {
  match program.btree_set_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

fn is_binary_heap(program: Program, class_ref: NamedRef) -> bool {
  match program.binary_heap_class {
    Some(id) => id == class_ref.id,
    None => false,
  }
}

/// `sag_sb_push_bytes` of a text without quotes or backslashes.
fn push_text(text: String) -> String {
  "  sag_sb_push_bytes(sb, " + c_string_literal(text) + `, ${text.len()});`
}

/// One element of a list or array, the first when `first` holds.
fn debug_element(elem: Type, access: String, first: String, all: List<Type>) -> String {
  const index = debug_position(all, elem).unwrap_or(0);

  `    sag_debug_next(sb, ${first}, indent + 1, pretty, false);\n    sag_debug_${index}(sb, ${access}, indent + 1, pretty);\n    if (pretty) {\n      sag_sb_push_bytes(sb, ",", 1);\n    }`
}

/// The fields of `items`, after the separator, each followed by a comma when `pretty`.
fn debug_items(body: List<String>, items: List<DebugItem>, all: List<Type>, pad: String, spaced: bool) {
  for index in 0..items.len() {
    const item = items[index];

    body.push(pad + `sag_debug_next(sb, ${index == 0}, indent + 1, pretty, ${spaced});`);

    if !item.label.is_empty() {
      const label = item.label + ": ";

      body.push(pad + "sag_sb_push_bytes(sb, " + c_string_literal(label) + `, ${label.len()});`);
    }

    if item.access.is_empty() {
      body.push(pad + "sag_sb_push_bytes(sb, \"(weak)\", 6);");
    } else {
      body.push(pad + `sag_debug_${debug_position(all, item.ty).unwrap_or(0)}(sb, ${item.access}, indent + 1, pretty);`);
    }

    body.push(pad + "if (pretty) {");
    body.push(pad + "  sag_sb_push_bytes(sb, \",\", 1);");
    body.push(pad + "}");
  }
}

/// `Name { a: 1, b: 2 }`, or `Name` without fields.
fn debug_named(body: List<String>, name: String, items: List<DebugItem>, all: List<Type>, pad: String) {
  body.push(pad + "sag_sb_push_bytes(sb, " + c_string_literal(name) + `, ${name.len()});`);

  if items.is_empty() {
    return;
  }

  body.push(pad + "sag_sb_push_bytes(sb, \" {\", 2);");
  debug_items(body, items, all, pad, true);
  body.push(pad + "sag_debug_end(sb, true, indent, pretty, true, \"}\");");
}

/// `Name(a, b)`.
fn debug_tuple(body: List<String>, name: String, items: List<DebugItem>, all: List<Type>, pad: String) {
  const open = name + "(";

  body.push(pad + "sag_sb_push_bytes(sb, " + c_string_literal(open) + `, ${open.len()});`);
  debug_items(body, items, all, pad, false);
  body.push(pad + "sag_debug_end(sb, true, indent, pretty, false, \")\");");
}

/// Exported functions are called from the FFI translation unit; the others stay private.
fn linkage(function: Function) -> String {
  if function.export.is_some() { "" } else { "static " }
}

/// A C struct to define: a struct, an enum, the objects of a class instance, or an array,
/// `Option`, `Result` or generic struct or enum type (index in `Generator::instances`).
enum Aggregate {
  Struct(usize),
  Enum(usize),
  Class(usize),
  Instance(usize),
}

/// A source position for `#line`.
struct SourceLine {
  pub file: u32;
  pub line: u32;
}

fn struct_type(index: usize) -> Type {
  types::of(TypeKind::Struct(NamedRef { id: index as u32, name: "", args: new List() }))
}

fn enum_type(index: usize) -> Type {
  types::of(TypeKind::Enum(NamedRef { id: index as u32, name: "", args: new List() }))
}

/// Functions are named by id, so any Sagitario identifier is safe in C.
fn fn_name(id: u32) -> String {
  `sag_fn_${id}`
}

/// The wrapper, in the FFI translation unit, that calls the C function of `extern` number
/// `index`.
fn ffi_name(index: usize) -> String {
  `sag_ffi_${index}`
}

fn local_name(local: u32) -> String {
  `l${local}`
}

fn int_c_type(int_ty: IntTy) -> String {
  match int_ty {
    IntTy::I8 => "int8_t",
    IntTy::I16 => "int16_t",
    IntTy::I32 => "int32_t",
    IntTy::I64 => "int64_t",
    IntTy::Isize => "intptr_t",
    IntTy::U8 => "uint8_t",
    IntTy::U16 => "uint16_t",
    IntTy::U32 => "uint32_t",
    IntTy::U64 => "uint64_t",
    IntTy::Usize => "size_t",
  }
}

fn without_sag_prefix(name: String) -> String {
  var rest = name;

  while rest.starts_with("sag_") {
    rest = rest.substring(4, rest.len());
  }

  rest
}

class Generator {
  pub const layouts: Layouts;
  /// Every array, `Option`, `Result` and generic struct or enum type used by the program.
  pub const instances: List<Type>;
  pub const instance_keys: Map<String, usize>;
  pub var out: StringBuilder;
  pub var indent: usize;
  /// The source paths as C string literals, by file index, for `#line`.
  pub const paths: List<String>;
  /// Locals of the function being generated.
  pub var locals: List<Type>;
  /// Whether local 0 of the function being generated is a pointer (`var self`).
  pub var self_by_ref: bool;
  /// In the body of an `async fn`, its frame (`sag_env<N>`), where its locals live.
  pub var frame: Option<usize>;
  /// The function being generated.
  pub var function_id: u32;
  /// The function whose frame each environment is, if it is one.
  pub const frame_functions: Map<usize, u32>;
  /// The source file and line of the statement being generated.
  pub var source_line: Option<SourceLine>;
  /// Types behind pointers, given a C type after the aggregate being visited.
  pub const pointees: List<Type>;
  /// Class instances whose objects are referenced.
  pub const class_queue: List<usize>;
  pub const classes: List<ClassInstance>;
  pub const class_keys: Map<String, usize>;
  pub const functions: List<Function>;
  pub const externs: List<ExternDecl>;
  pub const envs: List<List<Type>>;
  /// The element types of the lists the program uses.
  pub const list_elems: List<Type>;
  pub const list_keys: Map<String, usize>;
  /// Strings longer than C compilers must accept as literals.
  pub const long_strings: List<String>;
  pub const long_string_keys: Map<String, usize>;
  /// The C function pointer types (`sag_pN`), safe and unsafe ones alike, each after the ones
  /// its signature mentions.
  pub const fn_pointers: List<Type>;
  pub const fn_pointer_keys: Map<String, usize>;
  /// The C function pointer types converted from or to addresses, which get helpers.
  pub const converted_fn_pointers: List<usize>;
  /// The C types `mem::zeroed` makes, which get helpers.
  pub const zeroed_types: List<String>;
  pub const zeroed_keys: Map<String, usize>;
  /// Every type whose debug form the program writes, those `{x:?}` names first, then those inside
  /// them; with an interface among them, the types of every itable too
  /// (docs/adr/0101-the-rest-of-s2.md, Q712).
  pub var debug_all: List<Type>;
  /// Whether an interface value is written with `{x:?}`: every itable then has a debug thunk.
  pub var dyn_debug: bool;

  pub fn new(self, program: Program) {
    self.layouts = program.layouts;
    self.instances = new List();
    self.instance_keys = new Map<String, usize>();
    self.out = new StringBuilder();
    self.indent = 0;
    self.paths = new List();

    // With `/` on every system, so that the C does not depend on the machine that generates it
    // (docs/adr/0067-bootstrap-from-the-seed.md).
    for path in program.source_paths {
      self.paths.push(c_string_literal(path.replace("\\", "/")));
    }

    self.locals = new List();
    self.self_by_ref = false;
    self.frame = None;
    self.function_id = 0;
    self.frame_functions = new Map<usize, u32>();

    for index in 0..program.functions.len() {
      if let Some(env) = program.functions[index].frame {
        self.frame_functions.insert(env, index as u32);
      }
    }

    self.source_line = None;
    self.pointees = new List();
    self.class_queue = new List();
    self.classes = program.classes;
    self.class_keys = new Map<String, usize>();

    for index in 0..program.classes.len() {
      const key = type_key(types::of(TypeKind::Class(program.classes[index].class_ref)));

      if !self.class_keys.contains_key(key) {
        self.class_keys.insert(key, index);
      }
    }

    self.functions = program.functions;
    self.externs = program.externs;
    self.envs = program.envs;
    self.list_elems = new List();
    self.list_keys = new Map<String, usize>();
    self.long_strings = new List();
    self.long_string_keys = new Map<String, usize>();
    self.fn_pointers = new List();
    self.fn_pointer_keys = new Map<String, usize>();
    self.converted_fn_pointers = new List();
    self.zeroed_types = new List();
    self.zeroed_keys = new Map<String, usize>();
    self.debug_all = new List();
    self.dyn_debug = false;
  }

  /// Every aggregate type, each after the ones it contains, as C requires.
  pub fn aggregate_order(self, program: Program) -> List<Aggregate> {
    const order: List<Aggregate> = new List();
    const done: List<bool> = new List();

    for _ in 0..(self.layouts.structs.len() + self.layouts.enums.len() + self.classes.len()) {
      done.push(false);
    }

    for index in 0..self.layouts.structs.len() {
      self.visit_type(struct_type(index), done, order);
    }

    for index in 0..self.layouts.enums.len() {
      self.visit_type(enum_type(index), done, order);
    }

    for index in 0..self.classes.len() {
      self.class_queue.push(index);
    }

    for function in program.functions {
      for ty in function.locals {
        self.visit_type(ty, done, order);
      }

      self.visit_type(function.ret, done, order);
    }

    // Types measured by `mem::size_of` and `mem::align_of`, which may be no function's local.
    for function in program.functions {
      if !function.template {
        const measured: List<Type> = new List();

        measured_types(function.body, measured);

        for ty in measured {
          self.visit_type(ty, done, order);
        }
      }
    }

    // Captures, which may be no function's local.
    for env in program.envs {
      for ty in env {
        self.visit_type(ty, done, order);
      }
    }

    // Fields read through interfaces, which may be no function's local.
    for itable in program.itables {
      for entry in itable.entries {
        if let ItableEntry::Field { ty, .. } = entry {
          self.visit_type(ty, done, order);
        }
      }
    }

    for decl in program.externs {
      for ty in decl.params {
        self.visit_type(ty, done, order);
      }

      self.visit_type(decl.ret, done, order);
    }

    // A pointer only needs its pointee declared, so pointees and classes may come in any order.
    while true {
      if let Some(pointee) = self.pointees.pop() {
        self.visit_type(pointee, done, order);
      } else if let Some(class_index) = self.class_queue.pop() {
        self.visit_class(class_index, done, order);
      } else {
        break;
      }
    }

    order
  }

  /// Defines a class's objects after the types of its fields.
  prv fn visit_class(self, index: usize, done: List<bool>, order: List<Aggregate>) {
    const flag = self.layouts.structs.len() + self.layouts.enums.len() + index;

    if done.get(flag).unwrap_or(true) {
      return;
    }

    done[flag] = true;

    const instance = match self.classes.get(index) {
      Some(found) => found,
      None => {
        order.push(Aggregate::Class(index));

        return;
      }
    };

    // An object contains its parent's part by value.
    if let Some(parent) = instance.parent {
      self.visit_class(parent, done, order);
    }

    for field in instance.fields {
      self.visit_type(field, done, order);
    }

    order.push(Aggregate::Class(index));
  }

  /// `done` flags structs first, then enums, then class instances.
  prv fn visit_type(self, ty: Type, done: List<bool>, order: List<Aggregate>) {
    var flag = 0usize;
    var aggregate = Aggregate::Struct(0);

    match ty.kind {
      TypeKind::Struct(named) => {
        if !named.args.is_empty() {
          return self.visit_instance(ty, done, order);
        }

        flag = named.id as usize;
        aggregate = Aggregate::Struct(named.id as usize);
      }
      TypeKind::Enum(named) => {
        if !named.args.is_empty() {
          return self.visit_instance(ty, done, order);
        }

        // An enum with an integer representation is its integer.
        if self.layouts.enum_repr(ty).is_some() {
          return;
        }

        flag = self.layouts.structs.len() + named.id as usize;
        aggregate = Aggregate::Enum(named.id as usize);
      }
      TypeKind::Class(class_ref) => {
        self.class_queue.push(self.class_index(class_ref));

        return;
      }
      TypeKind::Option(inner) => {
        // An `Option` of a C function pointer is the pointer.
        if pkg::sir::is_nullable_pointer(ty) {
          return self.visit_type(inner, done, order);
        }

        return self.visit_instance(ty, done, order);
      }
      TypeKind::Array { .. } | TypeKind::Result { .. } | TypeKind::Tuple(_) => return self.visit_instance(ty, done, order),
      TypeKind::Ptr { pointee, .. } | TypeKind::Ref { pointee, .. } | TypeKind::Slice { elem: pointee, .. } => {
        self.pointees.push(pointee);

        return;
      }
      TypeKind::CFn { params, ret, .. } => {
        // A C function type may name incomplete types, so its parts only need declaring.
        for param in params {
          self.visit_type(param, done, order);
        }

        self.visit_type(ret, done, order);
        self.fn_pointer_index(ty);

        return;
      }
      // A list holds its elements behind a reference.
      TypeKind::List(elem) => {
        const key = type_key(elem);

        if !self.list_keys.contains_key(key) {
          self.list_keys.insert(key, self.list_elems.len());
          self.list_elems.push(elem);
        }

        self.pointees.push(elem);

        return;
      }
      _ => return,
    }

    if done.get(flag).unwrap_or(true) {
      return;
    }

    done[flag] = true;

    for group in self.parts(ty) {
      for part in group {
        self.visit_type(part, done, order);
      }
    }

    order.push(aggregate);
  }

  prv fn visit_instance(self, ty: Type, done: List<bool>, order: List<Aggregate>) {
    const key = type_key(ty);

    if self.instance_keys.contains_key(key) {
      return;
    }

    for group in self.parts(ty) {
      for part in group {
        self.visit_type(part, done, order);
      }
    }

    // A part may have registered the same instance meanwhile.
    if self.instance_keys.contains_key(key) {
      return;
    }

    self.instance_keys.insert(key, self.instances.len());
    self.instances.push(ty);
    order.push(Aggregate::Instance(self.instances.len() - 1));
  }

  /// The types a value of `ty` contains: per variant for enum-like types, else one group.
  prv fn parts(self, ty: Type) -> List<List<Type>> {
    match ty.kind {
      TypeKind::Struct(named) => List::from([self.layouts.struct_fields(named)]),
      TypeKind::Class(class_ref) => match self.classes.get(self.class_index(class_ref)) {
        Some(instance) => List::from([instance.fields]),
        None => List::from([new List<Type>()]),
      },
      TypeKind::Array { elem, .. } => List::from([List::from([elem])]),
      TypeKind::Tuple(elems) => List::from([elems]),
      _ => self.layouts.variants(ty).unwrap_or(new List()),
    }
  }

  prv fn flat_parts(self, ty: Type) -> List<Type> {
    const result: List<Type> = new List();

    for group in self.parts(ty) {
      for part in group {
        result.push(part);
      }
    }

    result
  }

  prv fn aggregate_type(self, aggregate: Aggregate) -> Type {
    match aggregate {
      Aggregate::Struct(index) => struct_type(index),
      Aggregate::Enum(index) => enum_type(index),
      Aggregate::Class(index) => match self.classes.get(index) {
        Some(instance) => types::of(TypeKind::Class(instance.class_ref)),
        None => types::error(),
      },
      Aggregate::Instance(index) => self.instances.get(index).unwrap_or(types::error()),
    }
  }

  /// The C struct of an aggregate: for a class, the struct of its objects.
  prv fn struct_name(self, ty: Type) -> String {
    match ty.kind {
      TypeKind::Class(class_ref) => `sag_c${self.class_index(class_ref)}`,
      _ => self.c_type(ty),
    }
  }

  /// The class instance of a class type.
  prv fn class_index(self, class_ref: NamedRef) -> usize {
    self.class_keys.get(type_key(types::of(TypeKind::Class(class_ref)))).unwrap_or(0)
  }

  pub fn type_definitions(self, order: List<Aggregate>) {
    // Declared first, so pointers can refer to any of them.
    for aggregate in order {
      const ty = self.aggregate_type(aggregate);
      const name = self.struct_name(ty);
      const keyword = if self.layouts.is_union(ty) { "union" } else { "struct" };

      self.out.append("typedef " + keyword + " " + name + " " + name + ";\n");
    }

    self.out.append(self.fn_pointer_typedefs());

    for aggregate in order {
      self.out.append(self.definition(self.aggregate_type(aggregate)));
    }

    for aggregate in order {
      self.arc_functions(aggregate);
    }

    self.enum_values();
    self.out.append("\n");
  }

  /// For each enum with an integer representation, the functions giving the position of the
  /// variant a value is (any other value panics) and whether a value is one of a variant.
  prv fn enum_values(self) {
    for id in 0..self.layouts.enums.len() {
      const layout = self.layouts.enums[id];
      const repr = match layout.repr {
        Some(found) => found,
        None => continue,
      };
      const c_type = int_c_type(repr);
      const cases = new StringBuilder();

      for index in 0..layout.values.len() {
        cases.append("  case " + constant(layout.values[index]) + `: return ${index}u;\n`);
      }

      const push = if types::is_signed(repr) { "sag_sb_push_i64(&message, (int64_t)value);" } else { "sag_sb_push_u64(&message, (uint64_t)value);" };
      const suffix = " for enum " + layout.name;

      self.out.append(`static uint32_t sag_e${id}_index(` + c_type + " value, const char *file, int line) {\n");
      self.out.append("  sag_sb message;\n  switch (value) {\n" + cases.to_string() + "  default: break;\n  }\n");
      self.out.append("  sag_sb_init(&message);\n  sag_sb_push_bytes(&message, \"invalid value \", 14);\n  " + push + "\n");
      self.out.append("  sag_sb_push_bytes(&message, " + c_string_literal(suffix) + `, ${suffix.len()});\n`);
      self.out.append("  sag_panic_str_at(sag_sb_finish(&message), file, line);\n}\n");
      self.out.append(`static bool sag_e${id}_valid(` + c_type + " value) {\n  switch (value) {\n");

      for value in layout.values {
        self.out.append("  case " + constant(value) + ":\n");
      }

      self.out.append("    return true;\n  default:\n    return false;\n  }\n}\n");
    }
  }

  /// The vtables, then the functions that create and destroy instances.
  pub fn class_support(self, order: List<Aggregate>) {
    for aggregate in order {
      if let Aggregate::Class(index) = aggregate {
        const methods: List<String> = new List();

        if let Some(instance) = self.classes.get(index) {
          for function in instance.vtable {
            methods.push("(sag_method)" + fn_name(function));
          }
        }

        if !methods.is_empty() {
          self.out.append(`static const sag_method sag_vtable_c${index}[] = { ` + methods.join(", ") + " };\n");
        }
      }
    }

    for aggregate in order {
      if let Aggregate::Class(index) = aggregate {
        self.class_functions(index);
      }
    }

    self.out.append("\n");
  }

  prv fn box_index(self, program: Program, ty: Type) -> Option<usize> {
    for index in 0..program.boxes.len() {
      if types::same_type(program.boxes[index], ty) {
        return Some(index);
      }
    }

    None
  }

  /// The boxes of struct and enum values held by interface values, then the itables with their
  /// thunks, then the functions converting values to interface values.
  pub fn interface_support(self, program: Program) {
    for index in 0..program.boxes.len() {
      const ty = program.boxes[index];
      const release = if self.layouts.is_managed(ty) { "  " + self.arc_call("release", ty, "box->value") + ";\n" } else { "" };

      self.out.append(`typedef struct sag_b${index} { sag_object header; ` + self.c_type(ty) + ` value; } sag_b${index};\n`);
      self.out.append(`static void sag_drop_b${index}(sag_object *object) {\n`);

      if release.is_empty() {
        self.out.append("  (void)object;\n");
      } else {
        self.out.append(`  sag_b${index} *box = (sag_b${index} *)object;\n` + release);
      }

      self.out.append("}\n");
    }

    for index in 0..program.itables.len() {
      self.out.append(`static const sag_itable sag_it_${index};\n`);

      if self.dyn_debug {
        self.out.append(`static void sag_itd_${index}(sag_sb *sb, sag_object *object, int32_t indent, bool pretty);\n`);
      }
    }

    for index in 0..program.itables.len() {
      const itable = program.itables[index];
      const boxed = self.box_index(program, itable.concrete);
      const methods: List<String> = new List();

      for slot in 0..itable.entries.len() {
        self.thunk(program, index, slot, itable.entries[slot], boxed);
        methods.push(`(sag_method)sag_th_${index}_${slot}`);
      }

      const parents: List<String> = new List();

      for parent in itable.parents {
        parents.push(`&sag_it_${parent}`);
      }

      var methods_name = "NULL";

      if !methods.is_empty() {
        self.out.append(`static const sag_method sag_itm_${index}[] = { ` + methods.join(", ") + " };\n");
        methods_name = `sag_itm_${index}`;
      }

      var parents_name = "NULL";

      if !parents.is_empty() {
        self.out.append(`static const sag_itable *const sag_itp_${index}[] = { ` + parents.join(", ") + " };\n");
        parents_name = `sag_itp_${index}`;
      }

      const debug_name = if self.dyn_debug { `sag_itd_${index}` } else { "NULL" };

      self.out.append(`static const sag_itable sag_it_${index} = { ` + parents_name + ", " + methods_name + ", " + debug_name + " };\n");

      const value_ty = self.c_type(itable.concrete);

      match boxed {
        Some(box_index) => {
          const retain = if self.layouts.is_managed(itable.concrete) { "  " + self.arc_call("retain", itable.concrete, "box->value") + ";\n" } else { "" };

          self.out.append(`static sag_dyn sag_todyn_${index}(` + value_ty + " value) {\n");
          self.out.append(`  sag_b${box_index} *box = sag_object_alloc(sizeof(sag_b${box_index}));\n  box->value = value;\n` + retain);
          self.out.append(`  sag_object_init((sag_object *)box, sag_drop_b${box_index}, NULL);\n`);
          self.out.append(`  return (sag_dyn){(sag_object *)box, &sag_it_${index}};\n}\n`);
        }
        None => {
          self.out.append(`static sag_dyn sag_todyn_${index}(sag_object *value) {\n`);
          self.out.append(`  sag_object_retain(value);\n  return (sag_dyn){value, &sag_it_${index}};\n}\n`);
        }
      }
    }

    self.out.append("\n");
  }

  /// The function at `slot` of itable `index`: calls the type's method, or reads or writes one of
  /// its fields.
  prv fn thunk(self, program: Program, index: usize, slot: usize, entry: ItableEntry, boxed: Option<usize>) {
    const name = `sag_th_${index}_${slot}`;
    const object = match boxed {
      Some(box_index) => `((sag_b${box_index} *)self.object)->value`,
      None => "self.object",
    };

    match entry {
      ItableEntry::Method { function, slot: vtable_slot, params, ret } => {
        const declared = List::from(["sag_dyn self"]);

        for arg in 0..params.len() {
          declared.push(self.c_type(params[arg]) + ` a${arg}`);
        }

        const by_ref = match program.functions.get(function as usize) {
          Some(target) => target.self_by_ref,
          None => false,
        };
        const args = List::from([if by_ref { "&" + object } else { object }]);

        for arg in 0..params.len() {
          args.push(`a${arg}`);
        }

        const callee = match vtable_slot {
          Some(found_slot) => "((" + self.method_pointer(function) + `)(self.object->vtable[${found_slot}]))`,
          None => fn_name(function),
        };
        const call = callee + "(" + args.join(", ") + ")";
        const ret_type = self.return_type(ret);
        const body = if ret_type == "void" { call + ";" } else { "return " + call + ";" };

        self.out.append("static " + ret_type + " " + name + "(" + declared.join(", ") + ") { " + body + " }\n");
      }
      ItableEntry::Field { field, ty, set } => {
        const place = match field {
          FieldAt::Class { class_id, index: field_index } => `((sag_c${class_id} *)self.object)->f${field_index}`,
          FieldAt::Struct(field_index) => object + `.f${field_index}`,
        };
        const c_type = self.c_type(ty);
        const managed = self.layouts.is_managed(ty);

        if set {
          const body: List<String> = new List();

          if managed {
            body.push(self.arc_call("retain", ty, "value") + ";");
            body.push(self.arc_call("release", ty, place) + ";");
          }

          body.push(place + " = value;");
          self.out.append("static void " + name + "(sag_dyn self, " + c_type + " value) { " + body.join(" ") + " }\n");
        } else {
          const retain = if managed { " " + self.arc_call("retain", ty, "value") + ";" } else { "" };

          self.out.append("static " + c_type + " " + name + "(sag_dyn self) { " + c_type + " value = " + place + ";" + retain + " return value; }\n");
        }
      }
    }
  }

  /// The functions that release an element of each list type with managed elements.
  pub fn list_support(self) {
    for index in 0..self.list_elems.len() {
      const elem = self.list_elems[index];

      if self.layouts.is_managed(elem) {
        const release = self.arc_call("release", elem, "(*(" + self.c_type(elem) + " *)element)");

        self.out.append(`static void sag_elem_release_${index}(void *element) { ` + release + "; }\n");
      }
    }

    self.out.append("\n");
  }

  /// The function releasing an element of a list of `elem`, or NULL.
  prv fn elem_release(self, elem: Type) -> String {
    match self.list_keys.get(type_key(elem)) {
      Some(index) => if self.layouts.is_managed(elem) { `sag_elem_release_${index}` } else { "NULL" },
      None => "NULL",
    }
  }

  /// The C type of the elements of the list `list`.
  prv fn list_elem(self, list: Operand) -> String {
    const ty = self.operand_type(list);

    match ty.kind {
      TypeKind::List(elem) => self.c_type(elem),
      _ => "uint8_t",
    }
  }

  /// `for` over a range counting down or by steps.
  prv fn for_range_stepped(self, variable: u32, ty: IntTy, start_operand: Operand, end_operand: Operand, inclusive: bool, reverse: bool, step: Option<Operand>, body: List<Stmt>) {
    const n = variable;
    const start = self.operand(start_operand);
    const end = self.operand(end_operand);
    const step_text = match step {
      Some(found) => "(uintmax_t)" + self.operand(found),
      None => "(uintmax_t)1",
    };
    const empty = if inclusive { start + " > " + end } else { start + " >= " + end };
    // The distance from the first to the last value.
    const last = if inclusive { "0" } else { "1" };
    const distance = "((uintmax_t)" + end + " - (uintmax_t)" + start + " - " + last + ")";
    const o = self.counter(`sag_o${n}`);
    const d = self.counter(`sag_d${n}`);
    const value = if reverse { "(uintmax_t)" + end + " - " + last + ` - ${o}` } else { "(uintmax_t)" + start + ` + ${o}` };
    const init = self.counters_init("uintmax_t", List::from([`sag_o${n}`, `sag_d${n}`]), List::from(["0", `(${empty})`]));

    self.line("if (" + step_text + " == 0) sag_panic_at(\"the step of `step_by` must be greater than 0\", __FILE__, __LINE__);");
    self.line(`for (${init}; ${d} == 0; ${d} = (${distance} - ${o} < ${step_text}), ${o} = ${d} ? ${o} : ${o} + ${step_text}) {`);
    self.indent += 1;
    self.line(self.local(variable) + " = sag_from_uintmax_" + types::int_name(ty) + "(" + value + ");");
    self.stmts(body);
    self.indent -= 1;
    self.line("}");
  }

  /// The closure environments, then the wrappers of named functions used as values.
  pub fn closure_support(self, program: Program) {
    for index in 0..program.envs.len() {
      const env_types = program.envs[index];
      const fields = new StringBuilder();
      const releases = new StringBuilder();

      for field in 0..env_types.len() {
        fields.append(" " + self.c_type(env_types[field]) + ` c${field};`);

        if self.layouts.is_managed(env_types[field]) {
          releases.append("  " + self.arc_call("release", env_types[field], `env->c${field}`) + ";\n");
        }
      }

      // The frame of an `async fn` also holds its state, locals and loop counters.
      if let Some(function_id) = self.frame_functions.get(index) {
        if let Some(function) = program.functions.get(function_id as usize) {
          fields.append(self.frame_fields(function));
        }
      }

      self.out.append(`typedef struct sag_env${index} { sag_object header;` + fields.to_string() + ` } sag_env${index};\n`);
      self.out.append(`static void sag_drop_env${index}(sag_object *object) {\n`);

      if releases.is_empty() {
        self.out.append("  (void)object;\n");
      } else {
        self.out.append(`  sag_env${index} *env = (sag_env${index} *)object;\n` + releases.to_string());
      }

      self.out.append("}\n");
    }

    for function_id in program.wrapped {
      const function = match program.functions.get(function_id as usize) {
        Some(found) => found,
        None => continue,
      };
      const declared = List::from(["sag_object *env"]);
      const args: List<String> = new List();

      for arg in 0..function.param_count {
        if let Some(ty) = function.locals.get(arg) {
          declared.push(self.c_type(ty) + ` a${arg}`);
          args.push(`a${arg}`);
        }
      }

      const ret = self.return_type(function.ret);
      const call = fn_name(function_id) + "(" + args.join(", ") + ")";
      const body = if ret == "void" { call + ";" } else { "return " + call + ";" };

      self.out.append("static " + ret + ` sag_wrap_${function_id}(` + declared.join(", ") + ") { (void)env; " + body + " }\n");
    }

    self.out.append("\n");
  }

  /// The vtable of a class instance as a C expression: `sag_vtable_cN`, or `NULL` when it is
  /// empty.
  prv fn vtable(self, class_id: usize) -> String {
    match self.classes.get(class_id) {
      Some(instance) => if instance.vtable.is_empty() { "NULL" } else { `sag_vtable_c${class_id}` },
      None => "NULL",
    }
  }

  /// `sag_drop_cN`, which releases the fields of an object (its own, then its parent's), and
  /// `sag_new_cN`.
  prv fn class_functions(self, index: usize) {
    const name = `sag_c${index}`;
    var parent: Option<usize> = None;
    const releases = new StringBuilder();

    if let Some(instance) = self.classes.get(index) {
      parent = instance.parent;

      for field in 0..instance.fields.len() {
        const is_weak = instance.weak_fields.get(field).unwrap_or(false);

        if is_weak {
          releases.append(`  sag_object_weak_release(value->f${field});\n`);
        } else if self.layouts.is_managed(instance.fields[field]) {
          releases.append("  " + self.arc_call("release", instance.fields[field], `value->f${field}`) + ";\n");
        }
      }
    }

    self.out.append(`static void sag_drop_c${index}(sag_object *object) {\n`);

    if releases.is_empty() {
      self.out.append("  (void)object;\n");
    } else {
      self.out.append("  " + name + " *value = (" + name + " *)object;\n" + releases.to_string());
    }

    if let Some(parent_index) = parent {
      self.out.append(`  sag_drop_c${parent_index}(object);\n`);
    }

    const vtable = self.vtable(index);

    self.out.append("}\n");

    // The `drop` of `Drop` runs first, with the object held by one reference while it does
    // (docs/adr/0096-streams-files-and-drop.md, Q655).
    var destroy = `sag_drop_c${index}`;

    if let Some(instance) = self.classes.get(index) {
      if let Some(function) = instance.user_drop {
        destroy = `sag_destroy_c${index}`;
        self.out.append(`static void sag_destroy_c${index}(sag_object *object) {\n`);
        self.out.append("  bool dropping = sag_object_drop_begin(object);\n");
        self.out.append("  " + fn_name(function) + "(object);\n");
        self.out.append("  sag_object_drop_end(object, dropping);\n");
        self.out.append(`  sag_drop_c${index}(object);\n`);
        self.out.append("}\n");
      }
    }

    self.out.append(`static sag_object *sag_new_c${index}(void) {\n`);
    self.out.append("  " + name + " *value = sag_object_alloc(sizeof(" + name + "));\n");
    self.out.append("  *value = (" + name + "){0};\n");
    self.out.append("  sag_object_init((sag_object *)value, " + destroy + ", " + vtable + ");\n");
    self.out.append("  return (sag_object *)value;\n}\n");
  }

  /// `struct sag_xN { ... };` for an aggregate type.
  prv fn definition(self, ty: Type) -> String {
    const name = self.struct_name(ty);
    var members = "";

    match ty.kind {
      TypeKind::Class(class_ref) => {
        const fields = self.flat_parts(ty);
        const instance = self.classes.get(self.class_index(class_ref));
        const weak_fields = match instance {
          Some(found) => found.weak_fields,
          None => new List(),
        };
        const text = new StringBuilder();

        for index in 0..fields.len() {
          const is_weak = weak_fields.get(index).unwrap_or(false);
          const c_type = if is_weak { "sag_object *" } else { self.c_type(fields[index]) };

          text.append(" " + c_type + ` f${index};`);
        }

        const parent = match instance {
          Some(found) => found.parent,
          None => None,
        };
        const base = match parent {
          Some(parent_index) => `sag_c${parent_index} base;`,
          None => "sag_object header;",
        };

        members = base + text.to_string();
      }
      TypeKind::Struct(_) | TypeKind::Tuple(_) => {
        const fields = self.flat_parts(ty);
        const parts: List<String> = new List();

        for index in 0..fields.len() {
          parts.push(self.c_type(fields[index]) + ` f${index};`);
        }

        if parts.is_empty() {
          // C has no empty structs.
          parts.push("uint8_t sag_unused;");
        }

        members = parts.join(" ");
      }
      TypeKind::Array { elem, len } => {
        // C has no zero-length arrays; the extra element is never accessed.
        const count = if len < 1 { 1u64 } else { len };

        members = self.c_type(elem) + ` data[${count}];`;
      }
      _ => {
        const variants: List<String> = new List();
        const groups = self.parts(ty);

        for index in 0..groups.len() {
          const fields = groups[index];

          if fields.is_empty() {
            continue;
          }

          const parts: List<String> = new List();

          for field in 0..fields.len() {
            parts.push(self.c_type(fields[field]) + ` f${field};`);
          }

          variants.push("struct { " + parts.join(" ") + ` } v${index};`);
        }

        members = if variants.is_empty() { "uint32_t tag;" } else { "uint32_t tag; union { " + variants.join(" ") + " } u;" };
      }
    }

    const keyword = if self.layouts.is_union(ty) { "union " } else { "struct " };

    keyword + name + " { " + members + " };\n"
  }

  /// `sag_retain_*` and `sag_release_*` for a managed aggregate.
  prv fn arc_functions(self, aggregate: Aggregate) {
    const ty = self.aggregate_type(aggregate);

    if let Aggregate::Class(_) = aggregate {
      return;
    }

    // Class references use the runtime's `sag_object_retain`/`sag_object_release`.
    if !self.layouts.is_managed(ty) {
      return;
    }

    const name = self.c_type(ty);
    const suffix = without_sag_prefix(name);

    for action in List::from(["retain", "release"]) {
      const body: List<String> = new List();

      match ty.kind {
        TypeKind::Struct(_) | TypeKind::Tuple(_) => {
          const fields = self.flat_parts(ty);

          for index in 0..fields.len() {
            if self.layouts.is_managed(fields[index]) {
              body.push("  " + self.arc_call(action, fields[index], `value->f${index}`) + ";");
            }
          }
        }
        TypeKind::Array { elem, len } => {
          const call = self.arc_call(action, elem, "value->data[sag_k]");

          body.push(`  for (size_t sag_k = 0; sag_k < ${len}; sag_k++) { ` + call + "; }");
        }
        _ => {
          body.push("  switch (value->tag) {");

          const groups = self.parts(ty);

          for variant in 0..groups.len() {
            const calls = new StringBuilder();
            const fields = groups[variant];

            for index in 0..fields.len() {
              if self.layouts.is_managed(fields[index]) {
                calls.append(self.arc_call(action, fields[index], `value->u.v${variant}.f${index}`) + "; ");
              }
            }

            if !calls.is_empty() {
              body.push(`  case ${variant}: ` + calls.to_string() + "break;");
            }
          }

          body.push("  default: break;");
          body.push("  }");
        }
      }

      self.out.append("static void sag_" + action + "_" + suffix + "(const " + name + " *value) {\n" + body.join("\n") + "\n}\n");
    }
  }

  /// A call that retains or releases the managed value `value`.
  prv fn arc_call(self, action: String, ty: Type, value: String) -> String {
    match ty.kind {
      TypeKind::String => "sag_string_" + action + "(" + value + ")",
      TypeKind::StringBuilder => "sag_builder_" + action + "(" + value + ")",
      TypeKind::CString => "sag_cstring_" + action + "(" + value + ")",
      TypeKind::Class(_) | TypeKind::List(_) => "sag_object_" + action + "(" + value + ")",
      TypeKind::Interface(_) => "sag_dyn_" + action + "(" + value + ")",
      TypeKind::Function { .. } => "sag_fnval_" + action + "(" + value + ")",
      TypeKind::Slice { .. } => "sag_slice_" + action + "(" + value + ")",
      _ => "sag_" + action + "_" + without_sag_prefix(self.c_type(ty)) + "(&" + value + ")",
    }
  }

  prv fn instance_index(self, ty: Type) -> usize {
    self.instance_keys.get(type_key(ty)).unwrap_or(0)
  }

  /// The number of the C type of a C function pointer type, registering it the first time; safe
  /// and unsafe pointers with the same signature share it.
  prv fn fn_pointer_index(self, ty: Type) -> usize {
    var key = type_key(ty);

    if let TypeKind::CFn { params, ret, .. } = ty.kind {
      key = type_key(types::of(TypeKind::CFn { is_unsafe: false, params: params, ret: ret }));
    }

    if let Some(index) = self.fn_pointer_keys.get(key) {
      return index;
    }

    const index = self.fn_pointers.len();

    self.fn_pointer_keys.insert(key, index);
    self.fn_pointers.push(ty);

    index
  }

  /// `typedef R (*sag_pN)(A, B);` for every C function pointer type.
  prv fn fn_pointer_typedefs(self) -> String {
    const out = new StringBuilder();

    for index in 0..self.fn_pointers.len() {
      if let TypeKind::CFn { params, ret, .. } = self.fn_pointers[index].kind {
        const parts: List<String> = new List();

        for param in params {
          parts.push(self.c_type(param));
        }

        const param_text = if parts.is_empty() { "void" } else { parts.join(", ") };

        out.append("typedef " + self.return_type(ret) + ` (*sag_p${index})(` + param_text + ");\n");
      }
    }

    out.to_string()
  }

  /// The functions converting C function pointers of type `sag_pN` to and from `void *`, through
  /// a union: ISO C11 does not define casts between function and data pointers.
  pub fn fn_pointer_conversions(self) -> String {
    const out = new StringBuilder();

    for index in self.converted_fn_pointers {
      const name = `sag_p${index}`;

      out.append("_Static_assert(sizeof(" + name + ") == sizeof(void *), \"C function pointers have the size of data pointers\");\n");
      out.append("static void *" + name + "_address(" + name + " f) {\n");
      out.append("  union { " + name + " f; void *p; } u;\n  u.f = f;\n  return u.p;\n}\n");
      out.append("static " + name + " " + name + "_from(void *p, const char *file, int line) {\n");
      out.append("  union { " + name + " f; void *p; } u;\n");
      out.append("  if (p == NULL) {\n    sag_panic_at(\"null C function pointer\", file, line);\n  }\n");
      out.append("  u.p = p;\n  return u.f;\n}\n");
    }

    if !out.is_empty() {
      out.append("\n");
    }

    out.to_string()
  }

  /// A value of `ty` with every byte zero, from a helper writing each byte: an initializer `{0}`
  /// leaves the padding and the other members of a union unspecified.
  prv fn zeroed(self, ty: Type) -> String {
    const name = self.c_type(ty);
    const key = "zeroed " + name;
    var index = self.zeroed_types.len();

    if let Some(found) = self.zeroed_keys.get(key) {
      index = found;
    } else {
      self.zeroed_keys.insert(key, index);
      self.zeroed_types.push(name);
    }

    `sag_zeroed_${index}()`
  }

  /// The helpers of `mem::zeroed`.
  pub fn zeroed_definitions(self) -> String {
    const out = new StringBuilder();

    for index in 0..self.zeroed_types.len() {
      const name = self.zeroed_types[index];

      out.append(`static ${name} sag_zeroed_${index}(void) {\n`);
      out.append(`  ${name} value;\n  unsigned char *bytes = (unsigned char *)&value;\n`);
      out.append("  for (size_t i = 0; i < sizeof value; i++) {\n    bytes[i] = 0;\n  }\n  return value;\n}\n");
    }

    if !out.is_empty() {
      out.append("\n");
    }

    out.to_string()
  }

  /// The name of the C function pointer type of `ty`, with its conversion helpers.
  prv fn converted_fn_pointer(self, ty: Type) -> String {
    const index = self.fn_pointer_index(ty);

    if !self.converted_fn_pointers.contains(index) {
      self.converted_fn_pointers.push(index);
    }

    `sag_p${index}`
  }

  /// The C type of a stored value. `()` has no data but is stored as a byte.
  prv fn c_type(self, ty: Type) -> String {
    match ty.kind {
      TypeKind::Unit | TypeKind::Never | TypeKind::Error => "uint8_t",
      TypeKind::Bool => "bool",
      TypeKind::Char => "uint32_t",
      TypeKind::Int(int_ty) => int_c_type(int_ty),
      TypeKind::Float(FloatTy::F32) => "float",
      TypeKind::Float(FloatTy::F64) => "double",
      TypeKind::String => "sag_string",
      TypeKind::StringBuilder => "sag_builder",
      TypeKind::Interface(_) => "sag_dyn",
      TypeKind::Function { .. } => "sag_fnval",
      // Templates are not generated, so parameters never reach C.
      TypeKind::Param(_) => "uint8_t",
      TypeKind::Struct(named) => if named.args.is_empty() { `sag_s${named.id}` } else { `sag_t${self.instance_index(ty)}` },
      TypeKind::Enum(named) => match self.layouts.enum_repr(ty) {
        Some(repr) => int_c_type(repr),
        None => if named.args.is_empty() { `sag_e${named.id}` } else { `sag_t${self.instance_index(ty)}` },
      },
      TypeKind::Class(_) | TypeKind::List(_) => "sag_object *",
      TypeKind::Option(inner) => if pkg::sir::is_nullable_pointer(ty) { self.c_type(inner) } else { `sag_t${self.instance_index(ty)}` },
      TypeKind::Array { .. } | TypeKind::Result { .. } | TypeKind::Tuple(_) => `sag_t${self.instance_index(ty)}`,
      TypeKind::CFn { .. } => `sag_p${self.fn_pointer_index(ty)}`,
      TypeKind::CString => "sag_cstring",
      TypeKind::CVoid => "void",
      TypeKind::Ptr { mutable, pointee } | TypeKind::Ref { mutable, pointee } => self.c_type(pointee) + (if mutable { "" } else { " const" }) + "*",
      TypeKind::Slice { .. } => "sag_slice",
      TypeKind::Atomic(inner) => "_Atomic(" + self.c_type(inner) + ")",
    }
  }

  // ---- The debug form of values (docs/adr/0089-display-debug-and-format-specifiers.md, Q588) ----

  /// `sag_debug_N(sb, value, indent, pretty)` for each type `{x:?}` writes and those inside it, and
  /// `sag_debug_string_N(value, pretty)` for the ones the program writes, which SIR calls.
  pub fn debug_support(self, program: Program) {
    if program.debug_types.is_empty() {
      return;
    }

    const all = self.debug_all;

    for index in 0..all.len() {
      self.out.append(`static void sag_debug_${index}(sag_sb *sb, ` + self.c_type(all[index]) + " v, int32_t indent, bool pretty);\n");
    }

    for index in 0..program.debug_types.len() {
      self.out.append(`static sag_string sag_debug_string_${index}(` + self.c_type(all[index]) + " v, bool pretty) {\n");
      self.out.append(`  sag_sb sb;\n  sag_sb_init(&sb);\n  sag_debug_${index}(&sb, v, 0, pretty);\n  return sag_sb_finish(&sb);\n}\n`);
    }

    for index in 0..all.len() {
      const body: List<String> = new List();

      self.debug_body(all[index], all, program, body);
      self.out.append(`static void sag_debug_${index}(sag_sb *sb, ` + self.c_type(all[index]) + " v, int32_t indent, bool pretty) {\n");
      self.out.append("  (void)indent;\n  (void)pretty;\n");
      self.out.append(body.join("\n") + "\n}\n");
    }

    // The debug thunk of each itable writes the value of its type, unboxed (Q712).
    if self.dyn_debug {
      for index in 0..program.itables.len() {
        const concrete = program.itables[index].concrete;
        const position = debug_position(all, concrete).unwrap_or(0);
        const value = match self.box_index(program, concrete) {
          Some(box_index) => `((sag_b${box_index} *)object)->value`,
          None => "(" + self.c_type(concrete) + ")object",
        };

        self.out.append(`static void sag_itd_${index}(sag_sb *sb, sag_object *object, int32_t indent, bool pretty) {\n`);
        self.out.append(`  sag_debug_${position}(sb, ` + value + ", indent, pretty);\n}\n");
      }
    }

    self.out.append("\n");
  }

  /// The types whose debug form the program writes, and whether an interface is among them, before
  /// the itables are written.
  pub fn debug_closure(self, program: Program) {
    const all: List<Type> = new List();

    for ty in program.debug_types {
      all.push(ty);
    }

    var next = 0usize;

    while next < all.len() {
      if let TypeKind::Interface(_) = all[next].kind {
        self.dyn_debug = true;
      }

      for child in self.debug_children(all[next], program) {
        if debug_position(all, child).is_none() {
          all.push(child);
        }
      }

      next += 1;
    }

    self.debug_all = all;
  }

  /// The types whose debug form that of `ty` writes.
  prv fn debug_children(self, ty: Type, program: Program) -> List<Type> {
    const result: List<Type> = new List();

    match ty.kind {
      TypeKind::Struct(named) => {
        if !self.layouts.is_union(ty) {
          for field in self.layouts.struct_fields(named) {
            result.push(field);
          }
        }
      }
      TypeKind::Enum(_) | TypeKind::Option(_) | TypeKind::Result { .. } => {
        if self.layouts.enum_repr(ty).is_none() {
          for part in self.flat_parts(ty) {
            result.push(part);
          }
        }
      }
      TypeKind::Array { elem, .. } | TypeKind::List(elem) | TypeKind::Slice { elem, .. } => result.push(elem),
      TypeKind::Tuple(elems) => {
        for elem in elems {
          result.push(elem);
        }
      }
      // An interface value may hold a value of the type of any itable.
      TypeKind::Interface(_) => {
        for itable in program.itables {
          result.push(itable.concrete);
        }
      }
      TypeKind::Class(class_ref) => {
        if is_map(program, class_ref) || is_hash_set(program, class_ref) || is_vec_deque(program, class_ref) || is_btree_map(program, class_ref) || is_btree_set(program, class_ref)
          || is_binary_heap(program, class_ref) {
          for arg in class_ref.args {
            result.push(arg);
          }
        } else {
          for field in self.debug_fields(class_ref) {
            if !field.is_weak {
              result.push(field.ty);
            }
          }
        }
      }
      _ => {}
    }

    result
  }

  /// Every field of a class instance, those of its ancestors first.
  prv fn debug_fields(self, class_ref: NamedRef) -> List<DebugField> {
    const chain: List<usize> = new List();
    var current: Option<usize> = Some(self.class_index(class_ref));

    while let Some(index) = current {
      chain.insert(0, index);
      current = match self.classes.get(index) {
        Some(instance) => instance.parent,
        None => None,
      };
    }

    const fields: List<DebugField> = new List();

    for index in chain {
      if let Some(instance) = self.classes.get(index) {
        for field in 0..instance.fields.len() {
          var ty = instance.fields[field];
          var access = `((sag_c${index} *)v)->f${field}`;

          // An atomic is read as one (docs/adr/0087-atomic-storage-and-std-sync.md).
          if let TypeKind::Atomic(inner) = ty.kind {
            ty = inner;
            access = "atomic_load(&" + access + ")";
          }

          fields.push(DebugField {
            name: instance.field_names.get(field).unwrap_or(""),
            ty: ty,
            access: access,
            is_weak: instance.weak_fields.get(field).unwrap_or(false),
          });
        }
      }
    }

    fields
  }

  /// The C that writes the debug form of `v`, of type `ty`.
  prv fn debug_body(self, ty: Type, all: List<Type>, program: Program, body: List<String>) {
    match ty.kind {
      TypeKind::Unit => body.push(push_text("()")),
      TypeKind::Bool => body.push("  sag_sb_push_bool(sb, v);"),
      TypeKind::Char => body.push("  sag_sb_push_debug_char(sb, v);"),
      TypeKind::String => body.push("  sag_sb_push_debug_str(sb, v);"),
      TypeKind::Int(int_ty) => body.push(if types::is_signed(int_ty) { "  sag_sb_push_i64(sb, (int64_t)v);" } else { "  sag_sb_push_u64(sb, (uint64_t)v);" }),
      TypeKind::Float(FloatTy::F32) => body.push("  sag_sb_push_f32(sb, v);"),
      TypeKind::Float(FloatTy::F64) => body.push("  sag_sb_push_f64(sb, v);"),
      TypeKind::Ptr { .. } | TypeKind::Ref { .. } => body.push("  sag_sb_push_address(sb, (const void *)v);"),
      TypeKind::Function { .. } | TypeKind::CFn { .. } => body.push(push_text("fn")),
      TypeKind::StringBuilder => body.push(push_text("StringBuilder")),
      TypeKind::CString => body.push(push_text("CString")),
      // The value's own form, through its itable (Q712).
      TypeKind::Interface(_) => body.push("  v.itable->debug(sb, v.object, indent, pretty);"),
      TypeKind::Struct(named) => {
        const layout = self.layouts.structs.get(named.id as usize);
        const name = match layout {
          Some(found) => found.name,
          None => "",
        };

        if self.layouts.is_union(ty) {
          body.push(push_text(name + " { .. }"));
          return;
        }

        const names = match layout {
          Some(found) => found.field_names,
          None => new List<String>(),
        };
        const fields = self.layouts.struct_fields(named);
        const items: List<DebugItem> = new List();

        for index in 0..fields.len() {
          items.push(DebugItem { label: names.get(index).unwrap_or(""), ty: fields[index], access: `v.f${index}` });
        }

        debug_named(body, name, items, all, "  ");
      }
      // `(1, "a")` (docs/adr/0092-tuples.md, Q611).
      TypeKind::Tuple(elems) => {
        const items: List<DebugItem> = new List();

        for index in 0..elems.len() {
          items.push(DebugItem { label: "", ty: elems[index], access: `v.f${index}` });
        }

        debug_tuple(body, "", items, all, "  ");
      }
      TypeKind::Array { elem, len } => {
        body.push("  sag_sb_push_bytes(sb, \"[\", 1);");
        body.push(`  for (size_t sag_k = 0; sag_k < ${len}u; sag_k++) {`);
        body.push(debug_element(elem, "v.data[sag_k]", "sag_k == 0", all));
        body.push("  }");
        body.push(`  sag_debug_end(sb, ${len}u > 0, indent, pretty, false, "]");`);
      }
      TypeKind::List(elem) => {
        const elem_type = self.c_type(elem);

        body.push("  size_t sag_n = sag_list_len(v);");
        body.push("  sag_sb_push_bytes(sb, \"[\", 1);");
        body.push("  for (size_t sag_k = 0; sag_k < sag_n; sag_k++) {");
        body.push(debug_element(elem, "(*(" + elem_type + " *)sag_list_at(v, sag_k, __FILE__, __LINE__))", "sag_k == 0", all));
        body.push("  }");
        body.push("  sag_debug_end(sb, sag_n > 0, indent, pretty, false, \"]\");");
      }
      TypeKind::Slice { elem, .. } => {
        const elem_type = self.c_type(elem);

        body.push("  sag_sb_push_bytes(sb, \"[\", 1);");
        body.push("  for (size_t sag_k = 0; sag_k < v.len; sag_k++) {");
        body.push(debug_element(elem, "((" + elem_type + " *)v.data)[sag_k]", "sag_k == 0", all));
        body.push("  }");
        body.push("  sag_debug_end(sb, v.len > 0, indent, pretty, false, \"]\");");
      }
      TypeKind::Option(inner) => {
        if pkg::sir::is_nullable_pointer(ty) {
          body.push("  if (v == NULL) {");
          body.push("  " + push_text("None"));
          body.push("    return;");
          body.push("  }");
          debug_tuple(body, "Some", List::from([DebugItem { label: "", ty: inner, access: "v" }]), all, "  ");
        } else {
          body.push("  if (v.tag == 0u) {");
          body.push("  " + push_text("None"));
          body.push("    return;");
          body.push("  }");
          debug_tuple(body, "Some", List::from([DebugItem { label: "", ty: inner, access: "v.u.v1.f0" }]), all, "  ");
        }
      }
      TypeKind::Result { value, error } => {
        body.push("  if (v.tag == 0u) {");
        debug_tuple(body, "Ok", List::from([DebugItem { label: "", ty: value, access: "v.u.v0.f0" }]), all, "    ");
        body.push("    return;");
        body.push("  }");
        debug_tuple(body, "Err", List::from([DebugItem { label: "", ty: error, access: "v.u.v1.f0" }]), all, "  ");
      }
      TypeKind::Enum(named) => {
        const layout = match self.layouts.enums.get(named.id as usize) {
          Some(found) => found,
          None => return,
        };

        // An enum with an integer representation is its value (docs/spec/10-ffi.md).
        if layout.repr.is_some() {
          for index in 0..layout.values.len() {
            body.push("  if (v == " + constant(layout.values[index]) + ") {");
            body.push("  " + push_text(layout.variant_names.get(index).unwrap_or("")));
            body.push("    return;");
            body.push("  }");
          }

          body.push("  sag_sb_push_i64(sb, (int64_t)v);");
          return;
        }

        const groups = self.parts(ty);

        body.push("  switch (v.tag) {");

        for variant in 0..groups.len() {
          const name = layout.variant_names.get(variant).unwrap_or("");
          const labels = layout.field_names.get(variant).unwrap_or(new List<String>());
          const fields = groups[variant];
          const items: List<DebugItem> = new List();

          for index in 0..fields.len() {
            items.push(DebugItem { label: labels.get(index).unwrap_or(""), ty: fields[index], access: `v.u.v${variant}.f${index}` });
          }

          body.push(`  case ${variant}u: {`);

          if fields.is_empty() {
            body.push("  " + push_text(name));
          } else if labels.is_empty() {
            debug_tuple(body, name, items, all, "    ");
          } else {
            debug_named(body, name, items, all, "    ");
          }

          body.push("    break;");
          body.push("  }");
        }

        body.push("  default:");
        body.push("    break;");
        body.push("  }");
      }
      TypeKind::Class(class_ref) => {
        if is_map(program, class_ref) {
          self.debug_map(class_ref, all, body);
          return;
        }

        if is_hash_set(program, class_ref) {
          self.debug_set(program, class_ref, all, body);
          return;
        }

        if is_vec_deque(program, class_ref) {
          self.debug_deque(class_ref, all, body);
          return;
        }

        if is_btree_map(program, class_ref) {
          self.debug_btree(class_ref, "v", true, all, body);
          return;
        }

        if is_binary_heap(program, class_ref) {
          self.debug_heap(class_ref, all, body);
          return;
        }

        // A `BTreeSet` is written as the keys of its map.
        if is_btree_set(program, class_ref) {
          const set_index = self.class_index(class_ref);

          if let Some(set) = self.classes.get(set_index) {
            for field in 0..set.field_names.len() {
              if set.field_names[field] == "map" {
                if let Some(map_ty) = set.fields.get(field) {
                  if let TypeKind::Class(map_ref) = map_ty.kind {
                    self.debug_btree(map_ref, `((sag_c${set_index} *)v)->f${field}`, false, all, body);
                  }
                }
              }
            }
          }

          return;
        }

        // A cycle writes the class again without its fields.
        body.push("  if (!sag_debug_enter(v)) {");
        body.push("  " + push_text(class_ref.name + " { .. }"));
        body.push("    return;");
        body.push("  }");

        const items: List<DebugItem> = new List();

        for field in self.debug_fields(class_ref) {
          if field.is_weak {
            items.push(DebugItem { label: field.name, ty: types::unit(), access: "" });
          } else {
            items.push(DebugItem { label: field.name, ty: field.ty, access: field.access });
          }
        }

        debug_named(body, class_ref.name, items, all, "  ");
        body.push("  sag_debug_leave();");
      }
      _ => body.push(push_text("?")),
    }
  }

  /// The prelude's `Map`: its entries in order, `{key: value, ...}`.
  prv fn debug_map(self, class_ref: NamedRef, all: List<Type>, body: List<String>) {
    const index = self.class_index(class_ref);
    const instance = match self.classes.get(index) {
      Some(found) => found,
      None => return,
    };
    var items_field = 0usize;

    for field in 0..instance.field_names.len() {
      if instance.field_names[field] == "items" {
        items_field = field;
      }
    }

    const items_ty = instance.fields.get(items_field).unwrap_or(types::unit());
    const entry_ty = match items_ty.kind {
      TypeKind::List(elem) => elem,
      _ => return,
    };
    const key_ty = class_ref.args.get(0).unwrap_or(types::unit());
    const value_ty = class_ref.args.get(1).unwrap_or(types::unit());
    const entry_type = self.c_type(entry_ty);

    body.push(`  sag_object *sag_items = ((sag_c${index} *)v)->f${items_field};`);
    body.push("  size_t sag_n = sag_list_len(sag_items);");
    body.push("  bool sag_any = false;");
    body.push("  sag_sb_push_bytes(sb, \"{\", 1);");
    body.push("  for (size_t sag_k = 0; sag_k < sag_n; sag_k++) {");
    body.push("    " + entry_type + " sag_e = *(" + entry_type + " *)sag_list_at(sag_items, sag_k, __FILE__, __LINE__);");
    body.push("    if (sag_e.tag != 1u) {");
    body.push("      continue;");
    body.push("    }");
    body.push("    sag_debug_next(sb, !sag_any, indent + 1, pretty, false);");
    body.push("    sag_any = true;");
    body.push(`    sag_debug_${debug_position(all, key_ty).unwrap_or(0)}(sb, sag_e.u.v1.f0.f0, indent + 1, pretty);`);
    body.push("    sag_sb_push_bytes(sb, \": \", 2);");
    body.push(`    sag_debug_${debug_position(all, value_ty).unwrap_or(0)}(sb, sag_e.u.v1.f0.f1, indent + 1, pretty);`);
    body.push("    if (pretty) {");
    body.push("      sag_sb_push_bytes(sb, \",\", 1);");
    body.push("    }");
    body.push("  }");
    body.push("  sag_debug_end(sb, sag_any, indent, pretty, false, \"}\");");
  }

  /// `{1, 2}`: the keys of the map of a `HashSet`, in order, as Rust's derived `Debug` writes a set
  /// (docs/adr/0095-collections.md, Q652).
  prv fn debug_set(self, program: Program, class_ref: NamedRef, all: List<Type>, body: List<String>) {
    const set_index = self.class_index(class_ref);
    const set = match self.classes.get(set_index) {
      Some(found) => found,
      None => return,
    };
    var map_field = 0usize;

    for field in 0..set.field_names.len() {
      if set.field_names[field] == "map" {
        map_field = field;
      }
    }

    const map_ref = match set.fields.get(map_field) {
      Some(found) => match found.kind {
        TypeKind::Class(named) => named,
        _ => return,
      },
      None => return,
    };

    if !is_map(program, map_ref) {
      return;
    }

    const map_index = self.class_index(map_ref);
    const map = match self.classes.get(map_index) {
      Some(found) => found,
      None => return,
    };
    var items_field = 0usize;

    for field in 0..map.field_names.len() {
      if map.field_names[field] == "items" {
        items_field = field;
      }
    }

    const entry_ty = match map.fields.get(items_field) {
      Some(found) => match found.kind {
        TypeKind::List(elem) => elem,
        _ => return,
      },
      None => return,
    };
    const elem_ty = class_ref.args.get(0).unwrap_or(types::unit());
    const entry_type = self.c_type(entry_ty);

    body.push(`  sag_object *sag_map = ((sag_c${set_index} *)v)->f${map_field};`);
    body.push(`  sag_object *sag_items = ((sag_c${map_index} *)sag_map)->f${items_field};`);
    body.push("  size_t sag_n = sag_list_len(sag_items);");
    body.push("  bool sag_any = false;");
    body.push("  sag_sb_push_bytes(sb, \"{\", 1);");
    body.push("  for (size_t sag_k = 0; sag_k < sag_n; sag_k++) {");
    body.push("    " + entry_type + " sag_e = *(" + entry_type + " *)sag_list_at(sag_items, sag_k, __FILE__, __LINE__);");
    body.push("    if (sag_e.tag != 1u) {");
    body.push("      continue;");
    body.push("    }");
    body.push("    sag_debug_next(sb, !sag_any, indent + 1, pretty, false);");
    body.push("    sag_any = true;");
    body.push(`    sag_debug_${debug_position(all, elem_ty).unwrap_or(0)}(sb, sag_e.u.v1.f0.f0, indent + 1, pretty);`);
    body.push("    if (pretty) {");
    body.push("      sag_sb_push_bytes(sb, \",\", 1);");
    body.push("    }");
    body.push("  }");
    body.push("  sag_debug_end(sb, sag_any, indent, pretty, false, \"}\");");
  }

  /// `[1, 2]`: the elements of a `VecDeque` from the front, which start at the slot `head` of its
  /// ring and wrap around its end (docs/adr/0095-collections.md, Q652).
  prv fn debug_deque(self, class_ref: NamedRef, all: List<Type>, body: List<String>) {
    const index = self.class_index(class_ref);
    const instance = match self.classes.get(index) {
      Some(found) => found,
      None => return,
    };
    var buffer_field = 0usize;
    var head_field = 0usize;
    var count_field = 0usize;

    for field in 0..instance.field_names.len() {
      const name = instance.field_names[field];

      if name == "buffer" {
        buffer_field = field;
      } else if name == "head" {
        head_field = field;
      } else if name == "count" {
        count_field = field;
      }
    }

    const slot_ty = match instance.fields.get(buffer_field) {
      Some(found) => match found.kind {
        TypeKind::List(elem) => elem,
        _ => return,
      },
      None => return,
    };
    const elem_ty = class_ref.args.get(0).unwrap_or(types::unit());
    const slot_type = self.c_type(slot_ty);
    // An `Option` of a C function pointer is the pointer itself.
    const element = if pkg::sir::is_nullable_pointer(slot_ty) { "sag_e" } else { "sag_e.u.v1.f0" };

    body.push(`  sag_object *sag_buffer = ((sag_c${index} *)v)->f${buffer_field};`);
    body.push(`  size_t sag_head = ((sag_c${index} *)v)->f${head_field};`);
    body.push(`  size_t sag_n = ((sag_c${index} *)v)->f${count_field};`);
    body.push("  size_t sag_cap = sag_list_len(sag_buffer);");
    body.push("  sag_sb_push_bytes(sb, \"[\", 1);");
    body.push("  for (size_t sag_k = 0; sag_k < sag_n; sag_k++) {");
    body.push("    " + slot_type + " sag_e = *(" + slot_type + " *)sag_list_at(sag_buffer, (sag_head + sag_k) % sag_cap, __FILE__, __LINE__);");
    body.push("    sag_debug_next(sb, sag_k == 0, indent + 1, pretty, false);");
    body.push(`    sag_debug_${debug_position(all, elem_ty).unwrap_or(0)}(sb, ${element}, indent + 1, pretty);`);
    body.push("    if (pretty) {");
    body.push("      sag_sb_push_bytes(sb, \",\", 1);");
    body.push("    }");
    body.push("  }");
    body.push("  sag_debug_end(sb, sag_n > 0, indent, pretty, false, \"]\");");
  }

  /// `{1: 2}`, or `{1, 2}` without the values: the entries of the `BTreeMap` that `map` (C code)
  /// points to, in order, by a walk of its tree with a stack, whose steps alternate between the
  /// children and the keys of a node (docs/adr/0095-collections.md, Q652). A B-tree of nodes of 5
  /// keys at least never needs 64 levels.
  prv fn debug_btree(self, map_ref: NamedRef, map: String, with_values: bool, all: List<Type>, body: List<String>) {
    const map_index = self.class_index(map_ref);
    const instance = match self.classes.get(map_index) {
      Some(found) => found,
      None => return,
    };
    var root_field = 0usize;

    for field in 0..instance.field_names.len() {
      if instance.field_names[field] == "root" {
        root_field = field;
      }
    }

    const node_ref = match instance.fields.get(root_field) {
      Some(found) => match found.kind {
        TypeKind::Class(named) => named,
        _ => return,
      },
      None => return,
    };
    const node_index = self.class_index(node_ref);
    const node = match self.classes.get(node_index) {
      Some(found) => found,
      None => return,
    };
    var keys_field = 0usize;
    var values_field = 0usize;
    var children_field = 0usize;

    for field in 0..node.field_names.len() {
      const name = node.field_names[field];

      if name == "keys" {
        keys_field = field;
      } else if name == "values" {
        values_field = field;
      } else if name == "children" {
        children_field = field;
      }
    }

    const key_ty = map_ref.args.get(0).unwrap_or(types::unit());
    const value_ty = map_ref.args.get(1).unwrap_or(types::unit());
    const key_type = self.c_type(key_ty);
    const value_type = self.c_type(value_ty);
    const child_type = self.c_type(types::of(TypeKind::Class(node_ref)));
    const at = `((sag_c${node_index} *)sag_node)`;

    body.push(`  sag_object *sag_stack[64];`);
    body.push(`  size_t sag_step[64];`);
    body.push(`  int sag_depth = 0;`);
    body.push(`  bool sag_any = false;`);
    body.push(`  sag_stack[0] = ((sag_c${map_index} *)${map})->f${root_field};`);
    body.push(`  sag_step[0] = 0;`);
    body.push("  sag_sb_push_bytes(sb, \"{\", 1);");
    body.push("  while (sag_depth >= 0) {");
    body.push("    sag_object *sag_node = sag_stack[sag_depth];");
    body.push("    size_t sag_s = sag_step[sag_depth]++;");
    body.push(`    sag_object *sag_keys = ${at}->f${keys_field};`);
    body.push(`    sag_object *sag_children = ${at}->f${children_field};`);
    body.push("    size_t sag_nk = sag_list_len(sag_keys);");
    body.push("    if (sag_s > 2 * sag_nk) {");
    body.push("      sag_depth--;");
    body.push("      continue;");
    body.push("    }");
    body.push("    if (sag_s % 2 == 0) {");
    body.push("      if (sag_list_len(sag_children) > 0 && sag_depth < 63) {");
    body.push("        sag_depth++;");
    body.push("        sag_stack[sag_depth] = *(" + child_type + " *)sag_list_at(sag_children, sag_s / 2, __FILE__, __LINE__);");
    body.push("        sag_step[sag_depth] = 0;");
    body.push("      }");
    body.push("      continue;");
    body.push("    }");
    body.push("    " + key_type + " sag_key = *(" + key_type + " *)sag_list_at(sag_keys, sag_s / 2, __FILE__, __LINE__);");
    body.push("    sag_debug_next(sb, !sag_any, indent + 1, pretty, false);");
    body.push("    sag_any = true;");
    body.push(`    sag_debug_${debug_position(all, key_ty).unwrap_or(0)}(sb, sag_key, indent + 1, pretty);`);

    if with_values {
      body.push(`    ${value_type} sag_value = *(${value_type} *)sag_list_at(${at}->f${values_field}, sag_s / 2, __FILE__, __LINE__);`);
      body.push("    sag_sb_push_bytes(sb, \": \", 2);");
      body.push(`    sag_debug_${debug_position(all, value_ty).unwrap_or(0)}(sb, sag_value, indent + 1, pretty);`);
    }

    body.push("    if (pretty) {");
    body.push("      sag_sb_push_bytes(sb, \",\", 1);");
    body.push("    }");
    body.push("  }");
    body.push("  sag_debug_end(sb, sag_any, indent, pretty, false, \"}\");");
  }

  /// `[9, 4, 2]`: the elements of a `BinaryHeap` in the order of its list, as Rust's derived
  /// `Debug` writes it (docs/adr/0095-collections.md, Q652).
  prv fn debug_heap(self, class_ref: NamedRef, all: List<Type>, body: List<String>) {
    const index = self.class_index(class_ref);
    const instance = match self.classes.get(index) {
      Some(found) => found,
      None => return,
    };
    var items_field = 0usize;

    for field in 0..instance.field_names.len() {
      if instance.field_names[field] == "items" {
        items_field = field;
      }
    }

    const elem_ty = class_ref.args.get(0).unwrap_or(types::unit());
    const elem_type = self.c_type(elem_ty);

    body.push(`  sag_object *sag_items = ((sag_c${index} *)v)->f${items_field};`);
    body.push("  size_t sag_n = sag_list_len(sag_items);");
    body.push("  sag_sb_push_bytes(sb, \"[\", 1);");
    body.push("  for (size_t sag_k = 0; sag_k < sag_n; sag_k++) {");
    body.push("    " + elem_type + " sag_e = *(" + elem_type + " *)sag_list_at(sag_items, sag_k, __FILE__, __LINE__);");
    body.push("    sag_debug_next(sb, sag_k == 0, indent + 1, pretty, false);");
    body.push(`    sag_debug_${debug_position(all, elem_ty).unwrap_or(0)}(sb, sag_e, indent + 1, pretty);`);
    body.push("    if (pretty) {");
    body.push("      sag_sb_push_bytes(sb, \",\", 1);");
    body.push("    }");
    body.push("  }");
    body.push("  sag_debug_end(sb, sag_n > 0, indent, pretty, false, \"]\");");
  }

  /// The C `main`, which calls the program's `main`; a library has none.
  pub fn entry_point(self, program: Program) {
    const entry_id = match program.entry {
      Some(found) => found,
      None => return,
    };
    const entry = fn_name(entry_id);
    const entry_function = program.functions.get(entry_id as usize);
    var returns_result = false;

    if let Some(function) = entry_function {
      if let TypeKind::Result { .. } = function.ret.kind {
        returns_result = true;
      }
    }

    self.out.append("int main(int argc, char **argv) {\n");
    self.out.append("  sag_rt_init(argc, argv);\n");

    if returns_result {
      const function = entry_function.unwrap_or(program.functions[0]);
      const ty = self.c_type(function.ret);

      self.out.append("  " + ty + " result = " + entry + "();\n");
      self.out.append("  if (result.tag == 1) {\n");

      var error_ty: Option<Type> = None;

      if let TypeKind::Result { error, .. } = function.ret.kind {
        error_ty = Some(error);
      }

      var handled = false;

      if let Some(main_error) = program.main_error {
        if let Some(found_error) = error_ty {
          handled = true;

          // The message of an `Error`: its `message()`.
          const error = match main_error.itable {
            Some(itable) => `sag_todyn_${itable}(result.u.v1.f0)`,
            None => "result.u.v1.f0",
          };
          const method = itable_path("error.itable", main_error.path);

          self.out.append("    sag_dyn error = " + error + ";\n");
          self.out.append("    sag_string message = ((sag_string (*)(sag_dyn))(" + method + `->methods[${main_error.slot}]))(error);\n`);
          self.out.append("    sag_report_main_error(message);\n");
          self.out.append("    sag_string_release(message);\n");

          if main_error.itable.is_some() {
            self.out.append("    sag_dyn_release(error);\n");
          }

          self.out.append("    " + self.arc_call("release", found_error, "result.u.v1.f0") + ";\n");
        }
      }

      if !handled {
        self.out.append("    sag_report_main_error(result.u.v1.f0);\n");
        self.out.append("    sag_string_release(result.u.v1.f0);\n");
      }

      self.out.append("    int code = sag_rt_finish();\n");
      self.out.append("    return code != 0 ? code : 1;\n");
      self.out.append("  }\n");
    } else {
      self.out.append("  " + entry + "();\n");
    }

    self.out.append("  return sag_rt_finish();\n");
    self.out.append("}\n");
  }

  /// The storage of each `static` and `sag_static_N(file, line)`, which gives its address after
  /// computing its value on the first use (docs/adr/0083-global-state.md, Q527); a value the
  /// compiler computed is the start of the storage. The values are released at exit for the leak
  /// check only (Q532).
  pub fn statics(self, program: Program) {
    for index in 0..program.statics.len() {
      const def = program.statics[index];
      const ty = self.c_type(def.ty);
      const value = `sag_static_value_${index}`;
      const head = "static " + ty + " *" + static_getter(index as u32) + "(const char *file, int line) {\n";
      const managed = self.layouts.is_managed(def.ty);
      // One storage per thread (Q529).
      const storage = if def.thread_local { "static _Thread_local " } else { "static " };

      // C's own storage (docs/adr/0086-c-globals-and-std-io.md, Q562).
      if def.extern_c {
        const address = extern_static_getter(index as u32);

        self.out.append(ty + " *" + address + "(void);\n");
        self.out.append(head + "  (void)file;\n  (void)line;\n  return " + address + "();\n}\n\n");
        continue;
      }

      if let Some(start) = def.value {
        // Its later values must be released at exit, which needs the state.
        if !(def.mutable && managed) {
          self.out.append(storage + ty + " " + value + " = " + static_initializer(start) + ";\n");
          self.out.append(head + "  (void)file;\n  (void)line;\n  return &" + value + ";\n}\n\n");
          continue;
        }
      }

      const state = `sag_static_state_${index}`;
      var release = "NULL";

      self.out.append(storage + ty + " " + value + ";\n");

      if managed {
        release = `sag_static_release_${index}`;
        self.out.append("static void " + release + "(void) {\n  " + self.arc_call("release", def.ty, value) + ";\n}\n");
      }

      // Only its thread computes it: a stage alone, without locks.
      if def.thread_local {
        self.out.append("static _Thread_local int " + state + ";\n" + head);
        self.out.append("  if (" + state + " != 2 && sag_static_local_begin(&" + state + ", " + c_string_literal(def.name) + ", file, line)) {\n");
        self.out.append("    " + value + " = " + fn_name(def.init) + "();\n");
        self.out.append("    sag_static_local_end(&" + state + ", " + release + ");\n");
        self.out.append("  }\n");
        self.out.append("  return &" + value + ";\n}\n\n");
        continue;
      }

      self.out.append("static sag_static_state " + state + ";\n");
      self.out.append(head);
      self.out.append("  if (!sag_static_ready(&" + state + ") && sag_static_begin(&" + state + ", " + c_string_literal(def.name) + ", file, line)) {\n");
      self.out.append("    " + value + " = " + fn_name(def.init) + "();\n");
      self.out.append("    sag_static_end(&" + state + ", " + release + ");\n");
      self.out.append("  }\n");
      self.out.append("  return &" + value + ";\n}\n\n");
    }
  }

  /// `ret sag_ffi_N(params)`, the wrapper calling a C function.
  pub fn extern_prototype(self, index: usize, decl: ExternDecl) -> String {
    self.return_type(decl.ret) + " " + ffi_name(index) + "(" + self.c_params(decl.params) + ")"
  }

  prv fn return_type(self, ty: Type) -> String {
    match ty.kind {
      TypeKind::Unit | TypeKind::Never => "void",
      _ => self.c_type(ty),
    }
  }

  /// `T a0, U a1`, or `void`.
  prv fn c_params(self, params: List<Type>) -> String {
    if params.is_empty() {
      return "void";
    }

    const parts: List<String> = new List();

    for index in 0..params.len() {
      parts.push(self.c_type(params[index]) + ` a${index}`);
    }

    parts.join(", ")
  }

  /// A FFI translation unit: a wrapper per C function called and a getter per C global, of the
  /// standard library (`std`) or of the program, which also has a function with the exported
  /// symbol per `extern "C" fn`.
  pub fn ffi_unit(self, program: Program, std: bool) -> Option<String> {
    const exports: List<u32> = new List();

    if !std {
      for index in 0..program.functions.len() {
        if program.functions[index].export.is_some() {
          exports.push(index as u32);
        }
      }
    }

    const externs: List<usize> = new List();
    // `std::sys` declares the C API of the system, but a program only links what it calls: a
    // program without threads never needs `-pthread`, and one for iOS never asks for the
    // functions of `Command` (docs/adr/0087-atomic-storage-and-std-sync.md).
    const used = if std { used_externs(program) } else { new List<bool>() };

    for index in 0..program.externs.len() {
      if !program.externs[index].runtime && program.externs[index].in_std == std && (!std || used[index]) {
        externs.push(index);
      }
    }

    const globals: List<usize> = new List();

    for index in 0..program.statics.len() {
      if program.statics[index].extern_c && program.statics[index].in_std == std {
        globals.push(index);
      }
    }

    if externs.is_empty() && exports.is_empty() && globals.is_empty() {
      return None;
    }

    const declared: List<String> = new List();
    const defined: List<Type> = new List();

    for index in externs {
      const decl = program.externs[index];

      for ty in decl.params {
        self.ffi_types(ty, true, declared, defined);
      }

      self.ffi_types(decl.ret, true, declared, defined);
    }

    for id in exports {
      const function = program.functions[id as usize];

      for index in 0..function.param_count {
        if let Some(ty) = function.locals.get(index) {
          self.ffi_types(ty, true, declared, defined);
        }
      }

      self.ffi_types(function.ret, true, declared, defined);
    }

    for index in globals {
      self.ffi_types(program.statics[index].ty, true, declared, defined);
    }

    const out = new StringBuilder();

    // C function pointer types name the types of their signatures, which only need declaring.
    for pointer in self.fn_pointers {
      if let TypeKind::CFn { params, ret, .. } = pointer.kind {
        for param in params {
          self.ffi_types(param, false, declared, defined);
        }

        self.ffi_types(ret, false, declared, defined);
      }
    }

    out.append("/* Generated by sag: calls between the program and C. Do not edit. */\n");
    out.append("#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n");

    for name in declared {
      var keyword = "struct";

      for index in 0..self.layouts.structs.len() {
        if self.layouts.structs[index].is_union && name == `sag_s${index}` {
          keyword = "union";
        }
      }

      out.append("typedef " + keyword + " " + name + " " + name + ";\n");
    }

    out.append(self.fn_pointer_typedefs());

    for ty in defined {
      out.append(self.definition(ty));
    }

    for index in externs {
      const decl = program.externs[index];
      const args: List<String> = new List();

      for arg in 0..decl.params.len() {
        args.push(`a${arg}`);
      }

      const call = decl.symbol + "(" + args.join(", ") + ")";
      const body = match decl.ret.kind {
        TypeKind::Unit | TypeKind::Never => call + ";",
        _ => "return " + call + ";",
      };

      out.append("\nextern " + self.return_type(decl.ret) + " " + decl.symbol + "(" + self.c_params(decl.params) + ");\n");
      out.append(self.extern_prototype(index, decl) + " { " + body + " }\n");
    }

    for id in exports {
      const function = program.functions[id as usize];
      const params: List<Type> = new List();
      const args: List<String> = new List();

      for index in 0..function.param_count {
        if let Some(ty) = function.locals.get(index) {
          params.push(ty);
          args.push(`a${index}`);
        }
      }

      const call = fn_name(id) + "(" + args.join(", ") + ")";
      const body = match function.ret.kind {
        TypeKind::Unit | TypeKind::Never => call + ";",
        _ => "return " + call + ";",
      };

      out.append("\n" + self.signature(id, function) + ";\n");
      out.append(self.return_type(function.ret) + " " + function.export.unwrap_or("") + "(" + self.c_params(params) + ") { " + body + " }\n");
    }

    for index in globals {
      const def = program.statics[index];
      const ty = self.c_type(def.ty);

      out.append("\nextern " + ty + " " + def.name + ";\n");
      out.append(ty + " *" + extern_static_getter(index as u32) + "(void) { return &" + def.name + "; }\n");
    }

    Some(out.to_string())
  }

  /// Collects the aggregate types the FFI unit needs: declared when behind a pointer, also defined
  /// when passed by value.
  prv fn ffi_types(self, ty: Type, by_value: bool, declared: List<String>, defined: List<Type>) {
    // C function pointer types are all defined by `fn_pointer_typedefs`, and an enum with an
    // integer representation is its integer.
    if pkg::sir::is_nullable_pointer(ty) || self.layouts.enum_repr(ty).is_some() {
      return;
    }

    match ty.kind {
      TypeKind::Ptr { pointee, .. } | TypeKind::Ref { pointee, .. } => self.ffi_types(pointee, false, declared, defined),
      TypeKind::Struct(_) | TypeKind::Enum(_) | TypeKind::Array { .. } | TypeKind::Option(_) | TypeKind::Result { .. } => {
        const name = self.c_type(ty);

        if !declared.contains(name) {
          declared.push(name);
        }

        if by_value && !types::contains_type(defined, ty) {
          for part in self.flat_parts(ty) {
            self.ffi_types(part, true, declared, defined);
          }

          defined.push(ty);
        }
      }
      _ => {}
    }
  }

  prv fn line_directive(self, file: u32, line: u32) {
    const path = self.paths.get(file as usize).unwrap_or("\"?\"");

    self.out.append(`#line ${line} ` + path + "\n");
  }

  prv fn line(self, text: String) {
    // One statement may become several C lines; a runtime check reports `__LINE__`, so the source
    // line is restated right before it.
    if text.contains("__LINE__") {
      if let Some(position) = self.source_line {
        self.line_directive(position.file, position.line);
      }
    }

    for _ in 0..self.indent {
      self.out.append("  ");
    }

    self.out.append(text);
    self.out.append("\n");
  }

  /// The C type of a pointer to a method, to call one taken from a vtable.
  prv fn method_pointer(self, id: u32) -> String {
    const function = match self.functions.get(id as usize) {
      Some(found) => found,
      None => return "void (*)(void)",
    };
    const params: List<String> = new List();

    for index in 0..function.param_count {
      if let Some(ty) = function.locals.get(index) {
        // A lambda's first parameter is its environment.
        params.push(if index == 0 && function.closure { "sag_object *" } else { self.c_type(ty) });
      }
    }

    self.return_type(function.ret) + " (*)(" + params.join(", ") + ")"
  }

  pub fn signature(self, id: u32, function: Function) -> String {
    const params: List<String> = new List();

    for index in 0..function.param_count {
      const ty = match function.locals.get(index) {
        Some(found) => found,
        None => continue,
      };

      // A lambda's first parameter is its environment.
      if index == 0 && function.closure {
        params.push("sag_object *" + local_name(0));
        continue;
      }

      const pointer = if index == 0 && function.self_by_ref { " *" } else { " " };

      params.push(self.c_type(ty) + pointer + local_name(index as u32));
    }

    const param_text = if params.is_empty() { "void" } else { params.join(", ") };

    self.return_type(function.ret) + " " + fn_name(id) + "(" + param_text + ")"
  }

  pub fn function(self, id: u32, function: Function) {
    const signature = self.signature(id, function);

    self.locals = function.locals;
    self.self_by_ref = function.self_by_ref;
    self.function_id = id;
    self.frame = function.frame;

    if let Some(env) = function.frame {
      return self.frame_function(id, env, function, signature);
    }

    self.out.append(linkage(function) + signature + " {\n");
    self.indent = 1;

    for index in function.param_count..function.locals.len() {
      const ty = function.locals[index];
      const init = match ty.kind {
        TypeKind::String | TypeKind::Interface(_) | TypeKind::Function { .. } | TypeKind::Struct(_) | TypeKind::Enum(_) | TypeKind::Array { .. } | TypeKind::Option(_)
          | TypeKind::Result { .. } | TypeKind::Slice { .. } | TypeKind::Tuple(_) => "{0}",
        _ => "0",
      };

      self.line(self.c_type(ty) + " " + local_name(index as u32) + " = " + init + ";");
    }

    self.stmts(function.body);
    self.indent = 0;
    self.out.append("}\n\n");
  }

  /// The body of an `async fn` (docs/spec/12-async.md): its locals are fields of its frame
  /// `sag_f`, and it starts by jumping to where it was suspended. Before it, the function that
  /// releases what the frame owns where it is suspended, if the program ends first.
  prv fn frame_function(self, id: u32, env: usize, function: Function, signature: String) {
    const awaits: List<Stmt> = new List();

    collect_awaits(function.body, awaits);

    self.out.append(`static void sag_frame_drop${id}(sag_object *object) {\n`);
    self.out.append(`  sag_env${env} *sag_f = (sag_env${env} *)object;\n`);
    self.out.append("  switch (sag_f->state) {\n");

    for statement in awaits {
      if let Stmt::Await { state, live } = statement {
        self.out.append(`  case ${state}:\n`);

        for local in live {
          self.out.append("    " + self.arc_call("release", self.local_type(local), `sag_f->l${local}`) + ";\n");
        }

        self.out.append("    break;\n");
      }
    }

    self.out.append("  default:\n    break;\n  }\n}\n\n");
    self.out.append(linkage(function) + signature + " {\n");
    self.indent = 1;
    self.line(`sag_env${env} *sag_f = (sag_env${env} *)l0;`);
    self.line("sag_task_enter();");
    self.line("switch (sag_f->state) {");

    for statement in awaits {
      if let Stmt::Await { state, .. } = statement {
        self.line(`case ${state}:`);
        self.line("  sag_task_resumed(l0);");
        self.line(`  goto sag_resume${state};`);
      }
    }

    self.line("default:");
    self.line("  break;");
    self.line("}");
    self.stmts(function.body);
    self.indent = 0;
    self.out.append("}\n\n");
    self.frame = None;
  }

  /// The fields of a frame after its captures: the state, the locals of the body of the
  /// `async fn` and the counters of its loops, which a `goto` into a loop must find.
  prv fn frame_fields(self, function: Function) -> String {
    const fields = new StringBuilder();

    fields.append(" uint32_t state;");

    for index in 1..function.locals.len() {
      fields.append(" " + self.c_type(function.locals[index]) + ` l${index};`);
    }

    const counters: List<String> = new List();

    collect_counters(function.body, counters);

    for counter in counters {
      fields.append(" " + counter + ";");
    }

    fields.to_string()
  }

  /// Loop counters of C type `c_ty` with their first values, as the start of a `for`. In the body
  /// of an `async fn` they are fields of the frame, only assigned.
  prv fn counters_init(self, c_ty: String, names: List<String>, values: List<String>) -> String {
    const parts: List<String> = new List();

    for index in 0..names.len() {
      parts.push(self.counter(names[index]) + " = " + values.get(index).unwrap_or("0"));
    }

    if self.frame.is_some() { parts.join(", ") } else { c_ty + " " + parts.join(", ") }
  }

  /// A loop counter: a field of the frame in the body of an `async fn`.
  prv fn counter(self, name: String) -> String {
    if self.frame.is_some() { "sag_f->" + name } else { name }
  }

  prv fn local_type(self, local: u32) -> Type {
    self.locals.get(local as usize).unwrap_or(types::error())
  }

  /// A local as an lvalue; the `var self` parameter is a pointer, and the locals of the body of an
  /// `async fn` are fields of its frame.
  prv fn local(self, local: u32) -> String {
    if self.frame.is_some() && local > 0 {
      return `sag_f->l${local}`;
    }

    if self.self_by_ref && local == 0 { "(*l0)" } else { local_name(local) }
  }

  prv fn place(self, place: Place) -> String {
    var out = self.local(place.local);

    for projection in place.projections {
      match projection {
        Projection::Field(index) => {
          out = out + `.f${index}`;
        }
        Projection::ClassField { class_id, index } => {
          out = `((sag_c${class_id} *)` + out + `)->f${index}`;
        }
        Projection::EnvField { env, index } => {
          out = `((sag_env${env} *)` + out + `)->c${index}`;
        }
        Projection::Index { index, len } => {
          out = out + ".data[sag_index_at(" + self.operand(index) + `, ${len}, __FILE__, __LINE__)]`;
        }
        Projection::ListElem { index, elem } => {
          const elem_type = self.c_type(elem);

          out = "(*(" + elem_type + " *)sag_list_at_sized(" + out + ", " + self.operand(index) + ", sizeof(" + elem_type + "), __FILE__, __LINE__))";
        }
        Projection::Tag => {
          out = out + ".tag";
        }
        Projection::NonNull => {
          out = "(" + out + " != NULL ? 1u : 0u)";
        }
        Projection::EnumIndex(id) => {
          out = `sag_e${id}_index(` + out + ", __FILE__, __LINE__)";
        }
        Projection::VariantField { variant, field } => {
          out = out + `.u.v${variant}.f${field}`;
        }
        Projection::Deref => {
          out = "(*SAG_CHECK_PTR(" + out + ", __FILE__, __LINE__))";
        }
        Projection::Borrowed => {
          out = "(*" + out + ")";
        }
        Projection::SliceElem { index, elem } => {
          const elem_type = self.c_type(elem);

          out = "(*(" + elem_type + " *)sag_slice_at(" + out + ", " + self.operand(index) + ", sizeof(" + elem_type + "), __FILE__, __LINE__))";
        }
      }
    }

    out
  }

  prv fn operand(self, operand: Operand) -> String {
    match operand {
      Operand::Local(target) => self.local(target),
      Operand::Place(place) => self.place(place),
      Operand::Ref(place) => "(&" + self.place(place) + ")",
      Operand::Const(value) => {
        if let Const::Str(text) = value {
          if text.len() > MAX_LITERAL {
            return self.long_string(text);
          }
        }

        constant(value)
      }
    }
  }

  /// A string too long for a literal, as a static array of its bytes.
  prv fn long_string(self, value: String) -> String {
    var index = 0usize;

    match self.long_string_keys.get(value) {
      Some(found) => {
        index = found;
      }
      None => {
        index = self.long_strings.len();
        self.long_strings.push(value);
        self.long_string_keys.insert(value, index);
      }
    }

    `sag_string_from_static((const char *)sag_text_${index}, ${value.len()})`
  }

  /// The arrays of `long_string`, which the functions using them follow.
  pub fn long_string_definitions(self) -> String {
    const out = new StringBuilder();

    for index in 0..self.long_strings.len() {
      out.append(`static const unsigned char sag_text_${index}[] = {`);

      var position = 0usize;

      for byte in self.long_strings[index].bytes() {
        out.append(if position % 24 == 0 { "\n  " } else { " " });
        out.append(`${byte},`);
        position += 1;
      }

      out.append("\n};\n");
    }

    if !out.is_empty() {
      out.append("\n");
    }

    out.to_string()
  }

  prv fn operand_type(self, operand: Operand) -> Type {
    match operand {
      Operand::Local(local) => self.local_type(local),
      Operand::Place(place) => place.ty,
      Operand::Ref(place) => place.ty,
      Operand::Const(Const::Str(_)) => types::string(),
      Operand::Const(_) => types::unit(),
    }
  }

  prv fn stmts(self, body: List<Stmt>) {
    for statement in body {
      self.stmt(statement);
    }
  }

  prv fn block(self, header: String, body: List<Stmt>) {
    self.line(header + " {");
    self.indent += 1;
    self.stmts(body);
    self.indent -= 1;
    self.line("}");
  }

  prv fn stmt(self, statement: Stmt) {
    match statement {
      Stmt::If { cond, then_body, else_body } => self.if_stmt(cond, then_body, else_body),
      Stmt::Loop(body) => self.block("for (;;)", body),
      Stmt::ForRange { variable, ty, start, end, inclusive, reverse, step, body } => self.for_range(variable, ty, start, end, inclusive, reverse, step, body),
      Stmt::ForArray { variable, array, len, body } => self.for_array(variable, array, len, body),
      Stmt::ForText { variable, text, bytes, body } => self.for_text(variable, text, bytes, body),
      _ => self.simple_stmt(statement),
    }
  }

  /// A statement that holds no statements.
  prv fn simple_stmt(self, statement: Stmt) {
    match statement {
      // `#line` must start at column 0 to stay readable; C ignores the indentation anyway.
      Stmt::Line { file, line } => {
        self.source_line = Some(SourceLine { file: file, line: line });
        self.line_directive(file, line);
      }
      Stmt::Assign { dest, value } => self.assign(self.local(dest), self.local_type(dest), value),
      Stmt::AssignPlace { dest, value } => self.assign(self.place(dest), dest.ty, value),
      Stmt::Eval(value) => self.line(self.rvalue(value, types::unit()) + ";"),
      Stmt::Retain(value) => self.line(self.arc_call("retain", self.operand_type(value), self.operand(value)) + ";"),
      Stmt::Release(target) => self.line(self.arc_call("release", self.local_type(target), self.local(target)) + ";"),
      Stmt::ReleasePlace(target) => self.line(self.arc_call("release", target.ty, self.place(target)) + ";"),
      Stmt::Reset(target) => {
        const ty = self.local_type(target);
        const value = if types::is_string(ty) { "sag_string_empty()" } else { "(" + self.c_type(ty) + "){0}" };

        self.line(self.local(target) + " = " + value + ";");
      }
      Stmt::ListPush { list, value } => {
        self.line("*(" + self.list_elem(list) + " *)sag_list_push(" + self.operand(list) + ") = " + self.operand(value) + ";");
      }
      Stmt::ListInsert { list, index, value } => {
        self.line("*(" + self.list_elem(list) + " *)sag_list_insert(" + self.operand(list) + ", " + self.operand(index) + ", __FILE__, __LINE__) = " + self.operand(value) + ";");
      }
      Stmt::ListClear(list) => self.line("sag_list_clear(" + self.operand(list) + ");"),
      Stmt::ListReverse(list) => self.line("sag_list_reverse(" + self.operand(list) + ");"),
      Stmt::WeakStore { dest, value } => {
        const dest_text = self.place(dest);
        const value_text = self.operand(value);

        self.line("sag_object_weak_set(&" + dest_text + ", " + value_text + ".tag == 1u ? " + value_text + ".u.v1.f0 : NULL);");
      }
      Stmt::SetVtable { object, class_id } => self.line(self.local(object) + "->vtable = " + self.vtable(class_id) + ";"),
      Stmt::Break => self.line("break;"),
      Stmt::Continue => self.line("continue;"),
      Stmt::Return(value) => match value {
        Some(found) => self.line("return " + self.operand(found) + ";"),
        None => {
          if self.frame.is_some() {
            self.line("sag_task_leave();");
          }

          self.line("return;");
        }
      },
      Stmt::Await { state, .. } => {
        self.line(`sag_f->state = ${state};`);
        self.line(`sag_task_suspended(l0, sag_frame_drop${self.function_id});`);
        self.line("sag_task_leave();");
        self.line("return;");
      }
      Stmt::Resumed(state) => self.line(`sag_resume${state}:;`),
      Stmt::Panic(PanicMessage::Static(message)) => self.line("sag_panic_at(" + c_string_literal(message) + ", __FILE__, __LINE__);"),
      Stmt::Panic(PanicMessage::Value(message)) => self.line("sag_panic_str_at(" + self.operand(message) + ", __FILE__, __LINE__);"),
      _ => {}
    }
  }

  prv fn if_stmt(self, cond: Operand, then_body: List<Stmt>, else_body: List<Stmt>) {
    self.block("if (" + self.operand(cond) + ")", then_body);

    if !else_body.is_empty() {
      self.block("else", else_body);
    }
  }

  prv fn for_range(self, variable: u32, ty: IntTy, start: Operand, end: Operand, inclusive: bool, reverse: bool, step: Option<Operand>, body: List<Stmt>) {
    if reverse || step.is_some() {
      return self.for_range_stepped(variable, ty, start, end, inclusive, reverse, step, body);
    }

    const c_ty = int_c_type(ty);
    const counter = self.counter(`sag_i${variable}`);
    const start_text = self.operand(start);
    const end_text = self.operand(end);
    // A `continue` jumps to the increment, which must never step past `end`, so the closed
    // form tracks completion in a separate flag.
    var header = "";

    if inclusive {
      const done = self.counter(`sag_done${variable}`);
      const init = self.counters_init(c_ty, List::from([`sag_i${variable}`, `sag_done${variable}`]), List::from([start_text, `(${c_ty})(${start_text} > ${end_text})`]));

      header = `for (${init}; ${done} == 0; ${done} = (${c_ty})(${counter} == ${end_text}), ${counter} = ${done} ? ${counter} : (${c_ty})(${counter} + 1))`;
    } else {
      const init = self.counters_init(c_ty, List::from([`sag_i${variable}`]), List::from([start_text]));

      header = `for (${init}; ${counter} < ${end_text}; ${counter} = (${c_ty})(${counter} + 1))`;
    }

    self.line(header + " {");
    self.indent += 1;
    self.line(self.local(variable) + " = " + counter + ";");
    self.stmts(body);
    self.indent -= 1;
    self.line("}");
  }

  prv fn for_array(self, variable: u32, array: u32, len: u64, body: List<Stmt>) {
    const counter = self.counter(`sag_i${variable}`);
    const init = self.counters_init("size_t", List::from([`sag_i${variable}`]), List::from(["0"]));

    self.line("for (" + init + "; " + counter + ` < ${len}; ` + counter + "++) {");
    self.indent += 1;
    self.line(self.local(variable) + " = " + self.local(array) + ".data[" + counter + "];");
    self.stmts(body);
    self.indent -= 1;
    self.line("}");
  }

  prv fn for_text(self, variable: u32, text: u32, bytes: bool, body: List<Stmt>) {
    const counter = self.counter(`sag_i${variable}`);
    const init = self.counters_init("size_t", List::from([`sag_i${variable}`]), List::from(["0"]));
    const text_name = self.local(text);
    const variable_name = self.local(variable);

    // `sag_utf8_next` advances the index, so `continue` needs no increment step.
    if bytes {
      self.line("for (" + init + "; " + counter + " < " + text_name + ".len; " + counter + "++) {");
      self.indent += 1;
      self.line(variable_name + " = " + text_name + ".ptr[" + counter + "];");
    } else {
      self.line("for (" + init + "; " + counter + " < " + text_name + ".len;) {");
      self.indent += 1;
      self.line(variable_name + " = sag_utf8_next(" + text_name + ", &" + counter + ");");
    }

    self.stmts(body);
    self.indent -= 1;
    self.line("}");
  }

  /// `dest = value;` where `dest` is an lvalue of type `ty`.
  prv fn assign(self, dest: String, ty: Type, value: Rvalue) {
    match value {
      Rvalue::Template(pieces) => self.template(dest, pieces),
      Rvalue::ResumeFn => {
        self.line(dest + " = (sag_fnval){(sag_method)" + fn_name(self.function_id) + ", l0};");
        self.line("sag_object_retain(l0);");
      }
      Rvalue::Closure { function, env, captures } => {
        const env_index = match env {
          Some(found) => found,
          None => return self.line(dest + " = " + self.rvalue(value, ty) + ";"),
        };
        const env_types = self.envs.get(env_index).unwrap_or(new List());

        self.line("{");
        self.indent += 1;
        self.line(`sag_env${env_index} *sag_closure = sag_object_alloc(sizeof(sag_env${env_index}));`);

        // A frame starts in its first state, without values.
        if self.frame_functions.contains_key(env_index) {
          self.line(`*sag_closure = (sag_env${env_index}){0};`);
        }

        var index = 0usize;

        while index < captures.len() && index < env_types.len() {
          self.line(`sag_closure->c${index} = ` + self.operand(captures[index]) + ";");

          if self.layouts.is_managed(env_types[index]) {
            self.line(self.arc_call("retain", env_types[index], `sag_closure->c${index}`) + ";");
          }

          index += 1;
        }

        self.line(`sag_object_init((sag_object *)sag_closure, sag_drop_env${env_index}, NULL);`);
        self.line(dest + " = (sag_fnval){(sag_method)" + fn_name(function) + ", (sag_object *)sag_closure};");
        self.indent -= 1;
        self.line("}");
      }
      Rvalue::DynUpcast { value: source, path } => {
        const value_text = self.operand(source);
        const itable = itable_path(value_text + ".itable", path);

        self.line(dest + " = (sag_dyn){" + value_text + ".object, " + itable + "};");
        self.line("sag_object_retain(" + dest + ".object);");
      }
      Rvalue::WeakLoad(source) => {
        const source_text = self.place(source);
        const c_type = self.c_type(ty);

        self.line("{");
        self.indent += 1;
        self.line("sag_object *sag_strong = sag_object_upgrade(" + source_text + ");");
        self.line(dest + " = sag_strong != NULL ? (" + c_type + "){.tag = 1u, .u.v1 = {sag_strong}} : (" + c_type + "){.tag = 0u};");
        self.indent -= 1;
        self.line("}");
      }
      Rvalue::Repeat(element) => {
        var elem_ty = types::error();
        var len = 0u64;

        match ty.kind {
          TypeKind::Array { elem, len: found_len } => {
            elem_ty = elem;
            len = found_len;
          }
          _ => return,
        }

        const element_text = self.operand(element);
        const managed = self.layouts.is_managed(elem_ty);

        self.line(`for (size_t sag_k = 0; sag_k < ${len}; sag_k++) {`);
        self.indent += 1;
        self.line(dest + ".data[sag_k] = " + element_text + ";");

        if managed {
          self.line(self.arc_call("retain", elem_ty, dest + ".data[sag_k]") + ";");
        }

        self.indent -= 1;
        self.line("}");
      }
      _ => self.line(dest + " = " + self.rvalue(value, ty) + ";"),
    }
  }

  prv fn operands(self, args: List<Operand>) -> List<String> {
    const result: List<String> = new List();

    for arg in args {
      result.push(self.operand(arg));
    }

    result
  }

  /// An rvalue stored into a destination of type `ty`.
  prv fn rvalue(self, value: Rvalue, ty: Type) -> String {
    match value {
      Rvalue::Use(operand) => self.operand(operand),
      Rvalue::Unary { op, ty: operand_ty, operand } => match op {
        // On an integer, every bit flipped (docs/adr/0088-bitwise-operators-and-integer-methods.md).
        UnaryOp::Not => match operand_ty.kind {
          TypeKind::Int(int_ty) => "((" + int_c_type(int_ty) + ")~" + self.operand(operand) + ")",
          _ => "(!" + self.operand(operand) + ")",
        },
        UnaryOp::Neg => match operand_ty.kind {
          TypeKind::Int(int_ty) => "sag_neg_" + types::int_name(int_ty) + "_at(" + self.operand(operand) + ", __FILE__, __LINE__)",
          _ => "(-" + self.operand(operand) + ")",
        },
        // Dereferences are places; this form is not produced.
        UnaryOp::Deref => "(*" + self.operand(operand) + ")",
      },
      Rvalue::Binary { op, ty: operand_ty, lhs, rhs } => {
        // MSVC rejects dividing constants by zero, which C11 with IEEE 754 defines.
        if op == BinaryOp::Div {
          if let TypeKind::Float(float_ty) = operand_ty.kind {
            const both_constant = match lhs {
              Operand::Const(_) => match rhs {
                Operand::Const(_) => true,
                _ => false,
              },
              _ => false,
            };

            if both_constant {
              return "sag_div_" + types::float_name(float_ty) + "(" + self.operand(lhs) + ", " + self.operand(rhs) + ")";
            }
          }
        }

        binary(op, operand_ty, self.operand(lhs), self.operand(rhs))
      }
      Rvalue::Cast { from, to, operand } => {
        const text = self.operand(operand);

        match from.kind {
          TypeKind::Ptr { .. } | TypeKind::Ref { .. } => match to.kind {
            TypeKind::Ptr { .. } => return "((" + self.c_type(to) + ")" + text + ")",
            TypeKind::Int(int_ty) => return "((" + int_c_type(int_ty) + ")(uintptr_t)" + text + ")",
            TypeKind::CFn { .. } => return self.converted_fn_pointer(to) + "_from((void *)" + text + ", __FILE__, __LINE__)",
            _ => {}
          },
          TypeKind::Int(_) => {
            match to.kind {
              TypeKind::Ptr { .. } => return "((" + self.c_type(to) + ")(uintptr_t)" + text + ")",
              TypeKind::CFn { .. } => return self.converted_fn_pointer(to) + "_from((void *)(uintptr_t)" + text + ", __FILE__, __LINE__)",
              _ => {}
            }
          }
          TypeKind::CFn { .. } => match to.kind {
            TypeKind::CFn { .. } => return "((" + self.c_type(to) + ")" + text + ")",
            TypeKind::Ptr { .. } => return "((" + self.c_type(to) + ")" + self.converted_fn_pointer(from) + "_address(" + text + "))",
            TypeKind::Int(int_ty) => return "((" + int_c_type(int_ty) + ")(uintptr_t)" + self.converted_fn_pointer(from) + "_address(" + text + "))",
            _ => {}
          },
          _ => {}
        }

        cast(from, to, text)
      }
      Rvalue::Call { callee, args } => self.call(callee, args),
      Rvalue::Closure { function, .. } => "(sag_fnval){(sag_method)" + fn_name(function) + ", NULL}",
      Rvalue::FnValue(function) => `(sag_fnval){(sag_method)sag_wrap_${function}, NULL}`,
      Rvalue::CFnValue(function) => fn_name(function),
      Rvalue::SizeOf(measured) => "sizeof(" + self.c_type(measured) + ")",
      Rvalue::AlignOf(measured) => "_Alignof(" + self.c_type(measured) + ")",
      Rvalue::Zeroed => self.zeroed(ty),
      Rvalue::UnionValue { field, value } => "(" + self.c_type(ty) + `){.f${field} = ` + self.operand(value) + "}",
      Rvalue::EnumValid { enum_id, operand } => `sag_e${enum_id}_valid(` + self.operand(operand) + ")",
      Rvalue::Slice { source, elem, range } => {
        const size = "sizeof(" + self.c_type(elem) + ")";
        const bounds = match range {
          Some(found) => "false, " + self.operand(found.start) + ", " + self.operand(found.end) + ", " + (if found.inclusive { "true" } else { "false" }),
          None => "true, 0, 0, false",
        };

        match source {
          SliceSource::Array { place, len } => `sag_slice_array((void *)${self.place(place)}.data, ${len}, ${size}, ${bounds}, __FILE__, __LINE__)`,
          SliceSource::List(list) => "sag_slice_list(" + self.operand(list) + ", " + bounds + ", __FILE__, __LINE__)",
          SliceSource::Slice(slice) => "sag_slice_sub(" + self.operand(slice) + ", " + size + ", " + bounds + ", __FILE__, __LINE__)",
        }
      }
      Rvalue::ExternFnValue(index) => ffi_name(index as usize),
      Rvalue::Aggregate(parts) => {
        const texts = self.operands(parts);
        const joined = if texts.is_empty() { "0" } else { texts.join(", ") };

        match ty.kind {
          TypeKind::Array { .. } => "(" + self.c_type(ty) + "){{" + joined + "}}",
          _ => "(" + self.c_type(ty) + "){" + joined + "}",
        }
      }
      Rvalue::Variant { index, fields } => {
        if let TypeKind::Enum(named) = ty.kind {
          if let Some(layout) = self.layouts.enums.get(named.id as usize) {
            if let Some(value) = layout.values.get(index as usize) {
              return constant(value);
            }
          }
        }

        // An `Option` of a C function pointer is the pointer, `NULL` for `None`.
        if pkg::sir::is_nullable_pointer(ty) {
          return if fields.is_empty() { "NULL" } else { self.operand(fields[0]) };
        }

        if fields.is_empty() {
          return "(" + self.c_type(ty) + `){.tag = ${index}u}`;
        }

        "(" + self.c_type(ty) + `){.tag = ${index}u, .u.v${index} = {` + self.operands(fields).join(", ") + "}}"
      }
      Rvalue::Alloc(class_id) => `sag_new_c${class_id}()`,
      Rvalue::ListNew => match ty.kind {
        TypeKind::List(elem) => "sag_list_new(sizeof(" + self.c_type(elem) + "), " + self.elem_release(elem) + ")",
        _ => "NULL",
      },
      Rvalue::ListFromArray { array, array_ty } => match array_ty.kind {
        TypeKind::Array { elem, len } => "sag_list_from(sizeof(" + self.c_type(elem) + "), " + self.elem_release(elem) + ", " + self.operand(array) + `.data, ${len})`,
        _ => "NULL",
      },
      Rvalue::ListLen(list) => "sag_list_len(" + self.operand(list) + ")",
      Rvalue::ListPop(list) => "(*(" + self.c_type(ty) + " *)sag_list_pop(" + self.operand(list) + "))",
      Rvalue::ListRemove { list, index } => "(*(" + self.c_type(ty) + " *)sag_list_remove(" + self.operand(list) + ", " + self.operand(index) + ", __FILE__, __LINE__))",
      Rvalue::ToDyn { value: source, itable } => `sag_todyn_${itable}(` + self.operand(source) + ")",
      // Templates, repeats, weak loads and conversions between interfaces are emitted as
      // statements by `assign`.
      _ => "0",
    }
  }

  prv fn call(self, callee: Callee, args: List<Operand>) -> String {
    const texts = self.operands(args);

    match callee {
      Callee::Dyn { path, slot, params, ret } => {
        const receiver = texts.first().unwrap_or("");
        const itable = itable_path(receiver + ".itable", path);
        const param_types = List::from(["sag_dyn"]);

        for param in params {
          param_types.push(self.c_type(param));
        }

        "((" + self.return_type(ret) + " (*)(" + param_types.join(", ") + "))(" + itable + `->methods[${slot}]))(` + texts.join(", ") + ")"
      }
      Callee::Closure { params, ret } => {
        const function_value = texts.first().unwrap_or("");
        const param_types = List::from(["sag_object *"]);

        for param in params {
          param_types.push(self.c_type(param));
        }

        const rest = List::from([function_value + ".env"]);

        for index in 1..texts.len() {
          rest.push(texts[index]);
        }

        "((" + self.return_type(ret) + " (*)(" + param_types.join(", ") + "))(" + function_value + ".fn))(" + rest.join(", ") + ")"
      }
      Callee::Virtual { slot, function } => {
        const receiver = texts.first().unwrap_or("");

        "((" + self.method_pointer(function) + ")(" + receiver + `->vtable[${slot}]))(` + texts.join(", ") + ")"
      }
      Callee::Pointer { .. } => {
        const pointer = texts.first().unwrap_or("");
        const rest: List<String> = new List();

        for index in 1..texts.len() {
          rest.push(texts[index]);
        }

        "(" + pointer + ")(" + rest.join(", ") + ")"
      }
      _ => {
        // Runtime functions that can panic report the source location.
        const located = match callee {
          Callee::Runtime { located, .. } => located,
          Callee::Builtin(name) => name == "panic" || name == "string_from_c",
          _ => false,
        };

        if located {
          texts.push("__FILE__");
          texts.push("__LINE__");
        }

        var name = callee_name(callee);

        if let Callee::Extern(id) = callee {
          if let Some(decl) = self.externs.get(id as usize) {
            if decl.runtime {
              name = decl.symbol;
            }
          }
        }

        name + "(" + texts.join(", ") + ")"
      }
    }
  }

  prv fn template(self, dest: String, pieces: List<TemplatePiece>) {
    self.line("{");
    self.indent += 1;
    self.line("sag_sb sag_template;");
    self.line("sag_sb_init(&sag_template);");

    for piece in pieces {
      match piece {
        TemplatePiece::Text(text) => {
          self.line("sag_sb_push_bytes(&sag_template, " + c_string_literal(text) + `, ${text.len()});`);
        }
        TemplatePiece::Value { ty, value } => {
          const text = self.operand(value);
          // Diverging, erroneous or non-interpolable parts never reach code generation.
          const push = match ty.kind {
            TypeKind::Int(int_ty) => if types::is_signed(int_ty) { "sag_sb_push_i64(&sag_template, (int64_t)(" + text + "))" } else { "sag_sb_push_u64(&sag_template, (uint64_t)(" + text + "))" },
            TypeKind::Float(FloatTy::F32) => "sag_sb_push_f32(&sag_template, " + text + ")",
            TypeKind::Float(FloatTy::F64) => "sag_sb_push_f64(&sag_template, " + text + ")",
            TypeKind::Bool => "sag_sb_push_bool(&sag_template, " + text + ")",
            TypeKind::Char => "sag_sb_push_char(&sag_template, " + text + ")",
            TypeKind::String => "sag_sb_push_str(&sag_template, " + text + ")",
            _ => "",
          };

          if !push.is_empty() {
            self.line(push + ";");
          }
        }
      }
    }

    self.line(dest + " = sag_sb_finish(&sag_template);");
    self.indent -= 1;
    self.line("}");
  }
}

fn binary(op: BinaryOp, ty: Type, lhs: String, rhs: String) -> String {
  var helper = "";

  if op == BinaryOp::Add {
    helper = "add";
  } else if op == BinaryOp::Sub {
    helper = "sub";
  } else if op == BinaryOp::Mul {
    helper = "mul";
  } else if op == BinaryOp::Div {
    helper = "div";
  } else if op == BinaryOp::Rem {
    helper = "rem";
  } else if op == BinaryOp::Shl {
    helper = "shl";
  } else if op == BinaryOp::Shr {
    helper = "shr";
  } else if op == BinaryOp::BitAnd || op == BinaryOp::BitOr || op == BinaryOp::BitXor {
    // Defined on every value; the cast undoes C's promotion to `int`.
    const c_ty = match ty.kind {
      TypeKind::Int(int_ty) => int_c_type(int_ty),
      _ => "bool",
    };

    return "((" + c_ty + ")(" + lhs + " " + ast::binary_symbol(op) + " " + rhs + "))";
  } else {
    // Comparisons are defined for every operand value; `&&`/`||` never reach here.
    return "(" + lhs + " " + ast::binary_symbol(op) + " " + rhs + ")";
  }

  match ty.kind {
    TypeKind::Int(int_ty) => `sag_${helper}_${types::int_name(int_ty)}_at(${lhs}, ${rhs}, __FILE__, __LINE__)`,
    TypeKind::Float(FloatTy::F32) => if op == BinaryOp::Rem { "fmodf(" + lhs + ", " + rhs + ")" } else { "(" + lhs + " " + ast::binary_symbol(op) + " " + rhs + ")" },
    TypeKind::Float(FloatTy::F64) => if op == BinaryOp::Rem { "fmod(" + lhs + ", " + rhs + ")" } else { "(" + lhs + " " + ast::binary_symbol(op) + " " + rhs + ")" },
    _ => "(" + lhs + " " + ast::binary_symbol(op) + " " + rhs + ")",
  }
}

/// `as` conversions (docs/spec/02-types.md#conversions); only between primitive types.
fn cast(from: Type, to: Type, value: String) -> String {
  if types::same_type(from, to) {
    return value;
  }

  if let TypeKind::Float(_) = from.kind {
    match to.kind {
      TypeKind::Int(int_ty) => return "sag_f2i_" + types::int_name(int_ty) + "((double)(" + value + "))",
      TypeKind::Float(FloatTy::F32) => {
        if let TypeKind::Float(FloatTy::F64) = from.kind {
          return "sag_f64_to_f32(" + value + ")";
        }
      }
      _ => {}
    }
  }

  // Integer narrowing keeps the low bits; widening, int-to-float rounding and bool/char
  // conversions are exact C conversions.
  match to.kind {
    TypeKind::Int(int_ty) => "((" + int_c_type(int_ty) + ")" + value + ")",
    TypeKind::Float(FloatTy::F32) => "((float)" + value + ")",
    TypeKind::Float(FloatTy::F64) => "((double)" + value + ")",
    TypeKind::Char => "((uint32_t)" + value + ")",
    _ => value,
  }
}

/// The itable reached from `itable` through the parents at `path`.
fn itable_path(itable: String, path: List<usize>) -> String {
  var current = itable;

  for parent in path {
    current = current + `->parents[${parent}]`;
  }

  current
}

fn callee_name(callee: Callee) -> String {
  match callee {
    Callee::Fn(id) => fn_name(id),
    Callee::Virtual { function, .. } => fn_name(function),
    // Calls through itables, of function values and of C function pointers are generated by
    // `Generator::call`.
    Callee::Dyn { .. } | Callee::Closure { .. } | Callee::Pointer { .. } => "",
    Callee::Extern(id) => ffi_name(id as usize),
    Callee::Builtin(name) => {
      if name == "print" {
        "sag_print"
      } else if name == "println" {
        "sag_println"
      } else if name == "eprintln" {
        "sag_eprintln"
      } else if name == "panic" {
        "sag_panic_str_at"
      } else if name == "exit" {
        "sag_process_exit"
      } else if name == "abort" {
        "sag_process_abort"
      } else if name == "Atomic::fence" {
        "sag_atomic_thread_fence"
      } else if name == "string_from_c" {
        "sag_string_from_c_at"
      } else if name == "CString::new" {
        "sag_cstring_new"
      } else {
        // Lowered to a `MessageError` converted to `Error`, and to `Rvalue::ListFromArray`.
        ""
      }
    }
    Callee::Runtime { function, .. } => function,
  }
}

const HEX_DIGITS: String = "0123456789ABCDEF";

/// Uppercase hexadecimal digits of a value.
fn hex(value: u32) -> String {
  if value == 0 {
    return "0";
  }

  const digits = HEX_DIGITS.bytes().collect();
  const reversed: List<u8> = new List();
  var rest = value;

  while rest > 0 {
    reversed.push(digits[(rest % 16) as usize]);
    rest = rest / 16;
  }

  const out = new StringBuilder();
  var index = reversed.len();

  while index > 0 {
    index -= 1;
    out.append_char(reversed[index] as char);
  }

  out.to_string()
}

fn constant(value: Const) -> String {
  match value {
    Const::Unit => "0",
    Const::Bool(found) => `${found}`,
    Const::Char(found) => "((uint32_t)0x" + hex(found as u32) + "u)",
    Const::Int { magnitude, negative, ty } => {
      if !negative {
        return "((" + int_c_type(ty) + `)${magnitude}ull)`;
      }

      // `-(v - 1) - 1` avoids writing the positive magnitude of the minimum, which overflows.
      if magnitude == 0 {
        return "((" + int_c_type(ty) + ")0)";
      }

      "((" + int_c_type(ty) + `)(-(int64_t)${magnitude - 1}ll - 1))`
    }
    Const::Float { text, ty } => {
      // Infinities and NaN, from constants (docs/adr/0076), through the macros of <math.h>.
      const c_type = match ty {
        FloatTy::F32 => "float",
        FloatTy::F64 => "double",
      };

      if text == "inf" {
        return "((" + c_type + ")INFINITY)";
      }

      if text == "-inf" {
        return "(-(" + c_type + ")INFINITY)";
      }

      if text == "NaN" {
        return "((" + c_type + ")NAN)";
      }

      const literal = if text.contains(".") || text.contains("e") { text } else { text + ".0" };

      match ty {
        FloatTy::F32 => literal + "f",
        FloatTy::F64 => literal,
      }
    }
    Const::Str(text) => "sag_string_from_static(" + c_string_literal(text) + `, ${text.len()})`,
  }
}

/// A C string literal holding exactly the bytes of `text`. Anything outside printable ASCII
/// becomes a three-digit octal escape; `?` is escaped to avoid trigraphs.
/// A constant as the initializer of C storage: a string is a literal, which is never released.
fn static_initializer(value: Const) -> String {
  match value {
    Const::Str(text) => "{(const uint8_t *)" + c_string_literal(text) + `, ${text.len()}, NULL}`,
    _ => constant(value),
  }
}

fn c_string_literal(text: String) -> String {
  const out = new StringBuilder();

  out.append("\"");

  for byte in text.bytes() {
    if byte == 34 {
      out.append("\\\"");
    } else if byte == 92 {
      out.append("\\\\");
    } else if byte == 63 {
      out.append("\\?");
    } else if byte >= 32 && byte <= 126 {
      out.append_char(byte as char);
    } else {
      out.append("\\" + `${byte / 64}` + `${(byte / 8) % 8}` + `${byte % 8}`);
    }
  }

  out.append("\"");
  out.to_string()
}

/// The `Await` statements of the body of an `async fn`, in order.
fn collect_awaits(body: List<Stmt>, out: List<Stmt>) {
  for statement in body {
    match statement {
      Stmt::Await { .. } => out.push(statement),
      Stmt::If { then_body, else_body, .. } => {
        collect_awaits(then_body, out);
        collect_awaits(else_body, out);
      }
      Stmt::Loop(inner) | Stmt::ForRange { body: inner, .. } | Stmt::ForArray { body: inner, .. } | Stmt::ForText { body: inner, .. } => collect_awaits(inner, out),
      _ => {}
    }
  }
}

/// The declarations of the loop counters of `body`, named as `for_range`, `for_array` and
/// `for_text` name them.
fn collect_counters(body: List<Stmt>, out: List<String>) {
  for statement in body {
    match statement {
      Stmt::If { then_body, else_body, .. } => {
        collect_counters(then_body, out);
        collect_counters(else_body, out);
      }
      Stmt::Loop(inner) => collect_counters(inner, out),
      Stmt::ForRange { variable, ty, inclusive, reverse, step, body: inner, .. } => {
        if reverse || step.is_some() {
          out.push(`uintmax_t sag_o${variable}`);
          out.push(`uintmax_t sag_d${variable}`);
        } else {
          out.push(int_c_type(ty) + ` sag_i${variable}`);

          if inclusive {
            out.push(int_c_type(ty) + ` sag_done${variable}`);
          }
        }

        collect_counters(inner, out);
      }
      Stmt::ForArray { variable, body: inner, .. } | Stmt::ForText { variable, body: inner, .. } => {
        out.push(`size_t sag_i${variable}`);
        collect_counters(inner, out);
      }
      _ => {}
    }
  }
}

/// Whether a function of the program calls the C function `extern_id`.
/// The types `mem::size_of` and `mem::align_of` measure in `body`.
fn measured_types(body: List<Stmt>, out: List<Type>) {
  for statement in body {
    match statement {
      Stmt::Assign { value, .. } | Stmt::AssignPlace { value, .. } | Stmt::Eval(value) => match value {
        Rvalue::SizeOf(ty) | Rvalue::AlignOf(ty) => out.push(ty),
        _ => {}
      },
      Stmt::If { then_body, else_body, .. } => {
        measured_types(then_body, out);
        measured_types(else_body, out);
      }
      Stmt::Loop(inner) | Stmt::ForRange { body: inner, .. } | Stmt::ForArray { body: inner, .. } | Stmt::ForText { body: inner, .. } => measured_types(inner, out),
      _ => {}
    }
  }
}

/// Whether the program uses one of its `extern "C" fn`s as a C function pointer.
fn passes_c_callbacks(program: Program) -> bool {
  for function in program.functions {
    if !function.template && body_passes_c_callbacks(function.body) {
      return true;
    }
  }

  false
}

fn body_passes_c_callbacks(body: List<Stmt>) -> bool {
  for statement in body {
    const found = match statement {
      Stmt::Assign { value, .. } | Stmt::AssignPlace { value, .. } | Stmt::Eval(value) => match value {
        Rvalue::CFnValue(_) => true,
        _ => false,
      },
      Stmt::If { then_body, else_body, .. } => body_passes_c_callbacks(then_body) || body_passes_c_callbacks(else_body),
      Stmt::Loop(inner) | Stmt::ForRange { body: inner, .. } | Stmt::ForArray { body: inner, .. } | Stmt::ForText { body: inner, .. } => body_passes_c_callbacks(inner),
      _ => false,
    };

    if found {
      return true;
    }
  }

  false
}

/// Which C functions of the `extern` blocks the program's functions call or take as values.
fn used_externs(program: Program) -> List<bool> {
  const used: List<bool> = new List();

  for _ in 0..program.externs.len() {
    used.push(false);
  }

  for function in program.functions {
    if !function.template {
      mark_externs(function.body, used);
    }
  }

  used
}

fn mark_externs(body: List<Stmt>, used: List<bool>) {
  for statement in body {
    match statement {
      Stmt::Assign { value, .. } | Stmt::AssignPlace { value, .. } | Stmt::Eval(value) => match value {
        Rvalue::Call { callee: Callee::Extern(id), .. } | Rvalue::ExternFnValue(id) => {
          if (id as usize) < used.len() {
            used[id as usize] = true;
          }
        }
        _ => {}
      },
      Stmt::If { then_body, else_body, .. } => {
        mark_externs(then_body, used);
        mark_externs(else_body, used);
      }
      Stmt::Loop(inner) | Stmt::ForRange { body: inner, .. } | Stmt::ForArray { body: inner, .. } | Stmt::ForText { body: inner, .. } => mark_externs(inner, used),
      _ => {}
    }
  }
}

fn calls_extern(program: Program, extern_id: u32) -> bool {
  for function in program.functions {
    if !function.template && body_calls(function.body, (callee) => match callee {
      Callee::Extern(id) => id == extern_id,
      _ => false,
    }) {
      return true;
    }
  }

  false
}

/// Whether a function the program keeps calls the builtin `name`.
fn calls_builtin(program: Program, name: String) -> bool {
  for function in program.functions {
    if !function.template && body_calls(function.body, (callee) => match callee {
      Callee::Builtin(found) => found == name,
      _ => false,
    }) {
      return true;
    }
  }

  false
}

fn body_calls(body: List<Stmt>, wanted: fn(Callee) -> bool) -> bool {
  for statement in body {
    const found = match statement {
      Stmt::Assign { value, .. } | Stmt::AssignPlace { value, .. } | Stmt::Eval(value) => match value {
        Rvalue::Call { callee, .. } => wanted(callee),
        _ => false,
      },
      Stmt::If { then_body, else_body, .. } => body_calls(then_body, wanted) || body_calls(else_body, wanted),
      Stmt::Loop(inner) | Stmt::ForRange { body: inner, .. } | Stmt::ForArray { body: inner, .. } | Stmt::ForText { body: inner, .. } => body_calls(inner, wanted),
      _ => false,
    };

    if found {
      return true;
    }
  }

  false
}
