//! `sagc`: the Sagitario compiler written in Sagitario (F5, docs/roadmap.md). While it is being
//! ported it does what its passes allow: `sagc check
//! --dump=tokens|ast|resolve|declarations|types|c <file.sag>`, which prints the tokens or the
//! syntax tree of a file, or the resolution, the typed declarations, the types or the generated C
//! of a program, like `sag check --dump=...`
//! (docs/adr/0050-lexer-port-and-token-dumps.md, docs/adr/0051-parser-port-and-ast-dumps.md,
//! docs/adr/0052-resolver-port-and-resolution-dumps.md,
//! docs/adr/0053-type-checker-port-and-type-dumps.md,
//! docs/adr/0054-lowering-and-c-generation-port.md).

use pkg::ast::dump;
use pkg::codegen_c;
use pkg::diagnostics;
use pkg::diagnostics::{DiagnosticFormat, Diagnostics};
use pkg::lexer;
use pkg::loader::Loader;
use pkg::parser;
use pkg::resolve;
use pkg::sir;
use pkg::span::SourceMap;
use pkg::types;
use pkg::types::Stage;
use std::env;
use std::fs;
use std::path;
use std::process;

const USAGE: String = "Usage: sagc check --dump=tokens|ast|resolve|declarations|types|c [--diagnostic-format human|short] <file.sag>";

/// Exit code for an internal compiler error.
const EXIT_ICE: i32 = 101;

/// The line separating the two translation units in `--dump=c`.
const C_DUMP_FFI_MARKER: String = "/* ---- sag_ffi.c ---- */\n";

/// Exit code for invalid command-line usage.
const EXIT_USAGE: i32 = 2;

/// What the command line asks for.
class Options {
  pub var input: Option<String>;
  pub var dump: Option<String>;
  pub var format: DiagnosticFormat;

  pub fn new(self) {
    self.input = None;
    self.dump = None;
    self.format = DiagnosticFormat::Human;
  }
}

fn usage_error(message: String) -> i32 {
  eprintln(`error: ${message}`);
  eprintln("");
  eprintln(USAGE);
  EXIT_USAGE
}

/// `--flag=value` or `--flag value`: the value, taken from the next argument if needed.
fn flag_value(inline: Option<String>, args: List<String>, index: Position) -> Option<String> {
  match inline {
    Some(value) => Some(value),
    None => {
      index.value += 1;
      args.get(index.value)
    }
  }
}

/// The position of the argument being read.
class Position {
  pub var value: usize;

  pub fn new(self, value: usize) {
    self.value = value;
  }
}

fn parse(args: List<String>) -> Result<Options, String> {
  if args.len() < 2 {
    return Err("missing command");
  }

  if args[1] != "check" {
    return Err(`unknown command \`${args[1]}\``);
  }

  const options = new Options();
  const index = new Position(2);

  while index.value < args.len() {
    const arg = args[index.value];
    var flag = arg;
    var inline: Option<String> = None;

    if arg.starts_with("--") {
      if let Some(equals) = arg.find("=") {
        flag = arg.substring(0, equals);
        inline = Some(arg.substring(equals + 1, arg.len()));
      }
    }

    if flag == "--dump" {
      match flag_value(inline, args, index) {
        Some(value) if value == "tokens" || value == "ast" || value == "resolve" || value == "declarations" || value == "types" || value == "c" => {
          options.dump = Some(value);
        }
        Some(value) => return Err(`unknown dump \`${value}\`; expected \`tokens\`, \`ast\`, \`resolve\`, \`declarations\`, \`types\` or \`c\``),
        None => return Err("`--dump` requires a value"),
      }
    } else if flag == "--diagnostic-format" {
      match flag_value(inline, args, index) {
        Some(value) if value == "human" => {
          options.format = DiagnosticFormat::Human;
        }
        Some(value) if value == "short" => {
          options.format = DiagnosticFormat::Short;
        }
        Some(value) => return Err(`unknown diagnostic format \`${value}\`; expected \`human\` or \`short\``),
        None => return Err("`--diagnostic-format` requires a value"),
      }
    } else if flag.starts_with("-") {
      return Err(`unknown option \`${flag}\``);
    } else if options.input.is_some() {
      return Err(`unexpected argument \`${arg}\`; only one input file is accepted`);
    } else {
      options.input = Some(arg);
    }

    index.value += 1;
  }

  if options.input.is_none() {
    return Err("missing input file");
  }

  if options.dump.is_none() {
    return Err("only `check --dump=tokens|ast|resolve|declarations|types|c` is ported yet");
  }

  Ok(options)
}

fn plural(count: usize) -> String {
  if count == 1 { "" } else { "s" }
}

/// Colors only the human format, honoring `NO_COLOR`, when `CLICOLOR_FORCE` asks for them:
/// Sagitario cannot tell yet whether stderr is a terminal.
fn use_color(format: DiagnosticFormat) -> bool {
  if format == DiagnosticFormat::Short {
    return false;
  }

  if let Some(value) = env::variable("NO_COLOR") {
    if !value.is_empty() {
      return false;
    }
  }

  match env::variable("CLICOLOR_FORCE") {
    Some(value) => value != "0",
    None => false,
  }
}

/// Prints the diagnostics in source order, and a summary in the human format. Returns whether
/// any of them is an error.
fn report(diagnostics: Diagnostics, sources: SourceMap, format: DiagnosticFormat, input: String) -> bool {
  const errors = diagnostics.error_count();
  const warnings = diagnostics.warning_count();
  const color = use_color(format);

  for diagnostic in diagnostics.take() {
    eprintln(diagnostics::render(diagnostic, sources, format, color));
  }

  if format == DiagnosticFormat::Human {
    const warnings_text = `${warnings} warning${plural(warnings)}`;

    if errors > 0 {
      const also = if warnings > 0 { `; ${warnings_text} emitted` } else { "" };

      eprintln(`error: could not compile \`${input}\` due to ${errors} previous error${plural(errors)}${also}`);
    } else if warnings > 0 {
      eprintln(`warning: \`${input}\` generated ${warnings_text}`);
    }
  }

  errors > 0
}

/// `check --dump=...`: the tokens or the syntax tree of the input file alone, and its
/// diagnostics. A file with lexical errors is not parsed, as in a build.
fn dump_file(input: String, dump_kind: String, format: DiagnosticFormat) -> i32 {
  const text = match fs::read_to_string(input) {
    Ok(text) => text,
    Err(error) => {
      eprintln(`error: cannot read \`${input}\`: ${error.message()}`);
      return 1;
    }
  };
  const sources = new SourceMap();
  const diagnostics = new Diagnostics();
  const file = sources.add(input, text);
  const tokens = lexer::lex(file, text, diagnostics);

  if dump_kind == "tokens" {
    print(lexer::dump(tokens));
  } else if !diagnostics.has_errors() {
    print(dump::dump(parser::parse_module(file, tokens, diagnostics)));
  }

  if report(diagnostics, sources, format, input) { 1 } else { 0 }
}

/// `check --dump=resolve|declarations|types|c`: loads the program as a build does, resolves it and
/// prints the resolution, or type checks its declarations or all of it and prints the result, or
/// lowers it and prints the generated C. Lexical and syntax errors stop before resolving; type
/// errors stop before lowering.
fn dump_program(input: String, dump_kind: String, format: DiagnosticFormat) -> i32 {
  const is_sag = match path::extension(input) {
    Some(extension) => extension == "sag",
    None => false,
  };

  if !is_sag {
    eprintln(`error: \`${input}\` is not a \`.sag\` file`);
    return 1;
  }

  if !fs::is_file(input) {
    eprintln(`error: cannot find \`${input}\``);
    return 1;
  }

  const sources = new SourceMap();
  const diagnostics = new Diagnostics();
  const loader = new Loader(input);

  if !loader.load(input, new List(), sources, diagnostics) || !loader.load_references(sources, diagnostics) {
    return 1;
  }

  if report(diagnostics, sources, format, input) {
    return 1;
  }

  const prelude = loader.load_prelude(sources, diagnostics);

  if report(diagnostics, sources, format, input) {
    return 1;
  }

  const package = loader.package(prelude);
  const resolution = resolve::resolve(package, diagnostics);

  if dump_kind == "resolve" {
    print(resolve::dump::dump(resolution));
  } else if dump_kind == "c" {
    const typed = types::check_until(package, resolution, diagnostics, Stage::Bodies);

    if report(diagnostics, sources, format, input) {
      return 1;
    }

    const program = match sir::lower(package, resolution, typed, sources, diagnostics) {
      Ok(program) => program,
      Err(message) => {
        eprintln(`internal compiler error: ${message}`);
        return EXIT_ICE;
      }
    };

    // Generic code may instantiate itself endlessly, found while lowering.
    if report(diagnostics, sources, format, input) {
      return 1;
    }

    const generated = codegen_c::generate(program);

    print(generated.program);

    if let Some(ffi) = generated.ffi {
      print(C_DUMP_FFI_MARKER + ffi);
    }

    return 0;
  } else {
    const stage = if dump_kind == "types" { Stage::Bodies } else { Stage::Declarations };

    print(types::dump::dump(types::check_until(package, resolution, diagnostics, stage)));
  }

  if report(diagnostics, sources, format, input) { 1 } else { 0 }
}

pub fn main() {
  const options = match parse(env::args()) {
    Ok(options) => options,
    Err(message) => process::exit(usage_error(message)),
  };
  const input = options.input.unwrap_or("");
  const dump_kind = options.dump.unwrap_or("tokens");
  const code = if dump_kind == "tokens" || dump_kind == "ast" { dump_file(input, dump_kind, options.format) } else { dump_program(input, dump_kind, options.format) };

  if code != 0 {
    process::exit(code);
  }
}
