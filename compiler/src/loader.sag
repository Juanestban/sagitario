//! Reads, lexes and parses the modules of a program (docs/spec/09-modules.md), the port of the
//! loader of `sagitario_driver`: the entry file is the root module `pkg`, and `pkg::net::http` is
//! the file `net/http.sag` next to it. The standard library modules a program names and the
//! prelude are embedded. Each dependency of a Nova package is a package of its own, with its root
//! module and its files (docs/adr/0052-resolver-port-and-resolution-dumps.md,
//! docs/adr/0060-driver-parity-for-nova.md).

use pkg::ast::{Module, Package, PackageInfo, TargetInfo};
use pkg::diagnostics::{Diagnostic, Diagnostics};
use pkg::diagnostics::codes;
use pkg::lexer;
use pkg::parser;
use pkg::parser::Ids;
use pkg::resolve::modules;
use pkg::resolve::modules::ModuleRef;
use pkg::span::{SourceMap, Span};
use std::fs;
use std::path;

/// The part of the prelude written in Sagitario.
const PRELUDE: String = include_str("../std/prelude.sag");

/// The file of `std` itself: helpers shared by its modules, which programs cannot name.
const STD_ROOT: String = include_str("../std/mod.sag");

const STD_ENV: String = include_str("../std/env.sag");
const STD_FS: String = include_str("../std/fs.sag");
const STD_IO: String = include_str("../std/io.sag");
const STD_PATH: String = include_str("../std/path.sag");
const STD_PROCESS: String = include_str("../std/process.sag");
const STD_SYNC: String = include_str("../std/sync.sag");
const STD_TASK: String = include_str("../std/task.sag");
const STD_THREAD: String = include_str("../std/thread.sag");
const STD_TIME: String = include_str("../std/time.sag");

/// The source of the standard library module `std::name` written in Sagitario.
fn std_source(name: String) -> Option<String> {
  // Change this and use match for improve the design
  if name == "env" {
    Some(STD_ENV)
  } else if name == "fs" {
    Some(STD_FS)
  } else if name == "io" {
    Some(STD_IO)
  } else if name == "path" {
    Some(STD_PATH)
  } else if name == "process" {
    Some(STD_PROCESS)
  } else if name == "sync" {
    Some(STD_SYNC)
  } else if name == "task" {
    Some(STD_TASK)
  } else if name == "thread" {
    Some(STD_THREAD)
  } else if name == "time" {
    Some(STD_TIME)
  } else {
    None
  }
}

/// The integer types, each with a function `range_<type>` in the prelude.
const INT_TYPES: String = "i8 i16 i32 i64 isize u8 u16 u32 u64 usize";

/// `start..end` (or `..=`) outside of `for`, forwards or reversed, for integers of type `TYPE`:
/// the iterator a range is. Written line by line, so the text does not depend on the line
/// endings of this file.
fn range_template() -> String {
  const lines = List::from([
    "",
    "fn range_TYPE(start: TYPE, end: TYPE, inclusive: bool, reverse: bool) -> Iter<TYPE> {",
    "  const cursor = new Cell<TYPE>(if reverse { end } else { start });",
    "  const done = new Cell<bool>(false);",
    "",
    "  new Iter<TYPE>(() => {",
    "    if done.value {",
    "      return None;",
    "    }",
    "",
    "    const value = cursor.value;",
    "",
    "    if reverse {",
    "      if inclusive {",
    "        if value < start {",
    "          done.value = true;",
    "          return None;",
    "        }",
    "",
    "        if value == start { done.value = true; } else { cursor.value = value - 1; }",
    "        Some(value)",
    "      } else {",
    "        if value <= start {",
    "          done.value = true;",
    "          return None;",
    "        }",
    "",
    "        cursor.value = value - 1;",
    "        Some(value - 1)",
    "      }",
    "    } else if inclusive {",
    "      if value > end {",
    "        done.value = true;",
    "        return None;",
    "      }",
    "",
    "      if value == end { done.value = true; } else { cursor.value = value + 1; }",
    "      Some(value)",
    "    } else {",
    "      if value >= end {",
    "        done.value = true;",
    "        return None;",
    "      }",
    "",
    "      cursor.value = value + 1;",
    "      Some(value)",
    "    }",
    "  })",
    "}",
    "",
  ]);

  lines.join("\n")
}

/// The prelude's source: `prelude.sag` (or the text given in its place) followed by the range
/// functions.
fn prelude_source(prelude: String) -> String {
  const source = new StringBuilder();
  const template = range_template();

  source.append(prelude);

  for ty in INT_TYPES.split(" ") {
    source.append(template.replace("TYPE", ty));
  }

  source.to_string()
}

/// Whether paths use `\` as their separator, as Rust's `PathBuf::push` does on Windows: only
/// there does `std::path` treat `\` as a separator.
pub fn windows() -> bool {
  path::join("x\\", "y") == "x\\y"
}

/// Whether the compiler runs on Linux for ARM, where C's `char` is unsigned: only the kernel of
/// that system names the architecture of the processor in `/proc/cpuinfo`, as `CPU architecture`.
pub fn linux_on_arm() -> bool {
  match fs::read_to_string("/proc/cpuinfo") {
    Ok(text) => text.contains("CPU architecture"),
    Err(_) => false,
  }
}

/// `name` after `dir`, as Rust's `PathBuf::push` writes it: the driver builds module paths that
/// way, and the diagnostics of both compilers must name the same files.
pub fn push_path(dir: String, name: String) -> String {
  if dir.is_empty() {
    return name;
  }

  const separator = if windows() { "\\" } else { "/" };

  if dir.ends_with("/") || dir.ends_with(separator) {
    return dir + name;
  }

  dir + separator + name
}

/// A path in a form that names one file however it is written: `/` as the separator and, on
/// Windows, whose file names ignore case, in lowercase.
pub fn path_key(file: String) -> String {
  const slashes = file.replace("\\", "/");

  if windows() { slashes.to_ascii_lowercase() } else { slashes }
}

/// Whether `dir` has an entry with exactly this name that is a directory (or a file), also on
/// case-insensitive file systems.
fn has_entry(dir: String, name: String, directory: bool) -> bool {
  const base = if dir.is_empty() { "." } else { dir };
  const entries = match fs::read_dir(base) {
    Ok(entries) => entries,
    Err(_) => return false,
  };

  entries.contains(name) && fs::is_dir(push_path(base, name)) == directory
}

/// A package whose modules are loaded: the input's, or a dependency.
pub class LoadedPackage {
  /// The name its dependents use as a path root; empty for the input's.
  pub const name: String;
  /// The directory of its root module, which holds its other modules.
  pub const root: String;
  pub const entry: String;
  /// Indices in `Loader::packages` of its dependencies.
  pub const dependencies: List<usize>;

  pub fn new(self, name: String, entry: String, dependencies: List<usize>) {
    self.name = name;
    self.root = path::parent(entry).unwrap_or("");
    self.entry = entry;
    self.dependencies = dependencies;
  }
}

/// Where the file of a module is.
enum ModuleFile {
  File(String),
  /// `name.sag` next to a directory `name/`, which holds `mod.sag` when `merged`.
  Conflict { file: String, merged: bool },
  Missing,
}

pub class Loader {
  /// The input's package first, then its dependencies.
  pub const packages: List<LoadedPackage>;
  /// Keeps node ids unique across modules.
  prv const ids: Ids;
  pub const modules: List<Module>;
  /// Indices in `modules` of the standard library modules.
  pub const std: List<usize>;
  /// Texts that replace files on disk, by `path_key`: the documents open in an editor.
  pub var overrides: Map<String, String>;
  /// Texts that replace the embedded standard library, by module: `prelude`, `std` (the file of
  /// `std` itself) or the name of a module of `std`, for its sources open in an editor.
  pub var std_overrides: Map<String, String>;

  /// A loader for the program whose root module is `entry`, without dependencies until
  /// `add_dependency`.
  pub fn new(self, entry: String) {
    self.packages = List::from([new LoadedPackage("", entry, new List())]);
    self.ids = new Ids(0);
    self.modules = new List();
    self.std = new List();
    self.overrides = new Map<String, String>();
    self.std_overrides = new Map<String, String>();
  }

  /// Adds a package the input depends on, directly or not: package `index + 1` for dependency
  /// `index`. `dependencies` are the indices of its own dependencies among them.
  pub fn add_dependency(self, name: String, entry: String, dependencies: List<usize>) {
    const packages: List<usize> = new List();

    for index in dependencies {
      packages.push(index + 1);
    }

    self.packages.push(new LoadedPackage(name, entry, packages));
  }

  /// Sets the direct dependencies of the input's package, by their index among the dependencies.
  pub fn set_direct_dependencies(self, dependencies: List<usize>) {
    if let Some(input) = self.packages.first() {
      input.dependencies.clear();

      for index in dependencies {
        input.dependencies.push(index + 1);
      }
    }
  }

  /// Loads the root module of every package: the input's first.
  pub fn load_entries(self, sources: SourceMap, diagnostics: Diagnostics) -> bool {
    for package in 0..self.packages.len() {
      if !self.load(self.packages[package].entry, new List(), package, sources, diagnostics) {
        return false;
      }
    }

    true
  }

  /// Adds a module of `package` unless it has lexical errors, which are reported later with the
  /// others. Returns `false`, after printing why, if the file cannot be read.
  pub fn load(self, file: String, module_path: List<String>, package: usize, sources: SourceMap, diagnostics: Diagnostics) -> bool {
    const text = match self.overrides.get(path_key(file)) {
      Some(found) => found,
      None => match fs::read_to_string(file) {
        Ok(found) => found,
        Err(error) => {
          eprintln(`error: cannot read \`${file}\`: ${error.message()}`);
          return false;
        }
      },
    };
    const id = sources.add(file, text);
    const errors = diagnostics.error_count();
    const tokens = lexer::lex(id, text, diagnostics);

    if diagnostics.error_count() == errors {
      var module = parser::parse_module_from(id, tokens, self.ids, diagnostics);

      module.path = module_path;
      module.package = package;
      module.location = Some(file);
      self.modules.push(module);
    }

    true
  }

  /// Loads the modules the loaded ones refer to that exist as files, and the standard library
  /// modules they name, until no module names a new one.
  pub fn load_references(self, sources: SourceMap, diagnostics: Diagnostics) -> bool {
    const attempted = new Map<String, bool>();
    const attempted_std = new Map<String, bool>();
    var index = 0usize;

    while index < self.modules.len() {
      const module = self.modules[index];
      const package = module.package;
      const targets = if self.std.contains(index) { new List<ModuleRef>() } else { modules::module_references(module, self.dependency_names(package)) };

      for target in targets {
        const target_package = match target.dependency {
          None => Some(package),
          Some(name) => self.dependency(package, name),
        };
        const found = match target_package {
          Some(found) => found,
          None => continue,
        };
        const key = `${found}:` + target.path.join("::");

        if attempted.contains_key(key) {
          continue;
        }

        attempted.insert(key, true);

        match self.module_file(found, target.path) {
          ModuleFile::File(file) => {
            if !self.load(file, target.path, found, sources, diagnostics) {
              return false;
            }
          }
          ModuleFile::Conflict { file, merged } => {
            if !self.report_layout(found, target.path, file, merged, sources, diagnostics) {
              return false;
            }
          }
          ModuleFile::Missing => {}
        }
      }

      for name in modules::std_references(module) {
        if attempted_std.contains_key(name) {
          continue;
        }

        attempted_std.insert(name, true);

        if let Some(text) = std_source(name) {
          self.load_std(name, self.std_overrides.get(name).unwrap_or(text), sources, diagnostics);
        }
      }

      index += 1;
    }

    true
  }

  /// Adds the prelude module, which every program sees, and returns its index.
  pub fn load_prelude(self, sources: SourceMap, diagnostics: Diagnostics) -> usize {
    self.load_embedded("<prelude>", prelude_source(self.std_overrides.get("prelude").unwrap_or(PRELUDE)), List::from(["std", "prelude"]), sources, diagnostics)
  }

  /// Adds the standard library module `std::name`. The first one comes with the file of `std`
  /// itself.
  prv fn load_std(self, name: String, text: String, sources: SourceMap, diagnostics: Diagnostics) {
    if self.std.is_empty() {
      self.std.push(self.load_embedded("<std>", self.std_overrides.get("std").unwrap_or(STD_ROOT), List::from(["std"]), sources, diagnostics));
    }

    self.std.push(self.load_embedded(`<std::${name}>`, text, List::from(["std", name]), sources, diagnostics));
  }

  /// Adds a module whose source the compiler embeds, even with lexical errors.
  prv fn load_embedded(self, file: String, text: String, module_path: List<String>, sources: SourceMap, diagnostics: Diagnostics) -> usize {
    const id = sources.add(file, text);
    const tokens = lexer::lex(id, text, diagnostics);
    var module = parser::parse_module_from(id, tokens, self.ids, diagnostics);

    module.path = module_path;
    self.modules.push(module);

    self.modules.len() - 1
  }

  /// The names of the dependencies of `package`.
  prv fn dependency_names(self, package: usize) -> List<String> {
    const names: List<String> = new List();

    if let Some(loaded) = self.packages.get(package) {
      for index in loaded.dependencies {
        if let Some(dependency) = self.packages.get(index) {
          names.push(dependency.name);
        }
      }
    }

    names
  }

  /// The package that `package` depends on under `name`.
  prv fn dependency(self, package: usize, name: String) -> Option<usize> {
    for index in self.packages.get(package)?.dependencies {
      if let Some(dependency) = self.packages.get(index) {
        if dependency.name == name {
          return Some(index);
        }
      }
    }

    None
  }

  /// The file of the module at `module_path` in `package` (docs/spec/09-modules.md#files):
  /// `name.sag`, or `name/mod.sag` for a module with submodules, with exactly these names. The
  /// package's entry file is no module, and `mod` names none. Unlike the driver, which compares
  /// canonical paths, the entry file is recognized by its name: a module of the root directory
  /// with the entry's name.
  prv fn module_file(self, package: usize, module_path: List<String>) -> ModuleFile {
    const loaded = match self.packages.get(package) {
      Some(found) => found,
      None => return ModuleFile::Missing,
    };
    const last = match module_path.last() {
      Some(found) => found,
      None => return ModuleFile::Missing,
    };

    if module_path.contains("mod") {
      return ModuleFile::Missing;
    }

    var dir = loaded.root;

    for index in 0..module_path.len() - 1 {
      const name = module_path[index];

      if !has_entry(dir, name, true) {
        return ModuleFile::Missing;
      }

      dir = push_path(dir, name);
    }

    const name = last + ".sag";
    const same = module_path.len() == 1 && match path::file_name(loaded.entry) {
      Some(entry_name) => entry_name == name,
      None => false,
    };
    const has_file = has_entry(dir, name, false) && !same;
    const has_dir = has_entry(dir, last, true);
    const merged = has_dir && has_entry(push_path(dir, last), "mod.sag", false);

    if has_file && has_dir {
      return ModuleFile::Conflict { file: push_path(dir, name), merged: merged };
    }

    if has_file {
      return ModuleFile::File(push_path(dir, name));
    }

    if merged { ModuleFile::File(push_path(push_path(dir, last), "mod.sag")) } else { ModuleFile::Missing }
  }

  /// Reports a module with two places for its file: `name.sag` next to a directory `name/`.
  /// Returns `false`, after printing why, if the file cannot be read.
  prv fn report_layout(self, package: usize, module_path: List<String>, file: String, merged: bool, sources: SourceMap, diagnostics: Diagnostics) -> bool {
    const text = match fs::read_to_string(file) {
      Ok(found) => found,
      Err(error) => {
        eprintln(`error: cannot read \`${file}\`: ${error.message()}`);
        return false;
      }
    };
    const root = match self.packages.get(package) {
      Some(loaded) => if loaded.name.is_empty() { "pkg" } else { loaded.name },
      None => "pkg",
    };
    const parts = List::from([root]);

    for segment in module_path {
      parts.push(segment);
    }

    const name = module_path.last().unwrap_or("");
    const id = sources.add(file, text);
    const help = if merged { `keep one file for the module: merge \`${name}.sag\` into \`${name}/mod.sag\`` } else { `move \`${name}.sag\` to \`${name}/mod.sag\`, next to its submodules` };

    diagnostics.push(
      Diagnostic::error(codes::MODULE_LAYOUT, Span::new(id, 0, 0), `the module \`${parts.join("::")}\` has both the file \`${name}.sag\` and the directory \`${name}/\``)
        .with_note("a module with submodules is the file `mod.sag` of their directory")
        .with_help(help),
    );

    true
  }

  /// The package of the program, compiled for `target`: its modules, the prelude and the
  /// standard library modules.
  pub fn package(self, prelude: usize, target: TargetInfo) -> Package {
    const infos: List<PackageInfo> = new List();

    for loaded in self.packages {
      infos.push(PackageInfo { name: loaded.name, dependencies: loaded.dependencies });
    }

    Package { modules: self.modules, prelude: Some(prelude), std: self.std, library: false, packages: infos, target: target }
  }
}
