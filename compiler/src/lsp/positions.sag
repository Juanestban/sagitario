//! Positions of the language server: LSP counts lines from 0 and columns in UTF-16 code units,
//! the compiler counts byte offsets into UTF-8 text (docs/adr/0058-language-server.md).

/// A position in LSP's terms.
pub struct Position {
  pub line: u32;
  pub character: u32;
}

/// How many bytes the UTF-8 sequence starting with `lead` has.
fn sequence_len(lead: u8) -> u32 {
  if lead < 128 {
    1
  } else if lead >= 240 {
    4
  } else if lead >= 224 {
    3
  } else if lead >= 192 {
    2
  } else {
    // A continuation byte: never a lead in valid UTF-8.
    1
  }
}

/// The lines of a text, to convert positions back and forth.
pub class LineIndex {
  prv const bytes: List<u8>;
  /// Byte offset where each line starts.
  prv const starts: List<u32>;

  pub fn new(self, text: String) {
    self.bytes = text.bytes().collect();
    self.starts = List::from([0u32]);

    var offset = 0u32;

    for byte in self.bytes {
      offset += 1;

      if byte == 10 {
        self.starts.push(offset);
      }
    }
  }

  prv fn len(self) -> u32 {
    self.bytes.len() as u32
  }

  /// The position of a byte offset; offsets past the end are the end.
  pub fn position(self, offset: u32) -> Position {
    const target = if offset > self.len() { self.len() } else { offset };
    // The last line starting at or before `target`.
    var low = 0usize;
    var high = self.starts.len();

    while high - low > 1 {
      const middle = low + (high - low) / 2;

      if self.starts.get(middle).unwrap_or(0) <= target {
        low = middle;
      } else {
        high = middle;
      }
    }

    var at = self.starts.get(low).unwrap_or(0);
    var character = 0u32;

    while at < target {
      const size = sequence_len(self.bytes.get(at as usize).unwrap_or(0));

      character += if size == 4 { 2 } else { 1 };
      at += size;
    }

    Position { line: low as u32, character: character }
  }

  /// The byte offset of a position; a line past the end is the end, and a character past the
  /// end of its line is the end of the line.
  pub fn offset(self, position: Position) -> u32 {
    const start = match self.starts.get(position.line as usize) {
      Some(found) => found,
      None => return self.len(),
    };
    const end = match self.starts.get(position.line as usize + 1) {
      // Before the `\n`.
      Some(next) => next - 1,
      None => self.len(),
    };
    var at = start;
    var units = 0u32;

    while at < end && units < position.character {
      const size = sequence_len(self.bytes.get(at as usize).unwrap_or(0));

      units += if size == 4 { 2 } else { 1 };
      at += size;
    }

    if at > end { end } else { at }
  }
}
