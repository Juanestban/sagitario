//! Completion (docs/adr/0058-language-server.md). The text around the cursor tells what is being
//! written, since code being typed rarely compiles: a member after `.`, an item after `::`, an
//! attribute after `@` and its argument after `@repr(`, or a name. Types come from the last
//! analysis of the document that reached the type checker.

use pkg::ast::{Module, Visibility};
use pkg::cfg;
use pkg::lsp::analysis;
use pkg::lsp::analysis::Analysis;
use pkg::lsp::builtins;
use pkg::lsp::builtins::Member;
use pkg::lsp::docs;
use pkg::lsp::json;
use pkg::lsp::json::{Json, member};
use pkg::loader::push_path;
use pkg::lsp::package;
use pkg::lsp::query;
use pkg::resolve::{ItemRef, ModuleInfo, ParamOwner, Resolution, StdItem, TypeItem};
use pkg::types;
use pkg::types::{NamedRef, Type, TypeKind};
use std::env;
use std::fs;

/// Kinds of completion items (LSP's `CompletionItemKind`).
const METHOD: i64 = 2;
const FUNCTION: i64 = 3;
const FIELD: i64 = 5;
const PROPERTY: i64 = 10;
const VARIABLE: i64 = 6;
const CLASS: i64 = 7;
const INTERFACE: i64 = 8;
const MODULE: i64 = 9;
const ENUM: i64 = 13;
const KEYWORD: i64 = 14;
const ENUM_MEMBER: i64 = 20;
const CONSTANT: i64 = 21;
const STRUCT: i64 = 22;

const KEYWORDS: String = "abstract as async await break class const continue else enum extends extern false fn for if impl in interface let loop match mod new override pkg prv pub return self Self static struct super true union unsafe use var weak where while zod";

const BUILTINS: String = "print println eprintln panic assert assert_eq assert_ne unreachable todo";

/// The types the language provides (docs/spec/02-types.md).
const BUILTIN_TYPES: String = "i8 i16 i32 i64 isize u8 u16 u32 u64 usize f32 f64 bool char String StringBuilder List Option Result";

const STD_MODULES: String = "collections env ffi fs hash hint io math mem net path process ptr sync task thread time";

/// The methods of the types the compiler provides (docs/spec/02-types.md).
const STRING_METHODS: String = "len is_empty contains starts_with ends_with find trim trim_start trim_end to_ascii_uppercase to_ascii_lowercase replace repeat substring chars bytes split lines parse_i8 parse_i16 parse_i32 parse_i64 parse_isize parse_u8 parse_u16 parse_u32 parse_u64 parse_usize parse_f32 parse_f64 rfind split_once rsplit_once strip_prefix strip_suffix split_whitespace splitn rsplit matches replacen char_indices to_uppercase to_lowercase";
const LIST_METHODS: String = "len is_empty push pop get first last insert remove clear reverse contains index_of sort sort_by join iter resize as_ptr as_mut_ptr extend append truncate retain dedup split_off drain binary_search binary_search_by sort_by_key min max fill swap windows chunks concat capacity reserve";
const ARRAY_METHODS: String = "len iter map filter take skip step_by collect count fold for_each any all find as_ptr as_mut_ptr contains index_of binary_search binary_search_by min max sort sort_by sort_by_key reverse fill swap copy_from_slice";
const SLICE_METHODS: String = "len is_empty iter as_ptr as_mut_ptr contains index_of binary_search binary_search_by min max sort sort_by sort_by_key reverse fill swap copy_from_slice";
const POINTER_METHODS: String = "is_null add";
/// The methods of iterators the compiler gives by the kind of their values.
const ITER_COMPILER_METHODS: String = "sum product min max unzip flatten";

const OPTION_METHODS: String = "is_some is_none unwrap expect unwrap_or map and_then unwrap_or_else filter ok_or ok_or_else or or_else and xor map_or map_or_else is_some_and is_none_or zip flatten iter unwrap_or_default take replace";
const RESULT_METHODS: String = "is_ok is_err unwrap expect unwrap_or unwrap_err map map_err and_then unwrap_or_else expect_err ok err and or or_else map_or map_or_else is_ok_and is_err_and iter unwrap_or_default";
const BUILDER_METHODS: String = "append append_char len is_empty clear to_string insert truncate pop capacity reserve";
/// The attributes (docs/spec/01-lexical.md#attributes-f1), with what they are written as.
const ATTRIBUTES: String = "cfg default export link_name repr thread_local";
/// The representations of `@repr(...)`: `C` for structs, unions and enums, an integer type for
/// enums.
const REPRESENTATIONS: String = "C i8 i16 i32 i64 isize u8 u16 u32 u64 usize";
const CHAR_METHODS: String = "is_ascii_digit is_ascii_alphabetic is_ascii_alphanumeric is_ascii_whitespace is_ascii_uppercase is_ascii_lowercase to_ascii_uppercase to_ascii_lowercase to_digit is_alphabetic is_numeric is_alphanumeric is_whitespace is_uppercase is_lowercase is_control to_uppercase to_lowercase len_utf8 len_utf16";

/// The completion items, without repeated labels.
class Items {
  pub const list: List<Json>;
  prv const seen: Map<String, bool>;

  pub fn new(self) {
    self.list = new List();
    self.seen = new Map<String, bool>();
  }

  pub fn add(self, label: String, kind: i64, detail: String) {
    if label.is_empty() || self.seen.contains_key(label) {
      return;
    }

    self.seen.insert(label, true);

    const members = List::from([member("label", json::str(label)), member("kind", json::int(kind))]);

    if !detail.is_empty() {
      members.push(member("detail", json::str(detail)));
    }

    self.list.push(json::object(members));
  }

  /// An item inserted as a snippet (LSP's `InsertTextFormat.Snippet`), such as `repr(${1:C})`.
  pub fn add_snippet(self, label: String, kind: i64, detail: String, snippet: String) {
    if self.seen.contains_key(label) {
      return;
    }

    self.seen.insert(label, true);
    self.list.push(json::object(List::from([
      member("label", json::str(label)),
      member("kind", json::int(kind)),
      member("detail", json::str(detail)),
      member("insertText", json::str(snippet)),
      member("insertTextFormat", json::int(2)),
    ])));
  }

  /// An item with its documentation, as Markdown, and the text it sorts by: the program's members
  /// before those every value has.
  pub fn add_documented(self, label: String, kind: i64, detail: String, documentation: String, sort: String) {
    if label.is_empty() || self.seen.contains_key(label) {
      return;
    }

    self.seen.insert(label, true);

    const members = List::from([member("label", json::str(label)), member("kind", json::int(kind))]);

    if !detail.is_empty() {
      members.push(member("detail", json::str(detail)));
    }

    if !documentation.is_empty() {
      members.push(member("documentation", json::object(List::from([member("kind", json::str("markdown")), member("value", json::str(documentation))]))));
    }

    if !sort.is_empty() {
      members.push(member("sortText", json::str(sort)));
    }

    self.list.push(json::object(members));
  }

  /// A field or method of a value.
  pub fn add_member(self, found: Member) {
    const kind = if found.is_field { FIELD } else { METHOD };
    // `0` before the program's members, `1` before the conversions every value has.
    const sort = (if found.general { "1" } else { "0" }) + found.name;

    self.add_documented(found.name, kind, found.signature, found.doc, sort);
  }

  pub fn add_words(self, words: String, kind: i64) {
    for word in words.split(" ") {
      self.add(word, kind, "");
    }
  }
}

pub fn is_name_char(c: char) -> bool {
  c.is_ascii_alphanumeric() || c == '_'
}

/// The characters of `text` before `offset`.
pub fn before(text: String, offset: u32) -> List<char> {
  const end = if offset as usize > text.len() { text.len() } else { offset as usize };

  text.substring(0, end).chars().collect()
}

/// A receiver written before `.` or `::`: names separated by `.`, each possibly called with `()`
/// (`self.items.first().`), read backwards from the position of the separator.
fn receiver_chain(chars: List<char>, end: usize) -> List<String> {
  const segments: List<String> = new List();
  var position = end;

  while true {
    // `name()`: the call's arguments are skipped, their result is the method's.
    var called = false;

    if position > 0 && chars.get(position - 1).unwrap_or(' ') == ')' {
      var depth = 0usize;

      while position > 0 {
        position -= 1;

        const c = chars.get(position).unwrap_or(' ');

        if c == ')' {
          depth += 1;
        } else if c == '(' {
          depth -= 1;

          if depth == 0 {
            break;
          }
        }
      }

      called = true;
    }

    const name_end = position;

    while position > 0 && is_name_char(chars.get(position - 1).unwrap_or(' ')) {
      position -= 1;
    }

    if position == name_end {
      return new List();
    }

    const name = new StringBuilder();

    for index in position..name_end {
      name.append_char(chars.get(index).unwrap_or(' '));
    }

    segments.insert(0, if called { name.to_string() + "()" } else { name.to_string() });

    if position > 0 && chars.get(position - 1).unwrap_or(' ') == '.' {
      position -= 1;
    } else {
      return segments;
    }
  }

  segments
}

/// The names before `::` (`std::fs::`), read backwards from the position of the separator.
fn path_chain(chars: List<char>, end: usize) -> List<String> {
  const segments: List<String> = new List();
  var position = end;

  while true {
    const name_end = position;

    while position > 0 && is_name_char(chars.get(position - 1).unwrap_or(' ')) {
      position -= 1;
    }

    if position == name_end {
      return segments;
    }

    const name = new StringBuilder();

    for index in position..name_end {
      name.append_char(chars.get(index).unwrap_or(' '));
    }

    segments.insert(0, name.to_string());

    if position >= 2 && chars.get(position - 1).unwrap_or(' ') == ':' && chars.get(position - 2).unwrap_or(' ') == ':' {
      position -= 2;
    } else {
      return segments;
    }
  }

  segments
}

/// The completion items at `offset` of `text`, the document of `module` in `analysis`.
/// `trigger` is the character whose typing asked for the completion, if one did.
pub fn complete(analysis: Option<Analysis>, module: Option<Module>, module_index: Option<usize>, text: String, offset: u32, trigger: Option<String>) -> Json {
  const items = new Items();
  const chars = before(text, offset);
  var start = chars.len();

  while start > 0 && is_name_char(chars.get(start - 1).unwrap_or(' ')) {
    start -= 1;
  }

  const separator = if start > 0 { chars.get(start - 1).unwrap_or(' ') } else { ' ' };
  const double_colon = separator == ':' && start >= 2 && chars.get(start - 2).unwrap_or(' ') == ':';

  if separator == '"' && start >= 1 && in_env_macro(chars, start - 1) {
    const package = match analysis {
      Some(found) => found.entry.package,
      None => None,
    };

    const typed = new StringBuilder();

    for index in start..chars.len() {
      typed.append_char(chars.get(index).unwrap_or(' '));
    }

    env_variables(items, package, typed.to_string());
    return Json::Array(items.list);
  }

  if separator == '@' {
    attributes(items);
    return Json::Array(items.list);
  }

  if separator == '(' && start >= 1 && attribute_before(chars, start - 1) == "repr" {
    items.add_words(REPRESENTATIONS, ENUM_MEMBER);
    return Json::Array(items.list);
  }

  if (separator == '(' || separator == ',' || separator == ' ') && in_cfg(chars, start) {
    cfg_conditions(items);
    return Json::Array(items.list);
  }

  if separator == ' ' && word_before(chars, start) == "mod" {
    if let Some(found) = module {
      mod_files(items, found);
    }

    return Json::Array(items.list);
  }

  // `(` asks only for the argument of an attribute: in a call, the names would cover the code.
  if let Some(character) = trigger {
    if character == "(" || character == "@" {
      return Json::Array(items.list);
    }
  }

  if let Some(found) = analysis {
    if separator == '.' {
      members_after(items, found, module, text, chars, start - 1, offset);
      return Json::Array(items.list);
    }

    if double_colon {
      path_members(items, found, module, module_index, path_chain(chars, start - 2), offset);
      return Json::Array(items.list);
    }

    names(items, found, module, module_index, offset);
  }

  items.add_words(BUILTIN_TYPES, STRUCT);
  items.add_words(KEYWORDS, KEYWORD);
  items.add_words(BUILTINS, FUNCTION);
  macros(items);
  Json::Array(items.list)
}

/// The built-in macros, as Rust's (docs/adr/0103-build-scripts-and-binding-generation.md, Q723).
fn macros(items: Items) {
  items.add_snippet("include!", FUNCTION, "include!(\"file.sag\"): puts the items of a file in the module", "include!(\"${1:file.sag}\");");
  items.add_snippet("include_str!", FUNCTION, "include_str!(\"file\"): the text of a file, read when the program is compiled", "include_str!(\"${1:file}\")");
  items.add_snippet("include_bytes!", FUNCTION, "include_bytes!(\"file\"): the bytes of a file, as a `[u8; N]`", "include_bytes!(\"${1:file}\")");
  items.add_snippet("concat!", FUNCTION, "concat!(a, b, ...): literals joined into one string literal", "concat!(${1})");
  items.add_snippet("env!", FUNCTION, "env!(\"NAME\"): an environment variable of the compiler, read when the program is compiled", "env!(\"${1:NAME}\")");
}

// ---- Attributes -------------------------------------------------------------------------------

fn attributes(items: Items) {
  for name in ATTRIBUTES.split(" ") {
    if name == "cfg" {
      items.add_snippet(name, KEYWORD, "@cfg(condition): keeps the item only on the systems where the condition holds", "cfg(${1:windows})");
    } else if name == "export" {
      items.add_snippet(name, KEYWORD, "@export(\"symbol\"): the C symbol of an `extern \"C\"` function", "export(\"${1:symbol}\")");
    } else if name == "link_name" {
      items.add_snippet(name, KEYWORD, "@link_name(\"symbol\"): the C symbol of a function or global of an `extern \"C\"` block, when it is not its name", "link_name(\"${1:symbol}\")");
    } else if name == "default" {
      items.add_snippet(name, KEYWORD, "@default on a struct or enum, and before the default variant: implements `Default`", "default");
    } else if name == "repr" {
      items.add_snippet(name, KEYWORD, "@repr(C) on structs, unions and enums, or an integer type on enums", "repr(${1:C})");
    } else {
      items.add_snippet(name, KEYWORD, "@thread_local on a `static var`: one value per thread", "thread_local");
    }
  }
}

/// The conditions of `@cfg(...)` (docs/adr/0085-conditional-compilation-and-std-time.md): the
/// names, the names with a value, whose values are a choice, and the combinations.
fn cfg_conditions(items: Items) {
  items.add_words(cfg::NAMES, ENUM_MEMBER);

  for key in cfg::KEYS.split(" ") {
    const choice = cfg::values(key).split(" ").join(",");

    items.add_snippet(key, PROPERTY, key + " = \"...\": one of " + cfg::values(key).split(" ").join(", "), key + " = \"${1|" + choice + "|}\"");
  }

  for combinator in cfg::COMBINATORS.split(" ") {
    const what = if combinator == "all" { "every condition holds" } else if combinator == "any" { "one condition holds" } else { "the condition does not hold" };

    items.add_snippet(combinator, FUNCTION, combinator + "(...): " + what, combinator + "(${1})");
  }
}

/// Whether `start`, on its line, is inside the parentheses of an `@cfg(`.
fn in_cfg(chars: List<char>, start: usize) -> bool {
  var index = start;
  var depth = 0i32;

  while index > 0 {
    const previous = chars.get(index - 1).unwrap_or(' ');

    if previous == '\n' {
      return false;
    }

    if previous == ')' {
      depth += 1;
    } else if previous == '(' {
      if depth == 0 && attribute_before(chars, index - 1) == "cfg" {
        return true;
      }

      if depth > 0 {
        depth -= 1;
      }
    }

    index -= 1;
  }

  false
}

/// The name of the attribute written as `@name` right before the `(` at `paren`, or `""`.
/// Whether the quote at `quote` opens the argument of `env!(`.
fn in_env_macro(chars: List<char>, quote: usize) -> bool {
  var at = quote;

  while at > 0 && chars.get(at - 1).unwrap_or('x') == ' ' {
    at -= 1;
  }

  if at < 5 {
    return false;
  }

  const before = new StringBuilder();

  for index in at - 5..at {
    before.append_char(chars.get(index).unwrap_or(' '));
  }

  before.to_string() == "env!(" && (at == 5 || !is_name_char(chars.get(at - 6).unwrap_or(' ')))
}

/// Inside `env!("`: the variables Nova gives the package, then those of the environment, with
/// their values (docs/adr/0112-language-server-packages-and-inlay-hints.md, Q804).
fn env_variables(items: Items, package_dir: Option<String>, prefix: String) {
  const given = package::variables_of(package_dir);

  for name in given {
    if name.starts_with(prefix) {
      items.add(name, CONSTANT, "set by Nova for the package's build script");
    }
  }

  const vars = env::vars();

  vars.sort_by((a, b) => a.0.compare(b.0));

  for pair in vars {
    // Those starting with what is typed: the environment is long.
    if !given.contains(pair.0) && pair.0.starts_with(prefix) {
      items.add(pair.0, CONSTANT, shorten(pair.1, 80));
    }
  }
}

/// The first `limit` characters of `text`, with `…` when it is longer.
fn shorten(text: String, limit: usize) -> String {
  const out = new StringBuilder();
  var count = 0usize;

  for c in text.chars() {
    if count == limit {
      out.append("…");
      break;
    }

    out.append_char(c);
    count += 1;
  }

  out.to_string()
}

/// The word before the spaces that end at `end`.
fn word_before(chars: List<char>, end: usize) -> String {
  var stop = end;

  while stop > 0 && chars.get(stop - 1).unwrap_or('x') == ' ' {
    stop -= 1;
  }

  var start = stop;

  while start > 0 && is_name_char(chars.get(start - 1).unwrap_or(' ')) {
    start -= 1;
  }

  const word = new StringBuilder();

  for index in start..stop {
    word.append_char(chars.get(index).unwrap_or(' '));
  }

  word.to_string()
}

/// After `mod `: the files of the module's directory that no `mod` of it declares yet, `name.sag`
/// or `name/mod.sag` (docs/adr/0111-modules-as-rust.md, Q797).
fn mod_files(items: Items, module: Module) {
  const dir = match module.dir {
    Some(found) => found,
    None => return,
  };
  const entries = match fs::read_dir(if dir.is_empty() { "." } else { dir }) {
    Ok(found) => found,
    Err(_) => return,
  };
  // In the same order on every system.
  entries.sort();

  const declared: List<String> = new List();

  for decl in module.mods {
    declared.push(decl.name.name);
  }

  for entry in entries {
    const full = push_path(dir, entry);
    var name = "";

    if entry.ends_with(".sag") && fs::is_file(full) {
      name = entry.substring(0, entry.len() - 4);
    } else if fs::is_file(push_path(full, "mod.sag")) {
      name = entry;
    }

    // Roots are no submodules.
    if name.is_empty() || name == "mod" || name == "main" || name == "lib" || name == "build" || declared.contains(name) {
      continue;
    }

    items.add_snippet(name, MODULE, "the module of `" + entry + "`", name + ";");
  }
}

fn attribute_before(chars: List<char>, paren: usize) -> String {
  var start = paren;

  while start > 0 && is_name_char(chars.get(start - 1).unwrap_or(' ')) {
    start -= 1;
  }

  if start == 0 || chars.get(start - 1).unwrap_or(' ') != '@' {
    return "";
  }

  const name = new StringBuilder();

  for index in start..paren {
    name.append_char(chars.get(index).unwrap_or(' '));
  }

  name.to_string()
}

// ---- Names ------------------------------------------------------------------------------------

fn item_kind(item: ItemRef) -> i64 {
  match item {
    ItemRef::Fn(_) => FUNCTION,
    ItemRef::Extern(_) => FUNCTION,
    ItemRef::Const(_) => CONSTANT,
    ItemRef::Static(_) => VARIABLE,
    ItemRef::Type(TypeItem::Struct(_)) => STRUCT,
    ItemRef::Type(TypeItem::Enum(_)) => ENUM,
    ItemRef::Type(TypeItem::Class(_)) => CLASS,
    ItemRef::Type(TypeItem::Interface(_)) => INTERFACE,
    ItemRef::Module(_) => MODULE,
    ItemRef::Std(StdItem::Root) => MODULE,
    ItemRef::Std(StdItem::Ffi) => MODULE,
    ItemRef::Std(_) => FUNCTION,
  }
}

fn item_detail(analysis: Analysis, item: ItemRef) -> String {
  match item {
    ItemRef::Fn(id) => query::signature(analysis, id).unwrap_or(""),
    ItemRef::Extern(id) => query::extern_signature(analysis, id).unwrap_or(""),
    // Module-level constants, the globals of a program, with their types.
    ItemRef::Const(_) | ItemRef::Static(_) => query::item_text(analysis, item).unwrap_or(""),
    _ => "",
  }
}

/// The module of the program read from module `index` of the package.
fn module_info(resolution: Resolution, index: usize) -> Option<ModuleInfo> {
  for info in resolution.modules {
    if let Some(source) = info.source {
      if source == index {
        return Some(info);
      }
    }
  }

  None
}

/// The names of the module `owner` that code of `viewer` sees, or its public names without a
/// viewer: items, re-exports and declared modules (docs/adr/0111-modules-as-rust.md, Q797).
fn add_module_items(items: Items, analysis: Analysis, resolution: Resolution, owner: u32, viewer: Option<u32>) {
  const info = match resolution.modules.get(owner as usize) {
    Some(found) => found,
    None => return,
  };
  const sees = (visibility: Visibility) => match viewer {
    Some(from) => resolution.visible(visibility, owner, from),
    None => visibility == Visibility::Public,
  };

  for entry in info.items.entries() {
    if sees(entry.value.visibility) {
      items.add_documented(entry.key, item_kind(entry.value.item), item_detail(analysis, entry.value.item), docs::of_item(analysis, entry.value.item), "");
    }
  }

  // Plain imports are the module's own; `pub use` makes them names of it.
  for entry in info.imports.entries() {
    if entry.value.visibility != Visibility::Module && sees(entry.value.visibility) {
      items.add(entry.key, item_kind(entry.value.item), item_detail(analysis, entry.value.item));
    }
  }

  // The modules of `std` and of the prelude need no `mod`.
  if info.in_std || info.source.is_none() {
    for name in info.children.keys() {
      items.add(name, MODULE, "");
    }
  } else {
    for entry in info.mods.entries() {
      if sees(entry.value.visibility) {
        items.add(entry.key, MODULE, "");
      }
    }
  }
}

/// The bindings, items, prelude and builtins visible at `offset`.
fn names(items: Items, analysis: Analysis, module: Option<Module>, module_index: Option<usize>, offset: u32) {
  const resolution = match analysis.resolution {
    Some(found) => found,
    None => return,
  };
  const typed = analysis.typed;

  // The bindings of the function declared before the cursor, nearest first.
  if let Some(found_module) = module {
    if let Some(function) = query::enclosing_function(analysis, found_module, offset) {
      if let Some(locals) = resolution.locals.get(function as usize) {
        var index = locals.len();

        while index > 0 {
          index -= 1;

          const local = locals[index];

          if local.span.start < offset {
            var detail = "";

            if let Some(found_typed) = typed {
              if let Some(ty) = found_typed.local_type(function, index as u32) {
                detail = types::text(ty);
              }
            }

            items.add(local.name, VARIABLE, detail);
          }
        }
      }
    }
  }

  if let Some(index) = module_index {
    if let Some(info) = module_info(resolution, index) {
      if let Some(id) = query::module_id(resolution, index) {
        add_module_items(items, analysis, resolution, id, Some(id));
      }

      for entry in info.imports.entries() {
        items.add(entry.key, item_kind(entry.value.item), item_detail(analysis, entry.value.item));
      }
    }
  }

  if let Some(prelude) = resolution.prelude {
    add_module_items(items, analysis, resolution, prelude, None);
  }

  items.add("Some", ENUM_MEMBER, "");
  items.add("None", ENUM_MEMBER, "");
  items.add("Ok", ENUM_MEMBER, "");
  items.add("Err", ENUM_MEMBER, "");
  items.add("std", MODULE, "");
}

// ---- Paths ------------------------------------------------------------------------------------

/// The built-in types with static functions or constants.
const BUILTIN_OWNERS: String = "CString Atomic List String char int float";

/// `int` and `float` for the number types, which share their static functions.
fn builtins_owner(name: String) -> String {
  if types::int_from_name(name).is_some() {
    "int"
  } else if name == "f32" || name == "f64" {
    "float"
  } else {
    name
  }
}

fn add_statics(items: Items, owner: String) {
  for found in builtins::statics(owner) {
    items.add_documented(found.name, if found.is_field { CONSTANT } else { FUNCTION }, found.signature, found.doc, "");
  }
}

/// The items after `a::b::`.
fn path_members(items: Items, analysis: Analysis, module: Option<Module>, module_index: Option<usize>, chain: List<String>, offset: u32) {
  const resolution = match analysis.resolution {
    Some(found) => found,
    None => return,
  };
  const first = match chain.first() {
    Some(found) => found,
    None => return,
  };

  if first == "std" && chain.len() == 1 {
    items.add_words(STD_MODULES, MODULE);
    return;
  }

  // The static functions and constants of the built-in types: `i32::MAX`, `CString::new`,
  // `List::from` (docs/adr/0109-language-server-members.md).
  if chain.len() == 1 && BUILTIN_OWNERS.split(" ").contains(builtins_owner(first)) {
    add_statics(items, first);
    return;
  }

  // `Self::`: what `Type::` names, for the type whose function holds the cursor
  // (docs/adr/0099-associated-and-composite-constants.md, Q687).
  if chain.len() == 1 && first == "Self" {
    if let Some(found_module) = module {
      if let Some(function) = query::enclosing_function(analysis, found_module, offset) {
        if let Some(item) = resolution.owner(function) {
          type_functions(items, analysis, item);
        }
      }
    }

    return;
  }

  // `T::`: the static functions of the interfaces bounding a type parameter in scope
  // (docs/adr/0094-conversions-and-defaults.md, Q631).
  if chain.len() == 1 {
    if let Some(ty) = param_in_scope(analysis, module, first, offset) {
      interface_statics(items, analysis, ty);
      return;
    }
  }

  // The module the path starts from.
  var current: Option<u32> = None;
  var rest = 1usize;

  if first == "pkg" {
    current = resolution.package_roots.first();
  } else if first == "std" {
    current = resolution.std_root;
  } else {
    const here = match module_index {
      Some(index) => query::module_id(resolution, index),
      None => None,
    };

    if first == "self" {
      current = here;
    } else if first == "super" {
      current = match here {
        Some(id) => match resolution.modules.get(id as usize) {
          Some(info) => info.parent,
          None => None,
        },
        None => None,
      };
    } else {
      current = here;
      rest = 0;
    }
  }

  var target: Option<ItemRef> = match current {
    Some(id) => Some(ItemRef::Module(id)),
    None => None,
  };

  for index in rest..chain.len() {
    target = match target {
      Some(ItemRef::Module(id)) => query::lookup(resolution, id, chain[index]),
      _ => None,
    };
  }

  const here = match module_index {
    Some(index) => query::module_id(resolution, index),
    None => None,
  };

  match target {
    Some(ItemRef::Module(id)) => {
      if let Some(info) = resolution.modules.get(id as usize) {
        add_module_items(items, analysis, resolution, id, here);

        // The functions the compiler provides to modules of `std`.
        if info.in_std && info.path.len() == 2 {
          add_statics(items, info.path[1]);
        }
      }
    }
    Some(ItemRef::Type(item)) => type_functions(items, analysis, item),
    _ => {}
  }
}

/// The functions of a type without `self`, its constants, and an enum's variants: what `Type::`
/// names.
fn type_functions(items: Items, analysis: Analysis, item: TypeItem) {
  const package = match analysis.package {
    Some(found) => found,
    None => return,
  };
  const resolution = match analysis.resolution {
    Some(found) => found,
    None => return,
  };

  if let TypeItem::Enum(id) = item {
    if let Some(decl) = resolution.enum_decl(package, id) {
      for variant in decl.variants {
        // As written, with its fields: `Circle(f64)`.
        const written = match analysis.sources.get(variant.span.file) {
          Some(source) => source.slice(variant.span),
          None => variant.name.name,
        };

        items.add_documented(variant.name.name, ENUM_MEMBER, written, docs::above(analysis, variant.span), "");
      }
    }
  }

  // Its constants (docs/adr/0099-associated-and-composite-constants.md, Q687).
  for id in resolution.type_consts(item) {
    if let Some(decl) = resolution.const_decl(package, id) {
      const detail = match analysis.typed {
        Some(typed) => match typed.const_types.get(id as usize) {
          Some(ty) => "const " + decl.name.name + ": " + types::text(ty),
          None => "",
        },
        None => "",
      };

      items.add(decl.name.name, CONSTANT, detail);
    }
  }

  // An interface's static functions are called through the types implementing it.
  if let TypeItem::Interface(_) = item {
    return;
  }

  const found = functions_of(resolution, item);

  add_block_functions(found, resolution, item);

  for function in found {
    if let Some(decl) = resolution.fn_decl(package, function) {
      if decl.self_param.is_none() {
        items.add_documented(decl.name.name, FUNCTION, query::signature(analysis, function).unwrap_or(""), docs::of_function(analysis, function), "");
      }
    }
  }

  // The defaults of the static functions of its interfaces.
  if let Some(typed) = analysis.typed {
    const name = resolution.type_name(package, item);
    const args = typed.identity_args(ParamOwner::Item(item));
    const ty = match item {
      TypeItem::Struct(id) => types::of(TypeKind::Struct(NamedRef { id: id, name: name, args: args })),
      TypeItem::Enum(id) => types::of(TypeKind::Enum(NamedRef { id: id, name: name, args: args })),
      TypeItem::Class(id) => types::of(TypeKind::Class(NamedRef { id: id, name: name, args: args })),
      TypeItem::Interface(_) => return,
    };

    interface_statics(items, analysis, ty);
  }
}

/// The type parameter `name` of the function around `offset` or of its type.
fn param_in_scope(analysis: Analysis, module: Option<Module>, name: String, offset: u32) -> Option<Type> {
  const typed = analysis.typed?;
  const resolution = analysis.resolution?;
  const function = query::enclosing_function(analysis, module?, offset)?;
  const owners = List::from([ParamOwner::Fn(function)]);

  if let Some(item) = resolution.owner(function) {
    owners.push(ParamOwner::Item(item));
  }

  for owner in owners {
    if let Some(params) = typed.generic_params(owner) {
      for index in 0..params.len() {
        if params[index].name == name {
          return typed.identity_args(owner).get(index);
        }
      }
    }
  }

  None
}

/// The static functions of the interfaces `ty` implements or is bounded by, and their ancestors.
fn interface_statics(items: Items, analysis: Analysis, ty: Type) {
  const typed = match analysis.typed {
    Some(found) => found,
    None => return,
  };
  const resolution = match analysis.resolution {
    Some(found) => found,
    None => return,
  };
  const package = match analysis.package {
    Some(found) => found,
    None => return,
  };

  for implemented in typed.implemented_refs(ty) {
    for interface_ref in typed.interface_ancestor_refs(implemented) {
      if let Some(def) = typed.interface_def(interface_ref.id) {
        for method in def.methods {
          if let Some(decl) = resolution.fn_decl(package, method) {
            if decl.self_param.is_none() {
              items.add(decl.name.name, FUNCTION, query::signature(analysis, method).unwrap_or(""));
            }
          }
        }
      }
    }
  }
}

fn functions_of(resolution: Resolution, item: TypeItem) -> List<u32> {
  const info = match item {
    TypeItem::Struct(id) => resolution.structs.get(id as usize),
    TypeItem::Enum(id) => resolution.enums.get(id as usize),
    TypeItem::Class(id) => resolution.classes.get(id as usize),
    TypeItem::Interface(id) => resolution.interfaces.get(id as usize),
  };

  match info {
    Some(found) => found.functions,
    None => new List(),
  }
}

/// The methods of the `impl ... for` blocks of a type (docs/adr/0081-operator-overloading.md).
fn add_block_functions(found: List<u32>, resolution: Resolution, item: TypeItem) {
  for block in resolution.type_blocks(item) {
    if let Some(info) = resolution.blocks.get(block as usize) {
      for function in info.functions {
        found.push(function);
      }
    }
  }
}

// ---- Members ----------------------------------------------------------------------------------

/// Whether `analysis` read the document `text` up to `end` as it is now, so that its offsets are
/// those of the text.
pub fn reads(analysis: Option<Analysis>, module: Option<Module>, text: String, end: u32) -> bool {
  const found = match analysis {
    Some(value) => value,
    None => return false,
  };
  const found_module = match module {
    Some(value) => value,
    None => return false,
  };

  if found.typed.is_none() {
    return false;
  }

  match analysis::source_of(found, found_module) {
    Some(source) => end as usize <= source.text.len() && end as usize <= text.len() && source.text.substring(0, end as usize) == text.substring(0, end as usize),
    None => false,
  }
}

/// Whether `analysis` read the document `text` up to the `.` at `dot` and found an expression
/// before it, whose type is the receiver's.
pub fn knows_receiver(analysis: Option<Analysis>, module: Option<Module>, text: String, dot: u32) -> bool {
  if !reads(analysis, module, text, dot) {
    return false;
  }

  match analysis {
    Some(found) => match module {
      Some(found_module) => query::find(found, found_module, dot).ending.is_some(),
      None => false,
    },
    None => false,
  }
}

/// The offset of the `.` before the name being typed at `offset`, if the name follows one.
pub fn member_dot(text: String, offset: u32) -> Option<u32> {
  const chars = before(text, offset);
  var start = chars.len();

  while start > 0 && is_name_char(chars.get(start - 1).unwrap_or(' ')) {
    start -= 1;
  }

  if start == 0 || chars.get(start - 1).unwrap_or(' ') != '.' {
    return None;
  }

  // `1..` and `0.5` are not members.
  if start >= 2 {
    const previous = chars.get(start - 2).unwrap_or(' ');

    if previous == '.' || previous.is_ascii_digit() && !ends_in_name(chars, start - 2) {
      return None;
    }
  }

  // The name being typed is ASCII, one byte per character.
  Some(offset - (chars.len() - start) as u32 - 1)
}

/// Whether the digit at `index` ends a name, as in `x1.`, rather than a number.
fn ends_in_name(chars: List<char>, index: usize) -> bool {
  var position = index + 1;

  while position > 0 && is_name_char(chars.get(position - 1).unwrap_or(' ')) {
    position -= 1;
  }

  !chars.get(position).unwrap_or('0').is_ascii_digit()
}

/// The members after `receiver.`, where the `.` is at `dot` of the characters before the cursor.
fn members_after(items: Items, analysis: Analysis, module: Option<Module>, text: String, chars: List<char>, dot: usize, offset: u32) {
  var ty: Option<Type> = None;

  // The type the checker gave the expression before the `.`, when the analysis read this text.
  if let Some(dot_offset) = member_dot(text, offset) {
    if reads(Some(analysis), module, text, dot_offset) {
      if let Some(found_module) = module {
        if let Some(expr) = query::find(analysis, found_module, dot_offset).ending {
          if let Some(typed) = analysis.typed {
            ty = typed.expr_types.get(expr.id);
          }
        }
      }
    }
  }

  // Else the type of the names before it, in the latest analysis that reached the checker.
  if ty.is_none() {
    ty = receiver_type(analysis, module, receiver_chain(chars, dot), offset);
  }

  if let Some(found) = ty {
    if !types::is_error(found) {
      for member in builtins::members(analysis, builtins::referred(found)) {
        items.add_member(member);
      }
    }
  }
}

/// The type of a receiver chain: a binding, `self` or a constant, then fields and method calls.
fn receiver_type(analysis: Analysis, module: Option<Module>, chain: List<String>, offset: u32) -> Option<Type> {
  const resolution = analysis.resolution?;
  const typed = analysis.typed?;
  const first = chain.first()?;
  var current: Option<Type> = None;

  if let Some(found_module) = module {
    if let Some(function) = query::enclosing_function(analysis, found_module, offset) {
      if let Some(locals) = resolution.locals.get(function as usize) {
        var index = locals.len();

        while index > 0 && current.is_none() {
          index -= 1;

          if locals[index].name == first && locals[index].span.start < offset {
            current = typed.local_type(function, index as u32);
          }
        }
      }
    }
  }

  var ty = current?;

  for index in 1..chain.len() {
    const segment = chain[index];
    const name = if segment.ends_with("()") { segment.substring(0, segment.len() - 2) } else { segment };

    ty = builtins::member(analysis, builtins::referred(ty), name)?.ty?;
  }

  Some(ty)
}
