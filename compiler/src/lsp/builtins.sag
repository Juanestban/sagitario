/// What every value has (docs/adr/0094-conversions-and-defaults.md, Q633).
const GENERAL: String = "into|() -> U|The value converted into the type expected, through `From`.
try_into|() -> Result<U, E>|The value converted into the type expected, through `TryFrom`, or why it cannot be.";

/// The kinds of `TABLE` that a value of type `ty` has.
fn kinds_of(ty: Type, iterable: bool) -> List<String> {
  const kinds: List<String> = match ty.kind {
    TypeKind::String => List::from(["string", "display"]),
    TypeKind::Char => List::from(["char", "display"]),
    TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool => List::from(["display"]),
    TypeKind::StringBuilder => List::from(["builder"]),
    TypeKind::List(_) => List::from(["list", "iterable"]),
    TypeKind::Array { .. } => List::from(["array", "seq", "iterable"]),
    TypeKind::Slice { .. } => List::from(["slice", "seq"]),
    TypeKind::Option(_) => List::from(["option"]),
    TypeKind::Result { .. } => List::from(["result"]),
    TypeKind::Ptr { .. } => List::from(["pointer"]),
    TypeKind::CString => List::from(["cstring"]),
    _ => new List(),
  };

  if iterable {
    kinds.push("iter");
  }

  kinds
}

/// The receiver's type arguments for `T`, `E` and `Self` in the table.
fn table_subst(ty: Type) -> Map<String, String> {
  const names = new Map<String, String>();

  names.insert("Self", types::text(ty));

  match ty.kind {
    TypeKind::List(elem) | TypeKind::Option(elem) | TypeKind::Array { elem, .. } | TypeKind::Slice { elem, .. } => {
      names.insert("T", types::text(elem));
    }
    TypeKind::Ptr { pointee, .. } => {
      names.insert("T", types::text(pointee));
    }
    TypeKind::Result { value, error } => {
      names.insert("T", types::text(value));
      names.insert("E", types::text(error));
    }
    _ => {}
  }

  names
}

fn is_word_char(c: char) -> bool {
  c.is_ascii_alphanumeric() || c == '_'
}

/// `text` with each whole word that `names` holds replaced by its value.
fn replace_words(text: String, names: Map<String, String>) -> String {
  const out = new StringBuilder();
  const word = new StringBuilder();

  for c in text.chars() {
    if is_word_char(c) {
      word.append_char(c);
      continue;
    }

    if !word.is_empty() {
      const found = word.to_string();

      out.append(names.get(found).unwrap_or(found));
      word.clear();
    }

    out.append_char(c);
  }

  if !word.is_empty() {
    const found = word.to_string();

    out.append(names.get(found).unwrap_or(found));
  }

  out.to_string()
}

/// The parameters of a table signature, `(a: A, b: fn(T) -> U)`, as `a: A` and `b: fn(T) -> U`.
fn table_params(source: String) -> List<String> {
  const close = source.rfind(")").unwrap_or(0);
  const inside = if close > 0 { source.substring(1, close) } else { "" };
  const params: List<String> = new List();
  const current = new StringBuilder();
  var depth = 0i32;

  for c in inside.chars() {
    if c == '(' || c == '<' || c == '[' {
      depth += 1;
    } else if c == ')' || c == '>' || c == ']' {
      // `->` holds a `>` that closes nothing.
      if !current.to_string().ends_with("-") {
        depth -= 1;
      }
    }

    if c == ',' && depth == 0 {
      params.push(current.to_string().trim());
      current.clear();
    } else {
      current.append_char(c);
    }
  }

  if !current.to_string().trim().is_empty() {
    params.push(current.to_string().trim());
  }

  params
}

/// `fn name(self, params) -> R` from a table signature `(params) -> R`.
fn table_signature(name: String, source: String) -> String {
  const params = table_params(source);
  const close = source.rfind(")").unwrap_or(0);
  const rest = source.substring(close + 1, source.len());
  const all = List::from(["self"]);

  for param in params {
    all.push(param);
  }

  "fn " + name + "(" + all.join(", ") + ")" + rest
}

/// The type arguments `unknowns` learned, with the parameters still unknown named as declared.
fn learned(typed: TypedModule, unknowns: generic::Unknowns) -> Subst {
  const params: List<SubstEntry> = new List();

  for group in unknowns.groups {
    const identity = typed.identity_args(group.owner);
    const args: List<Type> = new List();

    for index in 0..group.slots.len() {
      match group.slots[index] {
        Some(ty) => args.push(ty),
        None => args.push(identity.get(index).unwrap_or(types::error())),
      }
    }

    params.push(SubstEntry { owner: group.owner, args: args });
  }

  Subst { params: params, self_ty: None }
}

/// The receiver as the first parameter of a prelude function sees it: a slice for the functions
/// of slices, which lists and arrays lend.
fn as_first_param(ty: Type, first: Type) -> Type {
  if let TypeKind::Ref { mutable, pointee } = first.kind {
    if let TypeKind::Slice { .. } = pointee.kind {
      const elem = match ty.kind {
        TypeKind::List(elem) | TypeKind::Array { elem, .. } | TypeKind::Slice { elem, .. } => elem,
        _ => return ty,
      };

      return types::of(TypeKind::Ref { mutable: mutable, pointee: types::of(TypeKind::Slice { mutable: mutable, elem: elem }) });
    }
  }

  ty
}

/// A function written in Sagitario as a method of the receiver `ty`: `skip` leading parameters
/// are the receiver's, and the generic ones it shares with the receiver take its arguments.
fn function_member(analysis: Analysis, function: u32, name: String, ty: Type, skip: usize, owner_subst: Option<Subst>) -> Option<Member> {
  const package = analysis.package?;
  const resolution = analysis.resolution?;
  const typed = analysis.typed?;
  const decl = resolution.fn_decl(package, function)?;
  const sig = typed.sigs.get(function as usize)?;
  var subst = Subst::empty();

  match owner_subst {
    Some(found) => {
      subst = found;
    }
    None => {
      const unknowns = new generic::Unknowns();

      unknowns.typed = Some(typed);
      unknowns.add(ParamOwner::Fn(function), resolution.generics(package, ParamOwner::Fn(function)).len(), None);

      if let Some(first) = sig.params.first() {
        unknowns.unify(first, as_first_param(ty, first));
      }

      subst = learned(typed, unknowns);
    }
  }

  const params: List<String> = new List();

  for index in skip..decl.params.len() {
    const param_ty = match sig.params.get(index) {
      Some(found) => types::text(types::substitute(found, subst)),
      None => "?",
    };

    params.push(decl.params[index].name.name + ": " + param_ty);
  }

  const shown = List::from(["self"]);

  for param in params {
    shown.push(param);
  }

  const ret = types::substitute(sig.ret, subst);
  const ret_text = match ret.kind {
    TypeKind::Unit => "",
    _ => " -> " + types::text(ret),
  };

  Some(Member {
    name: name,
    signature: (if decl.is_async { "async fn " } else { "fn " }) + name + "(" + shown.join(", ") + ")" + ret_text,
    doc: docs::of_function(analysis, function),
    is_field: false,
    function: Some(function),
    params: params,
    general: false,
    ty: Some(ret),
  })
}

/// The class `Iter` of the prelude.
fn iter_class(resolution: Resolution) -> Option<u32> {
  const prelude = resolution.prelude?;
  const info = resolution.modules.get(prelude as usize)?;

  match info.items.get("Iter")?.item {
    ItemRef::Type(TypeItem::Class(id)) => Some(id),
    _ => None,
  }
}

/// A function of the root of `std`.
fn std_root_fn(resolution: Resolution, name: String) -> Option<u32> {
  const root = resolution.std_root?;
  const info = resolution.module(root)?;

  match info.items.get(name)?.item {
    ItemRef::Fn(id) => Some(id),
    _ => None,
  }
}

/// The element of a list, an array or a slice.
fn elem_of(ty: Type) -> Option<Type> {
  match ty.kind {
    TypeKind::List(elem) | TypeKind::Array { elem, .. } | TypeKind::Slice { elem, .. } => Some(elem),
    _ => None,
  }
}

/// The method `name` of the class `class_id` for a receiver whose type arguments are `args`.
fn class_method(analysis: Analysis, class_id: u32, name: String, args: List<Type>, ty: Type) -> Option<Member> {
  const package = analysis.package?;
  const resolution = analysis.resolution?;
  const typed = analysis.typed?;

  for ancestor_id in typed.class_chain(class_id) {
    for function in functions_of(resolution, TypeItem::Class(ancestor_id)) {
      if let Some(decl) = resolution.fn_decl(package, function) {
        if decl.name.name == name && decl.self_param.is_some() {
          const owner_args = if ancestor_id == class_id { args } else { ancestor_args(typed, class_id, ancestor_id, args) };

          return function_member(analysis, function, name, ty, 0, Some(Subst::of(ParamOwner::Item(TypeItem::Class(ancestor_id)), owner_args)));
        }
      }
    }
  }

  None
}

/// The type arguments of the ancestor `ancestor` of the class `class_id` instantiated with `args`.
fn ancestor_args(typed: TypedModule, class_id: u32, ancestor: u32, args: List<Type>) -> List<Type> {
  for found in typed.class_ancestors(NamedRef { id: class_id, name: "", args: args }) {
    if found.id == ancestor {
      return found.args;
    }
  }

  new List()
}

/// One line of `TABLE` as a member of `ty`, or `None` if the receiver does not have it (`join` of
/// a list of numbers, `flatten` of an option of numbers).
fn table_member(analysis: Analysis, ty: Type, name: String, source: String, doc: String) -> Option<Member> {
  const resolution = analysis.resolution?;
  var found: Option<Member> = None;

  if source.starts_with("@") || source.starts_with("#") {
    const function_name = source.substring(1, source.len());
    const function = if source.starts_with("@") { resolution.prelude_fn(function_name)? } else { std_root_fn(resolution, function_name)? };

    found = function_member(analysis, function, name, ty, 1, None);
  } else if source == "*" {
    found = class_method(analysis, iter_class(resolution)?, name, List::from([elem_of(ty)?]), ty);
  } else {
    const names = table_subst(ty);
    const signature = replace_words(table_signature(name, source), names);
    const params: List<String> = new List();

    for param in table_params(source) {
      params.push(replace_words(param, names));
    }

    found = Some(Member { name: name, signature: signature, doc: "", is_field: false, function: None, params: params, general: false, ty: None });
  }

  var member = found?;

  if member.doc.is_empty() {
    member.doc = doc;
  }

  Some(member)
}

/// The type of the values of an iterator: of `Iter<T>` and its subclasses.
fn iter_elem(analysis: Analysis, ty: Type) -> Option<Type> {
  analysis.typed?.iter_elem(ty)
}

/// The fields and methods of a value of type `ty`: the program's members first, then those the
/// compiler gives, then those every value has.
pub fn members(analysis: Analysis, ty: Type) -> List<Member> {
  const found: List<Member> = new List();
  const seen = new Map<String, bool>();
  const add = (member: Member) => {
    if !seen.contains_key(member.name) {
      seen.insert(member.name, true);
      found.push(member);
    }
  };

  for member in declared_members(analysis, ty) {
    add(member);
  }

  for member in tuple_members(ty) {
    add(member);
  }

  const iterable = iter_elem(analysis, ty).is_some();

  for kind in kinds_of(ty, iterable) {
    for line in TABLE.lines() {
      const parts = line.split("|");

      if parts.len() == 4 && parts[0] == kind {
        if let Some(member) = table_member(analysis, ty, parts[1], parts[2], parts[3]) {
          add(member);
        }
      }
    }
  }

  // The methods of numbers (docs/adr/0076-std-math-and-methods-of-numbers.md).
  for method in numbers::methods_of(ty) {
    add(Member { name: method.name, signature: numbers::signature(method), doc: "", is_field: false, function: None, params: new List(), general: false, ty: None });
  }

  // The conversions to bytes of integers, written in the prelude (docs/adr/0101-the-rest-of-s2.md, Q702).
  if let TypeKind::Int(int_ty) = ty.kind {
    if let Some(resolution) = analysis.resolution {
      for name in numbers::BYTE_METHODS.split(" ") {
        if let Some(function) = resolution.prelude_fn("int_" + name + "_" + types::int_name(int_ty)) {
          if let Some(member) = function_member(analysis, function, name, ty, 1, None) {
            add(member);
          }
        }
      }
    }
  }

  for line in GENERAL.lines() {
    const parts = line.split("|");

    add(Member { name: parts[0], signature: table_signature(parts[0], parts[1]), doc: parts[2], is_field: false, function: None, params: new List(), general: true, ty: None });
  }

  found
}

/// The member `name` of a value of type `ty`.
pub fn member(analysis: Analysis, ty: Type, name: String) -> Option<Member> {
  for found in members(analysis, ty) {
    if found.name == name {
      return Some(found);
    }
  }

  None
}

// ---- The program's types ---------------------------------------------------------------------

fn functions_of(resolution: Resolution, item: TypeItem) -> List<u32> {
  const info = match item {
    TypeItem::Struct(id) => resolution.structs.get(id as usize),
    TypeItem::Enum(id) => resolution.enums.get(id as usize),
    TypeItem::Class(id) => resolution.classes.get(id as usize),
    TypeItem::Interface(id) => resolution.interfaces.get(id as usize),
  };
  const found: List<u32> = new List();

  if let Some(info) = info {
    for function in info.functions {
      found.push(function);
    }
  }

  // The methods of the `impl ... for` blocks of the type (docs/adr/0081-operator-overloading.md).
  for block in resolution.type_blocks(item) {
    if let Some(block_info) = resolution.blocks.get(block as usize) {
      for function in block_info.functions {
        found.push(function);
      }
    }
  }

  found
}

/// The type item of a named type, with its type arguments.
fn named_item(ty: Type) -> Option<(TypeItem, List<Type>)> {
  match ty.kind {
    TypeKind::Struct(named) => Some((TypeItem::Struct(named.id), named.args)),
    TypeKind::Enum(named) => Some((TypeItem::Enum(named.id), named.args)),
    TypeKind::Class(named) => Some((TypeItem::Class(named.id), named.args)),
    TypeKind::Interface(named) => Some((TypeItem::Interface(named.id), named.args)),
    _ => None,
  }
}

/// The fields and methods declared by the type of `ty` and the types it inherits from, with its
/// type arguments in their types.
fn declared_members(analysis: Analysis, ty: Type) -> List<Member> {
  const found: List<Member> = new List();
  const package = match analysis.package {
    Some(value) => value,
    None => return found,
  };
  const resolution = match analysis.resolution {
    Some(value) => value,
    None => return found,
  };
  const typed = match analysis.typed {
    Some(value) => value,
    None => return found,
  };
  const named = match named_item(ty) {
    Some(value) => value,
    None => return found,
  };
  const item = named.0;
  const args = named.1;
  // The type and its ancestors, each with its own type arguments.
  const owners: List<(TypeItem, List<Type>)> = List::from([(item, args)]);

  if let TypeItem::Class(id) = item {
    for ancestor_id in typed.class_chain(id) {
      if ancestor_id != id {
        owners.push((TypeItem::Class(ancestor_id), ancestor_args(typed, id, ancestor_id, args)));
      }
    }
  }

  for owner in owners {
    const subst = Subst::of(ParamOwner::Item(owner.0), owner.1);

    for field in fields_of(typed, owner.0) {
      const field_ty = types::substitute(field.1, subst);

      found.push(Member {
        name: field.0,
        signature: field.0 + ": " + types::text(field_ty),
        doc: docs::of_field(analysis, owner.0, field.0),
        is_field: true,
        function: None,
        params: new List(),
        general: false,
        ty: Some(field_ty),
      });
    }

    for function in functions_of(resolution, owner.0) {
      if let Some(decl) = resolution.fn_decl(package, function) {
        // A class's `new` initializes instances: `new Class(...)` calls it, an instance cannot.
        const initializer = decl.name.name == "new" && is_class(item);

        if decl.self_param.is_some() && !initializer {
          if let Some(member) = function_member(analysis, function, decl.name.name, ty, 0, Some(subst)) {
            found.push(member);
          }
        }
      }
    }
  }

  found
}

fn is_class(item: TypeItem) -> bool {
  match item {
    TypeItem::Class(_) => true,
    _ => false,
  }
}

/// The names and types of the fields an item declares itself.
fn fields_of(typed: TypedModule, item: TypeItem) -> List<(String, Type)> {
  const found: List<(String, Type)> = new List();

  match item {
    TypeItem::Struct(id) => {
      if let Some(def) = typed.structs.get(id as usize) {
        for field in def.fields {
          found.push((field.name, field.ty));
        }
      }
    }
    TypeItem::Class(id) => {
      if let Some(def) = typed.classes.get(id as usize) {
        for field in def.fields {
          found.push((field.name, field.ty));
        }
      }
    }
    TypeItem::Interface(id) => {
      if let Some(def) = typed.interfaces.get(id as usize) {
        for field in def.fields {
          found.push((field.name, field.ty));
        }
      }
    }
    TypeItem::Enum(_) => {}
  }

  found
}

/// The elements of a tuple, by their indices (docs/adr/0092-tuples.md, Q615).
pub fn tuple_members(ty: Type) -> List<Member> {
  const found: List<Member> = new List();

  if let TypeKind::Tuple(elems) = ty.kind {
    for index in 0..elems.len() {
      found.push(Member { name: `${index}`, signature: `${index}: ` + types::text(elems[index]), doc: "", is_field: true, function: None, params: new List(), general: false, ty: Some(elems[index]) });
    }
  }

  found
}

// ---- Static functions and builtins -----------------------------------------------------------

/// The functions the compiler provides that are not methods, one per line: `owner|name|signature|doc`,
/// where `owner` is the type or module before `::` (`int` and `float` for each number type, whose
/// name `T` stands for), or empty for the builtins of every module. A signature without `fn` is a
/// constant.
const STATICS: String = "|print|fn print(text: String)|Writes `text` to the standard output.
|println|fn println(text: String)|Writes `text` and a new line to the standard output.
|eprintln|fn eprintln(text: String)|Writes `text` and a new line to the standard error.
|panic|fn panic(message: String) -> never|Stops the program with `message` and exit code 101.
|assert|fn assert(condition: bool)|Panics with `assertion failed` if `condition` is false.
|assert_eq|fn assert_eq(left: T, right: T)|Panics, showing both values, if `left != right`.
|assert_ne|fn assert_ne(left: T, right: T)|Panics, showing both values, if `left == right`.
|unreachable|fn unreachable() -> never|Panics with `entered unreachable code`.
|todo|fn todo() -> never|Panics with `not yet implemented`.
ffi|string_from_c|fn string_from_c(pointer: *const c_char) -> String|Copies a C string; invalid UTF-8 becomes U+FFFD. Needs `unsafe`; a null pointer panics.
process|exit|fn exit(code: i32) -> never|Ends the program with the exit code `code`.
process|abort|fn abort() -> never|Ends the program at once, abnormally.
hint|black_box|fn black_box<T>(value: T) -> T|Returns `value`, keeping the compiler from computing it ahead, for benchmarks.
mem|size_of|fn size_of<T>() -> usize|The size of `T` in bytes, as C lays it out.
mem|align_of|fn align_of<T>() -> usize|The alignment of `T` in bytes, as C lays it out.
mem|zeroed|fn zeroed<T>() -> T|A value of the C type `T` with every byte zero. Needs `unsafe`.
CString|new|fn new(text: String) -> Result<CString, String>|A NUL-terminated copy of `text` for C, or an error if it holds a NUL byte.
Atomic|new|fn new(value: T) -> Atomic<T>|An atomic `bool` or integer, the type of a `const` field of a class.
Atomic|fence|fn fence(ordering: i32)|A memory fence with an ordering of `std::sync`.
List|from|fn from(values: [T; N]) -> List<T>|A list with the elements of an array.
List|with_capacity|fn with_capacity(capacity: usize) -> List<T>|An empty list with room for `capacity` elements.
String|from|fn from(value: T) -> String|The text of a `char` or another value convertible to `String`.
String|default|fn default() -> String|The empty string.
String|from_utf8|fn from_utf8(bytes: List<u8>) -> Result<String, String>|The text the bytes encode in UTF-8, or an error where they do not.
String|from_utf8_lossy|fn from_utf8_lossy(bytes: List<u8>) -> String|The text the bytes encode in UTF-8, with U+FFFD for each ill-formed sequence.
String|from_utf16|fn from_utf16(units: List<u16>) -> Result<String, String>|The text the units encode in UTF-16, or an error where they do not.
char|from_u32|fn from_u32(code: u32) -> Option<char>|The character with the code point `code`, or `None`.
char|from_digit|fn from_digit(digit: u32, radix: u32) -> Option<char>|The character of `digit` in base `radix`, or `None`.
char|from|fn from(value: u8) -> char|The character of a byte.
char|try_from|fn try_from(value: u32) -> Result<char, String>|The character with a code point, or why it is not one.
char|default|fn default() -> char|The character `\\0`.
int|MIN|const MIN: T|The smallest value of `T`.
int|MAX|const MAX: T|The largest value of `T`.
int|from|fn from(value: U) -> T|`value` as `T`, when every value of its type fits.
int|try_from|fn try_from(value: U) -> Result<T, String>|`value` as `T`, or an error if it does not fit.
int|default|fn default() -> T|Zero.
int|from_le_bytes|fn from_le_bytes(bytes: [u8; N]) -> T|The integer of the bytes, least significant first.
int|from_be_bytes|fn from_be_bytes(bytes: [u8; N]) -> T|The integer of the bytes, most significant first.
int|from_ne_bytes|fn from_ne_bytes(bytes: [u8; N]) -> T|The integer of the bytes, in the order of the target.
int|from_str_radix|fn from_str_radix(text: String, radix: u32) -> Result<T, String>|The integer `text` writes in base `radix`.
float|from|fn from(value: U) -> T|`value` as `T`, when it converts without loss.
float|default|fn default() -> T|Zero.";

/// The owner of `STATICS` a type or module name stands for.
fn static_owner(name: String) -> String {
  if types::int_from_name(name).is_some() {
    "int"
  } else if name == "f32" || name == "f64" {
    "float"
  } else {
    name
  }
}

fn static_member(owner: String, parts: List<String>) -> Member {
  const names = new Map<String, String>();

  if owner == "int" || owner == "float" {
    names.insert("T", parts[0]);
  }

  const signature = replace_words(parts[2], names);
  const open = signature.find("(");
  const params = match open {
    Some(at) => table_params(signature.substring(at, signature.len())),
    None => new List(),
  };

  Member { name: parts[1], signature: signature, doc: replace_words(parts[3], names), is_field: !signature.starts_with("fn "), function: None, params: params, general: false, ty: None }
}

/// The static functions and constants the compiler gives the type or module `name`
/// (`CString`, `i32`, `mem`), or the builtins of every module for an empty name.
pub fn statics(name: String) -> List<Member> {
  const owner = static_owner(name);
  const found: List<Member> = new List();

  for line in STATICS.lines() {
    const parts = line.split("|");

    if parts.len() == 4 && parts[0] == owner {
      parts[0] = name;
      found.push(static_member(owner, parts));
    }
  }

  found
}

/// A builtin by the name the resolver gives it: `println`, `CString::new`, `i32::MAX`,
/// `mem::size_of`, `hint::black_box`.
pub fn builtin(name: String) -> Option<Member> {
  const parts = name.split("::");
  const owner = if parts.len() == 2 { parts[0] } else { "" };
  const member_name = parts.last()?;

  for found in statics(owner) {
    if found.name == member_name {
      return Some(found);
    }
  }

  // `string_from_c`, `exit` and `abort` are named without their module.
  for module in List::from(["ffi", "process"]) {
    for found in statics(module) {
      if found.name == member_name && owner.is_empty() {
        return Some(found);
      }
    }
  }

  None
}

/// The type a reference refers to: its fields and methods are used through it
/// (docs/spec/03-memory.md#references).
pub fn referred(ty: Type) -> Type {
  match ty.kind {
    TypeKind::Ref { pointee, .. } => pointee,
    _ => ty,
  }
}

/// The parameters of a signature `fn name(a: A, b: B) -> R`, without `self`.
pub fn params_of(signature: String) -> List<String> {
  const open = match signature.find("(") {
    Some(at) => at,
    None => return new List(),
  };
  var depth = 0i32;
  var close = signature.len();
  var index = open;

  // The `)` that closes the parameters, not one of the result's type.
  for c in signature.substring(open, signature.len()).chars() {
    if c == '(' {
      depth += 1;
    } else if c == ')' {
      depth -= 1;

      if depth == 0 {
        close = index;
        break;
      }
    }

    index += c.len_utf8();
  }

  const found: List<String> = new List();

  for param in table_params(signature.substring(open, close + 1)) {
    if param != "self" && !param.starts_with("self:") {
      found.push(param);
    }
  }

  found
}
