//! The members of values, as completion, hover and signature help show them
//! (docs/adr/0109-language-server-members.md): the fields and methods of the program's types,
//! with the type arguments of the receiver, and the methods the compiler gives the built-in types
//! (docs/spec/02-types.md, docs/spec/11-standard-library.md), whose signatures come from the
//! prelude functions implementing them where there are some, and else from the table below.

use pkg::lsp::analysis::Analysis;
use pkg::lsp::docs;
use pkg::resolve::{ItemRef, ParamOwner, Resolution, TypeItem};
use pkg::types;
use pkg::types::generic;
use pkg::types::numbers;
use pkg::types::{NamedRef, Subst, SubstEntry, Type, TypeKind};
use pkg::types::typed::TypedModule;

/// A member of a value.
pub struct Member {
  pub name: String;
  /// `fn trim(self) -> String`, or `value: T` for a field, with the receiver's type arguments.
  pub signature: String;
  /// Markdown, or empty.
  pub doc: String;
  pub is_field: bool;
  /// The function, for the members declared in Sagitario code.
  pub function: Option<u32>;
  /// The names of the parameters after `self` and their types, for signature help.
  pub params: List<String>;
  /// Shown after the program's own members: the conversions every value has.
  pub general: bool;
  /// The type of the field, or of the result of the method, for the members of Sagitario code.
  pub ty: Option<Type>;
}

/// The methods the compiler gives the built-in types, one per line: `kind|name|source|doc`.
/// `source` is the signature without `self`, `(a: A) -> R`, where `T` is the value or element,
/// `E` the error of a `Result` and other capitals type parameters of the method; or `@name`, the
/// prelude function implementing it, whose first parameter is the receiver; or `#name`, the same
/// for a function of the root of `std`; or `*`, the method of `Iter` with that name, for the
/// iterator methods of lists and arrays.
const TABLE: String = "string|len|() -> usize|The number of bytes of the text, which is UTF-8.
string|is_empty|() -> bool|Whether the text has no characters.
string|contains|(pattern: String) -> bool|Whether `pattern` is part of the text.
string|starts_with|(prefix: String) -> bool|Whether the text starts with `prefix`.
string|ends_with|(suffix: String) -> bool|Whether the text ends with `suffix`.
string|find|(pattern: String) -> Option<usize>|The byte index of the first `pattern` in the text, or `None`.
