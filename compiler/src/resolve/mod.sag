//! Name resolution (docs/spec/09-modules.md), the port of `sagitario_resolve`: builds the module
//! tree of the package, resolves `use` declarations and binds every path expression, pattern and
//! type path to what it names. Lookup order for a single name: local bindings (innermost scope
//! first, later shadowing earlier), the module's items and imports, then the prelude. Ids are
//! `u32` indices; maps by node id are `Map<u32, ...>`.

use pkg::ast::{
  Block, ClassDecl, ConstDecl, EnumDecl, Expr, ExprKind, ExternFn, FnDecl, GenericParam, Ident, InterfaceDecl, Item, LambdaParam, Module, Package,
  Path, Pattern, PatternKind, Stmt, StructDecl, TemplatePart, TypeExpr, TypeExprKind, VariantFields, Visibility,
};
use pkg::diagnostics;
use pkg::diagnostics::{Diagnostic, Diagnostics};
use pkg::diagnostics::codes;
use pkg::resolve::modules;
use pkg::span::Span;

/// The builtins a single name can refer to, besides `Error`, `List::from`, `CString::new`,
/// `string_from_c`, `exit` and `char::from_u32`.
fn builtin_from_name(name: String) -> Option<String> {
  if name == "print" || name == "println" || name == "eprintln" || name == "panic" || name == "include_str" { Some(name) } else { None }
}

const BUILTIN_NAMES: String = "print println eprintln panic include_str";

/// The C types of `std::ffi`, by name.
const C_TYPES: String = "c_char c_schar c_uchar c_short c_ushort c_int c_uint c_long c_ulong c_longlong c_ulonglong c_float c_double c_void";

fn c_type_names() -> List<String> {
  C_TYPES.split(" ")
}

/// A module or item of the standard library provided by the compiler.
pub enum StdItem {
  Root,
  Ffi,
  /// A C type, by its name (`c_int`).
  CType(String),
  CString,
  StringFromC,
  Exit,
}

/// A type declared by the program, which can have functions.
pub enum TypeItem {
  Struct(u32),
  Enum(u32),
  Class(u32),
  Interface(u32),
}

pub fn same_type_item(a: TypeItem, b: TypeItem) -> bool {
  match a {
    TypeItem::Struct(x) => match b {
      TypeItem::Struct(y) => x == y,
      _ => false,
    },
    TypeItem::Enum(x) => match b {
      TypeItem::Enum(y) => x == y,
      _ => false,
    },
    TypeItem::Class(x) => match b {
      TypeItem::Class(y) => x == y,
      _ => false,
    },
    TypeItem::Interface(x) => match b {
      TypeItem::Interface(y) => x == y,
      _ => false,
    },
  }
}

/// The enum a variant belongs to: a program enum or one of the prelude's.
pub enum EnumKind {
  User(u32),
  /// Variants `None` (0) and `Some` (1).
  Option,
  /// Variants `Ok` (0) and `Err` (1).
  Result,
}

fn prelude_variants(kind: EnumKind) -> List<String> {
  match kind {
    EnumKind::Option => List::from(["None", "Some"]),
    EnumKind::Result => List::from(["Ok", "Err"]),
    EnumKind::User(_) => new List(),
  }
}

pub struct VariantRef {
  pub owner: EnumKind;
  /// Position of the variant in its enum.
  pub index: u32;
}

/// The prelude variant with this name (`Some`, `None`, `Ok`, `Err`).
fn prelude_variant(name: String) -> Option<VariantRef> {
  for owner in List::from([EnumKind::Option, EnumKind::Result]) {
    if let Some(index) = prelude_variants(owner).index_of(name) {
      return Some(VariantRef { owner: owner, index: index as u32 });
    }
  }

  None
}

pub enum LocalKind {
  Param,
  SelfParam,
  Const,
  Var,
  ForVar,
  Pattern,
}

/// The bindings of a lambda: its own locals are numbered from `first_local` to `end_local`, and
/// it captures the enclosing locals in `captures`.
pub class LambdaInfo {
  pub var params: List<u32>;
  pub var first_local: u32;
  pub var end_local: u32;
  pub var captures: List<u32>;

  pub fn new(self, first_local: u32) {
    self.params = new List();
    self.first_local = first_local;
    self.end_local = 4294967295;
    self.captures = new List();
  }

  /// Whether a local is declared inside the lambda.
  pub fn owns(self, local: u32) -> bool {
    local >= self.first_local && local < self.end_local
  }
}

pub struct LocalInfo {
  pub name: String;
  pub span: Span;
  pub kind: LocalKind;
}

/// What a path expression, struct literal or pattern refers to.
pub enum Res {
  Fn(u32),
  Extern(u32),
  /// A builtin, by its name.
  Builtin(String),
  Local(u32),
  Struct(u32),
  Variant(VariantRef),
  Const(u32),
}

/// The declaration a type parameter belongs to.
pub enum ParamOwner {
  Item(TypeItem),
  Fn(u32),
}

/// What a type path refers to.
pub enum TypeRes {
  Item(TypeItem),
  Param { owner: ParamOwner, index: u32 },
  Builtin,
  CType(String),
  CString,
  Error,
}

/// What a module-level name refers to.
pub enum ItemRef {
  Fn(u32),
  Extern(u32),
  Const(u32),
  Type(TypeItem),
  Module(u32),
  Std(StdItem),
}

pub struct Declared {
  pub item: ItemRef;
  pub span: Span;
  pub visibility: Visibility;
}

pub struct Imported {
  pub item: ItemRef;
  pub span: Span;
}

/// A module of the package: a source file, or a directory without its own file.
pub class ModuleInfo {
  pub var path: List<String>;
  pub var in_std: bool;
  pub var package: usize;
  pub var root: String;
  pub var source: Option<usize>;
  pub var parent: Option<u32>;
  pub const children: Map<String, u32>;
  pub const items: Map<String, Declared>;
  pub const imports: Map<String, Imported>;

  pub fn new(self) {
    self.path = new List();
    self.in_std = false;
    self.package = 0;
    self.root = "";
    self.source = None;
    self.parent = None;
    self.children = new Map<String, u32>();
    self.items = new Map<String, Declared>();
    self.imports = new Map<String, Imported>();
  }

  /// The path as written in source: `pkg`, `pkg::net::http`.
  pub fn display_path(self) -> String {
    if self.in_std {
      return self.path.join("::");
    }

    const parts = List::from([if self.root.is_empty() { "pkg" } else { self.root }]);

    for segment in self.path {
      parts.push(segment);
    }

    parts.join("::")
  }
}

pub struct FnInfo {
  pub module: usize;
  pub item: usize;
  pub member: Option<usize>;
  pub owner: Option<TypeItem>;
}

pub struct ConstInfo {
  pub module: usize;
  pub item: usize;
}

pub struct ExternInfo {
  pub module: usize;
  pub item: usize;
  pub member: usize;
}

pub struct TypeInfo {
  pub module: usize;
  pub item: usize;
  pub functions: List<u32>;
}

/// The item at `item` of the module at `module`.
fn item_at(package: Package, module: usize, item: usize) -> Option<Item> {
  match package.modules.get(module) {
    Some(found) => found.items.get(item),
    None => None,
  }
}

pub class Resolution {
  pub const functions: List<FnInfo>;
  pub const structs: List<TypeInfo>;
  pub const enums: List<TypeInfo>;
  pub const classes: List<TypeInfo>;
  pub const interfaces: List<TypeInfo>;
  pub const consts: List<ConstInfo>;
  pub var prelude: Option<u32>;
  pub var std_root: Option<u32>;
  pub const package_roots: List<u32>;
  pub var error_interface: Option<u32>;
  pub const externs: List<ExternInfo>;
  pub const modules: List<ModuleInfo>;
  /// Local bindings of each function, indexed by function id then local id.
  pub const locals: List<List<LocalInfo>>;
  pub const paths: Map<u32, Res>;
  pub const type_paths: Map<u32, TypeRes>;
  pub const bindings: Map<u32, u32>;
  pub const lambdas: Map<u32, LambdaInfo>;
  pub var main: Option<u32>;

  pub fn new(self) {
    self.functions = new List();
    self.structs = new List();
    self.enums = new List();
    self.classes = new List();
    self.interfaces = new List();
    self.consts = new List();
    self.prelude = None;
    self.std_root = None;
    self.package_roots = new List();
    self.error_interface = None;
    self.externs = new List();
    self.modules = new List();
    self.locals = new List();
    self.paths = new Map<u32, Res>();
    self.type_paths = new Map<u32, TypeRes>();
    self.bindings = new Map<u32, u32>();
    self.lambdas = new Map<u32, LambdaInfo>();
    self.main = None;
  }

  pub fn fn_decl(self, package: Package, id: u32) -> Option<FnDecl> {
    const info = self.functions.get(id as usize)?;
    const item = item_at(package, info.module, info.item)?;

    match info.member {
      None => match item {
        Item::Fn(decl) => Some(decl),
        _ => None,
      },
      Some(member) => match item {
        Item::Struct(decl) => decl.functions.get(member),
        Item::Enum(decl) => decl.functions.get(member),
        Item::Class(decl) => decl.functions.get(member),
        Item::Interface(decl) => decl.functions.get(member),
        _ => None,
      },
    }
  }

  pub fn extern_decl(self, package: Package, id: u32) -> Option<ExternFn> {
    const info = self.externs.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Extern(block) => block.functions.get(info.member),
      _ => None,
    }
  }

  pub fn const_decl(self, package: Package, id: u32) -> Option<ConstDecl> {
    const info = self.consts.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Const(decl) => Some(decl),
      _ => None,
    }
  }

  pub fn struct_decl(self, package: Package, id: u32) -> Option<StructDecl> {
    const info = self.structs.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Struct(decl) => Some(decl),
      _ => None,
    }
  }

  pub fn enum_decl(self, package: Package, id: u32) -> Option<EnumDecl> {
    const info = self.enums.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Enum(decl) => Some(decl),
      _ => None,
    }
  }

  pub fn class_decl(self, package: Package, id: u32) -> Option<ClassDecl> {
    const info = self.classes.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Class(decl) => Some(decl),
      _ => None,
    }
  }

  pub fn interface_decl(self, package: Package, id: u32) -> Option<InterfaceDecl> {
    const info = self.interfaces.get(id as usize)?;

    match item_at(package, info.module, info.item)? {
      Item::Interface(decl) => Some(decl),
      _ => None,
    }
  }

  /// The type parameters of a generic declaration.
  pub fn generics(self, package: Package, owner: ParamOwner) -> List<GenericParam> {
    const found: Option<List<GenericParam>> = match owner {
      ParamOwner::Fn(id) => match self.fn_decl(package, id) {
        Some(decl) => Some(decl.generics),
        None => None,
      },
      ParamOwner::Item(item) => match item {
        TypeItem::Struct(id) => match self.struct_decl(package, id) {
          Some(decl) => Some(decl.generics),
          None => None,
        },
        TypeItem::Enum(id) => match self.enum_decl(package, id) {
          Some(decl) => Some(decl.generics),
          None => None,
        },
        TypeItem::Class(id) => match self.class_decl(package, id) {
          Some(decl) => Some(decl.generics),
          None => None,
        },
        TypeItem::Interface(id) => match self.interface_decl(package, id) {
          Some(decl) => Some(decl.generics),
          None => None,
        },
      },
    };

    found.unwrap_or(new List())
  }

  /// The name of a struct, enum, class or interface.
  pub fn type_name(self, package: Package, item: TypeItem) -> String {
    const name: Option<String> = match item {
      TypeItem::Struct(id) => match self.struct_decl(package, id) {
        Some(decl) => Some(decl.name.name),
        None => None,
      },
      TypeItem::Enum(id) => match self.enum_decl(package, id) {
        Some(decl) => Some(decl.name.name),
        None => None,
      },
      TypeItem::Class(id) => match self.class_decl(package, id) {
        Some(decl) => Some(decl.name.name),
        None => None,
      },
      TypeItem::Interface(id) => match self.interface_decl(package, id) {
        Some(decl) => Some(decl.name.name),
        None => None,
      },
    };

    name.unwrap_or("")
  }

  /// The functions a type declares, in declaration order.
  pub fn type_functions(self, package: Package, item: TypeItem) -> List<FnDecl> {
    const functions: Option<List<FnDecl>> = match item {
      TypeItem::Struct(id) => match self.struct_decl(package, id) {
        Some(decl) => Some(decl.functions),
        None => None,
      },
      TypeItem::Enum(id) => match self.enum_decl(package, id) {
        Some(decl) => Some(decl.functions),
        None => None,
      },
      TypeItem::Class(id) => match self.class_decl(package, id) {
        Some(decl) => Some(decl.functions),
        None => None,
      },
      TypeItem::Interface(id) => match self.interface_decl(package, id) {
        Some(decl) => Some(decl.functions),
        None => None,
      },
    };

    functions.unwrap_or(new List())
  }

  /// A type's function (method or static) by name.
  pub fn type_function(self, package: Package, item: TypeItem, name: String) -> Option<u32> {
    const info = match item {
      TypeItem::Struct(id) => self.structs.get(id as usize),
      TypeItem::Enum(id) => self.enums.get(id as usize),
      TypeItem::Class(id) => self.classes.get(id as usize),
      TypeItem::Interface(id) => self.interfaces.get(id as usize),
    }?;

    for function in info.functions {
      if let Some(decl) = self.fn_decl(package, function) {
        if decl.name.name == name {
          return Some(function);
        }
      }
    }

    None
  }

  /// The type that declares a function.
  pub fn owner(self, id: u32) -> Option<TypeItem> {
    match self.functions.get(id as usize) {
      Some(info) => info.owner,
      None => None,
    }
  }

  /// Whether a function is the initializer `new` of a class.
  pub fn is_initializer(self, package: Package, id: u32) -> bool {
    const in_class = match self.owner(id) {
      Some(TypeItem::Class(_)) => true,
      _ => false,
    };

    in_class && match self.fn_decl(package, id) {
      Some(decl) => decl.name.name == "new",
      None => false,
    }
  }

  /// The initializer of a class: its function `new` (docs/spec/04-classes.md).
  pub fn initializer(self, package: Package, id: u32) -> Option<u32> {
    const function = self.type_function(package, TypeItem::Class(id), "new")?;

    if self.is_initializer(package, function) { Some(function) } else { None }
  }

  /// Whether a function is a method: it takes `self` and is not an initializer.
  pub fn is_method(self, package: Package, id: u32) -> bool {
    const takes_self = match self.fn_decl(package, id) {
      Some(decl) => decl.self_param.is_some(),
      None => false,
    };

    takes_self && !self.is_initializer(package, id)
  }

  pub fn module(self, id: u32) -> Option<ModuleInfo> {
    self.modules.get(id as usize)
  }

  /// An item of the prelude module by name, public or not.
  pub fn prelude_item(self, name: String) -> Option<ItemRef> {
    const declared = self.module(self.prelude?)?.items.get(name)?;

    Some(declared.item)
  }

  /// A function of the prelude module by name.
  pub fn prelude_fn(self, name: String) -> Option<u32> {
    match self.prelude_item(name) {
      Some(ItemRef::Fn(id)) => Some(id),
      _ => None,
    }
  }

  /// The local bindings of a function.
  pub fn function_locals(self, id: u32) -> List<LocalInfo> {
    self.locals.get(id as usize).unwrap_or(new List())
  }

  /// A type of the prelude module by name.
  pub fn prelude_type(self, name: String) -> Option<TypeItem> {
    match self.prelude_item(name) {
      Some(ItemRef::Type(item)) => Some(item),
      _ => None,
    }
  }

  /// Whether the module at this index of `Package::modules` is the prelude.
  pub fn is_prelude_source(self, source: usize) -> bool {
    match self.prelude {
      Some(prelude) => match self.module(prelude) {
        Some(module) => match module.source {
          Some(found) => found == source,
          None => false,
        },
        None => false,
      },
      None => false,
    }
  }

  /// Whether a function (or the type declaring it) belongs to the prelude module.
  pub fn in_prelude(self, id: u32) -> bool {
    const source = match self.prelude {
      Some(prelude) => match self.module(prelude) {
        Some(module) => module.source,
        None => None,
      },
      None => None,
    };

    match source {
      Some(found) => match self.functions.get(id as usize) {
        Some(info) => info.module == found,
        None => false,
      },
      None => false,
    }
  }

  /// Whether a function (or the type declaring it) belongs to the prelude or the standard
  /// library, which programs only contain the parts of that they use.
  pub fn in_library(self, id: u32) -> bool {
    if self.in_prelude(id) {
      return true;
    }

    match self.functions.get(id as usize) {
      Some(info) => self.is_std_source(info.module),
      None => false,
    }
  }

  /// Whether the module at this index of `Package::modules` belongs to the standard library.
  pub fn is_std_source(self, source: usize) -> bool {
    for module in self.modules {
      if module.in_std {
        if let Some(found) = module.source {
          if found == source {
            return true;
          }
        }
      }
    }

    false
  }

  /// Whether a C function is a function of the runtime, which only the standard library, its
  /// prelude included, may declare: its name starts with `sag_`.
  pub fn is_runtime_extern(self, package: Package, id: u32) -> bool {
    const in_std = match self.externs.get(id as usize) {
      Some(info) => self.is_std_source(info.module) || self.is_prelude_source(info.module),
      None => false,
    };

    in_std && match self.extern_decl(package, id) {
      Some(decl) => decl.name.name.starts_with("sag_"),
      None => false,
    }
  }

  /// The root module of the package of `module`: what `pkg` names there.
  pub fn package_root(self, module: u32) -> u32 {
    match self.module(module) {
      Some(info) => self.package_roots.get(info.package).unwrap_or(0),
      None => 0,
    }
  }

  /// The root module of the dependency called `name` of the package of `module`.
  pub fn dependency_root(self, package: Package, module: u32, name: String) -> Option<u32> {
    const current = self.module(module)?.package;
    const info = package.packages.get(current)?;

    for index in info.dependencies {
      if let Some(dependency) = package.packages.get(index) {
        if dependency.name == name {
          return self.package_roots.get(index);
        }
      }
    }

    None
  }

  /// Whether `inner` is `outer` or one of its submodules, which see `outer`'s private items.
  pub fn is_within(self, inner: u32, outer: u32) -> bool {
    var current: Option<u32> = Some(inner);

    while let Some(id) = current {
      if id == outer {
        return true;
      }

      current = match self.module(id) {
        Some(info) => info.parent,
        None => None,
      };
    }

    false
  }
}

fn is_initializer_decl(decl: FnDecl) -> bool {
  decl.name.name == "new"
}

/// Names of the concurrency model that programs cannot declare.
fn is_reserved_name(name: String) -> bool {
  name == "Send" || name == "Sync"
}

/// The modules of the standard library (docs/spec/11-standard-library.md).
pub const STD_MODULES: String = "env ffi fs io path process sync thread time";

fn is_numeric_type(name: String) -> bool {
  NUMERIC_TYPES.split(" ").contains(name)
}

/// Integer and float type names, which take precedence over program types.
const NUMERIC_TYPES: String = "i8 i16 i32 i64 i128 isize u8 u16 u32 u64 u128 usize f32 f64";

/// Prelude and primitive type names that program types can shadow.
const PRELUDE_TYPES: String = "bool char String StringBuilder Option Result List";

pub fn resolve(package: Package, diagnostics: Diagnostics) -> Resolution {
  const resolution = new Resolution();
  const module_ids = modules::build_tree(resolution, package);

  for source in 0..package.modules.len() {
    declare_items(resolution, source, module_of(module_ids, source), package.modules[source], diagnostics);
  }

  if let Some(prelude) = resolution.prelude {
    if let Some(info) = resolution.module(prelude) {
      if let Some(declared) = info.items.get("Error") {
        if let ItemRef::Type(TypeItem::Interface(id)) = declared.item {
          resolution.error_interface = Some(id);
        }
      }
    }
  }

  if let Some(root) = resolution.module(0) {
    if let Some(declared) = root.items.get("main") {
      if let ItemRef::Fn(id) = declared.item {
        if !package.library {
          resolution.main = Some(id);
        }
      }
    }
  }

  if resolution.main.is_none() && !package.library {
    if let Some(root) = package.modules.first() {
      diagnostics.push(
        Diagnostic::error(codes::MISSING_MAIN, Span::new(root.file, 0, 0), "the program has no `main` function").with_note("add `fn main() { }`"),
      );
    }
  }

  for source in 0..package.modules.len() {
    modules::resolve_imports(resolution, package, module_of(module_ids, source), package.modules[source], diagnostics);
  }

  const used = new Map<String, bool>();
  // The types in the fields of structs and variants, then each function.
  const declarations: List<Pending> = new List();

  for index in 0..resolution.structs.len() {
    if let Some(decl) = resolution.struct_decl(package, index as u32) {
      const types: List<TypeExpr> = new List();

      for field in decl.fields {
        types.push(field.ty);
      }

      add_bounds(types, decl.generics);
      declarations.push(Pending { owner: Some(TypeItem::Struct(index as u32)), module: resolution.structs[index].module, types: types });
    }
  }

  for index in 0..resolution.enums.len() {
    if let Some(decl) = resolution.enum_decl(package, index as u32) {
      const types: List<TypeExpr> = new List();

      for variant in decl.variants {
        match variant.fields {
          VariantFields::Unit => {}
          VariantFields::Tuple(fields) => {
            for ty in fields {
              types.push(ty);
            }
          }
          VariantFields::Named(fields) => {
            for field in fields {
              types.push(field.ty);
            }
          }
        }
      }

      add_bounds(types, decl.generics);
      declarations.push(Pending { owner: Some(TypeItem::Enum(index as u32)), module: resolution.enums[index].module, types: types });
    }
  }

  for index in 0..resolution.classes.len() {
    if let Some(decl) = resolution.class_decl(package, index as u32) {
      const types: List<TypeExpr> = new List();

      for field in decl.fields {
        types.push(field.ty);
      }

      add_bounds(types, decl.generics);
      declarations.push(Pending { owner: Some(TypeItem::Class(index as u32)), module: resolution.classes[index].module, types: types });
    }
  }

  for index in 0..resolution.interfaces.len() {
    if let Some(decl) = resolution.interface_decl(package, index as u32) {
      const types: List<TypeExpr> = new List();

      for field in decl.fields {
        types.push(field.ty);
      }

      add_bounds(types, decl.generics);
      declarations.push(Pending { owner: Some(TypeItem::Interface(index as u32)), module: resolution.interfaces[index].module, types: types });
    }
  }

  // The parent class of each class (`extends`), the interfaces each type implements (`impl`)
  // and the parents of each interface.
  const supertypes: List<Pending> = new List();

  for index in 0..resolution.classes.len() {
    if let Some(decl) = resolution.class_decl(package, index as u32) {
      const types: List<TypeExpr> = new List();

      if let Some(parent) = decl.parent {
        types.push(parent);
      }

      for ty in decl.impls {
        types.push(ty);
      }

      supertypes.push(Pending { owner: Some(TypeItem::Class(index as u32)), module: resolution.classes[index].module, types: types });
    }
  }

  for index in 0..resolution.structs.len() {
    if let Some(decl) = resolution.struct_decl(package, index as u32) {
      supertypes.push(Pending { owner: Some(TypeItem::Struct(index as u32)), module: resolution.structs[index].module, types: decl.impls });
    }
  }

  for index in 0..resolution.enums.len() {
    if let Some(decl) = resolution.enum_decl(package, index as u32) {
      supertypes.push(Pending { owner: Some(TypeItem::Enum(index as u32)), module: resolution.enums[index].module, types: decl.impls });
    }
  }

  for index in 0..resolution.interfaces.len() {
    if let Some(decl) = resolution.interface_decl(package, index as u32) {
      supertypes.push(Pending { owner: Some(TypeItem::Interface(index as u32)), module: resolution.interfaces[index].module, types: decl.parents });
    }
  }

  for pending in supertypes {
    const resolver = new Resolver(package, resolution, module_of(module_ids, pending.module), pending.owner, diagnostics);

    for ty in pending.types {
      resolver.type_expr(ty);
    }

    merge_used(used, resolver.used);
    merge_type_paths(resolution, resolver);
  }

  for pending in declarations {
    const resolver = new Resolver(package, resolution, module_of(module_ids, pending.module), pending.owner, diagnostics);

    for ty in pending.types {
      resolver.type_expr(ty);
    }

    merge_used(used, resolver.used);
    merge_type_paths(resolution, resolver);
  }

  for index in 0..resolution.externs.len() {
    const id = index as u32;
    const decl = match resolution.extern_decl(package, id) {
      Some(decl) => decl,
      None => continue,
    };
    const resolver = new Resolver(package, resolution, module_of(module_ids, resolution.externs[index].module), None, diagnostics);

    for param in decl.params {
      resolver.type_expr(param.ty);
    }

    if let Some(ty) = decl.return_type {
      resolver.type_expr(ty);
    }

    merge_used(used, resolver.used);
    merge_type_paths(resolution, resolver);
  }

  // The type and value of each module-level constant, which other constants may name.
  for index in 0..resolution.consts.len() {
    const decl = match resolution.const_decl(package, index as u32) {
      Some(decl) => decl,
      None => continue,
    };
    const resolver = new Resolver(package, resolution, module_of(module_ids, resolution.consts[index].module), None, diagnostics);

    resolver.type_expr(decl.ty);
    resolver.expr(decl.value);

    for entry in resolver.paths.entries() {
      resolution.paths.insert(entry.key, entry.value);
    }

    merge_type_paths(resolution, resolver);
    merge_used(used, resolver.used);
  }

  for index in 0..resolution.functions.len() {
    const id = index as u32;
    const decl = match resolution.fn_decl(package, id) {
      Some(decl) => decl,
      None => continue,
    };
    const info = resolution.functions[index];
    const resolver = new Resolver(package, resolution, module_of(module_ids, info.module), info.owner, diagnostics);

    resolver.enter_generics(ParamOwner::Fn(id), decl.generics);

    for param in decl.generics {
      for bound in param.bounds {
        resolver.type_expr(bound);
      }
    }

    const in_class = match info.owner {
      Some(TypeItem::Class(_)) => true,
      _ => false,
    };

    if let Some(span) = decl.self_param {
      resolver.declare("self", span, LocalKind::SelfParam);
    } else if in_class && is_initializer_decl(decl) {
      // An initializer missing its `self` (an error) still gets one, to report nothing else.
      resolver.declare("self", decl.name.span, LocalKind::SelfParam);
    }

    for param in decl.params {
      if let Some(previous) = resolver.lookup_local(param.name.name) {
        if let Some(local) = resolver.locals.get(previous as usize) {
          diagnostics.push(
            Diagnostic::error(codes::DUPLICATE_DEFINITION, param.name.span, "the parameter `" + param.name.name + "` is declared more than once")
              .with_label(local.span, "previous declaration here"),
          );
        }
      }

      resolver.type_expr(param.ty);
      resolver.declare(param.name.name, param.name.span, LocalKind::Param);
    }

    if let Some(ty) = decl.return_type {
      resolver.type_expr(ty);
    }

    resolver.block(decl.body);
    resolution.locals.push(resolver.locals);

    for entry in resolver.paths.entries() {
      resolution.paths.insert(entry.key, entry.value);
    }

    for entry in resolver.bindings.entries() {
      resolution.bindings.insert(entry.key, entry.value);
    }

    for entry in resolver.lambdas.entries() {
      resolution.lambdas.insert(entry.key, entry.value);
    }

    merge_type_paths(resolution, resolver);
    merge_used(used, resolver.used);
  }

  modules::report_unused_imports(resolution, used, diagnostics);
  modules::report_private_interfaces(resolution, package, diagnostics);

  resolution
}

/// Types to resolve in the context of one declaration.
struct Pending {
  pub owner: Option<TypeItem>;
  pub module: usize;
  pub types: List<TypeExpr>;
}

fn add_bounds(types: List<TypeExpr>, generics: List<GenericParam>) {
  for param in generics {
    for bound in param.bounds {
      types.push(bound);
    }
  }
}

fn merge_used(used: Map<String, bool>, more: Map<String, bool>) {
  for entry in more.entries() {
    used.insert(entry.key, true);
  }
}

fn merge_type_paths(resolution: Resolution, resolver: Resolver) {
  for entry in resolver.type_paths.entries() {
    resolution.type_paths.insert(entry.key, entry.value);
  }
}

/// The key of an import in the set of used imports.
pub fn used_key(module: u32, name: String) -> String {
  `${module}:${name}`
}

/// The module of the file at `source`.
fn module_of(module_ids: List<u32>, source: usize) -> u32 {
  module_ids.get(source).unwrap_or(0)
}

/// Registers the functions, structs and enums of one module.
fn declare_items(resolution: Resolution, source: usize, node: u32, module: Module, diagnostics: Diagnostics) {
  for index in 0..module.items.len() {
    const names: List<Named> = new List();

    match module.items[index] {
      Item::Fn(decl) => {
        const id = resolution.functions.len() as u32;

        resolution.functions.push(FnInfo { module: source, item: index, member: None, owner: None });
        names.push(Named { name: decl.name, item: ItemRef::Fn(id), visibility: decl.visibility });
      }
      Item::Extern(block) => {
        for member in 0..block.functions.len() {
          const function = block.functions[member];
          const id = resolution.externs.len() as u32;

          resolution.externs.push(ExternInfo { module: source, item: index, member: member });
          names.push(Named { name: function.name, item: ItemRef::Extern(id), visibility: function.visibility });
        }
      }
      Item::Struct(decl) => {
        const owner = TypeItem::Struct(resolution.structs.len() as u32);
        const functions = register_functions(resolution, source, index, decl.functions.len(), owner);

        resolution.structs.push(TypeInfo { module: source, item: index, functions: functions });

        const members: List<Ident> = new List();

        for field in decl.fields {
          members.push(field.name);
        }

        for function in decl.functions {
          members.push(function.name);
        }

        check_members(decl.name.name, "fields and functions of a struct share one namespace", members, diagnostics);
        names.push(Named { name: decl.name, item: ItemRef::Type(owner), visibility: decl.visibility });
      }
      Item::Class(decl) => {
        const owner = TypeItem::Class(resolution.classes.len() as u32);
        const functions = register_functions(resolution, source, index, decl.functions.len(), owner);

        resolution.classes.push(TypeInfo { module: source, item: index, functions: functions });

        const members: List<Ident> = new List();

        for field in decl.fields {
          members.push(field.name);
        }

        for function in decl.functions {
          members.push(function.name);
        }

        check_members(decl.name.name, "fields and functions of a class share one namespace", members, diagnostics);
        names.push(Named { name: decl.name, item: ItemRef::Type(owner), visibility: decl.visibility });
      }
      Item::Interface(decl) => {
        const owner = TypeItem::Interface(resolution.interfaces.len() as u32);
        const functions = register_functions(resolution, source, index, decl.functions.len(), owner);

        resolution.interfaces.push(TypeInfo { module: source, item: index, functions: functions });

        const members: List<Ident> = new List();

        for field in decl.fields {
          members.push(field.name);
        }

        for function in decl.functions {
          members.push(function.name);
        }

        check_members(decl.name.name, "fields and methods of an interface share one namespace", members, diagnostics);
        names.push(Named { name: decl.name, item: ItemRef::Type(owner), visibility: decl.visibility });
      }
      Item::Enum(decl) => {
        const owner = TypeItem::Enum(resolution.enums.len() as u32);
        const functions = register_functions(resolution, source, index, decl.functions.len(), owner);

        resolution.enums.push(TypeInfo { module: source, item: index, functions: functions });

        const members: List<Ident> = new List();

        for variant in decl.variants {
          members.push(variant.name);
        }

        for function in decl.functions {
          members.push(function.name);
        }

        check_members(decl.name.name, "variants and functions of an enum share one namespace", members, diagnostics);

        for variant in decl.variants {
          if let VariantFields::Named(fields) = variant.fields {
            const field_names: List<Ident> = new List();

            for field in fields {
              field_names.push(field.name);
            }

            check_members(variant.name.name, "the fields of a variant need different names", field_names, diagnostics);
          }
        }

        names.push(Named { name: decl.name, item: ItemRef::Type(owner), visibility: decl.visibility });
      }
      Item::Const(decl) => {
        const id = resolution.consts.len() as u32;

        resolution.consts.push(ConstInfo { module: source, item: index });
        names.push(Named { name: decl.name, item: ItemRef::Const(id), visibility: decl.visibility });
      }
    }

    for named in names {
      declare_item(resolution, node, named.name, named.item, named.visibility, diagnostics);
    }
  }
}

/// A module-level name to declare.
struct Named {
  pub name: Ident;
  pub item: ItemRef;
  pub visibility: Visibility;
}

/// Adds a module-level name, reporting a clash with another item or a submodule.
fn declare_item(resolution: Resolution, node: u32, name: Ident, item: ItemRef, visibility: Visibility, diagnostics: Diagnostics) {
  // The prelude declares `Send`.
  const is_prelude = match resolution.prelude {
    Some(prelude) => prelude == node,
    None => false,
  };

  if !is_prelude {
    check_reserved(name.name, name.span, diagnostics);
  }

  const info = match resolution.module(node) {
    Some(info) => info,
    None => return,
  };

  if let Some(previous) = info.items.get(name.name) {
    diagnostics.push(
      Diagnostic::error(codes::DUPLICATE_DEFINITION, name.span, "the name `" + name.name + "` is defined more than once")
        .with_label(previous.span, "previous definition here")
        .with_note("functions, structs, enums and classes share one namespace per module"),
    );
  } else if info.children.contains_key(name.name) {
    const module_path = info.display_path() + "::" + name.name;

    diagnostics.push(
      Diagnostic::error(codes::DUPLICATE_DEFINITION, name.span, "the name `" + name.name + "` is also the module `" + module_path + "`")
        .with_note("items and modules share one namespace; rename the item or the module's file or directory"),
    );
  } else {
    info.items.insert(name.name, Declared { item: item, span: name.span, visibility: visibility });
  }
}

fn register_functions(resolution: Resolution, source: usize, item: usize, count: usize, owner: TypeItem) -> List<u32> {
  const functions: List<u32> = new List();

  for member in 0..count {
    functions.push(resolution.functions.len() as u32);
    resolution.functions.push(FnInfo { module: source, item: item, member: Some(member), owner: Some(owner) });
  }

  functions
}

/// Reports names declared twice among the members of a type.
fn check_members(owner: String, note: String, names: List<Ident>, diagnostics: Diagnostics) {
  const seen = new Map<String, Span>();

  for name in names {
    check_reserved(name.name, name.span, diagnostics);

    if let Some(previous) = seen.get(name.name) {
      diagnostics.push(
        Diagnostic::error(codes::DUPLICATE_DEFINITION, name.span, "the name `" + name.name + "` is declared more than once in `" + owner + "`")
          .with_label(previous, "previous declaration here")
          .with_note(note),
      );
    } else {
      seen.insert(name.name, name.span);
    }
  }
}

pub fn check_reserved(name: String, span: Span, diagnostics: Diagnostics) {
  if is_reserved_name(name) {
    diagnostics.push(Diagnostic::error(codes::RESERVED_NAME, span, "`" + name + "` is reserved by the concurrency model and cannot be declared"));
  }
}

/// What the start of a qualified path names: a module-level item, or a prelude enum.
pub enum Start {
  Item(ItemRef),
  Prelude(EnumKind),
  /// The prelude's `List`, with the static function `from`.
  List,
  /// The primitive `char`, with the static function `from_u32`.
  Char,
}

/// What a qualified path names so far, the last segment consumed and the segments left.
pub struct Qualified {
  pub start: Start;
  pub last: Ident;
  pub rest: List<Ident>;
}

/// A name bound by a pattern, for checking the alternatives of `|`.
struct PatternBinding {
  pub name: String;
  pub id: u32;
  pub span: Span;
}

struct ScopeEntry {
  pub name: String;
  pub id: u32;
}

struct GenericEntry {
  pub name: String;
  pub owner: ParamOwner;
  pub index: u32;
}

pub class Resolver {
  prv const package: Package;
  prv const resolution: Resolution;
  /// The module whose code is being resolved.
  prv const module: u32;
  /// The type whose function is being resolved, for `Self` and `prv` members.
  prv const owner: Option<TypeItem>;
  pub const locals: List<LocalInfo>;
  /// Names visible in each nested block, innermost last.
  prv const scopes: List<List<ScopeEntry>>;
  pub const paths: Map<u32, Res>;
  pub const bindings: Map<u32, u32>;
  pub const type_paths: Map<u32, TypeRes>;
  /// Imports that were used, by `used_key`.
  pub const used: Map<String, bool>;
  /// The type parameters in scope: the owner type's, then the function's.
  prv const generics: List<GenericEntry>;
  /// The lambdas being resolved, innermost last.
  prv const lambda_stack: List<u32>;
  pub const lambdas: Map<u32, LambdaInfo>;
  pub const diagnostics: Diagnostics;

  pub fn new(self, package: Package, resolution: Resolution, module: u32, owner: Option<TypeItem>, diagnostics: Diagnostics) {
    self.package = package;
    self.resolution = resolution;
    self.module = module;
    self.owner = owner;
    self.locals = new List();
    self.scopes = List::from([new List<ScopeEntry>()]);
    self.paths = new Map<u32, Res>();
    self.bindings = new Map<u32, u32>();
    self.type_paths = new Map<u32, TypeRes>();
    self.used = new Map<String, bool>();
    self.generics = new List();
    self.lambda_stack = new List();
    self.lambdas = new Map<u32, LambdaInfo>();
    self.diagnostics = diagnostics;

    if let Some(item) = owner {
      self.enter_generics(ParamOwner::Item(item), resolution.generics(package, ParamOwner::Item(item)));
    }
  }

  /// Brings the type parameters of a declaration into scope.
  pub fn enter_generics(self, owner: ParamOwner, params: List<GenericParam>) {
    for index in 0..params.len() {
      const param = params[index];
      const name = param.name.name;
      var repeated = false;

      for previous in 0..index {
        if params[previous].name.name == name {
          repeated = true;
        }
      }

      if repeated {
        self.diagnostics.push(Diagnostic::error(codes::DUPLICATE_DEFINITION, param.name.span, "the type parameter `" + name + "` is declared more than once"));
      }

      self.generics.push(GenericEntry { name: name, owner: owner, index: index as u32 });
    }
  }

  prv fn lookup_generic(self, name: String) -> Option<GenericEntry> {
    var index = self.generics.len();

    while index > 0 {
      index -= 1;

      if self.generics[index].name == name {
        return Some(self.generics[index]);
      }
    }

    None
  }

  /// The type arguments written in an expression path.
  prv fn type_args(self, path: Path) {
    if let Some(args) = path.type_args {
      for arg in args.args {
        self.type_expr(arg);
      }
    }
  }

  pub fn declare(self, name: String, span: Span, kind: LocalKind) -> u32 {
    check_reserved(name, span, self.diagnostics);

    const id = self.locals.len() as u32;

    self.locals.push(LocalInfo { name: name, span: span, kind: kind });

    if let Some(scope) = self.scopes.last() {
      scope.push(ScopeEntry { name: name, id: id });
    }

    id
  }

  pub fn lookup_local(self, name: String) -> Option<u32> {
    var found: Option<u32> = None;
    var scope_index = self.scopes.len();

    while found.is_none() && scope_index > 0 {
      scope_index -= 1;

      const scope = self.scopes[scope_index];
      var entry_index = scope.len();

      while entry_index > 0 {
        entry_index -= 1;

        if scope[entry_index].name == name {
          found = Some(scope[entry_index].id);
          break;
        }
      }
    }

    const id = found?;

    // Every enclosing lambda declared after the binding captures it.
    for lambda in self.lambda_stack {
      if let Some(info) = self.lambdas.get(lambda) {
        if id < info.first_local && !info.captures.contains(id) {
          info.captures.push(id);
        }
      }
    }

    Some(id)
  }

  /// `(params) => body`: the parameters and the body's bindings belong to the lambda.
  prv fn lambda(self, id: u32, params: List<LambdaParam>, body: Expr) {
    const first_local = self.locals.len() as u32;

    self.lambdas.insert(id, new LambdaInfo(first_local));
    self.lambda_stack.push(id);
    self.scopes.push(new List<ScopeEntry>());

    const declared: List<ScopeEntry> = new List();

    for param in params {
      if let Some(ty) = param.ty {
        self.type_expr(ty);
      }

      var count = 0usize;

      for other in params {
        if other.name.name == param.name.name {
          count += 1;
        }
      }

      var already = false;

      for entry in declared {
        if entry.name == param.name.name {
          already = true;
        }
      }

      if count > 1 && !already {
        self.diagnostics.push(
          Diagnostic::error(codes::DUPLICATE_DEFINITION, param.name.span, "the parameter `" + param.name.name + "` is declared more than once"),
        );
      }

      const local = self.declare(param.name.name, param.name.span, LocalKind::Param);

      declared.push(ScopeEntry { name: param.name.name, id: local });
    }

    self.expr(body);
    self.scopes.pop();
    self.lambda_stack.pop();

    const end_local = self.locals.len() as u32;

    if let Some(info) = self.lambdas.get(id) {
      const locals: List<u32> = new List();

      for entry in declared {
        locals.push(entry.id);
      }

      info.params = locals;
      info.end_local = end_local;
    }
  }

  /// A module-level name of the current module: one of its items or imports, or else a public
  /// item of the prelude module.
  pub fn lookup_item(self, name: String) -> Option<ItemRef> {
    const info = self.resolution.module(self.module)?;

    if let Some(declared) = info.items.get(name) {
      return Some(declared.item);
    }

    if let Some(imported) = info.imports.get(name) {
      self.used.insert(used_key(self.module, name), true);

      return Some(imported.item);
    }

    const prelude = self.resolution.module(self.resolution.prelude?)?;
    const declared = prelude.items.get(name)?;

    match declared.visibility {
      Visibility::Public => Some(declared.item),
      _ => None,
    }
  }

  /// Names of the current module's items and imports, sorted, for "similar name" suggestions.
  prv fn item_names(self) -> List<String> {
    const names: List<String> = new List();

    if let Some(info) = self.resolution.module(self.module) {
      for name in info.items.keys() {
        names.push(name);
      }

      for name in info.imports.keys() {
        names.push(name);
      }
    }

    names.sort();
    names
  }

  pub fn block(self, block: Block) {
    self.scopes.push(new List<ScopeEntry>());

    for stmt in block.stmts {
      match stmt {
        Stmt::Let(decl) => {
          if let Some(ty) = decl.ty {
            self.type_expr(ty);
          }

          // The initializer is resolved first, so `const x = x + 1;` reads the outer `x`.
          if let Some(init) = decl.init {
            self.expr(init);
          }

          const kind = if decl.mutable { LocalKind::Var } else { LocalKind::Const };
          const id = self.declare(decl.name.name, decl.name.span, kind);

          self.bindings.insert(decl.id, id);
        }
        Stmt::Assign { target, value, .. } => {
          self.expr(target);
          self.expr(value);
        }
        Stmt::Expr(expr) => self.expr(expr),
      }
    }

    if let Some(tail) = block.tail {
      self.expr(tail);
    }

    self.scopes.pop();
  }

  prv fn exprs(self, exprs: List<Expr>) {
    for expr in exprs {
      self.expr(expr);
    }
  }

  pub fn expr(self, expr: Expr) {
    match expr.kind {
      ExprKind::Path(path) => {
        self.type_args(path);

        if let Some(res) = self.path(path) {
          self.paths.insert(expr.id, res);
        }
      }
      ExprKind::Call { callee, args } => {
        self.expr(callee);
        self.exprs(args);
      }
      ExprKind::MethodCall { receiver, args, .. } => {
        self.expr(receiver);
        self.exprs(args);
      }
      ExprKind::Field { base, .. } => self.expr(base),
      ExprKind::Index { base, index } => {
        self.expr(base);
        self.expr(index);
      }
      ExprKind::StructLit { path, fields } => {
        self.type_args(path);

        if let Some(res) = self.struct_literal_path(path) {
          self.paths.insert(expr.id, res);
        }

        for field in fields {
          self.expr(field.value);
        }
      }
      ExprKind::ArrayLit(elems) => self.exprs(elems),
      ExprKind::ArrayRepeat { value, .. } => self.expr(value),
      ExprKind::Try(inner) | ExprKind::Await(inner) => self.expr(inner),
      ExprKind::New { path, args } => {
        self.type_args(path);
        self.new_path(path);
        self.exprs(args);
      }
      ExprKind::Match { scrutinee, arms } => {
        self.expr(scrutinee);

        for arm in arms {
          self.scopes.push(new List<ScopeEntry>());
          self.pattern(arm.pattern, new List(), None);

          if let Some(guard) = arm.guard {
            self.expr(guard);
          }

          self.expr(arm.body);
          self.scopes.pop();
        }
      }
      ExprKind::Template(parts) => {
        for part in parts {
          if let TemplatePart::Expr(inner) = part {
            self.expr(inner);
          }
        }
      }
      ExprKind::Unary { operand, .. } => self.expr(operand),
      ExprKind::Binary { lhs, rhs, .. } => {
        self.expr(lhs);
        self.expr(rhs);
      }
      ExprKind::Cast { expr: inner, ty } => {
        self.expr(inner);
        self.type_expr(ty);
      }
      ExprKind::Range { start, end, .. } => {
        self.expr(start);
        self.expr(end);
      }
      ExprKind::Block(block) => self.block(block),
      ExprKind::Loop(block) => self.block(block),
      ExprKind::Unsafe(block) => self.block(block),
      ExprKind::If { cond, then_block, else_branch } => {
        self.expr(cond);
        self.block(then_block);

        if let Some(branch) = else_branch {
          self.expr(branch);
        }
      }
      ExprKind::While { cond, body } => {
        self.expr(cond);
        self.block(body);
      }
      ExprKind::For { variable, iter, body } => {
        self.expr(iter);
        self.scopes.push(new List<ScopeEntry>());

        const id = self.declare(variable.name, variable.span, LocalKind::ForVar);

        self.bindings.insert(expr.id, id);
        self.block(body);
        self.scopes.pop();
      }
      ExprKind::Break(value) => {
        if let Some(value) = value {
          self.expr(value);
        }
      }
      ExprKind::Return(value) => {
        if let Some(value) = value {
          self.expr(value);
        }
      }
      ExprKind::Lambda { params, body } => self.lambda(expr.id, params, body),
      ExprKind::Zod => {
        const in_class = match self.owner {
          Some(TypeItem::Class(_)) => true,
          _ => false,
        };

        match self.lookup_local("self") {
          Some(id) if in_class => {
            self.paths.insert(expr.id, Res::Local(id));
          }
          _ => {
            self.diagnostics.push(
              Diagnostic::error(codes::UNRESOLVED_NAME, expr.span, "`zod` is only available in the methods and initializer of a class")
                .with_note("`zod.method(...)` calls the parent class's method, and `zod.new(...)` its initializer"),
            );
          }
        }
      }
      _ => {}
    }
  }

  /// Resolves a pattern, declaring its bindings in the current scope. `binds` collects the names
  /// it binds; with `reuse`, names must be ones already bound by the first alternative of an
  /// enclosing `|` pattern, and refer to the same locals.
  prv fn pattern(self, pattern: Pattern, binds: List<PatternBinding>, reuse: Option<List<PatternBinding>>) {
    match pattern.kind {
      PatternKind::Wildcard => {}
      PatternKind::Literal(expr) => self.expr(expr),
      PatternKind::Ident(name) => {
        if let Some(variant) = prelude_variant(name.name) {
          if self.lookup_item(name.name).is_none() {
            self.paths.insert(pattern.id, Res::Variant(variant));

            return;
          }
        }

        for bound in binds {
          if bound.name == name.name {
            self.diagnostics.push(
              Diagnostic::error(codes::DUPLICATE_DEFINITION, name.span, "`" + name.name + "` is bound more than once in the same pattern")
                .with_label(bound.span, "first bound here"),
            );

            return;
          }
        }

        var id = 0u32;

        match reuse {
          Some(first) => {
            var found: Option<u32> = None;

            for bound in first {
              if found.is_none() && bound.name == name.name {
                found = Some(bound.id);
              }
            }

            match found {
              Some(local) => {
                id = local;
              }
              None => {
                self.diagnostics.push(
                  Diagnostic::error(codes::INCONSISTENT_BINDINGS, name.span, "`" + name.name + "` is not bound in every alternative of the pattern")
                    .with_note("each alternative of `|` must bind the same names"),
                );

                return;
              }
            }
          }
          None => {
            id = self.declare(name.name, name.span, LocalKind::Pattern);
          }
        }

        self.bindings.insert(pattern.id, id);
        binds.push(PatternBinding { name: name.name, id: id, span: name.span });
      }
      PatternKind::Path(path) => self.variant_pattern(pattern.id, path),
      PatternKind::Tuple { path, elems } => {
        self.variant_pattern(pattern.id, path);

        for elem in elems {
          self.pattern(elem, binds, reuse);
        }
      }
      PatternKind::Named { path, fields, .. } => {
        self.variant_pattern(pattern.id, path);

        for field in fields {
          self.pattern(field.pattern, binds, reuse);
        }
      }
      PatternKind::Or(alternatives) => {
        const first = match alternatives.first() {
          Some(first) => first,
          None => return,
        };
        const first_binds: List<PatternBinding> = new List();

        self.pattern(first, first_binds, reuse);

        for index in 1..alternatives.len() {
          const alternative = alternatives[index];
          const alternative_binds: List<PatternBinding> = new List();

          self.pattern(alternative, alternative_binds, Some(first_binds));

          for bound in first_binds {
            var present = false;

            for other in alternative_binds {
              if other.name == bound.name {
                present = true;
              }
            }

            if !present {
              self.diagnostics.push(
                Diagnostic::error(codes::INCONSISTENT_BINDINGS, alternative.span, "`" + bound.name + "` is not bound in every alternative of the pattern")
                  .with_note("each alternative of `|` must bind the same names"),
              );
            }
          }
        }

        for bound in first_binds {
          binds.push(bound);
        }
      }
    }
  }

  prv fn variant_pattern(self, id: u32, path: Path) {
    if let Some(variant) = self.variant_path(path) {
      self.paths.insert(id, Res::Variant(variant));
    }
  }

  /// A path that must name a variant: `Some`, `Shape::Circle`, `Self::Empty`,
  /// `shapes::Shape::Circle`.
  prv fn variant_path(self, path: Path) -> Option<VariantRef> {
    if path.segments.len() == 1 {
      const segment = path.segments[0];
      var variant: Option<VariantRef> = None;

      if let Some(found) = prelude_variant(segment.name) {
        if self.lookup_item(segment.name).is_none() {
          variant = Some(found);
        }
      }

      if variant.is_none() {
        self.error(segment.span, "`" + segment.name + "` is not a variant");
      }

      return variant;
    }

    const qualified = self.qualified(path.segments)?;
    const owner = qualified.last;

    if qualified.rest.len() == 1 {
      const name = qualified.rest[0];

      match qualified.start {
        Start::Item(ItemRef::Type(TypeItem::Enum(id))) => return self.user_variant(id, name.name, name.span),
        Start::Prelude(kind) => return self.prelude_variant_of(kind, name.name, name.span),
        Start::Item(ItemRef::Type(TypeItem::Struct(_))) => {
          self.error(owner.span, "`" + owner.name + "` is a struct, not an enum");

          return None;
        }
        Start::Item(ItemRef::Type(TypeItem::Class(_))) => {
          self.error(owner.span, "`" + owner.name + "` is a class, not an enum");

          return None;
        }
        _ => {}
      }
    }

    self.error(path.span, "this path does not name a variant");

    None
  }

  prv fn user_variant(self, id: u32, name: String, span: Span) -> Option<VariantRef> {
    const decl = self.resolution.enum_decl(self.package, id)?;
    var index: Option<usize> = None;

    for position in 0..decl.variants.len() {
      if index.is_none() && decl.variants[position].name.name == name {
        index = Some(position);
      }
    }

    if index.is_none() {
      const candidates: List<String> = new List();

      for variant in decl.variants {
        candidates.push(variant.name.name);
      }

      var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, span, "no variant `" + name + "` in `" + decl.name.name + "`");

      if let Some(similar) = diagnostics::closest_match(name, candidates) {
        diagnostic = diagnostic.with_help("a variant with a similar name exists: `" + similar + "`");
      }

      self.diagnostics.push(diagnostic);
    }

    match index {
      Some(position) => Some(VariantRef { owner: EnumKind::User(id), index: position as u32 }),
      None => None,
    }
  }

  prv fn prelude_variant_of(self, kind: EnumKind, name: String, span: Span) -> Option<VariantRef> {
    const index = prelude_variants(kind).index_of(name);

    if index.is_none() {
      const enum_name = match kind {
        EnumKind::Option => "Option",
        _ => "Result",
      };

      self.error(span, "no variant `" + name + "` in `" + enum_name + "`");
    }

    match index {
      Some(position) => Some(VariantRef { owner: kind, index: position as u32 }),
      None => None,
    }
  }

  prv fn error(self, span: Span, message: String) {
    self.diagnostics.push(Diagnostic::error(codes::UNRESOLVED_NAME, span, message));
  }

  prv fn path(self, path: Path) -> Option<Res> {
    if path.segments.len() == 1 {
      const segment = path.segments[0];

      return self.value_name(segment.name, segment.span);
    }

    const qualified = self.qualified(path.segments)?;
    const last = qualified.last;
    const rest = qualified.rest;

    if rest.is_empty() {
      match qualified.start {
        Start::Item(item) => match item {
          ItemRef::Fn(id) => return Some(Res::Fn(id)),
          ItemRef::Extern(id) => return Some(Res::Extern(id)),
          ItemRef::Const(id) => return Some(Res::Const(id)),
          ItemRef::Std(StdItem::StringFromC) => return Some(Res::Builtin("string_from_c")),
          ItemRef::Std(StdItem::Exit) => return Some(Res::Builtin("exit")),
          ItemRef::Type(type_item) => {
            self.not_a_value(last.name, last.span, type_item);

            return None;
          }
          ItemRef::Module(_) | ItemRef::Std(StdItem::Root) | ItemRef::Std(StdItem::Ffi) => {
            self.error(last.span, "`" + last.name + "` is a module, not a value");

            return None;
          }
          ItemRef::Std(_) => {
            self.error(last.span, "`" + last.name + "` is a type, not a value");

            return None;
          }
        },
        Start::Prelude(_) => {
          self.error(last.span, "`" + last.name + "` is an enum, not a value");

          return None;
        }
        Start::List => {
          self.error(last.span, "`List` is a type, not a value");

          return None;
        }
        Start::Char => {
          self.error(last.span, "`char` has one static function, `char::from_u32`");

          return None;
        }
      }
    }

    const member = rest[0];

    if rest.len() == 1 {
      match qualified.start {
        Start::Item(ItemRef::Std(StdItem::CString)) => {
          if member.name == "new" {
            return Some(Res::Builtin("CString::new"));
          }

          self.error(member.span, "no function `" + member.name + "` in `CString`");

          return None;
        }
        Start::List => {
          if member.name == "from" {
            return Some(Res::Builtin("List::from"));
          }

          self.error(member.span, "no function `" + member.name + "` in `List`");

          return None;
        }
        Start::Char => {
          if member.name == "from_u32" {
            return Some(Res::Builtin("char::from_u32"));
          }

          self.error(last.span, "`char` has one static function, `char::from_u32`");

          return None;
        }
        Start::Item(ItemRef::Type(item)) => {
          if let TypeItem::Enum(id) = item {
            if let Some(decl) = self.resolution.enum_decl(self.package, id) {
              for position in 0..decl.variants.len() {
                if decl.variants[position].name.name == member.name {
                  return Some(Res::Variant(VariantRef { owner: EnumKind::User(id), index: position as u32 }));
                }
              }
            }
          }

          return self.type_function(item, member.name, member.span);
        }
        Start::Prelude(kind) => {
          return match self.prelude_variant_of(kind, member.name, member.span) {
            Some(variant) => Some(Res::Variant(variant)),
            None => None,
          };
        }
        _ => {}
      }
    }

    if let Start::Char = qualified.start {
      self.error(last.span, "`char` has one static function, `char::from_u32`");

      return None;
    }

    self.error(member.span, "cannot find `" + member.name + "` in `" + last.name + "`");

    None
  }

  prv fn not_a_value(self, name: String, span: Span, item: TypeItem) {
    const diagnostic = match item {
      TypeItem::Struct(_) => Diagnostic::error(codes::UNRESOLVED_NAME, span, "`" + name + "` is a struct, not a value")
        .with_help("build a value with `" + name + " { ... }` or call one of its static functions, such as `" + name + "::new(...)`"),
      TypeItem::Enum(_) => Diagnostic::error(codes::UNRESOLVED_NAME, span, "`" + name + "` is an enum, not a value")
        .with_help("name one of its variants: `" + name + "::Variant`"),
      TypeItem::Class(_) => Diagnostic::error(codes::UNRESOLVED_NAME, span, "`" + name + "` is a class, not a value")
        .with_help("create an instance with `new " + name + "(...)`"),
      TypeItem::Interface(_) => Diagnostic::error(codes::UNRESOLVED_NAME, span, "`" + name + "` is an interface, not a value")
        .with_help("create a value of a type that implements `" + name + "`"),
    };

    self.diagnostics.push(diagnostic);
  }

  /// A single name used as a value.
  prv fn value_name(self, name: String, span: Span) -> Option<Res> {
    if let Some(id) = self.lookup_local(name) {
      return Some(Res::Local(id));
    }

    if self.lookup_generic(name).is_some() {
      self.error(span, "`" + name + "` is a type parameter, not a value");

      return None;
    }

    if name == "self" {
      self.diagnostics.push(
        Diagnostic::error(codes::UNRESOLVED_NAME, span, "`self` is only available in methods")
          .with_help("add a `self` parameter to make this function a method of its type"),
      );

      return None;
    }

    if name == "Self" {
      self.error(span, "`Self` is a type, not a value");

      return None;
    }

    if name == "pkg" || name == "super" {
      self.error(span, "`" + name + "` is a module, not a value");

      return None;
    }

    if let Some(item) = self.lookup_item(name) {
      match item {
        ItemRef::Fn(id) => return Some(Res::Fn(id)),
        ItemRef::Extern(id) => return Some(Res::Extern(id)),
        ItemRef::Const(id) => return Some(Res::Const(id)),
        ItemRef::Std(StdItem::StringFromC) => return Some(Res::Builtin("string_from_c")),
        ItemRef::Std(StdItem::Exit) => return Some(Res::Builtin("exit")),
        ItemRef::Std(StdItem::CType(_)) | ItemRef::Std(StdItem::CString) => {
          self.error(span, "`" + name + "` is a type, not a value");

          return None;
        }
        ItemRef::Type(type_item) => {
          // `Error(message)` builds the prelude's basic error.
          if let TypeItem::Interface(id) = type_item {
            if let Some(error) = self.resolution.error_interface {
              if error == id {
                return Some(Res::Builtin("Error"));
              }
            }
          }

          self.not_a_value(name, span, type_item);

          return None;
        }
        ItemRef::Module(_) | ItemRef::Std(_) => {
          self.diagnostics.push(
            Diagnostic::error(codes::UNRESOLVED_NAME, span, "`" + name + "` is a module, not a value").with_help("name one of its items: `" + name + "::item`"),
          );

          return None;
        }
      }
    }

    if let Some(builtin) = builtin_from_name(name) {
      return Some(Res::Builtin(builtin));
    }

    if let Some(variant) = prelude_variant(name) {
      return Some(Res::Variant(variant));
    }

    var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, span, "cannot find `" + name + "` in this scope");
    const candidates: List<String> = new List();

    for scope in self.scopes {
      for entry in scope {
        candidates.push(entry.name);
      }
    }

    for item in self.item_names() {
      candidates.push(item);
    }

    for builtin in BUILTIN_NAMES.split(" ") {
      candidates.push(builtin);
    }

    if let Some(similar) = diagnostics::closest_match(name, candidates) {
      diagnostic = diagnostic.with_help("a name with a similar spelling exists: `" + similar + "`");
    }

    self.diagnostics.push(diagnostic);

    None
  }

  /// Resolves the first segment of a qualified path (`pkg`, `self`, `super`, `Self`, or a
  /// module-level name), then follows modules: `pkg::net::http::get` stops at the function `get`.
  pub fn qualified(self, segments: List<Ident>) -> Option<Qualified> {
    const first = segments.first()?;
    var start = Start::List;

    if first.name == "pkg" {
      start = Start::Item(ItemRef::Module(self.resolution.package_root(self.module)));
    } else if first.name == "self" {
      start = Start::Item(ItemRef::Module(self.module));
    } else if first.name == "super" {
      start = Start::Item(ItemRef::Module(self.parent(self.module, first.span)?));
    } else if first.name == "Self" {
      if self.owner.is_none() {
        self.error(first.span, "`Self` is only available inside a struct or enum");
      }

      start = Start::Item(ItemRef::Type(self.owner?));
    } else {
      const name = first.name;

      match self.lookup_item(name) {
        Some(item) => {
          start = Start::Item(item);
        }
        None => {
          if name == "Option" {
            start = Start::Prelude(EnumKind::Option);
          } else if name == "Result" {
            start = Start::Prelude(EnumKind::Result);
          } else if name == "List" {
            start = Start::List;
          } else if name == "char" {
            start = Start::Char;
          } else if name == "std" {
            start = Start::Item(ItemRef::Std(StdItem::Root));
          } else if let Some(root) = self.resolution.dependency_root(self.package, self.module, name) {
            // A dependency of the package, unless a name of the module hides it.
            start = Start::Item(ItemRef::Module(root));
          } else {
            var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, first.span, "cannot find `" + name + "` in this scope");

            if let Some(similar) = diagnostics::closest_match(name, self.item_names()) {
              diagnostic = diagnostic.with_help("a name with a similar spelling exists: `" + similar + "`");
            } else {
              diagnostic = diagnostic.with_help("to use a module of this package, import it with `use pkg::" + name + ";`");
            }

            self.diagnostics.push(diagnostic);

            return None;
          }
        }
      }
    }

    var last = first;
    // `super` may only repeat at the start: `super::super::x`.
    var leading_super = first.name == "super";
    var position = 1usize;

    while position < segments.len() && is_module_like(start) {
      const segment = segments[position];

      if let Start::Item(ItemRef::Module(module)) = start {
        if segment.name == "super" && leading_super {
          start = Start::Item(ItemRef::Module(self.parent(module, segment.span)?));
          last = segment;
          position += 1;
          continue;
        }
      }

      if segment.name == "pkg" || segment.name == "self" || segment.name == "super" || segment.name == "Self" {
        self.error(segment.span, "`" + segment.name + "` can only start a path");

        return None;
      }

      if let Start::Item(ItemRef::Module(module)) = start {
        leading_super = false;
        start = Start::Item(self.module_member(module, segment)?);
      } else {
        start = Start::Item(self.std_member(start, segment.name, segment.span)?);
      }

      last = segment;
      position += 1;
    }

    const rest: List<Ident> = new List();

    while position < segments.len() {
      rest.push(segments[position]);
      position += 1;
    }

    Some(Qualified { start: start, last: last, rest: rest })
  }

  /// A member of `std` (`std::ffi`, or a module written in Sagitario) or of `std::ffi`.
  prv fn std_member(self, module: Start, name: String, span: Span) -> Option<ItemRef> {
    if let Start::Item(ItemRef::Std(StdItem::Root)) = module {
      if name == "ffi" {
        return Some(ItemRef::Std(StdItem::Ffi));
      }

      if let Some(root) = self.resolution.std_root {
        if let Some(info) = self.resolution.module(root) {
          if let Some(child) = info.children.get(name) {
            return Some(ItemRef::Module(child));
          }
        }
      }

      // The standard library itself names the prelude to implement its interfaces.
      if name == "prelude" {
        if let Some(current) = self.resolution.module(self.module) {
          if current.in_std {
            return match self.resolution.prelude {
              Some(prelude) => Some(ItemRef::Module(prelude)),
              None => None,
            };
          }
        }
      }

      var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, span, "cannot find `" + name + "` in `std`");
      const modules = STD_MODULES.split(" ");

      if let Some(similar) = diagnostics::closest_match(name, modules) {
        diagnostic = diagnostic.with_help("a module with a similar spelling exists: `std::" + similar + "`");
      } else {
        const quoted: List<String> = new List();

        for module_name in modules {
          quoted.push("`" + module_name + "`");
        }

        diagnostic = diagnostic.with_note("the standard library has the modules " + quoted.join(", "));
      }

      self.diagnostics.push(diagnostic);

      return None;
    }

    if name == "CString" {
      return Some(ItemRef::Std(StdItem::CString));
    }

    if name == "string_from_c" {
      return Some(ItemRef::Std(StdItem::StringFromC));
    }

    const types = c_type_names();

    if types.contains(name) {
      return Some(ItemRef::Std(StdItem::CType(name)));
    }

    types.push("CString");
    types.push("string_from_c");

    var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, span, "cannot find `" + name + "` in `std::ffi`");

    if let Some(similar) = diagnostics::closest_match(name, types) {
      diagnostic = diagnostic.with_help("a name with a similar spelling exists: `" + similar + "`");
    }

    self.diagnostics.push(diagnostic);

    None
  }

  prv fn parent(self, module: u32, span: Span) -> Option<u32> {
    const parent = match self.resolution.module(module) {
      Some(info) => info.parent,
      None => None,
    };

    if parent.is_none() {
      self.error(span, "the root module `pkg` has no parent module");
    }

    parent
  }

  /// An item or submodule of `module`, checking that the current module can see it.
  prv fn module_member(self, module: u32, segment: Ident) -> Option<ItemRef> {
    const info = self.resolution.module(module)?;
    const name = segment.name;

    // `exit` never returns, which no function written in Sagitario can declare.
    if info.in_std && info.path.len() == 2 && info.path[0] == "std" && info.path[1] == "process" && name == "exit" {
      return Some(ItemRef::Std(StdItem::Exit));
    }

    if let Some(declared) = info.items.get(name) {
      const private = match declared.visibility {
        Visibility::Module => true,
        _ => false,
      };

      if private && !self.resolution.is_within(self.module, module) {
        self.diagnostics.push(
          Diagnostic::error(codes::PRIVATE_ITEM, segment.span, "`" + name + "` is private to the module `" + info.display_path() + "`")
            .with_label(declared.span, "declared without `pub` here")
            .with_help("mark it `pub` to use it from other modules"),
        );
      }

      return Some(declared.item);
    }

    if let Some(child) = info.children.get(name) {
      return Some(ItemRef::Module(child));
    }

    var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, segment.span, "cannot find `" + name + "` in the module `" + info.display_path() + "`");
    const candidates: List<String> = new List();

    for item in info.items.keys() {
      candidates.push(item);
    }

    for child in info.children.keys() {
      candidates.push(child);
    }

    candidates.sort();

    if let Some(similar) = diagnostics::closest_match(name, candidates) {
      diagnostic = diagnostic.with_help("a name with a similar spelling exists: `" + similar + "`");
    } else if info.source.is_some() || module == 0 {
      const parts: List<String> = new List();

      for part in info.path {
        parts.push(part);
      }

      parts.push(segment.name);

      const file = parts.join("/");

      diagnostic = if name == "mod" {
        diagnostic.with_note("`mod` cannot name a module: `mod.sag` is the file of the module of its directory")
      } else {
        diagnostic.with_note("a module `" + name + "` would be the file `" + file + ".sag`, or `" + file + "/mod.sag` with its submodules, next to the program's entry file")
      };
    }

    self.diagnostics.push(diagnostic);

    None
  }

  /// The path of `Name { ... }`: a struct, or an enum variant with named fields.
  prv fn struct_literal_path(self, path: Path) -> Option<Res> {
    const qualified = self.qualified(path.segments)?;
    const last = qualified.last;
    const rest = qualified.rest;

    if rest.is_empty() {
      match qualified.start {
        Start::Item(ItemRef::Type(TypeItem::Struct(id))) => return Some(Res::Struct(id)),
        Start::Item(ItemRef::Type(TypeItem::Enum(_))) | Start::Prelude(_) => {
          self.diagnostics.push(
            Diagnostic::error(codes::UNRESOLVED_NAME, last.span, "`" + last.name + "` is an enum, not a struct").with_help("name the variant: `Enum::Variant { ... }`"),
          );

          return None;
        }
        Start::Item(ItemRef::Type(TypeItem::Class(_))) => {
          self.diagnostics.push(
            Diagnostic::error(codes::UNRESOLVED_NAME, last.span, "`" + last.name + "` is a class, which has no literals")
              .with_help("create an instance with `new " + last.name + "(...)`"),
          );

          return None;
        }
        _ => {}
      }
    } else if rest.len() == 1 {
      const name = rest[0];

      match qualified.start {
        Start::Item(ItemRef::Type(TypeItem::Enum(id))) => {
          return match self.user_variant(id, name.name, name.span) {
            Some(variant) => Some(Res::Variant(variant)),
            None => None,
          };
        }
        Start::Prelude(kind) => {
          return match self.prelude_variant_of(kind, name.name, name.span) {
            Some(variant) => Some(Res::Variant(variant)),
            None => None,
          };
        }
        _ => {}
      }
    }

    self.error(path.span, "this path does not name a struct or a variant");

    None
  }

  /// `Type::function`: a static function of a struct, enum or class.
  prv fn type_function(self, item: TypeItem, name: String, span: Span) -> Option<Res> {
    const type_name = self.resolution.type_name(self.package, item);
    const function = match self.resolution.type_function(self.package, item, name) {
      Some(function) => function,
      None => {
        const candidates: List<String> = new List();

        for function in self.resolution.type_functions(self.package, item) {
          candidates.push(function.name.name);
        }

        var what = "function";

        if let TypeItem::Enum(id) = item {
          if let Some(decl) = self.resolution.enum_decl(self.package, id) {
            for variant in decl.variants {
              candidates.push(variant.name.name);
            }
          }

          what = "variant or function";
        }

        var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, span, "no " + what + " `" + name + "` in `" + type_name + "`");

        if let Some(similar) = diagnostics::closest_match(name, candidates) {
          diagnostic = diagnostic.with_help("a " + what + " with a similar name exists: `" + similar + "`");
        }

        self.diagnostics.push(diagnostic);

        return None;
      }
    };
    const decl = self.resolution.fn_decl(self.package, function)?;
    const is_method = decl.self_param.is_some();
    const is_private = match decl.visibility {
      Visibility::Private => true,
      _ => false,
    };

    if self.resolution.is_initializer(self.package, function) {
      self.diagnostics.push(
        Diagnostic::error(codes::WRONG_CALL_FORM, span, "the initializer of `" + type_name + "` cannot be called as a function")
          .with_help("create an instance with `new " + type_name + "(...)`"),
      );

      return None;
    }

    if is_method {
      self.diagnostics.push(
        Diagnostic::error(codes::WRONG_CALL_FORM, span, "`" + name + "` is a method of `" + type_name + "`, not a static function")
          .with_label(decl.name.span, "declared with a `self` parameter here")
          .with_help("call it on a value: `value." + name + "(...)`"),
      );

      return None;
    }

    const own = match self.owner {
      Some(owner) => same_type_item(owner, item),
      None => false,
    };

    if is_private && !own {
      self.diagnostics.push(
        Diagnostic::error(codes::PRIVATE_MEMBER, span, "the function `" + name + "` of `" + type_name + "` is private").with_label(decl.name.span, "declared `prv` here"),
      );
    }

    Some(Res::Fn(function))
  }

  /// The types named in a type expression.
  pub fn type_expr(self, ty: TypeExpr) {
    match ty.kind {
      TypeExprKind::Unit => {}
      TypeExprKind::Path(path) => self.type_path(path),
      TypeExprKind::Fn { params, ret } => {
        for param in params {
          self.type_expr(param);
        }

        if let Some(ret) = ret {
          self.type_expr(ret);
        }
      }
      TypeExprKind::Generic { path, args } => {
        self.type_path(path);

        for arg in args {
          self.type_expr(arg);
        }
      }
      TypeExprKind::Array { elem, .. } => self.type_expr(elem),
      TypeExprKind::Ptr { pointee, .. } => self.type_expr(pointee),
    }
  }

  /// The type of `new Type(...)`: recorded only when it names a program type.
  prv fn new_path(self, path: Path) {
    if path.segments.len() > 1 {
      self.type_path(path);
    } else if let Some(segment) = path.segments.first() {
      if let Some(ItemRef::Type(item)) = self.lookup_item(segment.name) {
        self.type_paths.insert(path.id, TypeRes::Item(item));
      }
    }
  }

  /// A type path. Numeric types come first, then program types and imports, then the prelude.
  prv fn type_path(self, path: Path) {
    var res = TypeRes::Error;

    if path.segments.len() == 1 {
      const segment = path.segments[0];
      const name = segment.name;

      if let Some(generic) = self.lookup_generic(name) {
        res = TypeRes::Param { owner: generic.owner, index: generic.index };
      } else if is_numeric_type(name) || name == "Self" {
        res = TypeRes::Builtin;
      } else {
        match self.lookup_item(name) {
          Some(ItemRef::Type(item)) => {
            res = TypeRes::Item(item);
          }
          Some(ItemRef::Std(StdItem::CType(ty))) => {
            res = TypeRes::CType(ty);
          }
          Some(ItemRef::Std(StdItem::CString)) => {
            res = TypeRes::CString;
          }
          Some(item) => {
            self.not_a_type(segment.name, segment.span, item);
          }
          None => {
            if PRELUDE_TYPES.split(" ").contains(name) {
              res = TypeRes::Builtin;
            } else {
              var diagnostic = Diagnostic::error(codes::UNRESOLVED_NAME, segment.span, "cannot find type `" + name + "`");
              const known: List<String> = NUMERIC_TYPES.split(" ");

              for prelude_type in PRELUDE_TYPES.split(" ") {
                known.push(prelude_type);
              }

              for item_name in self.item_names() {
                known.push(item_name);
              }

              if name == "CString" || c_type_names().contains(name) {
                diagnostic = diagnostic.with_help("import it from the standard library: `use std::ffi::" + name + ";`");
              } else if let Some(similar) = diagnostics::closest_match(name, known) {
                diagnostic = diagnostic.with_help("a type with a similar name exists: `" + similar + "`");
              }

              self.diagnostics.push(diagnostic);
            }
          }
        }
      }
    } else {
      match self.qualified(path.segments) {
        Some(qualified) => {
          if qualified.rest.is_empty() {
            match qualified.start {
              Start::Item(ItemRef::Type(item)) => {
                res = TypeRes::Item(item);
              }
              Start::Item(ItemRef::Std(StdItem::CType(ty))) => {
                res = TypeRes::CType(ty);
              }
              Start::Item(ItemRef::Std(StdItem::CString)) => {
                res = TypeRes::CString;
              }
              Start::Item(item) => self.not_a_type(qualified.last.name, qualified.last.span, item),
              _ => self.error(path.span, "`" + qualified.last.name + "` does not contain types"),
            }
          } else {
            self.error(path.span, "`" + qualified.last.name + "` does not contain types");
          }
        }
        None => {}
      }
    }

    self.type_paths.insert(path.id, res);
  }

  prv fn not_a_type(self, name: String, span: Span, item: ItemRef) {
    const what = match item {
      ItemRef::Fn(_) | ItemRef::Extern(_) | ItemRef::Std(StdItem::StringFromC) | ItemRef::Std(StdItem::Exit) => "a function",
      ItemRef::Module(_) | ItemRef::Std(StdItem::Root) | ItemRef::Std(StdItem::Ffi) => "a module",
      ItemRef::Type(_) | ItemRef::Std(_) => "a type",
      ItemRef::Const(_) => "a constant",
    };

    self.error(span, "`" + name + "` is " + what + ", not a type");
  }
}

/// Whether a path continues past this start: a module, `std` or `std::ffi`.
fn is_module_like(start: Start) -> bool {
  match start {
    Start::Item(ItemRef::Module(_)) | Start::Item(ItemRef::Std(StdItem::Root)) | Start::Item(ItemRef::Std(StdItem::Ffi)) => true,
    _ => false,
  }
}
