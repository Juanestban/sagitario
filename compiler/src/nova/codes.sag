//! The codes of the errors in `Nova.toml` and in a package's layout (docs/nova.md#errors). They
//! use the prefix `N`, apart from the language's `E` and `W` codes.

/// Text that is not the TOML subset `Nova.toml` uses.
pub const SYNTAX: String = "N0001";
/// A key or table defined twice.
pub const DUPLICATE: String = "N0002";
/// A key or table that `Nova.toml` does not have.
pub const UNKNOWN_KEY: String = "N0003";
/// A required table or key that is missing.
pub const MISSING_KEY: String = "N0004";
/// A value of the wrong type.
pub const WRONG_TYPE: String = "N0005";
/// A package name that is not a lowercase identifier, or is reserved.
pub const INVALID_NAME: String = "N0006";
/// A version that is not `MAJOR.MINOR.PATCH`.
pub const INVALID_VERSION: String = "N0007";
/// A part of `Nova.toml` that a later version of Nova provides.
pub const NOT_AVAILABLE: String = "N0008";
/// A package without exactly one of `src/main.sag` and `src/lib.sag`.
pub const INVALID_LAYOUT: String = "N0009";
/// A dependency whose path holds no package.
pub const DEPENDENCY_NOT_FOUND: String = "N0010";
/// A dependency whose package has another name.
pub const DEPENDENCY_NAME: String = "N0011";
/// A dependency that is a program, not a library.
pub const NOT_A_LIBRARY: String = "N0012";
/// Packages that depend on each other in a cycle.
pub const DEPENDENCY_CYCLE: String = "N0013";
/// A value that the key does not accept.
pub const INVALID_VALUE: String = "N0014";
/// A table that does not apply to this kind of package.
pub const NOT_APPLICABLE: String = "N0015";
/// A file or directory named in `Nova.toml` that does not exist.
pub const FILE_NOT_FOUND: String = "N0016";
