//! Abstract syntax tree, the port of `sagitario_ast`. It mirrors the source closely; names and
//! types are resolved by later phases, which refer to nodes by their ids. `Expr`, `Pattern` and
//! `TypeExpr` are classes: they contain themselves, which a struct cannot do by value.

use pkg::loader;
use pkg::span::Span;

pub struct Ident {
  pub name: String;
  pub span: Span;
}

/// Visibility of module-level items and of struct members.
pub enum Visibility {
  /// No modifier: visible in the declaring module only.
  Module,
  /// `pub`
  Public,
  /// `prv`: a member visible only inside its struct, enum or class.
  Private,
}

/// The modules of a program: the root module (the entry file) first, then every module it
/// reaches through paths.
pub struct Package {
  pub modules: List<Module>;
  /// Index in `modules` of the prelude written in Sagitario.
  pub prelude: Option<usize>;
  /// Indices in `modules` of the standard library modules the program uses.
  pub std: List<usize>;
  /// A library: it needs no `main`.
  pub library: bool;
  /// The package being compiled first, then its dependencies.
  pub packages: List<PackageInfo>;
  /// The machine the program is compiled for.
  pub target: TargetInfo;
}

/// The machine the program is compiled for: what the sizes of C types and the conditions of
/// `@cfg` depend on.
pub struct TargetInfo {
  /// `target_os` of `@cfg`: `windows`, `linux`, `macos`, `android` or `ios`.
  pub os: String;
  /// `target_arch` of `@cfg`: `x86_64`, `aarch64` or `arm`.
  pub arch: String;
  /// The width of pointers, `isize` and `usize`: 32 or 64.
  pub pointer_width: u32;
  /// Whether C's `long` has 32 bits: on Windows and on 32-bit targets.
  pub long_is_32: bool;
  /// Whether C's `char` is unsigned: on Linux and Android for ARM.
  pub char_is_unsigned: bool;

  /// The machine running the compiler. `sag` runs on 64-bit hosts, where C's `long` has 32 bits
  /// on Windows alone and C's `char` is unsigned on Linux for ARM alone.
  pub fn host() -> TargetInfo {
    TargetInfo {
      os: loader::host_os(),
      arch: loader::host_arch(),
      pointer_width: 64,
      long_is_32: loader::windows(),
      char_is_unsigned: loader::linux_on_arm(),
    }
  }
}

/// A package of a program: the one being compiled, or a dependency.
pub struct PackageInfo {
  /// The name its dependents use as a path root; unused for the package being compiled.
  pub name: String;
  /// Indices in `Package::packages` of the packages it depends on directly.
  pub dependencies: List<usize>;
}

/// One source file.
pub struct Module {
  pub file: u32;
  /// The logical path from the package root: empty for the root, `["net", "http"]` for
  /// `net/http.sag`.
  pub path: List<String>;
  /// Index in `Package::packages` of the package the file belongs to.
  pub package: usize;
  /// The file's path on disk, for `include_str!`; `None` for embedded modules.
  pub location: Option<String>;
  pub uses: List<UseDecl>;
  pub items: List<Item>;
  /// The files `include!` puts in the module, whose items the loader adds to `items`
  /// (docs/adr/0103-build-scripts-and-binding-generation.md, Q724).
  pub includes: List<Include>;
  /// The names of the built-in macros called in the module, with their `!`, which the parser
  /// expands: the language server colors them.
  pub macros: List<Span>;
}

/// `include!(path);` where an item may be: the path, as the macros inside it give it.
pub struct Include {
  pub path: String;
  pub span: Span;
}

/// `use tree;`
pub struct UseDecl {
  pub tree: UseTree;
  pub span: Span;
}

/// `a::b`, `a::b as c` or `a::{b, c::d}`.
pub struct UseTree {
  pub prefix: List<Ident>;
  pub kind: UseTreeKind;
  pub span: Span;
}

pub enum UseTreeKind {
  /// Imports the last segment of the prefix, under `alias` if given.
  Simple(Option<Ident>),
  /// `prefix::{trees}`
  Group(List<UseTree>),
}

pub enum Item {
  Fn(FnDecl),
  Struct(StructDecl),
  Enum(EnumDecl),
  Class(ClassDecl),
  Interface(InterfaceDecl),
  Extern(ExternBlock),
  Const(ConstDecl),
  Impl(ImplBlock),
  Static(StaticDecl),
}

/// `impl<T> Interface<A> for Type<T> { methods }`: the methods of one interface for one type,
/// declared in the module of the type (docs/adr/0081-operator-overloading.md, Q507).
pub struct ImplBlock {
  pub generics: List<GenericParam>;
  /// The interface, with its type arguments.
  pub implemented: TypeExpr;
  pub target: TypeExpr;
  /// Public, as the members of an interface are.
  pub functions: List<FnDecl>;
  pub span: Span;
}

/// `const NAME: Type = value;` at module level.
pub struct ConstDecl {
  pub visibility: Visibility;
  pub name: Ident;
  pub ty: TypeExpr;
  pub value: Expr;
  pub span: Span;
}

/// `static NAME: Type = value;` at module level (docs/adr/0083-global-state.md): one value for
/// the whole program, computed on its first use.
pub struct StaticDecl {
  pub visibility: Visibility;
  /// `static var` (Q528).
  pub mutable: bool;
  /// `@thread_local`, on a `static var` only: one value per thread (Q529).
  pub thread_local: bool;
  /// A global variable of C, declared in an `extern "C"` block without a value
  /// (docs/adr/0086-c-globals-and-std-io.md): its name is the C symbol.
  pub extern_c: bool;
  pub name: Ident;
  pub ty: TypeExpr;
  /// A function without parameters that returns `value`, named as the static: the passes
  /// check and compile it as any function, and the program calls it on the first use.
  pub init: FnDecl;
  pub span: Span;

  /// The initializer.
  pub fn value(self) -> Option<Expr> {
    self.init.body.tail
  }
}

pub struct InterfaceDecl {
  pub visibility: Visibility;
  pub name: Ident;
  pub generics: List<GenericParam>;
  pub parents: List<TypeExpr>;
  pub fields: List<FieldDecl>;
  pub functions: List<FnDecl>;
  pub span: Span;
}

pub struct ClassDecl {
  pub is_abstract: bool;
  pub visibility: Visibility;
  pub name: Ident;
  pub generics: List<GenericParam>;
  /// The class after `extends`.
  pub parent: Option<TypeExpr>;
  /// The interfaces after `impl`.
  pub impls: List<TypeExpr>;
  pub fields: List<FieldDecl>;
  /// `pub const NAME: Type = value;`: constants of the class
  /// (docs/adr/0099-associated-and-composite-constants.md, Q683).
  pub consts: List<ConstDecl>;
  pub functions: List<FnDecl>;
  pub span: Span;
}

/// `extern "C" { fn name(params) -> Ret; ... }`
pub struct ExternBlock {
  pub functions: List<ExternFn>;
  pub span: Span;
}

pub struct ExternFn {
  pub visibility: Visibility;
  pub name: Ident;
  pub params: List<Param>;
  /// `...` after the parameters: a variadic C function, which takes more arguments
  /// (docs/adr/0103-build-scripts-and-binding-generation.md, Q720).
  pub variadic: bool;
  pub return_type: Option<TypeExpr>;
  pub span: Span;
}

/// `@export("symbol")` on an `extern "C" fn`.
pub struct Export {
  pub symbol: String;
  pub span: Span;
}

pub struct EnumDecl {
  /// The integer type of `@repr(i32)`, or `C` for `@repr(C)` (docs/spec/10-ffi.md).
  pub repr: Option<Ident>;
  /// `@default`: the variant marked `@default` is its `Default`
  /// (docs/adr/0094-conversions-and-defaults.md, Q636).
  pub default: Option<Span>;
  pub visibility: Visibility;
  pub name: Ident;
  pub generics: List<GenericParam>;
  pub impls: List<TypeExpr>;
  pub variants: List<VariantDecl>;
  /// Constants of the enum (Q683).
  pub consts: List<ConstDecl>;
  pub functions: List<FnDecl>;
  pub span: Span;
}

pub struct VariantDecl {
  /// `@default` before the variant of an enum marked `@default`.
  pub default: Option<Span>;
  pub name: Ident;
  pub fields: VariantFields;
  /// `= 7` or `= -1` after a variant of an enum with an integer representation.
  pub discriminant: Option<Discriminant>;
  pub span: Span;
}

/// An explicit discriminant: an integer literal, as decimal digits, with its sign.
pub struct Discriminant {
  pub value: String;
  pub negative: bool;
  pub span: Span;
}

pub enum VariantFields {
  Unit,
  Tuple(List<TypeExpr>),
  Named(List<VariantFieldDecl>),
}

pub struct VariantFieldDecl {
  pub name: Ident;
  pub ty: TypeExpr;
  pub span: Span;
}

pub struct StructDecl {
  pub repr_c: bool;
  /// `@default`: the default of every field is its `Default` (Q636).
  pub default: Option<Span>;
  /// `union`: its fields share their memory (docs/spec/10-ffi.md).
  pub is_union: bool;
  pub visibility: Visibility;
  pub name: Ident;
  pub generics: List<GenericParam>;
  pub impls: List<TypeExpr>;
  pub fields: List<FieldDecl>;
  /// Constants of the struct (Q683).
  pub consts: List<ConstDecl>;
  pub functions: List<FnDecl>;
  pub span: Span;

  /// Whether this is an opaque C type: a `@repr(C)` struct whose only field is a `prv` array of
  /// length 0, as stable bindgen writes them. Its values never exist; it is used behind raw
  /// pointers (docs/adr/0103-build-scripts-and-binding-generation.md, Q721).
  pub fn is_opaque(self) -> bool {
    if !self.repr_c || self.is_union || self.fields.len() != 1 {
      return false;
    }

    const field = self.fields[0];

    if let Visibility::Private = field.visibility {
      return match field.ty.kind {
        TypeExprKind::Array { len, .. } => match len.value.parse_u64() {
          Ok(count) => count == 0,
          Err(_) => false,
        },
        _ => false,
      };
    }

    false
  }
}

pub struct FieldDecl {
  pub visibility: Visibility;
  /// `const` (false) or `var` (true) before the name.
  pub mutable: Option<bool>;
  pub is_weak: bool;
  pub name: Ident;
  pub ty: TypeExpr;
  pub span: Span;
}

pub struct FnDecl {
  pub id: u32;
  pub extern_c: bool;
  pub export: Option<Export>;
  pub visibility: Visibility;
  pub is_abstract: bool;
  pub is_override: bool;
  /// `async fn`: calling it returns a `Task` (docs/spec/12-async.md).
  pub is_async: bool;
  /// `unsafe fn`: calling it needs `unsafe` (docs/spec/10-ffi.md).
  pub is_unsafe: bool;
  pub name: Ident;
  pub generics: List<GenericParam>;
  /// The span of `self`, only in methods.
  pub self_param: Option<Span>;
  pub params: List<Param>;
  pub return_type: Option<TypeExpr>;
  pub body: Block;
  pub span: Span;
}

/// A type parameter `T: Bound1 + Bound2`, with the bounds of its `where` clause too.
pub struct GenericParam {
  pub name: Ident;
  pub bounds: List<TypeExpr>;
}

pub struct Param {
  pub name: Ident;
  pub ty: TypeExpr;
  pub span: Span;
}

pub class TypeExpr {
  pub const kind: TypeExprKind;
  pub const span: Span;

  pub fn new(self, kind: TypeExprKind, span: Span) {
    self.kind = kind;
    self.span = span;
  }
}

pub enum TypeExprKind {
  /// `()`
  Unit,
  /// `(A, B, ...)`, with two or more elements (docs/adr/0092-tuples.md).
  Tuple(List<TypeExpr>),
  /// A named type; `Self` is a path with the single segment `Self`.
  Path(Path),
  /// `Option<T>`, `Result<T, E>`
  Generic { path: Path, args: List<TypeExpr> },
  /// `[T; N]`
  Array { elem: TypeExpr, len: ArrayLen },
  /// `*const T` or `*mut T`
  Ptr { mutable: bool, pointee: TypeExpr },
  /// `&T` or `&mut T`, only the type of a parameter.
  Ref { mutable: bool, pointee: TypeExpr },
  /// `[T]`, only after the `&` or `&mut` of a parameter's type: a slice.
  Slice(TypeExpr),
  /// `fn(A, B) -> R`
  Fn { params: List<TypeExpr>, ret: Option<TypeExpr> },
  /// `extern "C" fn(A, B) -> R`, or `unsafe extern "C" fn(...)`: a C function pointer.
  CFn { is_unsafe: bool, params: List<TypeExpr>, ret: Option<TypeExpr> },
}

/// The length of an array type or repeat expression: an integer literal, as decimal digits.
pub struct ArrayLen {
  pub value: String;
  pub suffix: Option<String>;
  pub span: Span;
}

/// `a::b::c`; the keywords `pkg`, `self`, `super` and `Self` are segments with their own names.
pub struct Path {
  pub id: u32;
  pub segments: List<Ident>;
  /// Type arguments written after one of the segments in an expression.
  pub type_args: Option<TypeArgs>;
  pub span: Span;
}

/// `<T, U>` after the segment at `segment` of an expression path.
pub struct TypeArgs {
  pub segment: usize;
  pub args: List<TypeExpr>;
  pub span: Span;
}

pub struct Block {
  pub stmts: List<Stmt>;
  /// The final expression without `;`, which is the value of the block.
  pub tail: Option<Expr>;
  pub span: Span;
}

pub enum Stmt {
  /// `const name: Type = init;` or `var ...`
  Let(LetStmt),
  /// `target = value;`, or `target op= value;` when `op` is set.
  Assign { target: Expr, op: Option<BinaryOp>, value: Expr, span: Span },
  /// `expr;`, or a block-like expression used as a statement.
  Expr(Expr),
}

pub struct LetStmt {
  pub id: u32;
  pub mutable: bool;
  pub name: Ident;
  pub ty: Option<TypeExpr>;
  pub init: Option<Expr>;
  pub span: Span;
  /// Set on the hidden binding a tuple pattern of `const`, `var` or `for` becomes: the parser
  /// reads each element from it into a binding of its own (docs/adr/0092-tuples.md, Q610).
  pub shape: Option<TupleShape>;
}

/// Whether `name` is that of a hidden binding the parser makes for a tuple pattern: no source
/// can write it.
pub fn is_hidden(name: String) -> bool {
  name.starts_with("_tuple#")
}

/// Whether `value` reads an element of the hidden binding of a tuple pattern: the parser wrote
/// it, at the place of the name it binds.
pub fn is_hidden_read(value: Expr) -> bool {
  match value.kind {
    ExprKind::Field { base, .. } => match base.kind {
      ExprKind::Path(path) => path.segments.len() == 1 && is_hidden(path.segments[0].name),
      _ => false,
    },
    ExprKind::Path(path) => path.segments.len() == 1 && is_hidden(path.segments[0].name),
    _ => false,
  }
}

/// The elements a tuple pattern of a declaration takes apart.
pub struct TupleShape {
  /// The elements named or `_`, without `..`.
  pub count: usize;
  /// Whether `..` stands for any number of elements.
  pub rest: bool;
  /// The pattern.
  pub span: Span;
}

pub enum BinaryOp {
  Add,
  Sub,
  Mul,
  Div,
  Rem,
  Eq,
  Ne,
  Lt,
  Le,
  Gt,
  Ge,
  And,
  Or,
  /// The bitwise operators and shifts (docs/adr/0088-bitwise-operators-and-integer-methods.md).
  BitAnd,
  BitOr,
  BitXor,
  Shl,
  Shr,
}

pub fn binary_symbol(op: BinaryOp) -> String {
  match op {
    BinaryOp::Add => "+",
    BinaryOp::Sub => "-",
    BinaryOp::Mul => "*",
    BinaryOp::Div => "/",
    BinaryOp::Rem => "%",
    BinaryOp::Eq => "==",
    BinaryOp::Ne => "!=",
    BinaryOp::Lt => "<",
    BinaryOp::Le => "<=",
    BinaryOp::Gt => ">",
    BinaryOp::Ge => ">=",
    BinaryOp::And => "&&",
    BinaryOp::Or => "||",
    BinaryOp::BitAnd => "&",
    BinaryOp::BitOr => "|",
    BinaryOp::BitXor => "^",
    BinaryOp::Shl => "<<",
    BinaryOp::Shr => ">>",
  }
}

pub enum UnaryOp {
  Neg,
  Not,
  /// `*pointer`, only inside `unsafe`.
  Deref,
}

pub class Expr {
  pub const id: u32;
  pub const kind: ExprKind;
  pub const span: Span;

  pub fn new(self, id: u32, kind: ExprKind, span: Span) {
    self.id = id;
    self.kind = kind;
    self.span = span;
  }

  /// Block-like expressions can be statements without a trailing `;`.
  pub fn is_block_like(self) -> bool {
    match self.kind {
      ExprKind::If { .. } | ExprKind::While { .. } | ExprKind::Loop(_) | ExprKind::For { .. } | ExprKind::Match { .. } | ExprKind::Block(_)
        | ExprKind::Unsafe(_) => true,
      _ => false,
    }
  }
}

pub enum ExprKind {
  Int { value: String, suffix: Option<String> },
  Float { text: String, suffix: Option<String> },
  Bool(bool),
  Char(char),
  Str(String),
  Template(List<TemplatePart>),
  /// `()`
  Unit,
  /// `(a, b, ...)`, with two or more elements (docs/adr/0092-tuples.md).
  Tuple(List<Expr>),
  Path(Path),
  Call { callee: Expr, args: List<Expr> },
  /// `receiver.method(args)`
  MethodCall { receiver: Expr, method: Ident, args: List<Expr> },
  /// `base.name`, or `base.0` for an element of a tuple, whose name is the index.
  Field { base: Expr, name: Ident },
  /// `base[index]`
  Index { base: Expr, index: Expr },
  /// `Name { field: value, ... }`; the shorthand `{ x }` is stored as `{ x: x }`.
  /// `Name { a: 1, ..base }`: the fields not written come from `base`
  /// (docs/adr/0094-conversions-and-defaults.md, Q643).
  StructLit { path: Path, fields: List<FieldInit>, base: Option<Expr> },
  /// `[a, b, c]`
  ArrayLit(List<Expr>),
  /// `[value; N]`
  ArrayRepeat { value: Expr, len: ArrayLen },
  Unary { op: UnaryOp, operand: Expr },
  Binary { op: BinaryOp, lhs: Expr, rhs: Expr },
  Cast { expr: Expr, ty: TypeExpr },
  /// `&raw const place` or `&raw mut place` (`raw`): the address of a place, as a raw pointer;
  /// otherwise `&value` or `&mut place`, a reference lent to a parameter.
  AddrOf { mutable: bool, place: Expr, raw: bool },
  /// `start..end` or `start..=end`
  Range { start: Expr, end: Expr, inclusive: bool },
  /// `expr?`
  Try(Expr),
  /// `await task`, only inside an `async fn`.
  Await(Expr),
  /// `zod`, the parent class's view of `self`.
  Zod,
  /// `(a, b: T) => body` or `x => body`.
  Lambda { params: List<LambdaParam>, body: Expr },
  /// `new Type(args)`
  New { path: Path, args: List<Expr> },
  Match { scrutinee: Expr, arms: List<MatchArm> },
  Block(Block),
  /// `unsafe { ... }`
  Unsafe(Block),
  If { cond: Expr, then_block: Block, else_branch: Option<Expr> },
  While { cond: Expr, body: Block },
  Loop(Block),
  /// `for var in iter { body }`
  For { variable: Ident, iter: Expr, body: Block },
  Break(Option<Expr>),
  Continue,
  Return(Option<Expr>),
}

/// A parameter of a lambda, with an optional type.
pub struct LambdaParam {
  pub name: Ident;
  pub ty: Option<TypeExpr>;
  pub span: Span;
}

pub struct MatchArm {
  pub pattern: Pattern;
  /// `if condition` after the pattern.
  pub guard: Option<Expr>;
  pub body: Expr;
  pub span: Span;
}

pub class Pattern {
  pub const id: u32;
  pub const kind: PatternKind;
  pub const span: Span;

  pub fn new(self, id: u32, kind: PatternKind, span: Span) {
    self.id = id;
    self.kind = kind;
    self.span = span;
  }
}

pub enum PatternKind {
  /// `_`
  Wildcard,
  /// A single name: a new binding, or a prelude variant without data (`None`).
  Ident(Ident),
  /// An integer (possibly negated), character, boolean or string literal.
  Literal(Expr),
  /// A variant without data: `Shape::Empty`.
  Path(Path),
  /// `Shape::Circle(r)`, `Some(x)`
  Tuple { path: Path, elems: List<Pattern> },
  /// `Shape::Rect { w, h: 0.0, .. }`; `rest` is set by `..`.
  Named { path: Path, fields: List<FieldPattern>, rest: bool },
  /// `(a, b)`, or `(a, .., z)` with `rest` the position of `..` among `elems`
  /// (docs/adr/0092-tuples.md, Q610).
  Elements { elems: List<Pattern>, rest: Option<usize> },
  /// `a | b`
  Or(List<Pattern>),
}

/// `name: pattern`; the shorthand `name` is stored with an `Ident` pattern.
pub struct FieldPattern {
  pub name: Ident;
  pub pattern: Pattern;
  pub span: Span;
}

pub struct FieldInit {
  pub name: Ident;
  pub value: Expr;
  pub span: Span;
}

pub enum TemplatePart {
  Text(String),
  Expr(Expr),
  /// `{expr:spec}` in a format string (docs/adr/0089-display-debug-and-format-specifiers.md).
  Formatted { expr: Expr, spec: FormatSpec },

  /// The interpolated expression, of either form.
  pub fn expr(self) -> Option<Expr> {
    match self {
      TemplatePart::Text(_) => None,
      TemplatePart::Expr(inner) => Some(inner),
      TemplatePart::Formatted { expr, .. } => Some(expr),
    }
  }

  /// The interpolated expression, then the bindings its specifier reads for its width and
  /// precision (`{x:>width$.precision$}`, docs/adr/0101-the-rest-of-s2.md, Q711).
  pub fn exprs(self) -> List<Expr> {
    const found: List<Expr> = new List();

    if let Some(inner) = self.expr() {
      found.push(inner);
    }

    if let TemplatePart::Formatted { spec, .. } = self {
      if let Some(width) = spec.width_expr {
        found.push(width);
      }

      if let Some(precision) = spec.precision_expr {
        found.push(precision);
      }
    }

    found
  }
}

/// A format specifier, Rust's `[[fill]align][+][#][0][width][.precision][type]`
/// (docs/adr/0089-display-debug-and-format-specifiers.md, Q585).
pub struct FormatSpec {
  pub fill: char;
  /// 0 without an alignment, 1 for `<`, 2 for `^`, 3 for `>`.
  pub align: u32;
  pub plus: bool;
  pub alternate: bool;
  pub zero: bool;
  pub width: Option<u64>;
  pub precision: Option<u64>;
  /// `width$` and `.precision$`: a binding read for them when the string is formatted (Q711).
  pub width_expr: Option<Expr>;
  pub precision_expr: Option<Expr>;
  /// `""`, `"?"`, `"x"`, `"X"`, `"o"`, `"b"`, `"e"` or `"E"`.
  pub kind: String;
  pub span: Span;
}
