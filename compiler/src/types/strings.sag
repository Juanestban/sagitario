//! Methods of `String`, `char` and `StringBuilder`, and `new StringBuilder()`
//! (docs/spec/02-types.md#string-f1). Most methods are runtime functions taking the receiver and
//! the arguments in order; a few build an `Option` or `Result` and are lowered specially. The
//! port of `sagitario_types::text`.

use pkg::ast::{Expr, ExprKind, Ident, Path};
use pkg::diagnostics;
use pkg::diagnostics::Diagnostic;
use pkg::diagnostics::codes;
use pkg::resolve::{TypeItem, TypeRes};
use pkg::types::{Checker, FloatTy, IntTy, Type, TypeKind};
use pkg::types;
use pkg::types::classes;
use pkg::types::collections;
use pkg::types::exprs;
use pkg::types::typed::BuiltinMethod;

/// A method implemented by a runtime function: its name, parameters, result and whether it also
/// receives the source location (to report panics).
struct RuntimeMethod {
  pub name: String;
  pub params: List<Type>;
  pub ret: Type;
  pub function: String;
  pub located: bool;
}

fn runtime(name: String, params: List<Type>, ret: Type, function: String) -> RuntimeMethod {
  RuntimeMethod { name: name, params: params, ret: ret, function: function, located: false }
}

fn located(name: String, params: List<Type>, ret: Type, function: String) -> RuntimeMethod {
  RuntimeMethod { name: name, params: params, ret: ret, function: function, located: true }
}

fn usize_type() -> Type {
  types::int(IntTy::Usize)
}

fn string_methods() -> List<RuntimeMethod> {
  const string = types::string();
  const bool_ty = types::of(TypeKind::Bool);

  List::from([
    runtime("len", new List(), usize_type(), "sag_string_len"),
    runtime("as_ptr", new List(), types::of(TypeKind::Ptr { mutable: false, pointee: types::int(IntTy::U8) }), "sag_string_ptr"),
    runtime("is_empty", new List(), bool_ty, "sag_string_is_empty"),
    runtime("contains", List::from([string]), bool_ty, "sag_string_contains"),
    runtime("starts_with", List::from([string]), bool_ty, "sag_string_starts_with"),
    runtime("ends_with", List::from([string]), bool_ty, "sag_string_ends_with"),
    runtime("trim", new List(), string, "sag_string_trim"),
    runtime("trim_start", new List(), string, "sag_string_trim_start"),
    runtime("trim_end", new List(), string, "sag_string_trim_end"),
    runtime("to_ascii_uppercase", new List(), string, "sag_string_to_ascii_uppercase"),
    runtime("to_ascii_lowercase", new List(), string, "sag_string_to_ascii_lowercase"),
    runtime("replace", List::from([string, string]), string, "sag_string_replace"),
    located("repeat", List::from([usize_type()]), string, "sag_string_repeat_at"),
    located("substring", List::from([usize_type(), usize_type()]), string, "sag_string_substring_at"),
  ])
}

fn char_methods() -> List<RuntimeMethod> {
  const bool_ty = types::of(TypeKind::Bool);
  const char_ty = types::of(TypeKind::Char);

  List::from([
    runtime("is_ascii_digit", new List(), bool_ty, "sag_char_is_ascii_digit"),
    runtime("is_ascii_alphabetic", new List(), bool_ty, "sag_char_is_ascii_alphabetic"),
    runtime("is_ascii_alphanumeric", new List(), bool_ty, "sag_char_is_ascii_alphanumeric"),
    runtime("is_ascii_whitespace", new List(), bool_ty, "sag_char_is_ascii_whitespace"),
    runtime("is_ascii_uppercase", new List(), bool_ty, "sag_char_is_ascii_uppercase"),
    runtime("is_ascii_lowercase", new List(), bool_ty, "sag_char_is_ascii_lowercase"),
    runtime("to_ascii_uppercase", new List(), char_ty, "sag_char_to_ascii_uppercase"),
    runtime("to_ascii_lowercase", new List(), char_ty, "sag_char_to_ascii_lowercase"),
  ])
}

fn builder_methods() -> List<RuntimeMethod> {
  List::from([
    runtime("append", List::from([types::string()]), types::unit(), "sag_builder_append"),
    runtime("append_char", List::from([types::of(TypeKind::Char)]), types::unit(), "sag_builder_append_char"),
    runtime("len", new List(), usize_type(), "sag_builder_len"),
    runtime("is_empty", new List(), types::of(TypeKind::Bool), "sag_builder_is_empty"),
    runtime("clear", new List(), types::unit(), "sag_builder_clear"),
    runtime("to_string", new List(), types::string(), "sag_builder_to_string"),
  ])
}

/// The type parsed by `parse_<name>`.
fn parse_target(method: String) -> Option<Type> {
  if !method.starts_with("parse_") {
    return None;
  }

  const name = method.substring(6, method.len());

  if name == "f32" {
    return Some(types::of(TypeKind::Float(FloatTy::F32)));
  }

  if name == "f64" {
    return Some(types::of(TypeKind::Float(FloatTy::F64)));
  }

  match types::int_from_name(name) {
    Some(int_ty) => Some(types::int(int_ty)),
    None => None,
  }
}

/// A method call on a `String`, `char` or `StringBuilder`.
pub fn text_method(cx: Checker, value: Expr, receiver_ty: Type, method: Ident, args: List<Expr>) -> Type {
  const name = method.name;
  const is_string = types::is_string(receiver_ty);
  const is_char = match receiver_ty.kind {
    TypeKind::Char => true,
    _ => false,
  };
  var special: Option<BuiltinMethod> = None;
  var special_params: List<Type> = new List();
  var special_ret = types::error();

  if is_string && name == "find" {
    special = Some(BuiltinMethod::Find);
    special_params = List::from([types::string()]);
    special_ret = types::option(usize_type());
  } else if is_char && name == "to_digit" {
    special = Some(BuiltinMethod::ToDigit);
    special_params = List::from([types::int(IntTy::U32)]);
    special_ret = types::option(types::int(IntTy::U32));
  } else if is_string {
    if let Some(target) = parse_target(name) {
      special = Some(BuiltinMethod::Parse(target));
      special_ret = types::of(TypeKind::Result { value: target, error: types::string() });
    }
  }

  if let Some(builtin) = special {
    exprs::check_args(cx, value.span, "method", special_params, args);
    cx.typed.builtin_methods.insert(value.id, builtin);

    return special_ret;
  }

  // Outside of `for`, implemented by prelude functions.
  if is_string {
    var prelude: Option<String> = None;

    if name == "chars" {
      prelude = Some("string_chars");
    } else if name == "bytes" {
      prelude = Some("string_bytes");
    } else if name == "split" {
      prelude = Some("string_split");
    } else if name == "lines" {
      prelude = Some("string_lines");
    }

    if let Some(function) = prelude {
      return collections::prelude_method(cx, value, function, new List(), args);
    }
  }

  const methods = if is_string { string_methods() } else if is_char { char_methods() } else { builder_methods() };
  var found: Option<RuntimeMethod> = None;

  for candidate in methods {
    if found.is_none() && candidate.name == name {
      found = Some(candidate);
    }
  }

  const chosen = match found {
    Some(chosen) => chosen,
    None => {
      var diagnostic = Diagnostic::error(codes::UNKNOWN_MEMBER, method.span, "no method `" + name + "` on type `" + types::text(receiver_ty) + "`");
      const names: List<String> = new List();

      for candidate in methods {
        names.push(candidate.name);
      }

      if is_string {
        for extra in List::from(["find", "chars", "bytes", "split", "lines", "parse_i32"]) {
          names.push(extra);
        }
      }

      if let Some(similar) = diagnostics::closest_match(name, names) {
        diagnostic = diagnostic.with_help("a method with a similar name exists: `" + similar + "`");
      }

      cx.diagnostics.push(diagnostic);
      exprs::unchecked_args(cx, args);

      return types::error();
    }
  };

  exprs::check_args(cx, value.span, "method", chosen.params, args);
  cx.typed.builtin_methods.insert(value.id, BuiltinMethod::Runtime { function: chosen.function, located: chosen.located });

  chosen.ret
}

/// The element type of `for x in text.chars()` or `text.bytes()`, or `None` if `iter` is not such
/// a call.
pub fn text_iterable(cx: Checker, iter: Expr) -> Option<Type> {
  var receiver = iter;
  var method_name = "";
  var method_span = iter.span;
  var args: List<Expr> = new List();
  var is_call = false;

  if let ExprKind::MethodCall { receiver: found, method, args: found_args } = iter.kind {
    receiver = found;
    method_name = method.name;
    method_span = method.span;
    args = found_args;
    is_call = true;
  }

  if !is_call {
    return None;
  }

  var builtin = BuiltinMethod::Chars;
  var elem = types::of(TypeKind::Char);

  if method_name == "bytes" {
    builtin = BuiltinMethod::Bytes;
    elem = types::int(IntTy::U8);
  } else if method_name != "chars" {
    return None;
  }

  const receiver_ty = exprs::expr(cx, receiver, None);
  const valid = match receiver_ty.kind {
    TypeKind::String | TypeKind::Error | TypeKind::Never => true,
    _ => false,
  };

  if !valid {
    cx.error(codes::UNKNOWN_MEMBER, method_span, "no method `" + method_name + "` on type `" + types::text(receiver_ty) + "`");
    exprs::unchecked_args(cx, args);

    return Some(types::error());
  }

  exprs::check_args(cx, iter.span, "method", new List(), args);
  cx.typed.builtin_methods.insert(iter.id, builtin);
  cx.typed.expr_types.insert(iter.id, types::unit());

  Some(elem)
}

/// `new Type(args)`: a class instance or a `StringBuilder`.
pub fn new_expr(cx: Checker, value: Expr, path: Path, args: List<Expr>, expected: Option<Type>) -> Type {
  const name = match path.segments.last() {
    Some(segment) => segment.name,
    None => "",
  };
  const resolved = cx.resolution.type_paths.get(path.id);
  var user_type = false;
  var is_error_res = false;

  match resolved {
    Some(TypeRes::Item(TypeItem::Class(id))) => return classes::new_instance(cx, value, path, id, args, expected),
    Some(TypeRes::Item(_)) => {
      user_type = true;
    }
    Some(TypeRes::Error) => {
      is_error_res = true;
    }
    _ => {}
  }

  if path.segments.len() == 1 && name == "List" && !user_type {
    return collections::new_list(cx, path, args, expected);
  }

  if path.segments.len() == 1 && name == "StringBuilder" && !user_type {
    exprs::check_args(cx, path.span, "constructor", new List(), args);

    return types::of(TypeKind::StringBuilder);
  }

  exprs::unchecked_args(cx, args);

  if is_error_res {
    return types::error();
  }

  if user_type {
    cx.diagnostics.push(
      Diagnostic::error(codes::WRONG_CALL_FORM, path.span, "`new` creates class instances, and `" + name + "` is not a class")
        .with_help("build the value with a literal or a static function, such as `" + name + "::new(...)`"),
    );
  } else {
    cx.error(codes::UNRESOLVED_NAME, path.span, "cannot find the class `" + name + "`");
  }

  types::error()
}
