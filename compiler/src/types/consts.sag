//! Module-level constants (docs/spec/03-memory.md#module-level-constants, ADR-0049): the compiler
//! computes each value from literals, other constants, arithmetic, comparisons, casts and
//! `include_str`, and reports anything it cannot compute. The port of `sagitario_types::consts`.
//!
//! A constant may also be a struct, an enum, an array or a tuple of constants
//! (docs/adr/0099-associated-and-composite-constants.md, Q685): such a value, and one that reads a
//! part of one, is first checked as any expression, for its types, then computed from those types.
//!
//! Rust computes integers in `i128`. Every value that fits an integer type lies between
//! `i64::MIN` and `u64::MAX`, so `sag` keeps a sign and a `u64` magnitude (`Wide`), and treats a
//! result beyond that as one that fits no type, as Rust's range check does.

use pkg::ast::{BinaryOp, Expr, ExprKind, UnaryOp};
use pkg::ast;
use pkg::diagnostics::Diagnostic;
use pkg::diagnostics::codes;
use pkg::loader;
use pkg::resolve::Res;
use pkg::span::Span;
use pkg::types::{Checker, FloatTy, IntTy, Type, TypeKind};
use pkg::types;
use pkg::types::exprs;
use pkg::types::numbers;
use std::fs;
use std::io::ErrorKind;
use std::path;

const U64_MAX: u64 = 18446744073709551615;

/// An integer constant: a sign and a magnitude, never `-0`.
pub struct Wide {
  pub negative: bool;
  pub magnitude: u64;

  pub fn of(negative: bool, magnitude: u64) -> Wide {
    Wide { negative: negative && magnitude != 0, magnitude: magnitude }
  }

  pub fn text(self) -> String {
    if self.negative { `-${self.magnitude}` } else { `${self.magnitude}` }
  }

  pub fn compare(self, other: Wide) -> Ordering {
    if self.negative != other.negative {
      return if self.negative { Ordering::Less } else { Ordering::Greater };
    }

    if self.negative { other.magnitude.compare(self.magnitude) } else { self.magnitude.compare(other.magnitude) }
  }

  pub fn neg(self) -> Wide {
    Wide::of(!self.negative, self.magnitude)
  }

  /// The sum, or `None` beyond a `u64` magnitude.
  pub fn add(self, other: Wide) -> Option<Wide> {
    if self.negative == other.negative {
      if self.magnitude > U64_MAX - other.magnitude {
        return None;
      }

      return Some(Wide::of(self.negative, self.magnitude + other.magnitude));
    }

    if self.magnitude >= other.magnitude {
      Some(Wide::of(self.negative, self.magnitude - other.magnitude))
    } else {
      Some(Wide::of(other.negative, other.magnitude - self.magnitude))
    }
  }

  pub fn sub(self, other: Wide) -> Option<Wide> {
    self.add(other.neg())
  }

  pub fn mul(self, other: Wide) -> Option<Wide> {
    if self.magnitude != 0 && other.magnitude > U64_MAX / self.magnitude {
      return None;
    }

    Some(Wide::of(self.negative != other.negative, self.magnitude * other.magnitude))
  }

  /// Truncating division, as Rust's; `other` is not zero.
  pub fn div(self, other: Wide) -> Wide {
    Wide::of(self.negative != other.negative, self.magnitude / other.magnitude)
  }

  /// The remainder, with the sign of the dividend, as Rust's; `other` is not zero.
  pub fn rem(self, other: Wide) -> Wide {
    Wide::of(self.negative, self.magnitude % other.magnitude)
  }

  pub fn to_f64(self) -> f64 {
    const value = self.magnitude as f64;

    if self.negative { -value } else { value }
  }
}

/// The value of an integer literal: decimal digits, or `None` beyond `u64`.
fn literal(value: String) -> Option<Wide> {
  match value.parse_u64() {
    Ok(magnitude) => Some(Wide::of(false, magnitude)),
    Err(_) => None,
  }
}

/// The value of a module-level constant.
pub enum ConstValue {
  Bool(bool),
  Char(char),
  /// Within the range of the constant's integer type.
  Int(Wide),
  Float(f64),
  Str(String),
  /// A struct, an array or a tuple: its parts in order, a struct's in the order of its fields.
  Aggregate(List<Typed>),
  /// `[part; count]`, its part alone in a list: an enum cannot hold its own type directly.
  Repeat { part: List<Typed>, count: u64 },
  /// A variant of an enum, `Option` or `Result`, by its position, with its fields in order.
  Variant { index: u32, fields: List<Typed> },
}

/// Where the computation of each constant stands, to find constants that need themselves.
pub enum ConstState {
  Pending,
  Computing,
  Done,
}

/// A computed constant: its type and value.
pub struct Typed {
  pub ty: Type;
  pub value: ConstValue;
}

/// The type and value of every module-level constant.
pub fn const_defs(cx: Checker) {
  const count = cx.resolution.consts.len();
  const states: List<ConstState> = new List();

  for _ in 0..count {
    states.push(ConstState::Pending);
    cx.typed.const_types.push(types::error());
    cx.typed.const_values.push(None);
  }

  cx.const_states = states;

  // Every constant's type first: a value checked as an expression reads the types of the
  // constants it names. A constant of a type is checked inside it, where `Self` and the type's
  // private members are seen (docs/adr/0099-associated-and-composite-constants.md, Q683).
  const owner = cx.owner;

  for index in 0..count {
    if let Some(decl) = cx.resolution.const_decl(cx.package, index as u32) {
      cx.owner = const_owner(cx, index);
      cx.typed.const_types[index] = cx.type_expr(decl.ty);
    }
  }

  cx.owner = owner;

  for index in 0..count {
    const_value(cx, index as u32, None);
  }
}

/// The type declaring the constant at `index`, or `None` for a module's.
fn const_owner(cx: Checker, index: usize) -> Option<pkg::resolve::TypeItem> {
  match cx.resolution.consts.get(index) {
    Some(info) => info.owner,
    None => None,
  }
}

/// Whether a constant of type `ty` is a number, `bool`, `char` or `String`.
fn is_primitive(ty: Type) -> bool {
  match ty.kind {
    TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String => true,
    _ => false,
  }
}

/// Whether a constant can have the type `ty`: a primitive one, or a struct, an enum, an array or
/// a tuple of such types (Q685). `depth` stops at types nested deeper than any program writes.
fn constant_type(cx: Checker, ty: Type, depth: u32) -> bool {
  if is_primitive(ty) {
    return true;
  }

  if depth > 64 {
    return false;
  }

  match ty.kind {
    TypeKind::Array { elem, .. } => constant_type(cx, elem, depth + 1),
    TypeKind::Tuple(elems) => {
      for elem in elems {
        if !constant_type(cx, elem, depth + 1) {
          return false;
        }
      }

      true
    }
    TypeKind::Struct(named) => {
      match cx.typed.struct_def(named.id) {
        Some(def) => {
          if def.is_union {
            return false;
          }
        }
        None => return false,
      }

      for field in cx.typed.struct_field_types(named) {
        if !constant_type(cx, field, depth + 1) {
          return false;
        }
      }

      true
    }
    TypeKind::Enum(_) | TypeKind::Option(_) | TypeKind::Result { .. } => match cx.typed.variants(ty) {
      Some(variants) => {
        for variant in variants {
          for field in variant.field_types() {
            if !constant_type(cx, field, depth + 1) {
              return false;
            }
          }
        }

        true
      }
      None => false,
    },
    _ => false,
  }
}

/// Whether `value` builds a struct, an enum, an array or a tuple, or reads a part of one: what is
/// checked as an expression before it is computed.
fn has_parts(cx: Checker, value: Expr) -> bool {
  match value.kind {
    ExprKind::StructLit { .. } | ExprKind::ArrayLit(_) | ExprKind::ArrayRepeat { .. } | ExprKind::Tuple(_) | ExprKind::Field { .. } | ExprKind::Index { .. } => true,
    ExprKind::Path(_) => match cx.resolution.paths.get(value.id) {
      Some(Res::Variant(_)) => true,
      _ => false,
    },
    ExprKind::Call { callee, .. } => match cx.resolution.paths.get(callee.id) {
      Some(Res::Variant(_)) => true,
      _ => false,
    },
    ExprKind::Unary { operand, .. } => has_parts(cx, operand),
    ExprKind::Binary { lhs, rhs, .. } => has_parts(cx, lhs) || has_parts(cx, rhs),
    ExprKind::Cast { expr, .. } => has_parts(cx, expr),
    _ => false,
  }
}

/// Whether `value` has only the forms of a constant, reporting the first that is not: what can be
/// checked as an expression outside a function.
fn constant_shape(cx: Checker, value: Expr) -> bool {
  match value.kind {
    ExprKind::Int { .. } | ExprKind::Float { .. } | ExprKind::Bool(_) | ExprKind::Char(_) | ExprKind::Str(_) | ExprKind::Path(_) => true,
    ExprKind::Unary { op, operand } => {
      if op == UnaryOp::Deref {
        not_constant(cx, value.span);

        return false;
      }

      constant_shape(cx, operand)
    }
    ExprKind::Binary { lhs, rhs, .. } => constant_shape(cx, lhs) && constant_shape(cx, rhs),
    ExprKind::Cast { expr, .. } => constant_shape(cx, expr),
    ExprKind::Field { base, .. } => constant_shape(cx, base),
    ExprKind::Index { base, index } => constant_shape(cx, base) && constant_shape(cx, index),
    ExprKind::Tuple(elems) | ExprKind::ArrayLit(elems) => {
      for elem in elems {
        if !constant_shape(cx, elem) {
          return false;
        }
      }

      true
    }
    ExprKind::ArrayRepeat { value: repeated, .. } => constant_shape(cx, repeated),
    ExprKind::StructLit { fields, base, .. } => {
      if let Some(found) = base {
        not_constant(cx, found.span);

        return false;
      }

      for init in fields {
        if !constant_shape(cx, init.value) {
          return false;
        }
      }

      true
    }
    ExprKind::Call { callee, args } => {
      match cx.resolution.paths.get(callee.id) {
        Some(Res::Variant(_)) => {}
        Some(Res::Builtin(name)) if name == "include_str" => return true,
        _ => {
          not_constant(cx, value.span);

          return false;
        }
      }

      for arg in args {
        if !constant_shape(cx, arg) {
          return false;
        }
      }

      true
    }
    _ => {
      not_constant(cx, value.span);

      false
    }
  }
}

/// Computes a constant once; `use_span` is where another constant names it.
fn const_value(cx: Checker, id: u32, use_span: Option<Span>) -> Option<Typed> {
  const index = id as usize;
  const decl = cx.resolution.const_decl(cx.package, id)?;
  const state = cx.const_states.get(index)?;

  if state == ConstState::Done {
    const ty = cx.typed.const_types.get(index)?;

    return match cx.typed.const_values.get(index)? {
      Some(value) => Some(Typed { ty: ty, value: value }),
      None => None,
    };
  }

  if state == ConstState::Computing {
    cx.diagnostics.push(
      Diagnostic::error(codes::NOT_CONSTANT, use_span.unwrap_or(decl.name.span), "the constant `" + decl.name.name + "` needs its own value")
        .with_label(decl.name.span, "declared here"),
    );

    return None;
  }

  cx.const_states[index] = ConstState::Computing;

  const module = match cx.resolution.consts.get(index) {
    Some(info) => info.module,
    None => 0,
  };
  const ty = cx.typed.const_types.get(index)?;
  const valid = types::is_error(ty) || constant_type(cx, ty, 0);

  if !valid {
    const what = if const_owner(cx, index).is_some() { "a constant" } else { "a module-level constant" };

    cx.diagnostics.push(
      Diagnostic::error(codes::NOT_CONSTANT, decl.ty.span, what + " cannot have the type `" + types::text(ty) + "`")
        .with_note("constants are integers, floats, `bool`, `char`, `String`, and structs, enums, arrays and tuples of them"),
    );
  }

  var value: Option<ConstValue> = None;

  if valid && !types::is_error(ty) {
    if is_primitive(ty) && !has_parts(cx, decl.value) {
      value = const_expr(cx, decl.value, ty, module);
    } else if constant_shape(cx, decl.value) {
      // Its types first, as any expression's, in the type that declares it, if any (Q685).
      const owner = cx.owner;
      const reported = cx.diagnostics.len();

      cx.owner = const_owner(cx, index);
      exprs::expect(cx, decl.value, ty);
      cx.owner = owner;

      if cx.diagnostics.len() == reported {
        value = const_expr(cx, decl.value, ty, module);
      }
    }
  }

  cx.typed.const_types[index] = ty;
  cx.typed.const_values[index] = value;
  cx.const_states[index] = ConstState::Done;

  match value {
    Some(found) => Some(Typed { ty: ty, value: found }),
    None => None,
  }
}

/// Computes `expr` as a value of type `expected`, reporting a mismatch.
fn const_expr(cx: Checker, expr: Expr, expected: Type, module: usize) -> Option<ConstValue> {
  const found = const_eval(cx, expr, Some(expected), module)?;

  if !types::same_type(found.ty, expected) {
    cx.error(codes::MISMATCHED_TYPES, expr.span, "expected `" + types::text(expected) + "`, found `" + types::text(found.ty) + "`");

    return None;
  }

  Some(found.value)
}

/// The integer type of a literal: its suffix, else the hint, else `i32`.
fn literal_type(suffix: Option<String>, hint: Option<Type>) -> IntTy {
  if let Some(name) = suffix {
    if let Some(int_ty) = types::int_from_name(name) {
      return int_ty;
    }
  }

  if let Some(ty) = hint {
    if let TypeKind::Int(int_ty) = ty.kind {
      return int_ty;
    }
  }

  IntTy::I32
}

/// The type and value of `expr`; `hint` types integer and float literals without a suffix.
fn const_eval(cx: Checker, expr: Expr, hint: Option<Type>, module: usize) -> Option<Typed> {
  match expr.kind {
    ExprKind::Bool(value) => Some(Typed { ty: types::of(TypeKind::Bool), value: ConstValue::Bool(value) }),
    ExprKind::Char(value) => Some(Typed { ty: types::of(TypeKind::Char), value: ConstValue::Char(value) }),
    ExprKind::Str(value) => Some(Typed { ty: types::string(), value: ConstValue::Str(value) }),
    ExprKind::Int { value, suffix } => const_int(cx, literal(value), literal_type(suffix, hint), expr.span),
    ExprKind::Float { text, suffix } => {
      var float_ty = FloatTy::F64;

      match suffix {
        Some(name) => {
          if name == "f32" {
            float_ty = FloatTy::F32;
          }
        }
        None => {
          if let Some(ty) = hint {
            if let TypeKind::Float(FloatTy::F32) = ty.kind {
              float_ty = FloatTy::F32;
            }
          }
        }
      }

      const parsed = match text.replace("_", "").parse_f64() {
        Ok(parsed) => parsed,
        Err(_) => return None,
      };
      const typed = const_float(parsed, float_ty)?;

      // Infinities and NaN come from arithmetic (`1.0 / 0.0`), never from a literal too large.
      if let ConstValue::Float(rounded) = typed.value {
        if !is_finite(rounded) {
          const name = if float_ty == FloatTy::F32 { "f32" } else { "f64" };

          cx.error(codes::NOT_CONSTANT, expr.span, "this float literal is too large for `" + name + "`");

          return None;
        }
      }

      Some(typed)
    }
    ExprKind::Path(_) => match cx.resolution.paths.get(expr.id) {
      Some(Res::Const(other)) => const_value(cx, other, Some(expr.span)),
      Some(Res::Variant(variant)) => const_variant(cx, expr, variant, new List(), module),
      Some(Res::Builtin(name)) if numbers::int_limit(name).is_some() => match numbers::int_limit(name) {
        Some(limit) => {
          const max = types::int_max(limit.ty, cx.target.pointer_width);
          const value = if limit.max { Wide::of(false, max) } else if types::is_signed(limit.ty) { Wide::of(true, max + 1) } else { Wide::of(false, 0) };

          Some(Typed { ty: types::int(limit.ty), value: ConstValue::Int(value) })
        }
        None => not_constant(cx, expr.span),
      },
      _ => not_constant(cx, expr.span),
    },
    ExprKind::Unary { op, operand } => {
      // A negative literal: its magnitude may only fit once negated (`-128` in `i8`).
      if op == UnaryOp::Neg {
        if let ExprKind::Int { value, suffix } = operand.kind {
          const magnitude = match literal(value) {
            Some(found) => Some(found.neg()),
            None => None,
          };

          return const_int(cx, magnitude, literal_type(suffix, hint), expr.span);
        }
      }

      const found = const_eval(cx, operand, hint, module)?;

      match found.value {
        ConstValue::Int(value) => {
          if let TypeKind::Int(int_ty) = found.ty.kind {
            if op == UnaryOp::Neg {
              return const_int(cx, Some(value.neg()), int_ty, expr.span);
            }

            // Every bit flipped (docs/adr/0088-bitwise-operators-and-integer-methods.md).
            if op == UnaryOp::Not {
              const width = bits(int_ty, cx.target.pointer_width);

              return Some(Typed { ty: found.ty, value: ConstValue::Int(from_bits(low_mask(width) - to_bits(value, int_ty, cx.target.pointer_width), int_ty, cx.target.pointer_width)) });
            }
          }
        }
        ConstValue::Float(value) => {
          if op == UnaryOp::Neg {
            if let TypeKind::Float(float_ty) = found.ty.kind {
              return const_float(-value, float_ty);
            }
          }
        }
        ConstValue::Bool(value) => {
          if op == UnaryOp::Not {
            if let TypeKind::Bool = found.ty.kind {
              return Some(Typed { ty: found.ty, value: ConstValue::Bool(!value) });
            }
          }
        }
        _ => {}
      }

      const_operand_error(cx, expr.span, "`" + unary_symbol(op) + "`", found.ty)
    }
    ExprKind::Binary { op, lhs, rhs } => {
      const operand_hint: Option<Type> = if is_comparison(op) || op == BinaryOp::And || op == BinaryOp::Or { None } else { hint };
      const left = const_eval(cx, lhs, operand_hint, module)?;

      // The amount of a shift has a type of its own, `u32` for a literal.
      if op == BinaryOp::Shl || op == BinaryOp::Shr {
        const amount = const_eval(cx, rhs, Some(types::int(IntTy::U32)), module)?;

        return const_shift(cx, op, left, amount, expr.span);
      }

      const right = const_eval(cx, rhs, Some(left.ty), module)?;

      if !types::same_type(left.ty, right.ty) {
        cx.error(codes::MISMATCHED_TYPES, rhs.span, "expected `" + types::text(left.ty) + "`, found `" + types::text(right.ty) + "`");

        return None;
      }

      const_binary(cx, op, left.ty, left.value, right.value, expr.span)
    }
    ExprKind::Cast { expr: inner, ty } => {
      const found = const_eval(cx, inner, None, module)?;
      const owner = cx.owner;

      cx.owner = None;

      const to = cx.type_expr(ty);

      cx.owner = owner;
      const_cast(cx, found.ty, found.value, to, expr.span)
    }
    ExprKind::Call { callee, args } => {
      match cx.resolution.paths.get(callee.id) {
        Some(Res::Builtin(name)) if name == "include_str" => return include_str(cx, expr.span, args, module),
        Some(Res::Variant(variant)) => return const_variant(cx, expr, variant, args, module),
        _ => {}
      }

      not_constant(cx, expr.span)
    }
    ExprKind::StructLit { fields, .. } => const_struct(cx, expr, fields, module),
    ExprKind::Tuple(elems) => const_parts(cx, expr, elems, module),
    ExprKind::ArrayLit(elems) => const_parts(cx, expr, elems, module),
    ExprKind::ArrayRepeat { value, .. } => {
      const ty = checked_type(cx, expr)?;

      match ty.kind {
        TypeKind::Array { elem, len } => {
          const part = const_eval(cx, value, Some(elem), module)?;

          Some(Typed { ty: ty, value: ConstValue::Repeat { part: List::from([part]), count: len } })
        }
        _ => None,
      }
    }
    ExprKind::Field { base, name } => {
      const found = const_eval(cx, base, None, module)?;
      const parts = match found.value {
        ConstValue::Aggregate(parts) => parts,
        _ => return None,
      };
      const position = match found.ty.kind {
        TypeKind::Tuple(elems) => types::tuple_index(name.name, elems.len()),
        TypeKind::Struct(named) => cx.typed.field_index(named.id, name.name),
        _ => None,
      };

      parts.get(position?)
    }
    ExprKind::Index { base, index } => {
      const found = const_eval(cx, base, None, module)?;
      const position = const_eval(cx, index, Some(types::int(IntTy::Usize)), module)?;
      const at = match position.value {
        ConstValue::Int(found_index) => found_index,
        _ => return None,
      };
      const len = match found.value {
        ConstValue::Aggregate(parts) => parts.len() as u64,
        ConstValue::Repeat { count, .. } => count,
        _ => return None,
      };

      if at.negative || at.magnitude >= len {
        cx.error(codes::NOT_CONSTANT, expr.span, `index out of bounds: the len is ${len} but the index is ${at.text()}`);

        return None;
      }

      match found.value {
        ConstValue::Aggregate(parts) => parts.get(at.magnitude as usize),
        ConstValue::Repeat { part, .. } => part.first(),
        _ => None,
      }
    }
    _ => not_constant(cx, expr.span),
  }
}

/// The type the expression check gave `value`, which every value with parts has (Q685).
fn checked_type(cx: Checker, value: Expr) -> Option<Type> {
  match cx.typed.expr_types.get(value.id) {
    Some(ty) => if types::is_error(ty) { None } else { Some(ty) },
    None => {
      not_constant(cx, value.span);

      None
    }
  }
}

/// A tuple or an array of constants.
fn const_parts(cx: Checker, value: Expr, elems: List<Expr>, module: usize) -> Option<Typed> {
  const ty = checked_type(cx, value)?;
  const parts: List<Typed> = new List();

  for index in 0..elems.len() {
    const part_ty = match ty.kind {
      TypeKind::Tuple(part_types) => part_types.get(index)?,
      TypeKind::Array { elem, .. } => elem,
      _ => return None,
    };

    parts.push(Typed { ty: part_ty, value: const_expr(cx, elems[index], part_ty, module)? });
  }

  Some(Typed { ty: ty, value: ConstValue::Aggregate(parts) })
}

/// The value given to the field `name` in a literal.
fn field_value(fields: List<ast::FieldInit>, name: String) -> Option<Expr> {
  for init in fields {
    if init.name.name == name {
      return Some(init.value);
    }
  }

  None
}

/// `Point { x: 1, y: 2 }` or `Shape::Rect { w: 1, h: 2 }`, of constants.
fn const_struct(cx: Checker, value: Expr, fields: List<ast::FieldInit>, module: usize) -> Option<Typed> {
  const ty = checked_type(cx, value)?;

  match cx.resolution.paths.get(value.id) {
    Some(Res::Variant(variant)) => {
      const def = cx.typed.variants(ty)?.get(variant.index as usize)?;
      const parts: List<Typed> = new List();

      for field in def.fields {
        const given = field_value(fields, field.name?)?;

        parts.push(Typed { ty: field.ty, value: const_expr(cx, given, field.ty, module)? });
      }

      Some(Typed { ty: ty, value: ConstValue::Variant { index: variant.index, fields: parts } })
    }
    Some(Res::Struct(id)) => {
      const named = match ty.kind {
        TypeKind::Struct(found) => found,
        _ => return None,
      };
      const def = cx.typed.struct_def(id)?;
      const field_types = cx.typed.struct_field_types(named);
      const parts: List<Typed> = new List();

      for index in 0..def.fields.len() {
        const part_ty = field_types.get(index)?;
        const given = field_value(fields, def.fields[index].name)?;

        parts.push(Typed { ty: part_ty, value: const_expr(cx, given, part_ty, module)? });
      }

      Some(Typed { ty: ty, value: ConstValue::Aggregate(parts) })
    }
    _ => None,
  }
}

/// A variant without fields (`Color::Red`, `None`), or with them in order (`Some(3)`).
fn const_variant(cx: Checker, value: Expr, variant: pkg::resolve::VariantRef, args: List<Expr>, module: usize) -> Option<Typed> {
  const ty = checked_type(cx, value)?;
  const def = cx.typed.variants(ty)?.get(variant.index as usize)?;
  const field_types = def.field_types();
  const parts: List<Typed> = new List();

  for index in 0..args.len() {
    const part_ty = field_types.get(index)?;

    parts.push(Typed { ty: part_ty, value: const_expr(cx, args[index], part_ty, module)? });
  }

  Some(Typed { ty: ty, value: ConstValue::Variant { index: variant.index, fields: parts } })
}

fn not_constant(cx: Checker, span: Span) -> Option<Typed> {
  cx.diagnostics.push(
    Diagnostic::error(codes::NOT_CONSTANT, span, "the compiler cannot compute this expression")
      .with_note("a constant is made of literals, other constants, arithmetic, comparisons, `as` and `include_str`"),
  );

  None
}

fn const_operand_error(cx: Checker, span: Span, operator: String, ty: Type) -> Option<Typed> {
  cx.error(codes::INVALID_OPERAND, span, operator + " cannot be applied to `" + types::text(ty) + "`");

  None
}

/// The smallest value of an integer type, as text.
fn min_text(int_ty: IntTy, max: u64) -> String {
  if types::is_signed(int_ty) { `-${max + 1}` } else { "0" }
}

/// An integer of type `int_ty`, or an error if it does not fit (`None` is an overflow).
fn const_int(cx: Checker, value: Option<Wide>, int_ty: IntTy, span: Span) -> Option<Typed> {
  const max = types::int_max(int_ty, cx.target.pointer_width);
  var fits = false;

  if let Some(found) = value {
    fits = if found.negative { types::is_signed(int_ty) && found.magnitude <= max + 1 } else { found.magnitude <= max };
  }

  match value {
    Some(found) => {
      if fits {
        return Some(Typed { ty: types::int(int_ty), value: ConstValue::Int(found) });
      }
    }
    None => {}
  }

  const name = types::int_name(int_ty);

  cx.diagnostics.push(
    Diagnostic::error(codes::NOT_CONSTANT, span, "this constant does not fit in `" + name + "`")
      .with_note("`" + name + "` holds " + min_text(int_ty, max) + " to " + `${max}`),
  );

  None
}

fn is_nan(value: ConstValue) -> bool {
  match value {
    ConstValue::Float(found) => found != found,
    _ => false,
  }
}

/// Whether a float is a finite number: neither infinite nor NaN.
fn is_finite(value: f64) -> bool {
  value - value == 0.0
}

/// A float of `float_ty`: infinities and NaN are values like any other (docs/adr/0076).
fn const_float(value: f64, float_ty: FloatTy) -> Option<Typed> {
  const rounded = if float_ty == FloatTy::F32 { (value as f32) as f64 } else { value };

  Some(Typed { ty: types::of(TypeKind::Float(float_ty)), value: ConstValue::Float(rounded) })
}

fn compare_values(lhs: ConstValue, rhs: ConstValue) -> Option<Ordering> {
  match lhs {
    ConstValue::Aggregate(_) | ConstValue::Repeat { .. } | ConstValue::Variant { .. } => None,
    ConstValue::Int(a) => match rhs {
      ConstValue::Int(b) => Some(a.compare(b)),
      _ => None,
    },
    ConstValue::Float(a) => match rhs {
      ConstValue::Float(b) => Some(if a < b { Ordering::Less } else if a > b { Ordering::Greater } else { Ordering::Equal }),
      _ => None,
    },
    ConstValue::Bool(a) => match rhs {
      ConstValue::Bool(b) => Some(a.compare(b)),
      _ => None,
    },
    ConstValue::Char(a) => match rhs {
      ConstValue::Char(b) => Some(a.compare(b)),
      _ => None,
    },
    ConstValue::Str(a) => match rhs {
      ConstValue::Str(b) => Some(a.compare(b)),
      _ => None,
    },
  }
}

fn const_binary(cx: Checker, op: BinaryOp, ty: Type, lhs: ConstValue, rhs: ConstValue, span: Span) -> Option<Typed> {
  // Only the primitive types have operators in a constant (Q685).
  if !is_primitive(ty) {
    return const_operand_error(cx, span, "`" + ast::binary_symbol(op) + "`", ty);
  }

  if is_comparison(op) {
    // NaN is unordered: only `!=` holds.
    if is_nan(lhs) || is_nan(rhs) {
      return Some(Typed { ty: types::of(TypeKind::Bool), value: ConstValue::Bool(op == BinaryOp::Ne) });
    }

    const ordering = compare_values(lhs, rhs)?;
    var result = false;

    match ordering {
      Ordering::Less => {
        result = op == BinaryOp::Ne || op == BinaryOp::Lt || op == BinaryOp::Le;
      }
      Ordering::Equal => {
        result = op == BinaryOp::Eq || op == BinaryOp::Le || op == BinaryOp::Ge;
      }
      Ordering::Greater => {
        result = op == BinaryOp::Ne || op == BinaryOp::Gt || op == BinaryOp::Ge;
      }
    }

    return Some(Typed { ty: types::of(TypeKind::Bool), value: ConstValue::Bool(result) });
  }

  const symbol = "`" + ast::binary_symbol(op) + "`";

  match lhs {
    ConstValue::Bool(a) => {
      if let ConstValue::Bool(b) = rhs {
        if let TypeKind::Bool = ty.kind {
          if op == BinaryOp::And {
            return Some(Typed { ty: ty, value: ConstValue::Bool(a && b) });
          }

          if op == BinaryOp::Or || op == BinaryOp::BitOr {
            return Some(Typed { ty: ty, value: ConstValue::Bool(a || b) });
          }

          if op == BinaryOp::BitAnd {
            return Some(Typed { ty: ty, value: ConstValue::Bool(a && b) });
          }

          if op == BinaryOp::BitXor {
            return Some(Typed { ty: ty, value: ConstValue::Bool(a != b) });
          }
        }
      }
    }
    ConstValue::Str(a) => {
      if let ConstValue::Str(b) = rhs {
        if op == BinaryOp::Add && types::is_string(ty) {
          return Some(Typed { ty: ty, value: ConstValue::Str(a + b) });
        }
      }
    }
    ConstValue::Int(a) => {
      if let ConstValue::Int(b) = rhs {
        if let TypeKind::Int(int_ty) = ty.kind {
          if (op == BinaryOp::Div || op == BinaryOp::Rem) && b.magnitude == 0 {
            cx.error(codes::NOT_CONSTANT, span, "this constant divides by zero");

            return None;
          }

          if op == BinaryOp::Add {
            return const_int(cx, a.add(b), int_ty, span);
          }

          if op == BinaryOp::Sub {
            return const_int(cx, a.sub(b), int_ty, span);
          }

          if op == BinaryOp::Mul {
            return const_int(cx, a.mul(b), int_ty, span);
          }

          if op == BinaryOp::Div {
            return const_int(cx, Some(a.div(b)), int_ty, span);
          }

          if op == BinaryOp::Rem {
            return const_int(cx, Some(a.rem(b)), int_ty, span);
          }

          if op == BinaryOp::BitAnd || op == BinaryOp::BitOr || op == BinaryOp::BitXor {
            const width = cx.target.pointer_width;
            const combined = combine_bits(op, to_bits(a, int_ty, width), to_bits(b, int_ty, width));

            return Some(Typed { ty: ty, value: ConstValue::Int(from_bits(combined, int_ty, width)) });
          }

          return const_operand_error(cx, span, symbol, ty);
        }
      }
    }
    ConstValue::Float(a) => {
      if let ConstValue::Float(b) = rhs {
        if let TypeKind::Float(float_ty) = ty.kind {
          if op == BinaryOp::Add {
            return const_float(a + b, float_ty);
          }

          if op == BinaryOp::Sub {
            return const_float(a - b, float_ty);
          }

          if op == BinaryOp::Mul {
            return const_float(a * b, float_ty);
          }

          if op == BinaryOp::Div {
            return const_float(a / b, float_ty);
          }

          if op == BinaryOp::Rem {
            return const_float(a % b, float_ty);
          }

          return const_operand_error(cx, span, symbol, ty);
        }
      }
    }
    _ => {}
  }

  const_operand_error(cx, span, symbol, ty)
}

/// The width in bits of an integer type.
fn bits(int_ty: IntTy, pointer_width: u32) -> u32 {
  match int_ty {
    IntTy::I8 | IntTy::U8 => 8,
    IntTy::I16 | IntTy::U16 => 16,
    IntTy::I32 | IntTy::U32 => 32,
    IntTy::I64 | IntTy::U64 => 64,
    IntTy::Isize | IntTy::Usize => pointer_width,
  }
}

/// The unsigned type of the same width as `int_ty`.
fn unsigned_of(int_ty: IntTy) -> IntTy {
  match int_ty {
    IntTy::I8 => IntTy::U8,
    IntTy::I16 => IntTy::U16,
    IntTy::I32 => IntTy::U32,
    IntTy::I64 => IntTy::U64,
    IntTy::Isize => IntTy::Usize,
    other => other,
  }
}

/// The bits of `value` in the width of `int_ty`, as an unsigned number (two's complement).
fn to_bits(value: Wide, int_ty: IntTy, pointer_width: u32) -> u64 {
  wrap(value, unsigned_of(int_ty), pointer_width).magnitude
}

/// The value of `int_ty` whose bits are `bits`.
fn from_bits(bits: u64, int_ty: IntTy, pointer_width: u32) -> Wide {
  wrap(Wide::of(false, bits), int_ty, pointer_width)
}

/// Every bit of a width set.
fn low_mask(width: u32) -> u64 {
  if width == 64 { U64_MAX } else { power_of_two(width) - 1 }
}

/// 2 to the power `n`, for `n` below 64.
fn power_of_two(n: u32) -> u64 {
  var result = 1u64;

  for _ in 0..n {
    result = result * 2;
  }

  result
}

/// `a & b`, `a | b` or `a ^ b`, one bit at a time: the compiler is built by a seed without
/// bitwise operators.
fn combine_bits(op: BinaryOp, a: u64, b: u64) -> u64 {
  var result = 0u64;
  var x = a;
  var y = b;

  for index in 0..64u32 {
    const p = x % 2;
    const q = y % 2;
    const bit = if op == BinaryOp::BitAnd { p * q } else if op == BinaryOp::BitOr { if p + q > 0 { 1u64 } else { 0u64 } } else { (p + q) % 2 };

    if bit == 1 {
      result += power_of_two(index);
    }

    x = x / 2;
    y = y / 2;
  }

  result
}

/// `value << amount` or `value >> amount`, an error when the amount is not below the width.
fn const_shift(cx: Checker, op: BinaryOp, value: Typed, amount: Typed, span: Span) -> Option<Typed> {
  const symbol = "`" + ast::binary_symbol(op) + "`";
  const int_ty = match value.ty.kind {
    TypeKind::Int(found) => found,
    _ => return const_operand_error(cx, span, symbol, value.ty),
  };
  const found = match value.value {
    ConstValue::Int(found) => found,
    _ => return const_operand_error(cx, span, symbol, value.ty),
  };
  const shift = match amount.value {
    ConstValue::Int(found) => found,
    _ => return const_operand_error(cx, span, symbol, amount.ty),
  };
  const pointer_width = cx.target.pointer_width;
  const width = bits(int_ty, pointer_width);

  if shift.negative || shift.magnitude >= width as u64 {
    cx.error(codes::NOT_CONSTANT, span, `this constant shifts by ${shift.text()}, which is not below the ${width} bits of \`${types::int_name(int_ty)}\``);

    return None;
  }

  const n = shift.magnitude as u32;

  if n == 0 {
    return Some(Typed { ty: value.ty, value: ConstValue::Int(found) });
  }

  if op == BinaryOp::Shl {
    // The bits shifted out are dropped: the low `width - n` bits, moved up.
    const kept = to_bits(found, int_ty, pointer_width) % power_of_two(width - n);

    return Some(Typed { ty: value.ty, value: ConstValue::Int(from_bits(kept * power_of_two(n), int_ty, pointer_width)) });
  }

  // `>>` rounds towards negative infinity, as an arithmetic shift does.
  const divisor = power_of_two(n);
  const shifted = if found.negative { Wide::of(true, (found.magnitude - 1) / divisor + 1) } else { Wide::of(false, found.magnitude / divisor) };

  Some(Typed { ty: value.ty, value: ConstValue::Int(shifted) })
}

/// `value` reduced to the width of `int_ty`, keeping the low bits (two's complement).
fn wrap(value: Wide, int_ty: IntTy, pointer_width: u32) -> Wide {
  const width = bits(int_ty, pointer_width);

  if width == 64 {
    const low = if value.negative { (U64_MAX - value.magnitude) + 1 } else { value.magnitude };

    if types::is_signed(int_ty) && low >= 9223372036854775808 {
      return Wide::of(true, (U64_MAX - low) + 1);
    }

    return Wide::of(false, low);
  }

  const modulus = if width == 8 { 256u64 } else if width == 16 { 65536u64 } else { 4294967296u64 };
  var low = value.magnitude % modulus;

  if value.negative && low != 0 {
    low = modulus - low;
  }

  if types::is_signed(int_ty) && low >= modulus / 2 {
    return Wide::of(true, modulus - low);
  }

  Wide::of(false, low)
}

/// A float converted to an integer type: truncated and saturated, with NaN as 0.
fn saturate(value: f64, int_ty: IntTy, pointer_width: u32) -> Wide {
  const max = types::int_max(int_ty, pointer_width);

  if value != value {
    return Wide::of(false, 0);
  }

  if types::is_signed(int_ty) {
    if value >= max as f64 {
      return Wide::of(false, max);
    }

    const min = -(max as f64) - 1.0;

    if value <= min {
      return Wide::of(true, max + 1);
    }

    const truncated = value as i64;

    if truncated < 0 {
      return Wide::of(true, ((-(truncated + 1)) as u64) + 1);
    }

    return Wide::of(false, truncated as u64);
  }

  if value <= 0.0 {
    return Wide::of(false, 0);
  }

  if value >= max as f64 {
    return Wide::of(false, max);
  }

  Wide::of(false, value as u64)
}

/// `as` between primitive types, with the rules of docs/spec/02-types.md#conversions.
fn const_cast(cx: Checker, from: Type, value: ConstValue, to: Type, span: Span) -> Option<Typed> {
  const width = cx.target.pointer_width;

  if types::same_type(from, to) {
    return Some(Typed { ty: to, value: value });
  }

  match to.kind {
    TypeKind::Int(int_ty) => match value {
      ConstValue::Int(found) => return Some(Typed { ty: to, value: ConstValue::Int(wrap(found, int_ty, width)) }),
      ConstValue::Bool(found) => return Some(Typed { ty: to, value: ConstValue::Int(Wide::of(false, if found { 1 } else { 0 })) }),
      ConstValue::Char(found) => return Some(Typed { ty: to, value: ConstValue::Int(wrap(Wide::of(false, (found as u32) as u64), int_ty, width)) }),
      ConstValue::Float(found) => return Some(Typed { ty: to, value: ConstValue::Int(saturate(found, int_ty, width)) }),
      _ => {}
    },
    TypeKind::Float(float_ty) => match value {
      ConstValue::Int(found) => return const_float(found.to_f64(), float_ty),
      ConstValue::Float(found) => return const_float(found, float_ty),
      _ => {}
    },
    TypeKind::Char => {
      if let ConstValue::Int(found) = value {
        if let TypeKind::Int(IntTy::U8) = from.kind {
          if found.negative || found.magnitude > 255 {
            return None;
          }

          if let Some(c) = char::from_u32(found.magnitude as u32) {
            return Some(Typed { ty: to, value: ConstValue::Char(c) });
          }
        }
      }
    }
    _ => {}
  }

  cx.error(codes::INVALID_CAST, span, "cannot cast `" + types::text(from) + "` to `" + types::text(to) + "`");

  None
}

/// `include_str("path")`: the text of a file, by a path relative to the constant's file.
fn include_str(cx: Checker, span: Span, args: List<Expr>, module: usize) -> Option<Typed> {
  if args.len() != 1 {
    cx.error(codes::INVALID_INCLUDE, span, "`include_str` takes one argument: the path of a file");

    return None;
  }

  const arg = args[0];
  const relative = match arg.kind {
    ExprKind::Str(text) => text,
    _ => {
      cx.error(codes::INVALID_INCLUDE, arg.span, "the path of `include_str` must be a string literal");

      return None;
    }
  };
  const location = match cx.package.modules.get(module) {
    Some(found) => found.location,
    None => None,
  };
  const file = match location {
    Some(found) => found,
    None => {
      cx.error(codes::INVALID_INCLUDE, span, "`include_str` needs a source file on disk");

      return None;
    }
  };
  const full = match path::parent(file) {
    Some(dir) => loader::push_path(dir, relative),
    None => relative,
  };

  match fs::read_to_string(full) {
    Ok(text) => Some(Typed { ty: types::string(), value: ConstValue::Str(text) }),
    Err(problem) => {
      // The reason by kind, not the system's message, which depends on the platform.
      const reason = match problem.kind() {
        ErrorKind::NotFound => "the file does not exist",
        ErrorKind::PermissionDenied => "permission denied",
        ErrorKind::InvalidData => "the file is not UTF-8",
        _ => "the file cannot be read",
      };

      cx.diagnostics.push(
        Diagnostic::error(codes::INVALID_INCLUDE, arg.span, "cannot read `" + full + "`: " + reason)
          .with_note("the path is relative to the directory of this source file, and the file must be UTF-8"),
      );

      None
    }
  }
}

fn is_comparison(op: BinaryOp) -> bool {
  op == BinaryOp::Eq || op == BinaryOp::Ne || op == BinaryOp::Lt || op == BinaryOp::Le || op == BinaryOp::Gt || op == BinaryOp::Ge
}

fn unary_symbol(op: UnaryOp) -> String {
  match op {
    UnaryOp::Neg => "-",
    UnaryOp::Not => "!",
    UnaryOp::Deref => "*",
  }
}

/// The value of each static of a primitive type or `String` whose initializer is a constant
/// expression (docs/adr/0083-global-state.md, Q527). A value the compiler cannot compute is left
/// to the program, which computes it on the first use; what made it fail is not reported.
pub fn static_values(cx: Checker) {
  for index in 0..cx.resolution.statics.len() {
    const id = index as u32;
    var value: Option<ConstValue> = None;

    if let Some(decl) = cx.resolution.static_decl(cx.package, id) {
      if let Some(ty) = cx.typed.static_type(cx.resolution, id) {
        if let Some(init) = decl.value() {
          const module = cx.resolution.statics[index].module;
          const primitive = match ty.kind {
            TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String => true,
            _ => false,
          };

          if primitive && is_constant_expr(cx, init) {
            const reported = cx.diagnostics.len();

            value = const_expr(cx, init, ty, module);

            if value.is_none() {
              cx.diagnostics.truncate(reported);
            }
          }
        }
      }
    }

    cx.typed.static_values.push(value);
  }
}

/// Whether `value` is made of literals and constants, with operators and casts.
fn is_constant_expr(cx: Checker, value: Expr) -> bool {
  match value.kind {
    ExprKind::Int { .. } | ExprKind::Float { .. } | ExprKind::Bool(_) | ExprKind::Char(_) | ExprKind::Str(_) => true,
    ExprKind::Path(_) => match cx.resolution.paths.get(value.id) {
      Some(Res::Const(_)) => true,
      _ => false,
    },
    ExprKind::Unary { operand, .. } => is_constant_expr(cx, operand),
    ExprKind::Binary { lhs, rhs, .. } => is_constant_expr(cx, lhs) && is_constant_expr(cx, rhs),
    ExprKind::Cast { expr, .. } => is_constant_expr(cx, expr),
    _ => false,
  }
}
