//! What the type checker produces, and the questions later phases ask about it: the ancestors
//! of classes and interfaces, the interfaces a type implements, which types are `Send`, the
//! variants of an enum type. The port of `TypedModule` and its methods across `sagitario_types`.

use pkg::resolve::{ParamOwner, Resolution, TypeItem};
use pkg::ast::Package;
use pkg::types::{
  ClassDef, EnumDef, FieldDef, FloatTy, FnSig, GenericDef, IntTy, InterfaceDef, NamedRef, ParamRef, SELF_PARAM, StructDef, Subst, Type, TypeKind, VariantDef,
};
use pkg::types;
use pkg::types::consts::ConstValue;

/// The prelude items the compiler relies on.
pub struct PreludeItems {
  pub ordering: Option<u32>;
  pub eq: Option<u32>;
  pub ord: Option<u32>;
  pub hash: Option<u32>;
  pub entry: Option<u32>;
  pub iter: Option<u32>;
  /// `DoubleEndedIter<T>`, the iterators with two ends (docs/adr/0093-everyday-methods.md, Q627).
  pub double_iter: Option<u32>;
  pub map: Option<u32>;
  pub send: Option<u32>;
  /// `Display` (docs/adr/0089-display-debug-and-format-specifiers.md).
  pub display: Option<u32>;
  /// The interfaces of the operators (docs/adr/0081-operator-overloading.md).
  pub add: Option<u32>;
  pub sub: Option<u32>;
  pub mul: Option<u32>;
  pub div: Option<u32>;
  pub rem: Option<u32>;
  pub neg: Option<u32>;
  /// `From`, `Into`, `TryFrom` and `TryInto` (docs/adr/0094-conversions-and-defaults.md).
  pub from: Option<u32>;
  pub into: Option<u32>;
  pub try_from: Option<u32>;
  pub try_into: Option<u32>;
  pub default: Option<u32>;
  /// `Index` and `IndexMut` (docs/adr/0094-conversions-and-defaults.md, Q639).
  pub index: Option<u32>;
  pub index_mut: Option<u32>;
  /// `Iterable` and `FromIterator` (docs/adr/0095-collections.md).
  pub iterable: Option<u32>;
  pub from_iterator: Option<u32>;
  /// `HashSet` (docs/adr/0095-collections.md, Q647).
  pub hash_set: Option<u32>;
  /// `std::collections::VecDeque`, `BTreeMap` and `BTreeSet`, when the program uses the module
  /// (Q648-Q650).
  pub vec_deque: Option<u32>;
  pub btree_map: Option<u32>;
  pub btree_set: Option<u32>;
  /// `std::collections::BinaryHeap`, whose debug form is its list (Q651, Q652).
  pub binary_heap: Option<u32>;
}

/// The methods of `List<T>` implemented by the compiler (docs/spec/02-types.md#arrays-and-lists).
pub enum ListMethod {
  Len,
  IsEmpty,
  Push,
  Pop,
  Get,
  First,
  Last,
  Insert,
  Remove,
  Clear,
  Reverse,
}

/// A method of `Option`, `Result`, `String`, `char`, `StringBuilder` or `List`, implemented by
/// the compiler and the runtime.
pub enum BuiltinMethod {
  IsSome,
  IsNone,
  IsOk,
  IsErr,
  Unwrap,
  Expect,
  /// `expect_err(message)` on a `Result`.
  ExpectErr,
  /// `pop()` on a `StringBuilder`: the runtime's code point, or a sentinel.
  BuilderPop,
  UnwrapOr,
  UnwrapErr,
  /// A runtime function taking the receiver and the arguments in order; `located` functions
  /// also receive the source location.
  Runtime { function: String, located: bool },
  Find,
  ToDigit,
  Parse(Type),
  Chars,
  Bytes,
  Map,
  MapErr,
  AndThen,
  UnwrapOrElse,
  Filter,
  List(ListMethod),
  /// A method implemented by a prelude function, which receives the receiver first.
  Prelude(u32),
  TotalCompare,
  RangeRev,
  /// A method of `Atomic<T>`, by name (docs/adr/0087-atomic-storage-and-std-sync.md).
  Atomic(String),
  /// A `checked_*` method of an integer: the runtime function writes the result and says
  /// whether there is one (docs/adr/0088-bitwise-operators-and-integer-methods.md).
  Checked(String),
}

/// A call of the static function `function` of an interface, for the type `self_ty`, whose
/// implementation runs: a type parameter or `Self` until monomorphization
/// (docs/adr/0094-conversions-and-defaults.md, Q631).
pub struct StaticCall {
  pub function: u32;
  pub self_ty: Type;
}

/// `base[index]` on a type implementing `Index<Idx, Out>` with these `args`: its `index`, and the
/// `index_set` of `IndexMut` when the expression is assigned to (Q639).
pub struct IndexCall {
  pub index: u32;
  pub set: Option<u32>;
  pub args: List<Type>;
}

/// A value of type `from` made a `to`: by `From`, or by `TryFrom` with the error `error`. The
/// types may name type parameters until monomorphization.
pub struct Conversion {
  pub from: Type;
  pub to: Type;
  pub error: Option<Type>;
}

/// A list or array used as an iterator: the prelude function making the iterator and its type
/// arguments.
pub struct ToIter {
  pub function: u32;
  pub args: List<Type>;
}

/// An interface of an operator in the prelude, if it was found.
struct Operator {
  pub id: Option<u32>;
  pub name: String;
}

/// The interfaces a struct, enum or class implements: those after `impl` in its header, then
/// those of its `impl ... for` blocks (docs/adr/0081-operator-overloading.md).
pub struct ImplEntry {
  pub item: TypeItem;
  pub interfaces: List<NamedRef>;
  /// For each interface, the block implementing it, or `None` for the header.
  pub blocks: List<Option<u32>>;
}

/// The type parameters of a generic declaration.
pub struct GenericsEntry {
  pub owner: ParamOwner;
  pub params: List<GenericDef>;
}

/// The prelude's `Error` interface and the class `Error(message)` creates.
pub struct ErrorTypes {
  pub interface_id: u32;
  pub class_id: u32;
}

/// A field of a class or one of its ancestors: the declaring class and its position there.
pub struct ClassField {
  pub class_id: u32;
  pub index: usize;
  pub field: FieldDef;
}

/// The type of a field of a class type: the declaring ancestor with its arguments.
pub struct ClassFieldType {
  pub ancestor: NamedRef;
  pub index: usize;
  pub ty: Type;
}

/// A method of an interface or one of its ancestors, with the declaring interface.
pub struct InterfaceMethod {
  pub interface_id: u32;
  pub method: u32;
}

/// A field of an interface or one of its ancestors, with the declaring interface.
pub struct InterfaceField {
  pub interface_id: u32;
  pub index: usize;
  pub field: FieldDef;
}

/// The key of a type item in maps.
pub fn item_key(item: TypeItem) -> String {
  match item {
    TypeItem::Struct(id) => `s${id}`,
    TypeItem::Enum(id) => `e${id}`,
    TypeItem::Class(id) => `c${id}`,
    TypeItem::Interface(id) => `i${id}`,
  }
}

/// The key of a generic declaration in maps.
pub fn owner_key(owner: ParamOwner) -> String {
  match owner {
    ParamOwner::Item(item) => item_key(item),
    ParamOwner::Fn(id) => `f${id}`,
  }
}

pub class TypedModule {
  /// Signature of each function, indexed by function id.
  pub var sigs: List<FnSig>;
  /// Signature of each C function of the `extern` blocks.
  pub var extern_sigs: List<FnSig>;
  pub var structs: List<StructDef>;
  pub var enums: List<EnumDef>;
  pub var classes: List<ClassDef>;
  pub var interfaces: List<InterfaceDef>;
  /// By `item_key`.
  pub var impls: Map<String, ImplEntry>;
  /// By `owner_key`.
  pub var generics: Map<String, GenericsEntry>;
  pub var error_types: Option<ErrorTypes>;
  /// The vtable slot of each method dispatched dynamically.
  pub var slots: Map<u32, usize>;
  pub var prelude: PreludeItems;
  /// The classes of `std::sync`.
  pub var sync_classes: List<u32>;
  /// The type of each module-level constant.
  pub var const_types: List<Type>;
  /// The value of each module-level constant, or `None` if it has an error.
  pub var const_values: List<Option<ConstValue>>;
  /// The value of each static computed from constants, by static id: its storage starts with it
  /// (docs/adr/0083-global-state.md, Q527).
  pub var static_values: List<Option<ConstValue>>;
  /// The type arguments of each use of a generic function, method or initializer, by node id.
  pub var call_args: Map<u32, List<Type>>;
  /// Calls to built-in methods, by node id.
  pub var builtin_methods: Map<u32, BuiltinMethod>;
  /// The calls of static functions of interfaces, by call id.
  pub var static_calls: Map<u32, StaticCall>;
  /// The conversions of `from`, `try_from`, `into`, `try_into` and `?`, by the id of the call or
  /// of the operand of `?` (docs/adr/0094-conversions-and-defaults.md, Q632–Q635).
  pub var conversions: Map<u32, Conversion>;
  /// `base[index]` on a type implementing `Index`, by the id of the index expression (Q639).
  pub var index_calls: Map<u32, IndexCall>;
  /// The iterable of a `for` over a type implementing `Iterable`, by the id of the iterable: the
  /// type of its elements (docs/adr/0095-collections.md, Q645).
  pub var iterable_fors: Map<u32, Type>;
  /// `collect()` into a type implementing `FromIterator`, by call id (Q646).
  pub var collect_calls: Map<u32, StaticCall>;
  /// The structs and enums written after `@default`, by `item_key` (Q636).
  pub var derived_defaults: Map<String, bool>;
  /// The variant marked `@default` of each such enum, by enum id.
  pub var default_variants: Map<u32, u32>;
  /// Type of each local binding, indexed by function id then local id.
  pub var local_types: List<List<Type>>;
  pub var expr_types: Map<u32, Type>;
  /// The function called by each method call expression.
  pub var method_calls: Map<u32, u32>;
  /// Calls through `zod`, which run the named implementation without dynamic dispatch.
  pub var zod_calls: Map<u32, bool>;
  /// `value.name(args)` calling a field of a function type, by node id.
  pub var field_calls: Map<u32, bool>;
  /// The type argument of each call of `mem::size_of`, `mem::align_of` and `mem::zeroed`.
  pub var mem_types: Map<u32, Type>;
  /// Lists and arrays used as iterators, by node id.
  pub var to_iter: Map<u32, ToIter>;
  /// Ranges used as values, by node id: the prelude function making their iterator.
  pub var ranges: Map<u32, u32>;

  pub fn new(self) {
    self.sigs = new List();
    self.extern_sigs = new List();
    self.structs = new List();
    self.enums = new List();
    self.classes = new List();
    self.interfaces = new List();
    self.impls = new Map<String, ImplEntry>();
    self.generics = new Map<String, GenericsEntry>();
    self.error_types = None;
    self.slots = new Map<u32, usize>();
    self.prelude = PreludeItems {
      ordering: None,
      eq: None,
      ord: None,
      hash: None,
      entry: None,
      iter: None,
      double_iter: None,
      map: None,
      send: None,
      display: None,
      add: None,
      sub: None,
      mul: None,
      div: None,
      rem: None,
      neg: None,
      from: None,
      into: None,
      try_from: None,
      try_into: None,
      default: None,
      index: None,
      index_mut: None,
      iterable: None,
      from_iterator: None,
      hash_set: None,
      vec_deque: None,
      btree_map: None,
      btree_set: None,
      binary_heap: None,
    };
    self.sync_classes = new List();
    self.const_types = new List();
    self.static_values = new List();
    self.const_values = new List();
    self.call_args = new Map<u32, List<Type>>();
    self.builtin_methods = new Map<u32, BuiltinMethod>();
    self.static_calls = new Map<u32, StaticCall>();
    self.conversions = new Map<u32, Conversion>();
    self.index_calls = new Map<u32, IndexCall>();
    self.iterable_fors = new Map<u32, Type>();
    self.collect_calls = new Map<u32, StaticCall>();
    self.derived_defaults = new Map<String, bool>();
    self.default_variants = new Map<u32, u32>();
    self.local_types = new List();
    self.expr_types = new Map<u32, Type>();
    self.method_calls = new Map<u32, u32>();
    self.zod_calls = new Map<u32, bool>();
    self.field_calls = new Map<u32, bool>();
    self.mem_types = new Map<u32, Type>();
    self.to_iter = new Map<u32, ToIter>();
    self.ranges = new Map<u32, u32>();
  }

  /// Position of a field in its struct's declaration.
  pub fn field_index(self, id: u32, name: String) -> Option<usize> {
    const def = self.struct_def(id)?;

    for index in 0..def.fields.len() {
      if def.fields[index].name == name {
        return Some(index);
      }
    }

    None
  }

  /// `Iter<elem>`.
  pub fn iter_type(self, elem: Type) -> Type {
    match self.prelude.iter {
      Some(id) => types::class_type(id, "Iter", List::from([elem])),
      None => types::error(),
    }
  }

  /// `DoubleEndedIter<elem>`.
  pub fn double_iter_type(self, elem: Type) -> Type {
    match self.prelude.double_iter {
      Some(id) => types::class_type(id, "DoubleEndedIter", List::from([elem])),
      None => types::error(),
    }
  }

  /// The element type of an `Iter<T>` or a `DoubleEndedIter<T>`.
  pub fn iter_elem(self, ty: Type) -> Option<Type> {
    if let TypeKind::Class(class_ref) = ty.kind {
      if let Some(iter) = self.prelude.iter {
        if iter == class_ref.id {
          return class_ref.args.first();
        }
      }

      if self.is_double_iter(ty) {
        return class_ref.args.first();
      }
    }

    None
  }

  /// Whether `ty` is a `DoubleEndedIter<T>`.
  pub fn is_double_iter(self, ty: Type) -> bool {
    match ty.kind {
      TypeKind::Class(class_ref) => match self.prelude.double_iter {
        Some(id) => id == class_ref.id,
        None => false,
      },
      _ => false,
    }
  }

  /// The key and value types of a `Map<K, V>`.
  pub fn map_args(self, ty: Type) -> Option<List<Type>> {
    if let TypeKind::Class(class_ref) = ty.kind {
      if let Some(map) = self.prelude.map {
        if map == class_ref.id && class_ref.args.len() == 2 {
          return Some(class_ref.args);
        }
      }
    }

    None
  }

  /// `Entry<K, V>`.
  pub fn entry_type(self, key: Type, value: Type) -> Type {
    match self.prelude.entry {
      Some(id) => types::of(TypeKind::Struct(NamedRef { id: id, name: "Entry", args: List::from([key, value]) })),
      None => types::error(),
    }
  }

  /// The prelude's `Ordering`.
  pub fn ordering_type(self) -> Type {
    match self.prelude.ordering {
      Some(id) => types::of(TypeKind::Enum(NamedRef { id: id, name: "Ordering", args: new List() })),
      None => types::error(),
    }
  }

  /// The element type `for` iterates over in a list, an iterator or a map (its entries).
  pub fn collection_elem(self, ty: Type) -> Option<Type> {
    if let TypeKind::List(elem) = ty.kind {
      return Some(elem);
    }

    if let Some(elem) = self.iter_elem(ty) {
      return Some(elem);
    }

    match self.map_args(ty) {
      Some(args) => Some(self.entry_type(args[0], args[1])),
      None => None,
    }
  }

  pub fn sig(self, id: u32) -> Option<FnSig> {
    self.sigs.get(id as usize)
  }

  pub fn extern_sig(self, id: u32) -> Option<FnSig> {
    self.extern_sigs.get(id as usize)
  }

  pub fn struct_def(self, id: u32) -> Option<StructDef> {
    self.structs.get(id as usize)
  }

  pub fn class_def(self, id: u32) -> Option<ClassDef> {
    self.classes.get(id as usize)
  }

  pub fn interface_def(self, id: u32) -> Option<InterfaceDef> {
    self.interfaces.get(id as usize)
  }

  /// The parameters of a generic declaration.
  pub fn generic_params(self, owner: ParamOwner) -> Option<List<GenericDef>> {
    match self.generics.get(owner_key(owner)) {
      Some(entry) => Some(entry.params),
      None => None,
    }
  }

  pub fn class_parent_id(self, id: u32) -> Option<u32> {
    match self.class_def(id) {
      Some(def) => match def.parent {
        Some(parent) => Some(parent.id),
        None => None,
      },
      None => None,
    }
  }

  /// A class followed by its ancestors, nearest first.
  pub fn class_chain(self, id: u32) -> List<u32> {
    const chain = List::from([id]);

    // Cycles are reported and removed when the classes are defined; the bound is a safeguard.
    while let Some(parent) = self.class_parent_id(chain.last().unwrap_or(id)) {
      if chain.len() > self.classes.len() {
        break;
      }

      chain.push(parent);
    }

    chain
  }

  /// Whether `sub` is `sup` or one of its subclasses.
  pub fn is_subclass(self, sub: u32, sup: u32) -> bool {
    self.class_chain(sub).contains(sup)
  }

  /// A field of a class or one of its ancestors.
  pub fn class_field(self, id: u32, name: String) -> Option<ClassField> {
    for class_id in self.class_chain(id) {
      if let Some(def) = self.class_def(class_id) {
        for index in 0..def.fields.len() {
          if def.fields[index].name == name {
            return Some(ClassField { class_id: class_id, index: index, field: def.fields[index] });
          }
        }
      }
    }

    None
  }

  /// The positions in `parents` leading from interface `from` to its ancestor `to`.
  pub fn interface_path(self, from: u32, to: u32) -> Option<List<usize>> {
    const queue_ids = List::from([from]);
    const queue_paths: List<List<usize>> = List::from([new List<usize>()]);
    var next = 0usize;

    while next < queue_ids.len() {
      const current = queue_ids[next];
      const path = queue_paths[next];

      next += 1;

      if current == to {
        return Some(path);
      }

      if queue_ids.len() > self.interfaces.len() * self.interfaces.len() + 1 {
        break;
      }

      if let Some(def) = self.interface_def(current) {
        for index in 0..def.parents.len() {
          const extended: List<usize> = new List();

          for step in path {
            extended.push(step);
          }

          extended.push(index);
          queue_ids.push(def.parents[index].id);
          queue_paths.push(extended);
        }
      }
    }

    None
  }

  /// An interface followed by its ancestors, breadth first, without repetitions.
  pub fn interface_ancestors(self, id: u32) -> List<u32> {
    const found = List::from([id]);
    var next = 0usize;

    while next < found.len() {
      const current = found[next];

      next += 1;

      if let Some(def) = self.interface_def(current) {
        for parent in def.parents {
          if !found.contains(parent.id) {
            found.push(parent.id);
          }
        }
      }
    }

    found
  }

  /// The interfaces a struct, enum or class implements, with their ancestors (for a class, also
  /// those of its ancestors).
  pub fn implemented(self, item: TypeItem) -> List<u32> {
    const owners: List<TypeItem> = new List();

    match item {
      TypeItem::Class(id) => {
        for class_id in self.class_chain(id) {
          owners.push(TypeItem::Class(class_id));
        }
      }
      TypeItem::Interface(id) => return self.interface_ancestors(id),
      other => owners.push(other),
    }

    const found: List<u32> = new List();

    for owner in owners {
      if let Some(entry) = self.impls.get(item_key(owner)) {
        for interface_ref in entry.interfaces {
          for ancestor in self.interface_ancestors(interface_ref.id) {
            if !found.contains(ancestor) {
              found.push(ancestor);
            }
          }
        }
      }
    }

    found
  }

  /// A method of an interface or one of its ancestors.
  pub fn interface_method(self, id: u32, name: String, resolution: Resolution, package: Package) -> Option<InterfaceMethod> {
    for interface_id in self.interface_ancestors(id) {
      if let Some(def) = self.interface_def(interface_id) {
        for method in def.methods {
          if let Some(decl) = resolution.fn_decl(package, method) {
            if decl.name.name == name {
              return Some(InterfaceMethod { interface_id: interface_id, method: method });
            }
          }
        }
      }
    }

    None
  }

  /// A field of an interface or one of its ancestors.
  pub fn interface_field(self, id: u32, name: String) -> Option<InterfaceField> {
    for interface_id in self.interface_ancestors(id) {
      if let Some(def) = self.interface_def(interface_id) {
        for index in 0..def.fields.len() {
          if def.fields[index].name == name {
            return Some(InterfaceField { interface_id: interface_id, index: index, field: def.fields[index] });
          }
        }
      }
    }

    None
  }

  /// Whether a value of type `actual` can be used where `expected` is required, converting it if
  /// needed: an instance as one of its ancestors, a value as an interface its type implements.
  pub fn fits(self, actual: Type, expected: Type) -> bool {
    if let TypeKind::Class(actual_class) = actual.kind {
      if let TypeKind::Class(expected_class) = expected.kind {
        return types::contains_ref(self.class_ancestors(actual_class), expected_class);
      }
    }

    if let TypeKind::Interface(expected_interface) = expected.kind {
      const convertible = match actual.kind {
        TypeKind::Struct(_) | TypeKind::Enum(_) | TypeKind::Class(_) | TypeKind::Interface(_) | TypeKind::Param(_) => true,
        _ => false,
      };

      if convertible {
        return self.implements(actual, expected_interface);
      }
    }

    types::plain_fits(actual, expected)
  }

  /// The initializer `zod.new(...)` runs for a class: the nearest ancestor's.
  pub fn inherited_initializer(self, id: u32) -> Option<u32> {
    const chain = self.class_chain(id);

    for index in 1..chain.len() {
      if let Some(def) = self.class_def(chain[index]) {
        if let Some(initializer) = def.initializer {
          return Some(initializer);
        }
      }
    }

    None
  }

  /// The variants of an enum, `Option` or `Result` type, with their field types.
  pub fn variants(self, ty: Type) -> Option<List<VariantDef>> {
    match ty.kind {
      TypeKind::Enum(named) => {
        const subst = Subst::of(ParamOwner::Item(TypeItem::Enum(named.id)), named.args);
        const def = self.enums.get(named.id as usize)?;
        const variants: List<VariantDef> = new List();

        for variant in def.variants {
          const fields: List<types::VariantField> = new List();

          for field in variant.fields {
            fields.push(types::VariantField { name: field.name, ty: types::substitute(field.ty, subst) });
          }

          variants.push(VariantDef { name: variant.name, named: variant.named, fields: fields });
        }

        Some(variants)
      }
      TypeKind::Option(value) => Some(List::from([VariantDef::positional("None", new List()), VariantDef::positional("Some", List::from([value]))])),
      TypeKind::Result { value, error } => Some(List::from([VariantDef::positional("Ok", List::from([value])), VariantDef::positional("Err", List::from([error]))])),
      _ => None,
    }
  }

  /// The parameters of a declaration as types.
  pub fn identity_args(self, owner: ParamOwner) -> List<Type> {
    const args: List<Type> = new List();

    if let Some(params) = self.generic_params(owner) {
      for index in 0..params.len() {
        args.push(types::of(TypeKind::Param(ParamRef { owner: owner, index: index as u32, name: params[index].name })));
      }
    }

    args
  }

  /// The interfaces a parameter is bounded by; `Self` is bounded by its interface.
  pub fn param_bounds(self, param: ParamRef) -> List<NamedRef> {
    if param.index == SELF_PARAM {
      if let ParamOwner::Item(TypeItem::Interface(id)) = param.owner {
        const name = match self.interface_def(id) {
          Some(def) => def.name,
          None => "",
        };

        return List::from([NamedRef { id: id, name: name, args: self.identity_args(param.owner) }]);
      }

      return new List();
    }

    match self.generic_params(param.owner) {
      Some(params) => match params.get(param.index as usize) {
        Some(def) => def.bounds,
        None => new List(),
      },
      None => new List(),
    }
  }

  /// An interface followed by its ancestors, with their type arguments.
  pub fn interface_ancestor_refs(self, interface_ref: NamedRef) -> List<NamedRef> {
    const found = List::from([interface_ref]);
    var next = 0usize;

    while next < found.len() {
      const current = found[next];

      next += 1;

      const subst = Subst::of(ParamOwner::Item(TypeItem::Interface(current.id)), current.args);

      if let Some(def) = self.interface_def(current.id) {
        for parent in def.parents {
          const substituted = types::substitute_ref(parent, subst);

          if !types::contains_ref(found, substituted) && found.len() <= self.interfaces.len() * 4 {
            found.push(substituted);
          }
        }
      }
    }

    found
  }

  /// A class followed by its ancestors, with their type arguments.
  pub fn class_ancestors(self, class_ref: NamedRef) -> List<NamedRef> {
    const chain = List::from([class_ref]);

    while true {
      const last = chain.last().unwrap_or(class_ref);
      const parent = match self.class_def(last.id) {
        Some(def) => match def.parent {
          Some(parent) => parent,
          None => break,
        },
        None => break,
      };

      if chain.len() > self.classes.len() {
        break;
      }

      const subst = Subst::of(ParamOwner::Item(TypeItem::Class(last.id)), last.args);

      chain.push(types::substitute_ref(parent, subst));
    }

    chain
  }

  /// The interfaces a type implements, with their type arguments, each with its ancestors.
  pub fn implemented_refs(self, ty: Type) -> List<NamedRef> {
    var direct: List<NamedRef> = new List();

    match ty.kind {
      TypeKind::Struct(named) => {
        direct = self.impls_of(TypeItem::Struct(named.id), named.args);
        self.push_derived_default(direct, TypeItem::Struct(named.id));
      }
      TypeKind::Enum(named) => {
        direct = self.impls_of(TypeItem::Enum(named.id), named.args);
        self.push_derived_default(direct, TypeItem::Enum(named.id));
      }
      TypeKind::Class(named) => {
        for class_ref in self.class_ancestors(named) {
          for interface_ref in self.impls_of(TypeItem::Class(class_ref.id), class_ref.args) {
            direct.push(interface_ref);
          }
        }

        // A `VecDeque`, `BTreeMap` or `BTreeSet` compares, orders and hashes as a list of its
        // elements (docs/adr/0095-collections.md, Q648-Q650).
        if let Some(elem) = self.compared_element(named) {
          for found in self.tuple_impls(List::from([elem])) {
            direct.push(found);
          }
        }

        // A map is equal to another with the same keys and equal values (docs/adr/0093-everyday-methods.md, Q623).
        if let Some(map) = self.prelude.map {
          if map == named.id {
            if let Some(eq) = self.prelude.eq {
              const eq_ref = NamedRef { id: eq, name: "Eq", args: new List() };

              if named.args.len() == 2 && self.implements(named.args[1], eq_ref) {
                direct.push(eq_ref);
              }
            }

            // An empty map (docs/adr/0094-conversions-and-defaults.md, Q636).
            if let Some(default) = self.default_ref() {
              direct.push(default);
            }

            // `collect()` into a map (docs/adr/0095-collections.md, Q646).
            if named.args.len() == 2 {
              self.push_ref(direct, self.prelude.from_iterator, "FromIterator", types::of(TypeKind::Tuple(List::from([named.args[0], named.args[1]]))));
            }
          }
        }
      }
      TypeKind::Interface(named) => {
        direct = List::from([named]);
      }
      TypeKind::Param(param) => {
        direct = self.param_bounds(param);
      }
      TypeKind::Tuple(elems) => {
        direct = self.tuple_impls(elems);
        self.push_default_of(direct, elems);
      }
      // As Rust's (docs/adr/0093-everyday-methods.md, Q619); `None` is the default (Q636).
      TypeKind::Option(value) => {
        direct = self.tuple_impls(List::from([value]));

        if let Some(default) = self.default_ref() {
          direct.push(default);
        }
      }
      TypeKind::Result { value, error } => {
        direct = self.tuple_impls(List::from([value, error]));

        // `collect()` of results into a list of the values or the first error (Q646).
        if let TypeKind::List(elem) = value.kind {
          self.push_ref(direct, self.prelude.from_iterator, "FromIterator", types::result(elem, error));
        }
      }
      // Lists and arrays compare by value, as Rust's `Vec` (Q623). An empty list is a default,
      // and an array of defaults (Q636).
      TypeKind::List(elem) => {
        direct = self.tuple_impls(List::from([elem]));
        self.push_default_of(direct, new List());
        self.push_ref(direct, self.prelude.iterable, "Iterable", elem);
        self.push_ref(direct, self.prelude.from_iterator, "FromIterator", elem);
      }
      TypeKind::Array { elem, .. } => {
        direct = self.tuple_impls(List::from([elem]));
        self.push_default_of(direct, List::from([elem]));
        self.push_ref(direct, self.prelude.iterable, "Iterable", elem);
      }
      _ => {
        direct = self.primitive_impls(ty);
      }
    }

    const found: List<NamedRef> = new List();

    for interface_ref in direct {
      for ancestor in self.interface_ancestor_refs(interface_ref) {
        if !types::contains_ref(found, ancestor) {
          found.push(ancestor);
        }
      }
    }

    found
  }

  /// Whether `==` compares instances of the class `id` by value, as Rust's: a `Map` and a
  /// `HashSet` (docs/adr/0093-everyday-methods.md, Q623, and docs/adr/0095-collections.md, Q647).
  pub fn compares_by_value(self, id: u32) -> bool {
    is_id(self.prelude.map, id) || is_id(self.prelude.hash_set, id) || self.compared_elements(id)
  }

  /// Whether the class `id` is compared, ordered and hashed as a list of its elements: a
  /// `VecDeque`, a `BTreeMap` or a `BTreeSet` (docs/adr/0095-collections.md, Q648-Q650).
  pub fn compared_elements(self, id: u32) -> bool {
    is_id(self.prelude.vec_deque, id) || is_id(self.prelude.btree_map, id) || is_id(self.prelude.btree_set, id)
  }

  /// The type of the elements such a class compares by: a pair of a key and its value for a
  /// `BTreeMap`, the element for the others.
  pub fn compared_element(self, named: NamedRef) -> Option<Type> {
    if !self.compared_elements(named.id) {
      return None;
    }

    if is_id(self.prelude.btree_map, named.id) && named.args.len() == 2 {
      return Some(types::of(TypeKind::Tuple(List::from([named.args[0], named.args[1]]))));
    }

    named.args.first()
  }

  /// `Default`, without type arguments.
  pub fn default_ref(self) -> Option<NamedRef> {
    match self.prelude.default {
      Some(id) => Some(NamedRef { id: id, name: "Default", args: new List() }),
      None => None,
    }
  }

  /// Adds the prelude interface `id`, named `name`, with the one type argument `arg`.
  prv fn push_ref(self, found: List<NamedRef>, id: Option<u32>, name: String, arg: Type) {
    if let Some(found_id) = id {
      found.push(NamedRef { id: found_id, name: name, args: List::from([arg]) });
    }
  }

  /// Adds `Default` when `item` was written after `@default`.
  prv fn push_derived_default(self, found: List<NamedRef>, item: TypeItem) {
    if self.derived_defaults.contains_key(item_key(item)) {
      if let Some(default) = self.default_ref() {
        found.push(default);
      }
    }
  }

  /// Adds `Default` when every one of `parts` has a default.
  prv fn push_default_of(self, found: List<NamedRef>, parts: List<Type>) {
    if let Some(default) = self.default_ref() {
      if parts.iter().all((part) => self.implements(part, default)) {
        found.push(default);
      }
    }
  }

  prv fn impls_of(self, item: TypeItem, args: List<Type>) -> List<NamedRef> {
    const subst = Subst::of(ParamOwner::Item(item), args);
    const result: List<NamedRef> = new List();

    if let Some(entry) = self.impls.get(item_key(item)) {
      for interface_ref in entry.interfaces {
        result.push(types::substitute_ref(interface_ref, subst));
      }
    }

    result
  }

  /// The interfaces integers, `bool`, `char` and `String` implement: `Ord` and `Hash`; and those
  /// of the operators that numbers and `String` have, with their own type (Q513 of ADR-0081).
  /// `Eq`, `Ord` and `Hash`, each when every element of a tuple implements it
  /// (docs/adr/0092-tuples.md, Q611).
  prv fn tuple_impls(self, elems: List<Type>) -> List<NamedRef> {
    const result: List<NamedRef> = new List();
    const ids = List::from([self.prelude.eq, self.prelude.ord, self.prelude.hash]);
    const names = List::from(["Eq", "Ord", "Hash"]);

    for index in 0..ids.len() {
      if let Some(id) = ids[index] {
        const interface_ref = NamedRef { id: id, name: names[index], args: new List() };

        if elems.iter().all((elem) => self.implements(elem, interface_ref)) {
          result.push(interface_ref);
        }
      }
    }

    result
  }

  pub fn primitive_impls(self, ty: Type) -> List<NamedRef> {
    const result: List<NamedRef> = new List();
    var numeric = false;
    var negatable = false;

    match ty.kind {
      TypeKind::Int(int_ty) => {
        numeric = true;
        negatable = types::is_signed(int_ty);
      }
      TypeKind::Float(_) => {
        numeric = true;
        negatable = true;
      }
      _ => {}
    }

    const pair = List::from([ty, ty]);

    // Numbers, `bool`, `char` and `String` have the text format strings give them.
    match ty.kind {
      TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String => {
        if let Some(id) = self.prelude.display {
          result.push(NamedRef { id: id, name: "Display", args: new List() });
        }
      }
      _ => {}
    }

    if numeric {
      for entry in List::from([Operator { id: self.prelude.add, name: "Add" }, Operator { id: self.prelude.sub, name: "Sub" }, Operator { id: self.prelude.mul, name: "Mul" }, Operator { id: self.prelude.div, name: "Div" }, Operator { id: self.prelude.rem, name: "Rem" }]) {
        if let Some(id) = entry.id {
          result.push(NamedRef { id: id, name: entry.name, args: pair });
        }
      }
    }

    if negatable {
      if let Some(id) = self.prelude.neg {
        result.push(NamedRef { id: id, name: "Neg", args: List::from([ty]) });
      }
    }

    if types::is_string(ty) {
      if let Some(id) = self.prelude.add {
        result.push(NamedRef { id: id, name: "Add", args: pair });
      }

      // `collect()` of characters or strings (docs/adr/0095-collections.md, Q646).
      self.push_ref(result, self.prelude.from_iterator, "FromIterator", types::of(TypeKind::Char));
      self.push_ref(result, self.prelude.from_iterator, "FromIterator", types::string());
    }

    // Numbers, `bool`, `char`, `String` and `StringBuilder` start from zero, `false`, `'\0'` and
    // empty text (Q636).
    match ty.kind {
      TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String | TypeKind::StringBuilder => {
        if let Some(default) = self.default_ref() {
          result.push(default);
        }
      }
      _ => {}
    }

    // Rust's conversions between numbers, characters and strings (Q632, Q634).
    for source in conversion_sources() {
      if builtin_from(ty, source) {
        if let Some(id) = self.prelude.from {
          result.push(NamedRef { id: id, name: "From", args: List::from([source]) });
        }
      } else if builtin_try_from(ty, source) {
        if let Some(id) = self.prelude.try_from {
          result.push(NamedRef { id: id, name: "TryFrom", args: List::from([source, types::string()]) });
        }
      }
    }

    const primitive = match ty.kind {
      TypeKind::Int(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String => true,
      _ => false,
    };

    if !primitive {
      return result;
    }

    if let Some(id) = self.prelude.ord {
      result.push(NamedRef { id: id, name: "Ord", args: new List() });
    }

    if let Some(id) = self.prelude.hash {
      result.push(NamedRef { id: id, name: "Hash", args: new List() });
    }

    result
  }

  /// The method `name` of the `impl ... for` block of `ty` (or of an ancestor class) that
  /// implements `interface_ref` or a descendant of it, with these type arguments; `None` when the
  /// header implements it, whose methods are the type's own.
  pub fn block_method(self, resolution: Resolution, package: Package, ty: Type, interface_ref: NamedRef, name: String) -> Option<u32> {
    // The type, or the class and its ancestors, with their type arguments.
    const owners: List<TypeItem> = new List();
    const owner_args: List<List<Type>> = new List();

    match ty.kind {
      TypeKind::Struct(named) => {
        owners.push(TypeItem::Struct(named.id));
        owner_args.push(named.args);
      }
      TypeKind::Enum(named) => {
        owners.push(TypeItem::Enum(named.id));
        owner_args.push(named.args);
      }
      TypeKind::Class(named) => {
        for ancestor in self.class_ancestors(named) {
          owners.push(TypeItem::Class(ancestor.id));
          owner_args.push(ancestor.args);
        }
      }
      _ => return None,
    }

    for position in 0..owners.len() {
      const item = owners[position];
      const entry = match self.impls.get(item_key(item)) {
        Some(found) => found,
        None => continue,
      };
      const subst = Subst::of(ParamOwner::Item(item), owner_args[position]);

      for index in 0..entry.interfaces.len() {
        const block = match entry.blocks.get(index) {
          Some(Some(found)) => found,
          _ => continue,
        };
        const implemented = types::substitute_ref(entry.interfaces[index], subst);

        if !types::contains_ref(self.interface_ancestor_refs(implemented), interface_ref) {
          continue;
        }

        if let Some(info) = resolution.blocks.get(block as usize) {
          for function in info.functions {
            if let Some(decl) = resolution.fn_decl(package, function) {
              if decl.name.name == name {
                return Some(function);
              }
            }
          }
        }
      }
    }

    None
  }

  /// The method `to_string` of `Display`, if the prelude has it.
  pub fn display_method(self) -> Option<u32> {
    const id = self.prelude.display?;

    self.interface_def(id)?.methods.first()
  }

  /// Whether values of `ty` can be interpolated: numbers, `bool`, `char`, `String`, and types
  /// implementing `Display` (docs/adr/0089-display-debug-and-format-specifiers.md, Q583).
  pub fn displayable(self, ty: Type) -> bool {
    match ty.kind {
      TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Char | TypeKind::String | TypeKind::Never | TypeKind::Error => true,
      _ => match self.prelude.display {
        Some(id) => self.implements(ty, NamedRef { id: id, name: "Display", args: new List() }),
        None => false,
      },
    }
  }

  /// Whether values of `ty` implement `interface` (with the same type arguments). The compiler
  /// infers `Send`, which no type names after `impl`.
  pub fn implements(self, ty: Type, interface_ref: NamedRef) -> bool {
    if let Some(send) = self.prelude.send {
      if send == interface_ref.id {
        return self.not_send_reason(ty).is_none();
      }
    }

    if types::contains_ref(self.implemented_refs(ty), interface_ref) {
      return true;
    }

    // Every type is `From` itself, and `Into` and `TryInto` mirror `From` and `TryFrom`
    // (docs/adr/0094-conversions-and-defaults.md, Q632–Q634).
    const args = interface_ref.args;

    if is_id(self.prelude.from, interface_ref.id) && args.len() == 1 {
      return types::same_type(args[0], ty) || self.collection_from(ty, args[0]);
    }

    if is_id(self.prelude.into, interface_ref.id) && args.len() == 1 {
      return self.converts(ty, args[0]);
    }

    if is_id(self.prelude.try_into, interface_ref.id) && args.len() == 2 {
      return match self.prelude.try_from {
        Some(id) => self.implements(args[0], NamedRef { id: id, name: "TryFrom", args: List::from([ty, args[1]]) }),
        None => false,
      };
    }

    false
  }

  /// Whether `to` is a list made from an array of its elements (`List::from`), or a map from a
  /// list of its pairs (`Map::from`), as Rust's (Q632).
  pub fn collection_from(self, to: Type, from: Type) -> bool {
    match to.kind {
      TypeKind::List(elem) => match from.kind {
        TypeKind::Array { elem: from_elem, .. } => types::same_type(elem, from_elem),
        _ => false,
      },
      TypeKind::Class(named) => {
        if !is_id(self.prelude.map, named.id) || named.args.len() != 2 {
          return false;
        }

        if let TypeKind::List(pair) = from.kind {
          if let TypeKind::Tuple(elems) = pair.kind {
            return elems.len() == 2 && types::same_type(elems[0], named.args[0]) && types::same_type(elems[1], named.args[1]);
          }
        }

        false
      }
      _ => false,
    }
  }

  /// Whether a `from` converts into a `to` without failing: the same type, or `to` is
  /// `From<from>`.
  pub fn converts(self, from: Type, to: Type) -> bool {
    if types::same_type(from, to) {
      return true;
    }

    match self.prelude.from {
      Some(id) => self.implements(to, NamedRef { id: id, name: "From", args: List::from([from]) }),
      None => false,
    }
  }

  /// The field types of a struct type, with its type arguments.
  pub fn struct_field_types(self, named: NamedRef) -> List<Type> {
    const subst = Subst::of(ParamOwner::Item(TypeItem::Struct(named.id)), named.args);
    const result: List<Type> = new List();

    if let Some(def) = self.struct_def(named.id) {
      for field in def.fields {
        result.push(types::substitute(field.ty, subst));
      }
    }

    result
  }

  /// The type of a field of a class type or one of its ancestors.
  pub fn class_field_type(self, class_ref: NamedRef, name: String) -> Option<ClassFieldType> {
    for ancestor in self.class_ancestors(class_ref) {
      if let Some(def) = self.class_def(ancestor.id) {
        for index in 0..def.fields.len() {
          if def.fields[index].name == name {
            const subst = Subst::of(ParamOwner::Item(TypeItem::Class(ancestor.id)), ancestor.args);

            return Some(ClassFieldType { ancestor: ancestor, index: index, ty: types::substitute(def.fields[index].ty, subst) });
          }
        }
      }
    }

    None
  }

  /// The field types of a class type's own fields, with its type arguments.
  pub fn class_field_types(self, class_ref: NamedRef) -> List<Type> {
    const subst = Subst::of(ParamOwner::Item(TypeItem::Class(class_ref.id)), class_ref.args);
    const result: List<Type> = new List();

    if let Some(def) = self.class_def(class_ref.id) {
      for field in def.fields {
        result.push(types::substitute(field.ty, subst));
      }
    }

    result
  }

  /// The parent of a class type, with its type arguments.
  pub fn class_parent(self, class_ref: NamedRef) -> Option<NamedRef> {
    self.class_ancestors(class_ref).get(1)
  }

  /// The type of a local binding of a function.
  pub fn local_type(self, function: u32, local: u32) -> Option<Type> {
    match self.local_types.get(function as usize) {
      Some(locals) => locals.get(local as usize),
      None => None,
    }
  }

  /// The ancestor of `ty` (itself included) declaring the class `id`, with its arguments.
  pub fn class_ancestor(self, ty: NamedRef, id: u32) -> Option<NamedRef> {
    for ancestor in self.class_ancestors(ty) {
      if ancestor.id == id {
        return Some(ancestor);
      }
    }

    None
  }

  /// The ancestor interface `id` of an interface type, or one of the interfaces a type
  /// implements, with its arguments.
  pub fn implemented_ref(self, ty: Type, id: u32) -> Option<NamedRef> {
    for interface_ref in self.implemented_refs(ty) {
      if interface_ref.id == id {
        return Some(interface_ref);
      }
    }

    None
  }

  /// Why values of `ty` cannot be sent to another thread, or `None` if `ty` is `Send`.
  /// The type of a `static`: what the function computing its value returns.
  pub fn static_type(self, resolution: Resolution, id: u32) -> Option<Type> {
    const info = resolution.statics.get(id as usize)?;

    Some(self.sigs.get(info.init as usize)?.ret)
  }

  pub fn not_send_reason(self, ty: Type) -> Option<String> {
    self.not_send(ty, new List())
  }

  /// `visiting` holds the types being checked: a type reached again through itself adds no new
  /// reason.
  prv fn not_send(self, ty: Type, visiting: List<Type>) -> Option<String> {
    if types::contains_type(visiting, ty) {
      return None;
    }

    match ty.kind {
      // A C function pointer holds no data, as in Rust.
      TypeKind::Unit | TypeKind::Bool | TypeKind::Char | TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::String | TypeKind::CString | TypeKind::Never
        | TypeKind::Error | TypeKind::CFn { .. } => None,
      TypeKind::StringBuilder => Some("a `StringBuilder` can be changed through any reference to it"),
      TypeKind::List(_) => Some("a `" + types::text(ty) + "` can be changed through any reference to it"),
      TypeKind::Function { .. } => Some("a function value can capture values that are not `Send`"),
      TypeKind::Ptr { .. } | TypeKind::CVoid => Some("raw pointers are not `Send`"),
      TypeKind::Ref { .. } | TypeKind::Slice { .. } => Some("references live while a call does"),
      // Threads share an atomic to change it at once (docs/adr/0087-atomic-storage-and-std-sync.md, Q569).
      TypeKind::Atomic(_) => None,
      TypeKind::Interface(interface_ref) => {
        if let Some(send) = self.prelude.send {
          if send == interface_ref.id {
            return None;
          }
        }

        Some("a value of the interface `" + interface_ref.name + "` can hold a type that is not `Send`")
      }
      TypeKind::Param(param) => {
        var bounded = false;

        for bound in self.param_bounds(param) {
          if let Some(send) = self.prelude.send {
            if send == bound.id {
              bounded = true;
            }
          }
        }

        if bounded { None } else { Some("the type parameter `" + param.name + "` is not bounded by `Send`") }
      }
      TypeKind::Array { elem, .. } => self.not_send(elem, visiting),
      TypeKind::Tuple(elems) => {
        for elem in elems {
          if let Some(reason) = self.not_send(elem, visiting) {
            return Some(reason);
          }
        }

        None
      }
      TypeKind::Option(elem) => self.not_send(elem, visiting),
      TypeKind::Result { value, error } => {
        if let Some(reason) = self.not_send(value, visiting) {
          return Some(reason);
        }

        self.not_send(error, visiting)
      }
      TypeKind::Struct(named) => {
        visiting.push(ty);

        var reason: Option<String> = None;

        for field in self.struct_field_types(named) {
          if reason.is_none() {
            reason = self.not_send(field, visiting);
          }
        }

        visiting.pop();
        reason
      }
      TypeKind::Enum(named) => {
        visiting.push(ty);

        const subst = Subst::of(ParamOwner::Item(TypeItem::Enum(named.id)), named.args);
        var reason: Option<String> = None;

        if let Some(def) = self.enums.get(named.id as usize) {
          for variant in def.variants {
            for field in variant.field_types() {
              if reason.is_none() {
                reason = self.not_send(types::substitute(field, subst), visiting);
              }
            }
          }
        }

        visiting.pop();
        reason
      }
      TypeKind::Class(named) => {
        if self.sync_classes.contains(named.id) {
          for arg in named.args {
            if let Some(reason) = self.not_send(arg, visiting) {
              return Some(reason);
            }
          }

          return None;
        }

        visiting.push(ty);

        const reason = self.class_not_send(named, visiting);

        visiting.pop();
        reason
      }
    }
  }

  /// A class is `Send` when every field, its own and inherited, is `const` and `Send`, and so is
  /// every subclass.
  prv fn class_not_send(self, class_ref: NamedRef, visiting: List<Type>) -> Option<String> {
    for ancestor in self.class_ancestors(class_ref) {
      if let Some(reason) = self.own_fields_not_send(ancestor, visiting) {
        return Some(reason);
      }
    }

    for index in 0..self.classes.len() {
      const id = index as u32;

      if id != class_ref.id && self.is_subclass(id, class_ref.id) {
        const name = match self.class_def(id) {
          Some(def) => def.name,
          None => "",
        };
        const subclass = NamedRef { id: id, name: name, args: self.identity_args(ParamOwner::Item(TypeItem::Class(id))) };

        if let Some(reason) = self.own_fields_not_send(subclass, visiting) {
          return Some("its subclass `" + name + "` is not `Send`: " + reason);
        }
      }
    }

    None
  }

  prv fn own_fields_not_send(self, class_ref: NamedRef, visiting: List<Type>) -> Option<String> {
    const def = self.class_def(class_ref.id)?;
    const field_types = self.class_field_types(class_ref);

    for index in 0..def.fields.len() {
      const field = def.fields[index];

      if field.is_weak {
        return Some("the field `" + field.name + "` of `" + def.name + "` is `weak`");
      }

      if field.mutable {
        return Some("the field `" + field.name + "` of `" + def.name + "` is `var`");
      }

      if let Some(ty) = field_types.get(index) {
        if let Some(reason) = self.not_send(ty, visiting) {
          return Some(reason);
        }
      }
    }

    None
  }
}

fn is_id(found: Option<u32>, id: u32) -> bool {
  match found {
    Some(other) => other == id,
    None => false,
  }
}

/// The types the prelude converts from: integers, `f32` and `char`.
fn conversion_sources() -> List<Type> {
  const sources: List<Type> = new List();

  for int_ty in types::int_types() {
    sources.push(types::int(int_ty));
  }

  sources.push(types::of(TypeKind::Float(FloatTy::F32)));
  sources.push(types::of(TypeKind::Char));
  sources
}

/// Whether the prelude makes a `to` from every `from`, as Rust's `From`
/// (docs/adr/0094-conversions-and-defaults.md, Q632).
pub fn builtin_from(to: Type, from: Type) -> bool {
  match to.kind {
    TypeKind::Int(to_int) => match from.kind {
      TypeKind::Int(from_int) => types::int_widens(to_int, from_int),
      TypeKind::Char => to_int == IntTy::U32 || to_int == IntTy::U64,
      _ => false,
    },
    TypeKind::Float(to_float) => match from.kind {
      TypeKind::Float(from_float) => to_float == FloatTy::F64 && from_float == FloatTy::F32,
      TypeKind::Int(from_int) => {
        const sized = from_int == IntTy::Isize || from_int == IntTy::Usize;
        const bits = if to_float == FloatTy::F64 { 32u32 } else { 16u32 };

        !sized && types::int_bits(from_int) <= bits
      }
      _ => false,
    },
    TypeKind::Char => match from.kind {
      TypeKind::Int(from_int) => from_int == IntTy::U8,
      _ => false,
    },
    TypeKind::String => match from.kind {
      TypeKind::Char => true,
      _ => false,
    },
    _ => false,
  }
}

/// Whether the prelude tries to make a `to` from a `from`, with a `String` error (Q634): between
/// integers without a `From`, and `char` from `u32`.
pub fn builtin_try_from(to: Type, from: Type) -> bool {
  match to.kind {
    TypeKind::Int(to_int) => match from.kind {
      TypeKind::Int(from_int) => to_int != from_int && !types::int_widens(to_int, from_int),
      _ => false,
    },
    TypeKind::Char => match from.kind {
      TypeKind::Int(from_int) => from_int == IntTy::U32,
      _ => false,
    },
    _ => false,
  }
}
