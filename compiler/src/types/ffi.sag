//! The foreign function interface (docs/spec/10-ffi.md): C types, raw pointers, `unsafe`,
//! `extern` declarations, exported functions and `@repr(C)` structs. The port of
//! `sagitario_types::ffi`.

use pkg::ast::{Block, Expr, ExprKind, FnDecl, Ident, Path, TypeExpr, UnaryOp};
use pkg::diagnostics::Diagnostic;
use pkg::diagnostics::codes;
use pkg::resolve::TypeItem;
use pkg::span::Span;
use pkg::ast::TargetInfo;
use pkg::types::{Checker, FloatTy, FnSig, IntTy, SpanType, Type, TypeKind};
use pkg::types;
use pkg::types::classes;
use pkg::types::classes::PlaceUse;
use pkg::types::exprs;
use pkg::types::typed::BuiltinMethod;

/// The Sagitario type of a C type, by its name, on the target: `long` has 32 bits on Windows and
/// on 32-bit targets, and `char` is unsigned on Linux and Android for ARM. It keeps C's own name
/// of the type (docs/adr/0105-c-types-at-the-ffi-boundary.md, Q742).
pub fn c_type(name: String, target: TargetInfo) -> Type {
  const ty = c_type_of(name, target);

  ty.c_name = c_name_of(name);
  ty
}

/// C's name of a type of `std::ffi`: `c_ulonglong` is `unsigned long long`.
fn c_name_of(name: String) -> String {
  if name == "c_void" {
    return "";
  }

  const words = name.substring(2, name.len());
  const unsigned = words.starts_with("u") && words != "uchar" || words == "uchar";
  var base = if words.starts_with("u") { words.substring(1, words.len()) } else { words };

  if words == "schar" {
    return "signed char";
  }

  if base == "longlong" {
    base = "long long";
  }

  if unsigned { "unsigned " + base } else { base }
}

fn c_type_of(name: String, target: TargetInfo) -> Type {
  if name == "c_char" {
    return types::int(if target.char_is_unsigned { IntTy::U8 } else { IntTy::I8 });
  }

  if name == "c_schar" {
    return types::int(IntTy::I8);
  }

  if name == "c_uchar" {
    return types::int(IntTy::U8);
  }

  if name == "c_short" {
    return types::int(IntTy::I16);
  }

  if name == "c_ushort" {
    return types::int(IntTy::U16);
  }

  if name == "c_int" {
    return types::int(IntTy::I32);
  }

  if name == "c_uint" {
    return types::int(IntTy::U32);
  }

  if name == "c_long" {
    return types::int(if target.long_is_32 { IntTy::I32 } else { IntTy::I64 });
  }

  if name == "c_ulong" {
    return types::int(if target.long_is_32 { IntTy::U32 } else { IntTy::U64 });
  }

  if name == "c_longlong" {
    return types::int(IntTy::I64);
  }

  if name == "c_ulonglong" {
    return types::int(IntTy::U64);
  }

  if name == "c_float" {
    return types::of(TypeKind::Float(FloatTy::F32));
  }

  if name == "c_double" {
    return types::of(TypeKind::Float(FloatTy::F64));
  }

  types::of(TypeKind::CVoid)
}

/// Words C reserves, which cannot be C symbols: keywords, and names the C files generated by
/// `sag` define.
const C_RESERVED: String = "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while bool true false NULL main offsetof";

/// Why a symbol cannot be used in C, or `None` if it can.
fn symbol_problem(symbol: String) -> Option<String> {
  var valid = !symbol.is_empty();
  var first = true;

  for c in symbol.chars() {
    if first {
      valid = valid && (c.is_ascii_alphabetic() || c == '_');
      first = false;
    } else {
      valid = valid && (c.is_ascii_alphanumeric() || c == '_');
    }
  }

  if !valid {
    return Some("`" + symbol + "` is not a C identifier (ASCII letters, digits and `_`, not starting with a digit)");
  }

  var second_upper = false;
  var position = 0usize;

  for c in symbol.chars() {
    if position == 1 {
      second_upper = c.is_ascii_uppercase();
    }

    position += 1;
  }

  if C_RESERVED.split(" ").contains(symbol) || symbol.starts_with("__") || (symbol.starts_with("_") && second_upper) {
    return Some("`" + symbol + "` is reserved in C");
  }

  if symbol.starts_with("sag_") || symbol.starts_with("SAG_") || symbol.starts_with("_Z") || symbol.ends_with("_t") {
    return Some("`" + symbol + "` is reserved: names starting with `sag_` belong to the Sagitario runtime, and names ending in `_t` to C types");
  }

  None
}

/// `*const T` or `*mut T`; the pointee is checked once all types are known.
pub fn pointer_type(cx: Checker, mutable: bool, pointee: TypeExpr) -> Type {
  const pointee_ty = cx.type_expr_at(pointee, true);

  cx.pointees.push(SpanType { span: pointee.span, ty: pointee_ty });

  types::of(TypeKind::Ptr { mutable: mutable, pointee: pointee_ty })
}

/// A `c_void` outside a pointer.
pub fn bare_c_void(cx: Checker, span: Span) -> Type {
  cx.diagnostics.push(
    Diagnostic::error(codes::NOT_FFI_SAFE, span, "`c_void` can only be used behind a pointer").with_help("write `*mut c_void` or `*const c_void`"),
  );

  types::error()
}

/// Whether the struct `id` is an opaque C type (docs/adr/0103-build-scripts-and-binding-generation.md,
/// Q721).
pub fn is_opaque(cx: Checker, id: u32) -> bool {
  match cx.resolution.struct_decl(cx.package, id) {
    Some(decl) => decl.is_opaque(),
    None => false,
  }
}

/// A value of an opaque C type, which never exists.
pub fn bare_opaque(cx: Checker, span: Span, id: u32) -> Type {
  const name = match cx.resolution.struct_decl(cx.package, id) {
    Some(decl) => decl.name.name,
    None => "",
  };

  cx.diagnostics.push(
    Diagnostic::error(codes::NOT_FFI_SAFE, span, "`" + name + "` is an opaque C type: it can only be used behind a raw pointer")
      .with_note("its only field is a private array of length 0, so C defines its contents and its size")
      .with_help("write `*mut " + name + "` or `*const " + name + "`"),
  );

  types::error()
}

/// The pointee of `ty`, when it is an opaque C type.
fn opaque_pointee(cx: Checker, pointee: Type) -> bool {
  match pointee.kind {
    TypeKind::Struct(named) => is_opaque(cx, named.id),
    _ => false,
  }
}

/// Whether C can receive or return values of `ty`: numbers, `bool`, pointers, C function
/// pointers (also in an `Option`, whose `None` is `NULL`) and `@repr(C)` structs.
fn ffi_safe(cx: Checker, ty: Type) -> bool {
  ffi_safe_in(cx, ty, false)
}

/// Whether `ty` is FFI-safe as a parameter or result, or (`in_field`) as a field of a C layout.
fn ffi_safe_in(cx: Checker, ty: Type, in_field: bool) -> bool {
  match ty.kind {
    TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Ptr { .. } | TypeKind::CFn { .. } | TypeKind::Error | TypeKind::Never => true,
    TypeKind::Option(inner) => is_c_fn(inner),
    // A non-null pointer for C (docs/adr/0079-references-and-borrowing.md, Q496).
    TypeKind::Ref { pointee, .. } => !in_field && !is_managed(cx, pointee, new List()) && ffi_safe_in(cx, pointee, true),
    // Laid out as C's `T name[N]` (docs/adr/0078-ffi-without-c-shims.md, Q477); only fields
    // hold arrays, since C passes a pointer for an array parameter.
    TypeKind::Array { elem, .. } => in_field && ffi_safe_in(cx, elem, false),
    // Laid out as its integer (Q479).
    TypeKind::Enum(named) => has_repr(cx, named.id),
    TypeKind::Struct(named) => match cx.resolution.struct_decl(cx.package, named.id) {
      Some(decl) => decl.repr_c,
      None => false,
    },
    _ => false,
  }
}

/// Whether `ty` is a C function pointer, `extern "C" fn(..)`.
pub fn is_c_fn(ty: Type) -> bool {
  match ty.kind {
    TypeKind::CFn { .. } => true,
    _ => false,
  }
}

fn not_ffi_safe(cx: Checker, span: Span, ty: Type, context: String) {
  const help = match ty.kind {
    TypeKind::String => "pass a `CString` with `as_ptr()`, a `*const c_char`",
    TypeKind::Char => "pass the code point as `u32`",
    TypeKind::Struct(_) => "mark the struct `@repr(C)`",
    TypeKind::Tuple(_) => "declare a `@repr(C)` struct with a field for each element",
    TypeKind::Array { .. } => "pass a pointer to the first element with `as_ptr()`, as C does; arrays of C types can be fields of `@repr(C)` structs",
    TypeKind::Function { .. } => "C calls functions through pointers: use an `extern \"C\" fn(..)` type, and pass an `extern \"C\" fn` of Sagitario",
    _ => "C takes numbers, `bool`, raw pointers, `extern \"C\" fn` pointers and `@repr(C)` structs",
  };

  cx.diagnostics.push(Diagnostic::error(codes::NOT_FFI_SAFE, span, context + " has type `" + types::text(ty) + "`, which C cannot represent").with_help(help));
}

/// Whether a parameter or result of a runtime function is allowed: runtime functions also take
/// and return `String`s and `fn()` values.
fn runtime_safe(ty: Type) -> bool {
  if types::is_string(ty) {
    return true;
  }

  match ty.kind {
    TypeKind::Function { params, ret } => params.is_empty() && types::is_unit(ret),
    _ => false,
  }
}

/// The parameters and result of a function C calls or is called through.
fn check_ffi_signature(cx: Checker, sig: FnSig, params: List<TypeExpr>, ret: Option<TypeExpr>, runtime: bool) {
  var index = 0usize;

  while index < sig.params.len() && index < params.len() {
    const ty = sig.params[index];

    if !ffi_safe(cx, ty) && !(runtime && runtime_safe(ty)) {
      not_ffi_safe(cx, params[index].span, ty, "this parameter");
    }

    index += 1;
  }

  if let Some(expr) = ret {
    if !types::is_unit(sig.ret) && !ffi_safe(cx, sig.ret) && !(runtime && runtime_safe(sig.ret)) {
      not_ffi_safe(cx, expr.span, sig.ret, "the result");
    }
  }
}

/// The signatures of the C functions in `extern` blocks.
pub fn extern_sigs(cx: Checker) {
  for index in 0..cx.resolution.externs.len() {
    const id = index as u32;
    const decl = match cx.resolution.extern_decl(cx.package, id) {
      Some(decl) => decl,
      None => continue,
    };
    const params: List<Type> = new List();
    const param_exprs: List<TypeExpr> = new List();

    for param in decl.params {
      params.push(cx.type_expr(param.ty));
      param_exprs.push(param.ty);
    }

    const ret = match decl.return_type {
      Some(ty) => cx.type_expr(ty),
      None => types::unit(),
    };
    const sig = FnSig { receiver: None, params: params, ret: ret };
    const runtime = cx.resolution.is_runtime_extern(cx.package, id);

    check_ffi_signature(cx, sig, param_exprs, decl.return_type, runtime);
    cx.typed.extern_sigs.push(sig);
  }
}

/// The types of the C globals (docs/adr/0086-c-globals-and-std-io.md, Q559).
pub fn check_extern_statics(cx: Checker) {
  for index in 0..cx.resolution.statics.len() {
    const id = index as u32;
    const decl = match cx.resolution.static_decl(cx.package, id) {
      Some(decl) => decl,
      None => continue,
    };

    if !decl.extern_c {
      continue;
    }

    if let Some(ty) = cx.typed.static_type(cx.resolution, id) {
      if !types::is_error(ty) && !ffi_safe(cx, ty) {
        not_ffi_safe(cx, decl.ty.span, ty, "the C global `" + decl.name.name + "`");
      }
    }
  }
}

/// `extern "C" fn`: a function with the C ABI, which C can call.
pub fn check_exported(cx: Checker, decl: FnDecl, sig: FnSig) {
  const params: List<TypeExpr> = new List();

  for param in decl.params {
    params.push(param.ty);
  }

  check_ffi_signature(cx, sig, params, decl.return_type, false);
}

/// The fields of `@repr(C)` structs, which C reads with its own layout.
pub fn check_repr_c_structs(cx: Checker) {
  for index in 0..cx.resolution.structs.len() {
    const id = index as u32;
    const decl = match cx.resolution.struct_decl(cx.package, id) {
      Some(decl) => decl,
      None => continue,
    };

    if !decl.repr_c {
      continue;
    }

    const fields = match cx.typed.struct_def(id) {
      Some(def) => def.fields,
      None => new List(),
    };
    var position = 0usize;

    while position < decl.fields.len() && position < fields.len() {
      const field = decl.fields[position];
      const ty = fields[position].ty;

      position += 1;

      if !ffi_safe_in(cx, ty, true) {
        const kind = if decl.is_union { "union" } else { "struct" };

        not_ffi_safe(cx, field.ty.span, ty, "the field `" + field.name.name + "` of the `@repr(C)` " + kind + " `" + decl.name.name + "`");
      } else if !decl.is_opaque() && has_empty_array(ty) {
        cx.diagnostics.push(
          Diagnostic::error(codes::NOT_FFI_SAFE, field.ty.span, "C has no arrays of length 0, so the field `" + field.name.name + "` has no C layout")
            .with_note("a `@repr(C)` struct whose only field is a `prv` array of length 0 is an opaque C type")
            .with_help("for an opaque type, declare `@repr(C) struct " + decl.name.name + " { prv _unused: [u8; 0]; }` and use it behind pointers"),
        );
      }
    }

    // Its values never exist, so it has no methods (Q721).
    if decl.is_opaque() {
      for function in decl.functions {
        if function.self_param.is_some() {
          cx.diagnostics.push(
            Diagnostic::error(codes::NOT_FFI_SAFE, function.name.span, "the opaque C type `" + decl.name.name + "` cannot have methods")
              .with_note("its values only exist in C, behind pointers")
              .with_help("write a function taking a `*mut " + decl.name.name + "` instead"),
          );
        }
      }
    }
  }
}

/// Whether `ty` is, or holds directly, an array of length 0.
fn has_empty_array(ty: Type) -> bool {
  match ty.kind {
    TypeKind::Array { elem, len } => len == 0 || has_empty_array(elem),
    _ => false,
  }
}

/// A C symbol the program declares (with the signature of the C function) or defines.
struct Symbol {
  pub span: Span;
  pub sig: Option<FnSig>;
  /// Of the standard library, which may declare the reserved names of the system's C library
  /// and define the runtime's own (docs/adr/0085-conditional-compilation-and-std-time.md, Q552).
  pub in_std: bool;
  /// A C function declared with `...`.
  pub variadic: bool;
}

/// Checks the C symbols: valid identifiers, not reserved, each declared or defined once (a C
/// function may be declared in several `extern` blocks with the same signature).
pub fn check_symbols(cx: Checker) {
  const symbols = new Map<String, Symbol>();
  const found: List<Symbol> = new List();
  const names: List<String> = new List();

  for index in 0..cx.resolution.externs.len() {
    const id = index as u32;
    const decl = match cx.resolution.extern_decl(cx.package, id) {
      Some(decl) => decl,
      None => continue,
    };

    // The runtime's functions are declared by its header, not by the program.
    if cx.resolution.is_runtime_extern(cx.package, id) {
      continue;
    }

    names.push(decl.name.name);
    found.push(Symbol { span: decl.name.span, sig: cx.typed.extern_sig(id), in_std: cx.resolution.is_std_source(cx.resolution.externs[index].module), variadic: decl.variadic });
  }

  for index in 0..cx.resolution.statics.len() {
    if let Some(decl) = cx.resolution.static_decl(cx.package, index as u32) {
      if decl.extern_c {
        names.push(decl.name.name);
        found.push(Symbol { span: decl.name.span, sig: None, in_std: cx.resolution.is_std_source(cx.resolution.statics[index].module), variadic: false });
      }
    }
  }

  for index in 0..cx.resolution.functions.len() {
    const decl = match cx.resolution.fn_decl(cx.package, index as u32) {
      Some(decl) => decl,
      None => continue,
    };

    if decl.extern_c {
      const in_std = cx.resolution.is_std_source(cx.resolution.functions[index].module);

      match decl.export {
        Some(export) => {
          names.push(export.symbol);
          found.push(Symbol { span: export.span, sig: None, in_std: in_std, variadic: false });
        }
        None => {
          names.push(decl.name.name);
          found.push(Symbol { span: decl.name.span, sig: None, in_std: in_std, variadic: false });
        }
      }
    }
  }

  for index in 0..found.len() {
    const symbol = names[index];
    const entry = found[index];
    const span = entry.span;

    const problem: Option<String> = if entry.in_std { None } else { symbol_problem(symbol) };

    if let Some(problem) = problem {
      cx.diagnostics.push(
        Diagnostic::error(codes::INVALID_SYMBOL, span, "cannot use `" + symbol + "` as a C symbol")
          .with_note(problem)
          .with_help("rename the function, or choose the exported name with `@export(\"name\")`"),
      );
      continue;
    }

    // The standard library's C declarations are compiled apart from the program's.
    const key = if entry.in_std { "std:" + symbol } else { symbol };

    if let Some(previous) = symbols.get(key) {
      var message = "first used here";

      if let Some(sig) = entry.sig {
        if let Some(previous_sig) = previous.sig {
          if types::same_sig(previous_sig, sig) && previous.variadic == entry.variadic {
            continue;
          }

          message = "declared again here with a different signature";
        }
      }

      cx.diagnostics.push(
        Diagnostic::error(codes::INVALID_SYMBOL, span, "the C symbol `" + symbol + "` is already used")
          .with_label(previous.span, "first used here")
          .with_note("each C symbol is defined once; a C function can be declared again only with the same signature (" + message + ")"),
      );
      continue;
    }

    symbols.insert(key, entry);
  }
}

/// `*const c_char`, the type of C strings.
pub fn c_string_ptr(target: TargetInfo) -> Type {
  types::of(TypeKind::Ptr { mutable: false, pointee: c_type("c_char", target) })
}

/// Pointers cannot point to values with ARC references: C would copy or free them unseen.
pub fn check_pointees(cx: Checker) {
  const pending = cx.pointees;

  cx.pointees = new List<SpanType>();

  for entry in pending {
    if is_managed(cx, entry.ty, new List()) {
      cx.diagnostics.push(
        Diagnostic::error(codes::NOT_FFI_SAFE, entry.span, "a pointer cannot point to `" + types::text(entry.ty) + "`, which holds reference-counted values")
          .with_note("pass strings to C as `CString` and read them back with `string_from_c`"),
      );
    }
  }
}

/// Whether values of `ty` hold `String`s or other ARC references.
pub fn is_managed(cx: Checker, ty: Type, visited: List<TypeItem>) -> bool {
  match ty.kind {
    TypeKind::String | TypeKind::StringBuilder | TypeKind::CString | TypeKind::Class(_) | TypeKind::List(_) => true,
    TypeKind::Array { elem, .. } => is_managed(cx, elem, visited),
    TypeKind::Tuple(elems) => elems.iter().any((elem) => is_managed(cx, elem, visited)),
    TypeKind::Option(elem) => is_managed(cx, elem, visited),
    TypeKind::Result { value, error } => is_managed(cx, value, visited) || is_managed(cx, error, visited),
    TypeKind::Struct(named) => {
      for item in visited {
        if let TypeItem::Struct(seen) = item {
          if seen == named.id {
            return false;
          }
        }
      }

      visited.push(TypeItem::Struct(named.id));

      const fields: List<Type> = new List();

      if let Some(def) = cx.typed.struct_def(named.id) {
        for field in def.fields {
          fields.push(field.ty);
        }
      }

      for field in fields {
        if is_managed(cx, field, visited) {
          return true;
        }
      }

      false
    }
    TypeKind::Enum(named) => {
      for item in visited {
        if let TypeItem::Enum(seen) = item {
          if seen == named.id {
            return false;
          }
        }
      }

      visited.push(TypeItem::Enum(named.id));

      const parts: List<Type> = new List();

      if let Some(variants) = cx.typed.variants(ty) {
        for variant in variants {
          for part in variant.field_types() {
            parts.push(part);
          }
        }
      }

      for part in parts {
        if is_managed(cx, part, visited) {
          return true;
        }
      }

      false
    }
    _ => false,
  }
}

/// Marks the innermost `unsafe` block as needed, or reports that one is missing.
pub fn require_unsafe(cx: Checker, span: Span, what: String) {
  if !cx.unsafe_blocks.is_empty() {
    cx.unsafe_blocks[cx.unsafe_blocks.len() - 1] = true;

    return;
  }

  cx.diagnostics.push(
    Diagnostic::error(codes::UNSAFE_REQUIRED, span, what + " is unsafe and needs an `unsafe` block")
      .with_help("wrap it in `unsafe { ... }` after checking that the operation is valid"),
  );
}

/// `mem::size_of<T>()`, `mem::align_of<T>()` and `mem::zeroed<T>()`
/// (docs/adr/0078-ffi-without-c-shims.md, Q480). The type of `zeroed` may also come from the
/// expected type.
pub fn mem_call(cx: Checker, value: Expr, path: Path, name: String, args: List<Expr>, expected: Option<Type>) -> Type {
  const zeroed = name == "mem::zeroed";
  var measured: Option<Type> = None;

  if let Some(explicit) = pkg::types::generic::explicit_args(cx, path) {
    if explicit.args.len() == 1 {
      measured = Some(explicit.args[0]);
    } else {
      cx.error(codes::WRONG_ARGUMENT_COUNT, value.span, `\`${name}\` takes 1 type argument but ${explicit.args.len()} were supplied`);
    }
  } else if zeroed {
    measured = expected;
  }

  exprs::check_args(cx, value.span, "function", new List(), args);

  const ty = match measured {
    Some(found) => found,
    None => {
      cx.diagnostics.push(
        Diagnostic::error(codes::UNKNOWN_TYPE, value.span, "cannot infer the type `" + name + "` is about")
          .with_help("write it as a type argument: `" + name + "<T>()`"),
      );

      return if zeroed { types::error() } else { types::int(IntTy::Usize) };
    }
  };

  cx.typed.mem_types.insert(value.id, ty);

  if !zeroed {
    return types::int(IntTy::Usize);
  }

  require_unsafe(cx, value.span, "making a zeroed value");

  if !types::is_error(ty) && !zeroable(cx, ty) {
    var diagnostic = Diagnostic::error(codes::NOT_FFI_SAFE, value.span, "`mem::zeroed` cannot make a `" + types::text(ty) + "`")
      .with_note("only C types are valid with every byte zero: numbers, `bool`, raw pointers, `Option` of C function pointers, enums with a variant of value 0, and `@repr(C)` structs, unions and arrays of them");

    if is_c_fn(ty) {
      diagnostic = diagnostic.with_help("a C function pointer is never null: zero an `Option<extern \"C\" fn(..)>` instead");
    }

    cx.diagnostics.push(diagnostic);
  }

  ty
}

/// Whether the enum `id` has an integer representation.
pub fn has_repr(cx: Checker, id: u32) -> bool {
  match cx.typed.enums.get(id as usize) {
    Some(def) => def.repr.is_some(),
    None => false,
  }
}

/// Whether every byte zero is a valid value of `ty`.
fn zeroable(cx: Checker, ty: Type) -> bool {
  match ty.kind {
    // One of its variants must be zero.
    TypeKind::Enum(named) => match cx.typed.enums.get(named.id as usize) {
      Some(def) => {
        var zero = false;

        for value in def.discriminants {
          zero = zero || value.magnitude == 0;
        }

        def.repr.is_some() && zero
      }
      None => false,
    },
    TypeKind::Int(_) | TypeKind::Float(_) | TypeKind::Bool | TypeKind::Ptr { .. } | TypeKind::Error => true,
    TypeKind::Option(inner) => is_c_fn(inner),
    TypeKind::Array { elem, .. } => zeroable(cx, elem),
    TypeKind::Struct(named) => {
      const repr_c = match cx.resolution.struct_decl(cx.package, named.id) {
        Some(decl) => decl.repr_c,
        None => false,
      };

      if !repr_c {
        return false;
      }

      for field in cx.typed.struct_field_types(named) {
        if !zeroable(cx, field) {
          return false;
        }
      }

      true
    }
    _ => false,
  }
}

/// A call to an `unsafe fn` needs `unsafe`.
pub fn check_unsafe_call(cx: Checker, span: Span, function: u32) {
  if let Some(decl) = cx.resolution.fn_decl(cx.package, function) {
    if decl.is_unsafe {
      require_unsafe(cx, span, "calling the unsafe function `" + decl.name.name + "`");
    }
  }
}

/// `unsafe { ... }`
pub fn unsafe_block(cx: Checker, value: Expr, body: Block, expected: Option<Type>) -> Type {
  cx.unsafe_blocks.push(false);

  const ty = exprs::block(cx, body, expected);
  const used = cx.unsafe_blocks.pop().unwrap_or(true);

  if !used {
    const keyword = Span::new(value.span.file, value.span.start, value.span.start + 6);

    cx.diagnostics.push(
      Diagnostic::warning(codes::UNUSED_UNSAFE, keyword, "unnecessary `unsafe` block").with_note("it contains no call to C, pointer dereference, pointer offset or use of a `static var`"),
    );
  }

  ty
}

fn points_to_void(pointee: Type) -> bool {
  match pointee.kind {
    TypeKind::CVoid => true,
    _ => false,
  }
}

/// Whether `place` is a place `&raw` takes the address of: a binding, a field of a place or of a
/// class instance, an element of an array, or `*pointer`.
fn is_address_place(cx: Checker, place: Expr) -> bool {
  match place.kind {
    ExprKind::Path(_) => match cx.resolution.paths.get(place.id) {
      Some(pkg::resolve::Res::Local(_)) | Some(pkg::resolve::Res::Static(_)) => true,
      _ => false,
    },
    ExprKind::Field { .. } => true,
    ExprKind::Index { base, .. } => match cx.typed.expr_types.get(base.id) {
      Some(ty) => match ty.kind {
        TypeKind::Array { .. } => is_address_place(cx, base),
        _ => false,
      },
      None => false,
    },
    ExprKind::Unary { op, .. } => op == UnaryOp::Deref,
    _ => false,
  }
}

/// `&raw const place` and `&raw mut place` (docs/adr/0078-ffi-without-c-shims.md, Q481): taking
/// the address is safe; using it needs `unsafe`, as any raw pointer does.
pub fn addr_of(cx: Checker, mutable: bool, place: Expr) -> Type {
  // Taking the address of a field of a union does not read it.
  if let ExprKind::Field { base, .. } = place.kind {
    cx.union_write = Some(base.id);
  }

  var ty = types::error();

  // The address of a static is safe to take, as in Rust: using it is not
  // (docs/adr/0083-global-state.md, Q528).
  match cx.resolution.paths.get(place.id) {
    Some(pkg::resolve::Res::Static(id)) => {
      ty = cx.typed.static_type(cx.resolution, id).unwrap_or(types::error());
      cx.typed.expr_types.insert(place.id, ty);
    }
    _ => {
      ty = exprs::expr(cx, place, None);
    }
  }

  cx.union_write = None;

  if types::is_error(ty) {
    return types::error();
  }

  if !is_address_place(cx, place) {
    var diagnostic = Diagnostic::error(codes::INVALID_OPERAND, place.span, "`&raw` takes the address of a place: a binding, a field, an element of an array or `*pointer`");

    if let ExprKind::Index { .. } = place.kind {
      diagnostic = diagnostic.with_note("the elements of a list move when it grows").with_help("use `list.as_ptr()` or `list.as_mut_ptr()`");
    } else {
      diagnostic = diagnostic.with_help("store the value in a binding first");
    }

    cx.diagnostics.push(diagnostic);

    return types::error();
  }

  if mutable {
    classes::check_mutable_place(cx, place, PlaceUse::Assign);
  }

  if is_managed(cx, ty, new List()) {
    cx.diagnostics.push(
      Diagnostic::error(codes::NOT_FFI_SAFE, place.span, "a pointer cannot point to `" + types::text(ty) + "`, which holds reference-counted values")
        .with_note("pass strings to C as `CString` and read them back with `string_from_c`"),
    );
  }

  types::of(TypeKind::Ptr { mutable: mutable, pointee: ty })
}

/// `*pointer`
pub fn deref(cx: Checker, value: Expr, operand: Expr) -> Type {
  const ty = exprs::expr(cx, operand, None);

  match ty.kind {
    TypeKind::Ptr { pointee, .. } => {
      if points_to_void(pointee) {
        cx.error(codes::INVALID_OPERAND, value.span, "cannot dereference a `" + types::text(ty) + "`; cast it to a pointer to a known type first");

        return types::error();
      }

      if opaque_pointee(cx, pointee) {
        require_unsafe(cx, value.span, "dereferencing a raw pointer");
        cx.diagnostics.push(
          Diagnostic::error(codes::INVALID_OPERAND, value.span, "cannot dereference a `" + types::text(ty) + "`: `" + types::text(pointee) + "` is an opaque C type")
            .with_note("its contents and its size are known only to C")
            .with_help("pass the pointer to the C functions that use it"),
        );

        return types::error();
      }

      require_unsafe(cx, value.span, "dereferencing a raw pointer");

      pointee
    }
    // A reference is never null: reading it is safe (docs/adr/0079-references-and-borrowing.md).
    TypeKind::Ref { pointee, .. } => pointee,
    TypeKind::Error | TypeKind::Never => types::error(),
    _ => {
      cx.error(codes::INVALID_OPERAND, value.span, "cannot dereference a value of type `" + types::text(ty) + "`; only references and raw pointers can be");

      types::error()
    }
  }
}

/// The pointer a place is reached through (`*p`, `(*p).x`), if any.
pub fn deref_pointer(place: Expr) -> Option<Expr> {
  match place.kind {
    ExprKind::Unary { op, operand } => if op == UnaryOp::Deref { Some(operand) } else { None },
    ExprKind::Field { base, .. } => deref_pointer(base),
    ExprKind::Index { base, .. } => deref_pointer(base),
    _ => None,
  }
}

/// Writing through a pointer needs a `*mut` one, and through a reference a `&mut` one.
pub fn check_pointer_write(cx: Checker, place: Expr, pointer: Expr) {
  if let Some(ty) = cx.typed.expr_types.get(pointer.id) {
    match ty.kind {
      TypeKind::Ptr { mutable, .. } => {
        if !mutable {
          cx.diagnostics.push(
            Diagnostic::error(codes::IMMUTABLE_PLACE, place.span, "cannot modify a value through a `*const` pointer")
              .with_help("use a `*mut` pointer, for example with `as *mut T`"),
          );
        }
      }
      TypeKind::Ref { mutable, pointee } => {
        if !mutable {
          cx.diagnostics.push(
            Diagnostic::error(codes::IMMUTABLE_PLACE, place.span, "cannot modify a value through a `&` reference")
              .with_help("take a `&mut " + types::text(pointee) + "` parameter, and lend it with `&mut`"),
          );
        }
      }
      _ => {}
    }
  }
}

fn runtime_method(function: String) -> BuiltinMethod {
  BuiltinMethod::Runtime { function: function, located: false }
}

/// Methods of raw pointers, `CString` and the `as_ptr`/`as_mut_ptr` of arrays.
pub fn ffi_method(cx: Checker, value: Expr, receiver: Expr, receiver_ty: Type, method: Ident, args: List<Expr>) -> Option<Type> {
  const name = method.name;
  var builtin = runtime_method("");
  var params: List<Type> = new List();
  var ret = types::error();

  match receiver_ty.kind {
    TypeKind::Ptr { pointee, .. } => {
      if name == "is_null" {
        builtin = runtime_method("SAG_PTR_IS_NULL");
        ret = types::of(TypeKind::Bool);
      } else if name == "add" {
        if opaque_pointee(cx, pointee) {
          require_unsafe(cx, value.span, "offsetting a raw pointer");
          cx.error(codes::INVALID_OPERAND, method.span, "cannot offset a `" + types::text(receiver_ty) + "`; its pointee is an opaque C type, whose size only C knows");
        } else if points_to_void(pointee) {
          cx.error(codes::INVALID_OPERAND, method.span, "cannot offset a `" + types::text(receiver_ty) + "`; its pointee has no size");
        } else {
          require_unsafe(cx, value.span, "offsetting a raw pointer");
        }

        builtin = runtime_method("SAG_PTR_ADD");
        params = List::from([types::int(IntTy::Usize)]);
        ret = receiver_ty;
      } else {
        cx.diagnostics.push(
          Diagnostic::error(codes::UNKNOWN_MEMBER, method.span, "no method `" + name + "` on type `" + types::text(receiver_ty) + "`")
            .with_note("its methods are `is_null` and `add`"),
        );
        exprs::unchecked_args(cx, args);

        return Some(types::error());
      }
    }
    TypeKind::CString => {
      if name == "as_ptr" {
        builtin = runtime_method("sag_cstring_ptr");
        ret = c_string_ptr(cx.target);
      } else {
        cx.diagnostics.push(
          Diagnostic::error(codes::UNKNOWN_MEMBER, method.span, "no method `" + name + "` on type `" + types::text(receiver_ty) + "`").with_note("its methods are `as_ptr`"),
        );
        exprs::unchecked_args(cx, args);

        return Some(types::error());
      }
    }
    // A pointer to the first element of a list, valid until its length changes; a list is a
    // reference, so any binding gives a `*mut` one (docs/adr/0078-ffi-without-c-shims.md, Q482).
    TypeKind::List(elem) => {
      if name != "as_ptr" && name != "as_mut_ptr" {
        return None;
      }

      if is_managed(cx, elem, new List()) {
        cx.diagnostics.push(
          Diagnostic::error(codes::NOT_FFI_SAFE, method.span, "a pointer cannot point to `" + types::text(elem) + "`, which holds reference-counted values"),
        );
      }

      builtin = runtime_method("SAG_LIST_PTR");
      ret = types::of(TypeKind::Ptr { mutable: name == "as_mut_ptr", pointee: elem });
    }
    TypeKind::Array { elem, .. } => {
      if name != "as_ptr" && name != "as_mut_ptr" {
        return None;
      }

      const mutable = name == "as_mut_ptr";

      if is_managed(cx, elem, new List()) {
        cx.diagnostics.push(
          Diagnostic::error(codes::NOT_FFI_SAFE, method.span, "a pointer cannot point to `" + types::text(elem) + "`, which holds reference-counted values"),
        );
      }

      if mutable {
        classes::check_mutable_place(cx, receiver, PlaceUse::Receiver("as_mut_ptr"));
      }

      builtin = runtime_method(if mutable { "SAG_ARRAY_MUT_PTR" } else { "SAG_ARRAY_PTR" });
      ret = types::of(TypeKind::Ptr { mutable: mutable, pointee: elem });
    }
    _ => return None,
  }

  exprs::check_args(cx, value.span, "method", params, args);
  cx.typed.builtin_methods.insert(value.id, builtin);

  Some(ret)
}

/// The type of a C function C pointers point to, as `extern "C" fn(A) -> R`.
pub fn c_fn_type(is_unsafe: bool, sig: FnSig) -> Type {
  types::of(TypeKind::CFn { is_unsafe: is_unsafe, params: sig.params, ret: sig.ret })
}

/// A C function of an `extern` block used as a value: an `unsafe extern "C" fn`.
pub fn extern_value(cx: Checker, span: Span, id: u32) -> Type {
  if is_variadic(cx, id) {
    cx.diagnostics.push(
      Diagnostic::error(codes::NOT_FFI_SAFE, span, "a variadic C function cannot be used as a function pointer")
        .with_note("a function pointer has a fixed list of parameters (docs/spec/10-ffi.md)")
        .with_help("call it directly, or wrap the call in an `extern \"C\" fn` with the parameters you need"),
    );

    return types::error();
  }

  match cx.typed.extern_sig(id) {
    Some(sig) => c_fn_type(true, sig),
    None => types::error(),
  }
}

/// Whether the C function `id` of an `extern` block ends its parameters with `...`
/// (docs/adr/0103-build-scripts-and-binding-generation.md, Q720).
pub fn is_variadic(cx: Checker, id: u32) -> bool {
  match cx.resolution.extern_decl(cx.package, id) {
    Some(decl) => decl.variadic,
    None => false,
  }
}

/// The arguments of a call to a variadic C function: its parameters, then the extra ones, which
/// must be FFI-safe and of a type C passes as it is, as in Rust: C promotes the narrower integers,
/// `bool` and `f32` (Q720).
pub fn variadic_args(cx: Checker, span: Span, params: List<Type>, args: List<Expr>) {
  if args.len() < params.len() {
    cx.error(codes::WRONG_ARGUMENT_COUNT, span, `this function takes at least ${params.len()} argument${types::plural(params.len())} but ${args.len()} were supplied`);
  }

  for index in 0..args.len() {
    if index < params.len() {
      exprs::expect(cx, args[index], params[index]);
      continue;
    }

    const ty = exprs::expr(cx, args[index], None);

    if types::is_error(ty) {
      continue;
    }

    if let Some(promoted) = promoted_type(cx, ty) {
      cx.diagnostics.push(
        Diagnostic::error(codes::NOT_FFI_SAFE, args[index].span, "C promotes a `" + types::text(ty) + "` passed as an extra argument of a variadic function")
          .with_help("convert it to the type C reads: `as " + promoted + "`"),
      );
    } else if !ffi_safe(cx, ty) {
      not_ffi_safe(cx, args[index].span, ty, "this extra argument");
    }
  }
}

/// The type a value of `ty` becomes when C passes it as an extra argument, if C changes it.
fn promoted_type(cx: Checker, ty: Type) -> Option<String> {
  match ty.kind {
    TypeKind::Bool => Some("c_int"),
    TypeKind::Int(int_ty) => match int_ty {
      IntTy::I8 | IntTy::I16 | IntTy::U8 => Some("c_int"),
      IntTy::U16 => Some("c_uint"),
      _ => None,
    },
    TypeKind::Float(float_ty) => if float_ty == FloatTy::F32 { Some("f64") } else { None },
    TypeKind::Enum(named) => match cx.typed.enums.get(named.id as usize) {
      Some(def) => match def.repr {
        Some(IntTy::I8) | Some(IntTy::I16) | Some(IntTy::U8) => Some("c_int"),
        Some(IntTy::U16) => Some("c_uint"),
        _ => None,
      },
      None => None,
    },
    _ => None,
  }
}

/// The signature of a C function of an `extern` block.
pub fn extern_call_sig(cx: Checker, callee: Expr, id: u32) -> Option<FnSig> {
  const name = match cx.resolution.extern_decl(cx.package, id) {
    Some(decl) => decl.name.name,
    None => "",
  };

  require_unsafe(cx, callee.span, "calling the C function `" + name + "`");
  cx.typed.extern_sig(id)
}
