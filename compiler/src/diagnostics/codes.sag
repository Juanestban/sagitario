//! The registry of diagnostic codes: every diagnostic the compiler emits uses one of these codes
//! (docs/adr/0067-bootstrap-from-the-seed.md).
//!
//! Errors: `E0001`–`E0099` lexical, `E0100`–`E0199` syntax, `E0200`–`E0299` names,
//! `E0300`–`E0399` types and control flow, `E0900`–`E0999` language features not implemented
//! yet. Warnings: `W0001`–`W0999`.

/// A character that cannot start any token.
pub const UNEXPECTED_CHARACTER: String = "E0001";

/// A string or template literal without its closing delimiter.
pub const UNTERMINATED_STRING: String = "E0002";

/// A `/* */` comment without its closing `*/`.
pub const UNTERMINATED_BLOCK_COMMENT: String = "E0003";

/// An unknown or malformed escape sequence.
pub const INVALID_ESCAPE: String = "E0004";

/// A malformed numeric literal: bad digits, misplaced `_`, unknown suffix, or too large.
pub const INVALID_NUMBER: String = "E0005";

/// A character literal that is empty, unterminated or holds more than one character.
pub const INVALID_CHAR_LITERAL: String = "E0006";

/// A token that does not fit the grammar at that point.
pub const UNEXPECTED_TOKEN: String = "E0100";

/// Chained non-associative operators, such as `a < b < c`.
pub const CHAINED_OPERATORS: String = "E0102";

/// A struct member without `pub` or `prv`.
pub const MISSING_VISIBILITY: String = "E0103";

/// An enum without variants, or a variant with empty `()` or `{}`.
pub const EMPTY_DECLARATION: String = "E0104";

/// An unknown, repeated or misplaced attribute, or one with the wrong arguments.
pub const INVALID_ATTRIBUTE: String = "E0105";

/// A name that does not refer to anything in scope.
pub const UNRESOLVED_NAME: String = "E0200";

/// The same name declared twice in one scope.
pub const DUPLICATE_DEFINITION: String = "E0201";

/// A declaration using a name reserved for a future phase (`Send`, `Sync`, `spawn`).
pub const RESERVED_NAME: String = "E0202";

/// A program without a `main` function.
pub const MISSING_MAIN: String = "E0203";

/// A `main` function with the wrong signature.
pub const INVALID_MAIN: String = "E0204";

/// A `prv` member used outside its struct, enum or class.
pub const PRIVATE_MEMBER: String = "E0205";

/// Alternatives of a `|` pattern that bind different names.
pub const INCONSISTENT_BINDINGS: String = "E0206";

/// An item used outside the modules that can see it.
pub const PRIVATE_ITEM: String = "E0207";

/// A C symbol that is not a valid C identifier, is reserved, or is declared incompatibly twice.
pub const INVALID_SYMBOL: String = "E0208";

/// A module with two places for its file: `name.sag` next to a directory `name/`.
pub const MODULE_LAYOUT: String = "E0209";

/// An expression whose type differs from the expected one.
pub const MISMATCHED_TYPES: String = "E0300";

/// A call with the wrong number of arguments.
pub const WRONG_ARGUMENT_COUNT: String = "E0301";

/// An integer literal that does not fit its type.
pub const INTEGER_OUT_OF_RANGE: String = "E0302";

/// `break` or `continue` outside of a loop.
pub const BREAK_OUTSIDE_LOOP: String = "E0303";

/// `break` with a value inside `while` or `for`.
pub const BREAK_WITH_VALUE: String = "E0304";

/// An `as` conversion between types that cannot be converted.
pub const INVALID_CAST: String = "E0305";

/// A value of a type that cannot be interpolated in a template string.
pub const NOT_INTERPOLABLE: String = "E0306";

/// An assignment whose target is not a binding.
pub const INVALID_ASSIGNMENT_TARGET: String = "E0307";

/// An assignment to a `const` that may already hold a value, or to a parameter.
pub const ASSIGN_TO_CONST: String = "E0308";

/// A binding read before it is definitely assigned.
pub const UNASSIGNED_BINDING: String = "E0309";

/// An operator applied to operands of a type it does not support.
pub const INVALID_OPERAND: String = "E0310";

/// A binding declared without type and value that is never assigned.
pub const UNKNOWN_TYPE: String = "E0311";

/// An assignment to a field or element of a value that is not mutable.
pub const IMMUTABLE_PLACE: String = "E0312";

/// A method that modifies `self` called on a value that is not mutable.
pub const IMMUTABLE_RECEIVER: String = "E0313";

/// A static function called as a method, or a method called as a static function.
pub const WRONG_CALL_FORM: String = "E0314";

/// A struct literal that does not initialize every field.
pub const MISSING_FIELDS: String = "E0315";

/// A field or method that the type does not have.
pub const UNKNOWN_MEMBER: String = "E0316";

/// A struct that contains itself by value.
pub const RECURSIVE_TYPE: String = "E0317";

/// A generic type used with the wrong number of type arguments.
pub const WRONG_TYPE_ARGUMENTS: String = "E0318";

/// A `match` that does not cover every possible value.
pub const NON_EXHAUSTIVE_MATCH: String = "E0319";

/// A pattern whose shape does not fit the value it matches.
pub const INVALID_PATTERN: String = "E0320";

/// `?` on a value or in a function where it cannot propagate.
pub const INVALID_TRY: String = "E0321";

/// A type that cannot cross the C boundary (or a pointer to a managed type).
pub const NOT_FFI_SAFE: String = "E0322";

/// An operation that needs an `unsafe` block: calling C, dereferencing or offsetting a pointer.
pub const UNSAFE_REQUIRED: String = "E0323";

/// A class whose initializer `new` is missing or declared wrongly.
pub const INVALID_INITIALIZER: String = "E0324";

/// A class field not assigned by the initializer before `self` is used or `new` returns.
pub const UNINITIALIZED_FIELD: String = "E0325";

/// Extending something that is not a class, a cycle of `extends`, an abstract class instantiated
/// or abstract methods left unimplemented.
pub const INVALID_INHERITANCE: String = "E0326";

/// An `override` without a method to override or with another signature, a method replaced
/// without `override`, or a malformed abstract method.
pub const INVALID_OVERRIDE: String = "E0327";

/// `weak` on something other than a `var` class field of type `Option<C>`, with `C` a class.
pub const INVALID_WEAK: String = "E0328";

/// An `impl` or interface that breaks the rules of interfaces: not an interface, a missing or
/// mismatched member, a cycle of `extends`, or an interface mentioning `Self` used as a type.
pub const INVALID_IMPL: String = "E0329";

/// A type argument that does not implement a bound of its parameter, a bound that is not an
/// interface, or generic instances that never end.
pub const UNSATISFIED_BOUND: String = "E0330";

/// An assignment inside a closure to a binding it captures (captures are read-only copies).
pub const CAPTURED_ASSIGNMENT: String = "E0331";

/// A value that is not `Send` crossing to another thread: a capture of the lambda of
/// `thread::spawn`.
pub const NOT_SEND: String = "E0332";

/// `thread::spawn` given something other than a lambda or a function name, or used as a value.
pub const INVALID_SPAWN: String = "E0333";

/// A module-level constant the compiler cannot compute: an expression that is not constant, a
/// value out of range, a division by zero, a type that constants cannot have, or a constant
/// that needs itself.
pub const NOT_CONSTANT: String = "E0334";

/// `include_str` outside a constant, with a path that is not a string literal, or naming a file
/// that cannot be read.
pub const INVALID_INCLUDE: String = "E0335";

/// `await` outside an `async fn`, or inside a lambda written in one.
pub const AWAIT_OUTSIDE_ASYNC: String = "E0336";

/// An `async fn` that cannot be one: `extern "C"`, `@export` or an initializer.
pub const INVALID_ASYNC: String = "E0337";

/// An `async` method that modifies `self`, a copy of a struct or enum value.
pub const ASYNC_MODIFIES_SELF: String = "E0338";

/// A language feature that is specified but not implemented yet.
pub const NOT_IMPLEMENTED: String = "E0900";

/// A binding that is never read (names starting with `_` are exempt).
pub const UNUSED_BINDING: String = "W0001";

/// A `var` that is never reassigned.
pub const UNNEEDED_VAR: String = "W0002";

/// A statement that can never run.
pub const UNREACHABLE_CODE: String = "W0003";

/// A `match` arm that can never match because earlier arms cover its values.
pub const UNREACHABLE_PATTERN: String = "W0004";

/// A `use` whose name is never used.
pub const UNUSED_IMPORT: String = "W0005";

/// A type in the signature or fields of an item that is visible in more places than the type.
pub const PRIVATE_INTERFACE: String = "W0006";

/// An `unsafe` block without unsafe operations.
pub const UNUSED_UNSAFE: String = "W0007";

/// A closure stored in a field of the object it captures: a reference cycle ARC never frees.
pub const CLOSURE_CYCLE: String = "W0008";

/// A `Task` discarded by an expression statement, which neither awaits it nor keeps it.
pub const UNUSED_TASK: String = "W0009";
