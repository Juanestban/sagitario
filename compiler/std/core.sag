//! `std::core`: the core of the runtime, in Sagitario (docs/adr/0110-the-core-in-sagitario.md).
//! The generated code calls these functions by the C symbols `@export` gives them, which
//! `runtime/sagitario_runtime.h` declares; every program compiles this module, and only the
//! modules of `std` can name it.
//!
//! The core implements what Sagitario code relies on, reference counting among it, so it never
//! uses a type with a reference count (`String`, `List`, classes, function and interface values):
//! the values of those types are their C layouts here, `@repr(C)` structs reached through raw
//! pointers (Q782). The harness checks it.

use std::ffi::c_void;

extern "C" {
  fn memcpy(target: *mut c_void, source: *const c_void, count: usize) -> *mut c_void;
}

// ---- Layouts ------------------------------------------------------------------------------------

/// A `String`: `sag_string` of the runtime's header (Q789). `buf` owns the bytes and holds the
/// count; it is null for literals and the empty string.
@repr(C)
pub struct RawString {
  pub ptr: *const u8;
  pub len: usize;
  pub buf: *mut c_void;
}

// ---- Hashing and order ----------------------------------------------------------------------

/// The hash of a string's bytes: FNV-1a.
@export("sag_string_hash")
extern "C" fn string_hash(text: RawString) -> u64 {
  var hash = 0xcbf29ce484222325u64;

  for index in 0..text.len {
    const byte = unsafe { *text.ptr.add(index) };

    hash = (hash ^ byte as u64).wrapping_mul(0x100000001b3);
  }

  hash
}

/// The bits of a float as an unsigned key in the same total order: negative values reversed below
/// the positive ones.
fn total_key64(bits: u64) -> u64 {
  if bits >> 63 != 0 { !bits } else { bits | 1u64 << 63 }
}

fn total_key32(bits: u32) -> u32 {
  if bits >> 31 != 0 { !bits } else { bits | 1u32 << 31 }
}

/// -1, 0 or 1 by the order of their keys.
fn compare_keys(x: u64, y: u64) -> i32 {
  if x < y { -1 } else if x > y { 1 } else { 0 }
}

/// -1, 0 or 1 by the IEEE 754 total order: -NaN < -inf < ... < -0 < +0 < ... < inf < NaN.
@export("sag_f32_total_compare")
extern "C" fn f32_total_compare(a: f32, b: f32) -> i32 {
  var x = 0u32;
  var y = 0u32;

  // The bits through `memcpy`, as C reads the bits of another type.
  unsafe {
    memcpy(&raw mut x as *mut c_void, &raw const a as *const c_void, 4);
    memcpy(&raw mut y as *mut c_void, &raw const b as *const c_void, 4);
  }

  compare_keys(total_key32(x) as u64, total_key32(y) as u64)
}

@export("sag_f64_total_compare")
extern "C" fn f64_total_compare(a: f64, b: f64) -> i32 {
  var x = 0u64;
  var y = 0u64;

  unsafe {
    memcpy(&raw mut x as *mut c_void, &raw const a as *const c_void, 8);
    memcpy(&raw mut y as *mut c_void, &raw const b as *const c_void, 8);
  }

  compare_keys(total_key64(x), total_key64(y))
}
