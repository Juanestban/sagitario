  pub fn fetch_update(self, set_order: Ordering, fetch_order: Ordering, f: fn(u64) -> Option<u64>) -> Result<u64, u64> {
    var previous = self.load(fetch_order);

    while let Some(next) = f(previous) {
      match self.compare_exchange_weak(previous, next, set_order, fetch_order) {
        Ok(found) => return Ok(found),
        Err(found) => {
          previous = found;
        }
      }
    }

    Err(previous)
  }
}

/// An `usize` that threads read and change at once.
pub class AtomicUsize {
  prv const value: Atomic<usize>;

  pub fn new(self, value: usize) {
    self.value = Atomic::new(value);
  }

  pub fn load(self, order: Ordering) -> usize {
    self.value.load(load_code(order))
  }

  pub fn store(self, value: usize, order: Ordering) {
    self.value.store(value, store_code(order));
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: usize, order: Ordering) -> usize {
    self.value.swap(value, code(order))
  }

  /// Adds `value` and returns the previous value; the sum wraps around at the limits of `usize`.
  pub fn fetch_add(self, value: usize, order: Ordering) -> usize {
    self.value.fetch_add(value, code(order))
  }

  /// Subtracts `value` and returns the previous value; the difference wraps around at the limits of `usize`.
  pub fn fetch_sub(self, value: usize, order: Ordering) -> usize {
    self.value.fetch_sub(value, code(order))
  }

  /// Stores the value `&` `value` and returns the previous value.
  pub fn fetch_and(self, value: usize, order: Ordering) -> usize {
    self.value.fetch_and(value, code(order))
  }

  /// Stores the value `|` `value` and returns the previous value.
  pub fn fetch_or(self, value: usize, order: Ordering) -> usize {
    self.value.fetch_or(value, code(order))
  }

  /// Stores the value `^` `value` and returns the previous value.
  pub fn fetch_xor(self, value: usize, order: Ordering) -> usize {
    self.value.fetch_xor(value, code(order))
  }

  /// Stores `!(previous & value)` and returns the previous value.
  pub fn fetch_nand(self, value: usize, order: Ordering) -> usize {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, !(previous & value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the larger of the value and `value`, and returns the previous value.
  pub fn fetch_max(self, value: usize, order: Ordering) -> usize {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous.max(value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the smaller of the value and `value`, and returns the previous value.
  pub fn fetch_min(self, value: usize, order: Ordering) -> usize {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous.min(value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores `desired` if the value is `current`: `Ok(current)` if it did, `Err(actual)` if not.
  /// `success` orders the exchange, `failure` the load of a value that differs.
  pub fn compare_exchange(self, current: usize, desired: usize, success: Ordering, failure: Ordering) -> Result<usize, usize> {
    const failed = failure_code(failure);

    self.value.compare_exchange(current, desired, success_code(success, failure), failed)
  }

  /// As `compare_exchange`, but it may fail although the value is `current`, which is faster in a
  /// loop on some processors.
  pub fn compare_exchange_weak(self, current: usize, desired: usize, success: Ordering, failure: Ordering) -> Result<usize, usize> {
    const failed = failure_code(failure);

    self.value.compare_exchange_weak(current, desired, success_code(success, failure), failed)
  }

  /// Stores what `f` returns for the value while it returns `Some`, trying again if another
  /// thread changed the value in between: `Ok(previous)`, or `Err(previous)` once `f` gives
  /// `None`. `set_order` orders the store, `fetch_order` the loads.
  pub fn fetch_update(self, set_order: Ordering, fetch_order: Ordering, f: fn(usize) -> Option<usize>) -> Result<usize, usize> {
    var previous = self.load(fetch_order);

    while let Some(next) = f(previous) {
      match self.compare_exchange_weak(previous, next, set_order, fetch_order) {
        Ok(found) => return Ok(found),
        Err(found) => {
          previous = found;
        }
      }
    }

    Err(previous)
  }
}

/// A raw pointer that threads read and change at once, as Rust's `AtomicPtr`: what it points to
/// is read and written through `unsafe`, as any raw pointer's.
pub class AtomicPtr<T> {
  prv const value: Atomic<*mut T>;

  pub fn new(self, value: *mut T) {
    self.value = Atomic::new(value);
  }

  pub fn load(self, order: Ordering) -> *mut T {
    self.value.load(load_code(order))
  }

  pub fn store(self, value: *mut T, order: Ordering) {
    self.value.store(value, store_code(order));
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: *mut T, order: Ordering) -> *mut T {
    self.value.swap(value, code(order))
  }

  /// Stores `desired` if the value is `current`: `Ok(current)` if it did, `Err(actual)` if not.
  /// `success` orders the exchange, `failure` the load of a value that differs.
  pub fn compare_exchange(self, current: *mut T, desired: *mut T, success: Ordering, failure: Ordering) -> Result<*mut T, *mut T> {
    const failed = failure_code(failure);

    self.value.compare_exchange(current, desired, success_code(success, failure), failed)
  }

  /// As `compare_exchange`, but it may fail although the value is `current`, which is faster in a
  /// loop on some processors.
  pub fn compare_exchange_weak(self, current: *mut T, desired: *mut T, success: Ordering, failure: Ordering) -> Result<*mut T, *mut T> {
    const failed = failure_code(failure);

    self.value.compare_exchange_weak(current, desired, success_code(success, failure), failed)
  }

  /// Stores what `f` returns for the value while it returns `Some`, trying again if another
  /// thread changed the value in between: `Ok(previous)`, or `Err(previous)` once `f` gives
  /// `None`. `set_order` orders the store, `fetch_order` the loads.
  pub fn fetch_update(self, set_order: Ordering, fetch_order: Ordering, f: fn(*mut T) -> Option<*mut T>) -> Result<*mut T, *mut T> {
    var previous = self.load(fetch_order);

    while let Some(next) = f(previous) {
      match self.compare_exchange_weak(previous, next, set_order, fetch_order) {
        Ok(found) => return Ok(found),
        Err(found) => {
          previous = found;
        }
      }
    }

    Err(previous)
  }
}
