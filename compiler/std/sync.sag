//! `std::sync`: values that threads share safely (docs/spec/11-standard-library.md#stdsync).
//!
//! `Mutex` and `Channel` hold a `std::sys::Lock`, the lock and condition of each system, and an
//! atomic holds its value in a field of type `std::sys::Atomic`, which the compiler provides
//! (docs/adr/0087-atomic-storage-and-std-sync.md), with the orderings of Rust
//! (docs/adr/0098-locks-orderings-and-threads.md).

use std::sys;
use std::sys::Atomic;

/// A value that threads share, changed by one thread at a time. `T` must be `Send`, so that what
/// `get` returns can go on living in any thread.
pub class Mutex<T: Send> {
  prv const lock: sys::Lock;
  prv var value: T;

  pub fn new(self, value: T) {
    self.lock = new sys::Lock();
    self.value = value;
  }

  /// A copy of the value.
  pub fn get(self) -> T {
    self.lock.lock();
    const value = self.value;
    self.lock.unlock();
    value
  }

  /// Replaces the value.
  pub fn set(self, value: T) {
    self.lock.lock();
    self.value = value;
    self.lock.unlock();
  }

  /// Replaces the value with what `f` returns for it, while no other thread can use the mutex,
  /// and returns the new value. `f` must not use this mutex: that panics.
  pub fn update(self, f: fn(T) -> T) -> T {
    self.lock.lock();
    const next = f(self.value);
    self.value = next;
    self.lock.unlock();
    next
  }
}

/// A queue of values that threads send to each other, without a limit. `receive` waits for a
/// value; once the channel is closed and empty it returns `None`.
pub class Channel<T: Send> {
  prv const lock: sys::Lock;
  /// Values sent, the newest last.
  prv const inbox: List<T>;
  /// Values to receive, the next one last.
  prv const outbox: List<T>;
  prv var closed: bool;
  /// The receivers waiting for a value: a send wakes them only when there are some, since a wake
  /// is a call to the system (docs/adr/0090-benchmarks.md).
  prv var waiting: usize;

  pub fn new(self) {
    self.lock = new sys::Lock();
    self.inbox = new List();
    self.outbox = new List();
    self.closed = false;
    self.waiting = 0;
  }

  /// Adds `value` at the end of the queue. Sending on a closed channel panics.
  pub fn send(self, value: T) {
    self.lock.lock();

    if self.closed {
      self.lock.unlock();
      panic("send on a closed channel");
    }

    self.inbox.push(value);

    if self.waiting > 0 {
      self.lock.notify_all();
    }

    self.lock.unlock();
  }

  /// The value at the front of the queue, waiting until there is one; `None` once the channel
  /// is closed and empty.
  pub fn receive(self) -> Option<T> {
    self.lock.lock();

    while self.outbox.is_empty() {
      if !self.inbox.is_empty() {
        // The oldest value of the inbox ends up last in the outbox.
        while move_newest(self.inbox, self.outbox) {}
      } else if self.closed {
        self.lock.unlock();
        return None;
      } else {
        self.waiting += 1;
        self.lock.wait();
        self.waiting -= 1;
      }
    }

    const value = self.outbox.pop();

    self.lock.unlock();
    value
  }

  /// No more values can be sent; those already sent are still received. Closing it again does
  /// nothing.
  pub fn close(self) {
    self.lock.lock();
    self.closed = true;
    self.lock.notify_all();
    self.lock.unlock();
  }

  /// The values received one by one, until the channel is closed and empty:
  /// `for value in channel.iter() { ... }`.
  pub fn iter(self) -> Iter<T> {
    new Iter<T>(() => self.receive())
  }
}

/// Moves the newest value of `from` to the end of `to`; false when `from` is empty.
fn move_newest<T>(from: List<T>, to: List<T>) -> bool {
  match from.pop() {
    Some(value) => {
      to.push(value);
      true
    }
    None => false,
  }
}

// ---- Atomics (docs/adr/0098-locks-orderings-and-threads.md, Q676 and Q677) ----------------------

/// How an atomic operation orders the memory operations around it, as Rust's
/// `std::sync::atomic::Ordering`. Written `sync::Ordering`, or imported, which hides the prelude's
/// `Ordering` of comparisons.
pub enum Ordering {
  /// Only the operation itself is atomic.
  Relaxed,
  /// The writes before it are seen by a thread that reads its value with `Acquire`.
  Release,
  /// It sees the writes made before a `Release` whose value it reads.
  Acquire,
  /// Both `Acquire` and `Release`, for an operation that reads and writes.
  AcqRel,
  /// `AcqRel`, and every thread sees all `SeqCst` operations in one order.
  SeqCst,
}

/// The number of an ordering for `std::sys::Atomic`.
fn code(order: Ordering) -> i32 {
  match order {
    Ordering::Relaxed => 0,
    Ordering::Release => 1,
    Ordering::Acquire => 2,
    Ordering::AcqRel => 3,
    Ordering::SeqCst => 4,
  }
}

/// A load may not release, as Rust's says.
fn load_code(order: Ordering) -> i32 {
  match order {
    Ordering::Release => panic("there is no such thing as a release load"),
    Ordering::AcqRel => panic("there is no such thing as an acquire-release load"),
    _ => code(order),
  }
}

/// A store may not acquire.
fn store_code(order: Ordering) -> i32 {
  match order {
    Ordering::Acquire => panic("there is no such thing as an acquire store"),
    Ordering::AcqRel => panic("there is no such thing as an acquire-release store"),
    _ => code(order),
  }
}

/// What a failed compare-exchange does is a load.
fn failure_code(order: Ordering) -> i32 {
  match order {
    Ordering::Release => panic("there is no such thing as a release failure ordering"),
    Ordering::AcqRel => panic("there is no such thing as an acquire-release failure ordering"),
    _ => code(order),
  }
}

/// The ordering of a compare-exchange that succeeds. C11 wants it no weaker than the one of a
/// failure, which Rust does not: a stronger one keeps what both ask for.
fn success_code(success: Ordering, failure: Ordering) -> i32 {
  match failure {
    Ordering::SeqCst => 4,
    Ordering::Acquire => match success {
      Ordering::Relaxed => 2,
      Ordering::Release => 3,
      _ => code(success),
    },
    _ => code(success),
  }
}

/// A fence orders the memory operations around it without an atomic of its own, as Rust's
/// `std::sync::atomic::fence`. Panics with `Relaxed`, which would order nothing.
pub fn fence(order: Ordering) {
  if order == Ordering::Relaxed {
    panic("there is no such thing as a relaxed fence");
  }

  Atomic::fence(code(order));
}

/// A `bool` that threads read and change at once.
pub class AtomicBool {
  prv const value: Atomic<bool>;

  pub fn new(self, value: bool) {
    self.value = Atomic::new(value);
  }

  pub fn load(self, order: Ordering) -> bool {
    self.value.load(load_code(order))
  }

  pub fn store(self, value: bool, order: Ordering) {
    self.value.store(value, store_code(order));
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: bool, order: Ordering) -> bool {
    self.value.swap(value, code(order))
  }

  /// Stores `desired` if the value is `current`: `Ok(current)` if it did, `Err(actual)` if not.
  /// `success` orders the exchange, `failure` the load of a value that differs.
  pub fn compare_exchange(self, current: bool, desired: bool, success: Ordering, failure: Ordering) -> Result<bool, bool> {
    const failed = failure_code(failure);

    self.value.compare_exchange(current, desired, success_code(success, failure), failed)
  }

  /// As `compare_exchange`, but it may fail although the value is `current`, which is faster in a
  /// loop on some processors.
  pub fn compare_exchange_weak(self, current: bool, desired: bool, success: Ordering, failure: Ordering) -> Result<bool, bool> {
    const failed = failure_code(failure);

    self.value.compare_exchange_weak(current, desired, success_code(success, failure), failed)
  }

  /// Stores what `f` returns for the value while it returns `Some`, trying again if another
  /// thread changed the value in between: `Ok(previous)`, or `Err(previous)` once `f` gives
  /// `None`. `set_order` orders the store, `fetch_order` the loads.
  pub fn fetch_update(self, set_order: Ordering, fetch_order: Ordering, f: fn(bool) -> Option<bool>) -> Result<bool, bool> {
    var previous = self.load(fetch_order);

    while let Some(next) = f(previous) {
      match self.compare_exchange_weak(previous, next, set_order, fetch_order) {
        Ok(found) => return Ok(found),
        Err(found) => {
          previous = found;
        }
      }
    }

    Err(previous)
  }

  /// Stores the value `&&` `value` and returns the previous value.
  pub fn fetch_and(self, value: bool, order: Ordering) -> bool {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous && value, code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the value `||` `value` and returns the previous value.
  pub fn fetch_or(self, value: bool, order: Ordering) -> bool {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous || value, code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the value `!=` `value` and returns the previous value.
  pub fn fetch_xor(self, value: bool, order: Ordering) -> bool {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous != value, code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores `!(previous && value)` and returns the previous value.
  pub fn fetch_nand(self, value: bool, order: Ordering) -> bool {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, !(previous && value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the opposite of the value and returns the previous value.
  pub fn fetch_not(self, order: Ordering) -> bool {
    self.fetch_xor(true, order)
  }
}

/// An `i8` that threads read and change at once.
pub class AtomicI8 {
  prv const value: Atomic<i8>;

  pub fn new(self, value: i8) {
    self.value = Atomic::new(value);
  }

  pub fn load(self, order: Ordering) -> i8 {
    self.value.load(load_code(order))
  }

  pub fn store(self, value: i8, order: Ordering) {
    self.value.store(value, store_code(order));
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: i8, order: Ordering) -> i8 {
    self.value.swap(value, code(order))
  }

  /// Adds `value` and returns the previous value; the sum wraps around at the limits of `i8`.
  pub fn fetch_add(self, value: i8, order: Ordering) -> i8 {
    self.value.fetch_add(value, code(order))
  }

  /// Subtracts `value` and returns the previous value; the difference wraps around at the limits of `i8`.
  pub fn fetch_sub(self, value: i8, order: Ordering) -> i8 {
    self.value.fetch_sub(value, code(order))
  }

  /// Stores the value `&` `value` and returns the previous value.
  pub fn fetch_and(self, value: i8, order: Ordering) -> i8 {
    self.value.fetch_and(value, code(order))
  }

  /// Stores the value `|` `value` and returns the previous value.
  pub fn fetch_or(self, value: i8, order: Ordering) -> i8 {
    self.value.fetch_or(value, code(order))
  }

  /// Stores the value `^` `value` and returns the previous value.
  pub fn fetch_xor(self, value: i8, order: Ordering) -> i8 {
    self.value.fetch_xor(value, code(order))
  }

  /// Stores `!(previous & value)` and returns the previous value.
  pub fn fetch_nand(self, value: i8, order: Ordering) -> i8 {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, !(previous & value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the larger of the value and `value`, and returns the previous value.
  pub fn fetch_max(self, value: i8, order: Ordering) -> i8 {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous.max(value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores the smaller of the value and `value`, and returns the previous value.
  pub fn fetch_min(self, value: i8, order: Ordering) -> i8 {
    var previous = self.value.load(0);

    loop {
      match self.value.compare_exchange_weak(previous, previous.min(value), code(order), 0) {
        Ok(found) => return found,
        Err(found) => {
          previous = found;
        }
      }
    }
  }

  /// Stores `desired` if the value is `current`: `Ok(current)` if it did, `Err(actual)` if not.
  /// `success` orders the exchange, `failure` the load of a value that differs.
  pub fn compare_exchange(self, current: i8, desired: i8, success: Ordering, failure: Ordering) -> Result<i8, i8> {
    const failed = failure_code(failure);

    self.value.compare_exchange(current, desired, success_code(success, failure), failed)
  }

  /// As `compare_exchange`, but it may fail although the value is `current`, which is faster in a
  /// loop on some processors.
  pub fn compare_exchange_weak(self, current: i8, desired: i8, success: Ordering, failure: Ordering) -> Result<i8, i8> {
    const failed = failure_code(failure);

    self.value.compare_exchange_weak(current, desired, success_code(success, failure), failed)
  }

  /// Stores what `f` returns for the value while it returns `Some`, trying again if another
  /// thread changed the value in between: `Ok(previous)`, or `Err(previous)` once `f` gives
  /// `None`. `set_order` orders the store, `fetch_order` the loads.
  pub fn fetch_update(self, set_order: Ordering, fetch_order: Ordering, f: fn(i8) -> Option<i8>) -> Result<i8, i8> {
    var previous = self.load(fetch_order);

    while let Some(next) = f(previous) {
      match self.compare_exchange_weak(previous, next, set_order, fetch_order) {
        Ok(found) => return Ok(found),
        Err(found) => {
          previous = found;
        }
      }
    }

    Err(previous)
  }
}

