//! `std::sync`: values that threads share safely (docs/spec/11-standard-library.md#stdsync).
//!
//! `Mutex` and `Channel` hold a `std::sys::Lock`, the lock and condition of each system, and an
//! atomic holds its value in a field of type `std::sys::Atomic`, which the compiler provides
//! (docs/adr/0087-atomic-storage-and-std-sync.md).

use std::sys;
use std::sys::Atomic;

/// A value that threads share, changed by one thread at a time. `T` must be `Send`, so that what
/// `get` returns can go on living in any thread.
pub class Mutex<T: Send> {
  prv const lock: sys::Lock;
  prv var value: T;

  pub fn new(self, value: T) {
    self.lock = new sys::Lock();
    self.value = value;
  }

  /// A copy of the value.
  pub fn get(self) -> T {
    self.lock.lock();
    const value = self.value;
    self.lock.unlock();
    value
  }

  /// Replaces the value.
  pub fn set(self, value: T) {
    self.lock.lock();
    self.value = value;
    self.lock.unlock();
  }

  /// Replaces the value with what `f` returns for it, while no other thread can use the mutex,
  /// and returns the new value. `f` must not use this mutex: that panics.
  pub fn update(self, f: fn(T) -> T) -> T {
    self.lock.lock();
    const next = f(self.value);
    self.value = next;
    self.lock.unlock();
    next
  }
}

/// A queue of values that threads send to each other, without a limit. `receive` waits for a
/// value; once the channel is closed and empty it returns `None`.
pub class Channel<T: Send> {
  prv const lock: sys::Lock;
  /// Values sent, the newest last.
  prv const inbox: List<T>;
  /// Values to receive, the next one last.
  prv const outbox: List<T>;
  prv var closed: bool;
  /// The receivers waiting for a value: a send wakes them only when there are some, since a wake
  /// is a call to the system (docs/adr/0090-benchmarks.md).
  prv var waiting: usize;

  pub fn new(self) {
    self.lock = new sys::Lock();
    self.inbox = new List();
    self.outbox = new List();
    self.closed = false;
    self.waiting = 0;
  }

  /// Adds `value` at the end of the queue. Sending on a closed channel panics.
  pub fn send(self, value: T) {
    self.lock.lock();

    if self.closed {
      self.lock.unlock();
      panic("send on a closed channel");
    }

    self.inbox.push(value);

    if self.waiting > 0 {
      self.lock.notify_all();
    }

    self.lock.unlock();
  }

  /// The value at the front of the queue, waiting until there is one; `None` once the channel
  /// is closed and empty.
  pub fn receive(self) -> Option<T> {
    self.lock.lock();

    while self.outbox.is_empty() {
      if !self.inbox.is_empty() {
        // The oldest value of the inbox ends up last in the outbox.
        while move_newest(self.inbox, self.outbox) {}
      } else if self.closed {
        self.lock.unlock();
        return None;
      } else {
        self.waiting += 1;
        self.lock.wait();
        self.waiting -= 1;
      }
    }

    const value = self.outbox.pop();

    self.lock.unlock();
    value
  }

  /// No more values can be sent; those already sent are still received. Closing it again does
  /// nothing.
  pub fn close(self) {
    self.lock.lock();
    self.closed = true;
    self.lock.notify_all();
    self.lock.unlock();
  }

  /// The values received one by one, until the channel is closed and empty:
  /// `for value in channel.iter() { ... }`.
  pub fn iter(self) -> Iter<T> {
    new Iter<T>(() => self.receive())
  }
}

/// Moves the newest value of `from` to the end of `to`; false when `from` is empty.
fn move_newest<T>(from: List<T>, to: List<T>) -> bool {
  match from.pop() {
    Some(value) => {
      to.push(value);
      true
    }
    None => false,
  }
}

/// A `bool` that threads read and change at once.
pub class AtomicBool {
  prv const value: Atomic<bool>;

  pub fn new(self, value: bool) {
    self.value = Atomic::new(value);
  }

  pub fn load(self) -> bool {
    self.value.load()
  }

  pub fn store(self, value: bool) {
    self.value.store(value);
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: bool) -> bool {
    self.value.swap(value)
  }

  /// Stores `desired` if the value is `expected`: `Ok(expected)` if it did, `Err(actual)` if not.
  pub fn compare_exchange(self, expected: bool, desired: bool) -> Result<bool, bool> {
    self.value.compare_exchange(expected, desired)
  }
}

/// An `i32` that threads read and change at once.
pub class AtomicI32 {
  prv const value: Atomic<i32>;

  pub fn new(self, value: i32) {
    self.value = Atomic::new(value);
  }

  pub fn load(self) -> i32 {
    self.value.load()
  }

  pub fn store(self, value: i32) {
    self.value.store(value);
  }

  /// Stores `value` and returns the previous value.
  pub fn swap(self, value: i32) -> i32 {
    self.value.swap(value)
  }

  /// Adds `n` and returns the previous value; the sum wraps around at the limits of `i32`.
  pub fn fetch_add(self, n: i32) -> i32 {
    self.value.fetch_add(n)
  }

  /// Subtracts `n` and returns the previous value; the difference wraps around at the limits of
  /// `i32`.
  pub fn fetch_sub(self, n: i32) -> i32 {
    self.value.fetch_sub(n)
  }

  /// Stores `desired` if the value is `expected`: `Ok(expected)` if it did, `Err(actual)` if not.
  pub fn compare_exchange(self, expected: i32, desired: i32) -> Result<i32, i32> {
    self.value.compare_exchange(expected, desired)
  }
}

