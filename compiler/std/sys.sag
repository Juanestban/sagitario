//! `std::sys`: the C API of each system that the standard library is written on, and the code that
//! differs by system, as Rust's `std/src/sys` (docs/adr/0085-conditional-compilation-and-std-time.md,
//! Q551). Only the modules of `std` can name it.

use std::ffi::{c_char, c_int, c_void, string_from_c, CString};
@cfg(windows)
use std::mem;
@cfg(unix)
use std::ffi::c_long;
use std::sys::Atomic;

// ---- errno ------------------------------------------------------------------------------------

@cfg(target_os = "linux")
extern "C" {
  fn __errno_location() -> *mut c_int;
}

@cfg(target_os = "android")
extern "C" {
  fn __errno() -> *mut c_int;
}

@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  fn __error() -> *mut c_int;
}

@cfg(windows)
extern "C" {
  fn _errno() -> *mut c_int;
}

/// Where C's `errno` is for this thread: a macro reaching a function whose name changes with the
/// C library.
@cfg(target_os = "linux")
fn errno_place() -> *mut c_int {
  unsafe { __errno_location() }
}

@cfg(target_os = "android")
fn errno_place() -> *mut c_int {
  unsafe { __errno() }
}

@cfg(any(target_os = "macos", target_os = "ios"))
fn errno_place() -> *mut c_int {
  unsafe { __error() }
}

@cfg(windows)
fn errno_place() -> *mut c_int {
  unsafe { _errno() }
}

/// The error of the last call to the C library that failed in this thread.
pub fn errno() -> i32 {
  unsafe { *errno_place() }
}

pub fn clear_errno() {
  unsafe { *errno_place() = 0; }
}

extern "C" {
  fn strerror(code: c_int) -> *const c_char;
}

/// The C library's description of the `errno` value `code`; invalid UTF-8 becomes U+FFFD.
pub fn error_message(code: i32) -> String {
  unsafe { string_from_c(strerror(code)) }
}

/// A call interrupted by a signal, on every Unix system.
@cfg(unix)
const EINTR: i32 = 4;

// ---- Clocks and sleeping ----------------------------------------------------------------------

/// `struct timespec`, whose `time_t` has 64 bits, except on 32-bit Android.
@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
@repr(C)
pub struct Timespec {
  pub tv_sec: i64;
  pub tv_nsec: c_long;

  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: secs as i64, tv_nsec: nanos as c_long }
  }

  /// The nanoseconds it holds, or zero for a time before 1970.
  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

/// `struct timespec` on 32-bit Android, whose `time_t` has 32 bits.
@cfg(all(target_os = "android", target_pointer_width = "32"))
@repr(C)
pub struct Timespec {
  pub tv_sec: i32;
  pub tv_nsec: c_long;

  /// At most 2^31 - 1 seconds, about 68 years.
  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: if secs > 0x7FFF_FFFF { 0x7FFF_FFFF } else { secs as i32 }, tv_nsec: nanos as c_long }
  }

  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

@cfg(unix)
const CLOCK_REALTIME: c_int = 0;

@cfg(any(target_os = "linux", target_os = "android"))
const CLOCK_MONOTONIC: c_int = 1;

@cfg(any(target_os = "macos", target_os = "ios"))
const CLOCK_MONOTONIC: c_int = 6;

@cfg(unix)
extern "C" {
  fn clock_gettime(clock: c_int, now: *mut Timespec) -> c_int;
  fn nanosleep(duration: *const Timespec, left: *mut Timespec) -> c_int;
}

/// `FILETIME`: 100-nanosecond intervals since 1601-01-01, in two halves.
@cfg(windows)
@repr(C)
pub struct FileTime {
  pub low: u32;
  pub high: u32;
}

@cfg(windows)
extern "C" {
  fn QueryPerformanceCounter(count: *mut i64) -> c_int;
  fn QueryPerformanceFrequency(frequency: *mut i64) -> c_int;
  fn GetSystemTimePreciseAsFileTime(time: *mut FileTime);
  fn Sleep(milliseconds: u32);
}

/// A monotonic clock, in nanoseconds since a start that means nothing outside the program.
@cfg(unix)
pub fn monotonic_nanos() -> u64 {
  clock(CLOCK_MONOTONIC)
}

/// The system clock, in nanoseconds since 1970-01-01 00:00:00 UTC, or zero before it.
@cfg(unix)
pub fn system_nanos() -> u64 {
  clock(CLOCK_REALTIME)
}

@cfg(unix)
fn clock(id: c_int) -> u64 {
  var now = Timespec::of(0, 0);

  if unsafe { clock_gettime(id, &mut now) } != 0 {
    return 0;
  }

  now.nanos()
}

@cfg(windows)
pub fn monotonic_nanos() -> u64 {
  var count = 0i64;
  var frequency = 1i64;

  unsafe {
    QueryPerformanceCounter(&mut count);
    QueryPerformanceFrequency(&mut frequency);
  }

  if frequency <= 0 || count < 0 {
    return 0;
  }

  const ticks = count as u64;
  const rate = frequency as u64;

  // Split so that `ticks * 10^9` cannot overflow.
  ticks / rate * 1_000_000_000 + ticks % rate * 1_000_000_000 / rate
}

@cfg(windows)
pub fn system_nanos() -> u64 {
  var now = FileTime { low: 0, high: 0 };

  unsafe { GetSystemTimePreciseAsFileTime(&mut now); }

  // The Unix epoch is 11644473600 seconds after 1601-01-01.
  const intervals = now.high as u64 * 0x1_0000_0000 + now.low as u64;
  const epoch = 116_444_736_000_000_000u64;

  if intervals < epoch { 0 } else { (intervals - epoch) * 100 }
}

/// Pauses the calling thread for at least `nanos` nanoseconds, resuming after a signal.
@cfg(unix)
pub fn sleep_nanos(nanos: u64) {
  var left = Timespec::of(nanos / 1_000_000_000, nanos % 1_000_000_000);

  loop {
    const asked = left;

    if unsafe { nanosleep(&asked, &mut left) } == 0 || errno() != EINTR {
      return;
    }
  }
}

/// In whole milliseconds, rounded up so that the program never sleeps less than asked.
@cfg(windows)
pub fn sleep_nanos(nanos: u64) {
  var millis = nanos / 1_000_000 + if nanos % 1_000_000 != 0 { 1 } else { 0 };

  while millis > 0 {
    const part = if millis > 0x7FFF_FFFF { 0x7FFF_FFFFu64 } else { millis };

    unsafe { Sleep(part as u32); }
    millis -= part;
  }
}

// ---- Arguments and environment variables ------------------------------------------------------

/// What C's `main` received, which the runtime's core passes on when the program starts
/// (`std::env`, `sag_env_init`), as Rust's `lang_start` gives them to its `std`. The address of
/// `argv` is kept as a number, so that the static is computed by the compiler.
@cfg(unix)
static var ARGC: c_int = 0;

@cfg(unix)
static var ARGV: usize = 0;

@cfg(unix)
extern "C" {
  fn getenv(name: *const c_char) -> *const c_char;
}

@cfg(unix)
pub fn set_args(argc: c_int, argv: *const *const c_char) {
  unsafe {
    ARGC = argc;
    ARGV = argv as usize;
  }
}

/// Windows reads its own command line, as UTF-16.
@cfg(windows)
pub fn set_args(_argc: c_int, _argv: *const *const c_char) {
  // C's `argv` is in the ANSI code page, not UTF-16.
}

/// The arguments C's `main` received; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn args() -> List<String> {
  const args = new List<String>();
  const count = unsafe { ARGC };
  const argv = unsafe { ARGV } as *const *const c_char;

  if argv.is_null() || count <= 0 {
    return args;
  }

  for index in 0..count as usize {
    const arg = unsafe { *argv.add(index) };

    if arg.is_null() {
      break;
    }

    args.push(unsafe { string_from_c(arg) });
  }

  args
}

/// The value of an environment variable; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn variable(name: String) -> Option<String> {
  const c_name = match CString::new(name) {
    Ok(found) => found,
    Err(_) => return None,
  };
  const value = unsafe { getenv(c_name.as_ptr()) };

  if value.is_null() { None } else { Some(unsafe { string_from_c(value) }) }
}

@cfg(windows)
extern "C" {
  fn GetCommandLineW() -> *const u16;
  fn GetEnvironmentVariableW(name: *const u16, buffer: *mut u16, size: u32) -> u32;
}

@cfg(windows)
const QUOTE: u16 = 0x22;
@cfg(windows)
const BACKSLASH: u16 = 0x5C;
@cfg(windows)
const SPACE: u16 = 0x20;
@cfg(windows)
const TAB: u16 = 0x09;

/// The code unit `at` of a NUL-terminated UTF-16 text.
@cfg(windows)
fn unit(text: *const u16, at: usize) -> u16 {
  unsafe { *text.add(at) }
}

/// The arguments, split from the command line with the rules of Microsoft's C runtime.
@cfg(windows)
pub fn args() -> List<String> {
  const args = new List<String>();
  const line = unsafe { GetCommandLineW() };

  if line.is_null() {
    return args;
  }

  const arg = new List<u16>();
  var at = 0usize;

  // The program ends at the first space, or at the closing quote; backslashes are kept.
  if unit(line, at) == QUOTE {
    at += 1;

    while unit(line, at) != 0 && unit(line, at) != QUOTE {
      arg.push(unit(line, at));
      at += 1;
    }

    if unit(line, at) == QUOTE {
      at += 1;
    }
  } else {
    while unit(line, at) != 0 && unit(line, at) != SPACE && unit(line, at) != TAB {
      arg.push(unit(line, at));
      at += 1;
    }
  }

  args.push(from_utf16_lossy(&arg));

  loop {
    while unit(line, at) == SPACE || unit(line, at) == TAB {
      at += 1;
    }

    if unit(line, at) == 0 {
      return args;
    }

    var quoted = false;

    arg.clear();

    while unit(line, at) != 0 && (quoted || (unit(line, at) != SPACE && unit(line, at) != TAB)) {
      const c = unit(line, at);

      if c == BACKSLASH {
        var slashes = 0usize;

        while unit(line, at) == BACKSLASH {
          slashes += 1;
          at += 1;
        }

        // 2n backslashes and a quote: n backslashes, and the quote delimits. 2n + 1: n
        // backslashes and a literal quote. Backslashes elsewhere are literal.
        const kept = if unit(line, at) == QUOTE { slashes / 2 } else { slashes };

        for _ in 0..kept {
          arg.push(BACKSLASH);
        }

        if unit(line, at) == QUOTE && slashes % 2 == 1 {
          arg.push(QUOTE);
          at += 1;
        }
      } else if c == QUOTE {
        if quoted && unit(line, at + 1) == QUOTE {
          arg.push(QUOTE);
          at += 2;
        } else {
          quoted = !quoted;
          at += 1;
        }
      } else {
        arg.push(c);
        at += 1;
      }
    }

    args.push(from_utf16_lossy(&arg));
  }
}

/// The value of an environment variable, read as UTF-16.
@cfg(windows)
pub fn variable(name: String) -> Option<String> {
  const wide = to_utf16(name);
  // Without a buffer, the size it needs with its terminator; 0 when the variable is not set.
  const size = unsafe { GetEnvironmentVariableW(wide.as_ptr(), 0 as *mut u16, 0) };

  if size == 0 {
    return None;
  }

  const value = new List<u16>();

  value.resize(size as usize, 0);

  const written = unsafe { GetEnvironmentVariableW(wide.as_ptr(), value.as_mut_ptr(), size) };

  // The variable grew in between.
  if written >= size {
    return None;
  }

  Some(from_utf16_lossy(&value[0..written as usize]))
}

/// UTF-16 code units as a string; an unpaired surrogate becomes U+FFFD.
@cfg(windows)
pub fn from_utf16_lossy(units: &[u16]) -> String {
  const text = new StringBuilder();
  var index = 0usize;

  while index < units.len() {
    var code = units[index] as u32;

    index += 1;

    if code >= 0xD800 && code <= 0xDBFF && index < units.len() && units[index] as u32 >= 0xDC00 && units[index] as u32 <= 0xDFFF {
      code = 0x10000 + ((code - 0xD800) << 10) + (units[index] as u32 - 0xDC00);
      index += 1;
    } else if code >= 0xD800 && code <= 0xDFFF {
      code = 0xFFFD;
    }

    text.append_char(char::from_u32(code).unwrap_or('?'));
  }

  text.to_string()
}

/// A string as NUL-terminated UTF-16.
@cfg(windows)
pub fn to_utf16(text: String) -> List<u16> {
  const units = new List<u16>();

  for c in text.chars() {
    const code = c as u32;

    if code >= 0x10000 {
      units.push((0xD800 + ((code - 0x10000) >> 10)) as u16);
      units.push((0xDC00 + ((code - 0x10000) & 0x3FF)) as u16);
    } else {
      units.push(code as u16);
    }
  }

  units.push(0);
  units
}

// ---- The standard streams ---------------------------------------------------------------------

/// C's streams, through which the runtime's core prints too, so that both write in order and the
/// C library locks them for threads (docs/adr/0086-c-globals-and-std-io.md, Q564).
@cfg(any(target_os = "linux", target_os = "android"))
extern "C" {
  static stdin: *mut c_void;
  static stdout: *mut c_void;
  static stderr: *mut c_void;
}

@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  static __stdinp: *mut c_void;
  static __stdoutp: *mut c_void;
  static __stderrp: *mut c_void;
}

@cfg(windows)
extern "C" {
  fn __acrt_iob_func(index: u32) -> *mut c_void;
}

extern "C" {
  pub fn fwrite(data: *const u8, size: usize, count: usize, stream: *mut c_void) -> usize;
  pub fn fputc(c: c_int, stream: *mut c_void) -> c_int;
  pub fn fflush(stream: *mut c_void) -> c_int;
  pub fn getc(stream: *mut c_void) -> c_int;
  pub fn fread(data: *mut u8, size: usize, count: usize, stream: *mut c_void) -> usize;
  pub fn ferror(stream: *mut c_void) -> c_int;
  pub fn clearerr(stream: *mut c_void);
}

/// C's `FILE *` of a standard stream: 0 is stdin, 1 stdout and 2 stderr.
@cfg(any(target_os = "linux", target_os = "android"))
pub fn stream(index: i32) -> *mut c_void {
  unsafe { if index == 0 { stdin } else if index == 1 { stdout } else { stderr } }
}

@cfg(any(target_os = "macos", target_os = "ios"))
pub fn stream(index: i32) -> *mut c_void {
  unsafe { if index == 0 { __stdinp } else if index == 1 { __stdoutp } else { __stderrp } }
}

@cfg(windows)
pub fn stream(index: i32) -> *mut c_void {
  unsafe { __acrt_iob_func(index as u32) }
}

/// The lock of a C stream, which each of its functions takes too, so that a series of writes
/// holding it is not interleaved with other threads' (docs/adr/0096-streams-files-and-drop.md,
/// Q660).
@cfg(unix)
extern "C" {
  fn flockfile(stream: *mut c_void);
  fn funlockfile(stream: *mut c_void);
}

@cfg(windows)
extern "C" {
  fn _lock_file(stream: *mut c_void);
  fn _unlock_file(stream: *mut c_void);
}

@cfg(unix)
pub fn lock_stream(index: i32) {
  unsafe { flockfile(stream(index)); }
}

@cfg(unix)
pub fn unlock_stream(index: i32) {
  unsafe { funlockfile(stream(index)); }
}

@cfg(windows)
pub fn lock_stream(index: i32) {
  unsafe { _lock_file(stream(index)); }
}

@cfg(windows)
pub fn unlock_stream(index: i32) {
  unsafe { _unlock_file(stream(index)); }
}

@cfg(unix)
extern "C" {
  fn isatty(fd: c_int) -> c_int;
}

/// Whether the standard stream `index` is a terminal.
@cfg(unix)
pub fn is_terminal(index: i32) -> bool {
  (unsafe { isatty(index) }) != 0
}

@cfg(windows)
extern "C" {
  fn GetStdHandle(which: u32) -> *mut c_void;
  fn GetConsoleMode(console: *mut c_void, mode: *mut u32) -> c_int;
}

/// A console, which has a console mode: the C library's `_isatty` also says yes for `NUL` and
/// other character devices.
@cfg(windows)
pub fn is_terminal(index: i32) -> bool {
  // STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and STD_ERROR_HANDLE are -10, -11 and -12.
  const handle = unsafe { GetStdHandle((-10 - index) as u32) };
  var mode = 0u32;

  if handle.is_null() || handle as usize == 0xFFFF_FFFF_FFFF_FFFF {
    return false;
  }

  (unsafe { GetConsoleMode(handle, &mut mode) }) != 0
}

// ---- Files and directories --------------------------------------------------------------------

/// `errno` values that `std::fs` reports itself. They are the same on every supported system,
/// except `ENOTEMPTY`.
pub const ENOENT: i32 = 2;
pub const ENOTDIR: i32 = 20;
pub const EISDIR: i32 = 21;
pub const EINVAL: i32 = 22;

@cfg(any(target_os = "linux", target_os = "android"))
pub const ENOTEMPTY: i32 = 39;
@cfg(any(target_os = "macos", target_os = "ios"))
pub const ENOTEMPTY: i32 = 66;
@cfg(windows)
pub const ENOTEMPTY: i32 = 41;

/// What a path names, as `std::fs` asks it.
pub const KIND_MISSING: i32 = 0;
pub const KIND_FILE: i32 = 1;
pub const KIND_DIR: i32 = 2;
pub const KIND_OTHER: i32 = 3;

@cfg(unix)
const EEXIST: i32 = 17;
@cfg(unix)
const ERANGE: i32 = 34;

@cfg(unix)
extern "C" {
  fn fopen(path: *const c_char, mode: *const c_char) -> *mut c_void;
  fn fclose(file: *mut c_void) -> c_int;
  fn mkdir(path: *const c_char, mode: u32) -> c_int;
  fn rmdir(path: *const c_char) -> c_int;
  fn unlink(path: *const c_char) -> c_int;
  fn rename(from: *const c_char, to: *const c_char) -> c_int;
  fn getcwd(buffer: *mut c_char, size: usize) -> *mut c_char;
  fn opendir(path: *const c_char) -> *mut c_void;
  fn readdir(dir: *mut c_void) -> *const u8;
  fn closedir(dir: *mut c_void) -> c_int;
  fn stat(path: *const c_char, info: *mut StatBuffer) -> c_int;
}

/// Room for C's `struct stat` on every system, read at the offset of its `st_mode`. On macOS for
/// Intel, `stat` and `readdir` are the symbols of 32-bit inodes, which Apple still exports: the
/// 64-bit ones are named `stat$INODE64` and `readdir$INODE64`, which C cannot name.
@cfg(unix)
@repr(C)
struct StatBuffer {
  pub words: [u64; 32];
}

/// Where `st_mode` is in `struct stat`, and how many bytes it has.
@cfg(all(any(target_os = "linux", target_os = "android"), target_arch = "x86_64"))
const MODE_OFFSET: usize = 24;
@cfg(all(any(target_os = "linux", target_os = "android"), not(target_arch = "x86_64")))
const MODE_OFFSET: usize = 16;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const MODE_OFFSET: usize = 4;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const MODE_OFFSET: usize = 8;

@cfg(any(target_os = "linux", target_os = "android"))
const MODE_BYTES: usize = 4;
@cfg(any(target_os = "macos", target_os = "ios"))
const MODE_BYTES: usize = 2;

/// Where `d_name` is in `struct dirent`.
@cfg(any(target_os = "linux", target_os = "android"))
const NAME_OFFSET: usize = 19;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const NAME_OFFSET: usize = 21;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const NAME_OFFSET: usize = 8;

/// `path` as a C string, or `None` if it holds a NUL.
@cfg(unix)
fn c_path(path: String) -> Option<CString> {
  match CString::new(path) {
    Ok(found) => Some(found),
    Err(_) => None,
  }
}

/// The code of the last failed call of the C library.
@cfg(unix)
fn failure() -> i32 {
  super::last_error()
}

@cfg(unix)
pub fn path_kind(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return KIND_MISSING,
  };
  var info = StatBuffer { words: [0u64; 32] };

  if unsafe { stat(name.as_ptr(), &mut info) } != 0 {
    return KIND_MISSING;
  }

  const at = unsafe { (&raw const info as *const u8).add(MODE_OFFSET) };
  const mode = if MODE_BYTES == 2 { (unsafe { *(at as *const u16) }) as u32 } else { unsafe { *(at as *const u32) } };
  // `S_IFMT`, the type: `S_IFDIR` is 0o040000, `S_IFREG` 0o100000.
  const file_type = (mode >> 12) & 0xF;

  if file_type == 4 {
    KIND_DIR
  } else if file_type == 8 {
    KIND_FILE
  } else {
    KIND_OTHER
  }
}

/// The bytes of the file at `path`, or the code of the failure.
@cfg(unix)
pub fn read_file(path: String) -> Result<List<u8>, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  const mode = CString::new("rb").unwrap();

  clear_errno();

  const file = unsafe { fopen(name.as_ptr(), mode.as_ptr()) };

  if file.is_null() {
    return Err(failure());
  }

  const data = new List<u8>();

  loop {
    const start = data.len();

    data.resize(start + 4096, 0);

    const read = unsafe { fread(data.as_mut_ptr().add(start), 1, 4096, file) };

    data.resize(start + read, 0);

    if read == 0 {
      break;
    }
  }

  const failed = unsafe { ferror(file) } != 0;
  const code = if failed { failure() } else { 0 };

  unsafe { fclose(file); }

  if failed { Err(code) } else { Ok(data) }
}

/// Writes `len` bytes at `data` to the file at `path`, creating it, replacing it or appending.
@cfg(unix)
pub fn write_file(path: String, data: *const u8, len: usize, append: bool) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };
  const mode = CString::new(if append { "ab" } else { "wb" }).unwrap();

  clear_errno();

  const file = unsafe { fopen(name.as_ptr(), mode.as_ptr()) };

  if file.is_null() {
    return failure();
  }

  var code = 0;

  if len > 0 && unsafe { fwrite(data, 1, len, file) } != len {
    code = failure();
  }

  if unsafe { fclose(file) } != 0 && code == 0 {
    code = failure();
  }

  code
}

@cfg(unix)
pub fn create_dir(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  // 0o777, less the umask.
  if unsafe { mkdir(name.as_ptr(), 511) } == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn remove_dir(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  const code = if unsafe { rmdir(name.as_ptr()) } == 0 { 0 } else { failure() };

  // Some systems report a directory that is not empty as `EEXIST`.
  if code == EEXIST { ENOTEMPTY } else { code }
}

@cfg(unix)
pub fn remove_file(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  if unsafe { unlink(name.as_ptr()) } == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn rename_path(from: String, to: String) -> i32 {
  const source = match c_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match c_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  if unsafe { rename(source.as_ptr(), target.as_ptr()) } == 0 { 0 } else { failure() }
}

/// Copies the bytes of the file `from` to `to`, which is created or replaced.
@cfg(unix)
pub fn copy_file(from: String, to: String) -> i32 {
  match read_file(from) {
    Ok(data) => write_file(to, data.as_ptr(), data.len(), false),
    Err(code) => code,
  }
}

/// The names in the directory `path`, without `.` and `..`; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn read_dir(path: String) -> Result<List<String>, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };

  clear_errno();

  const dir = unsafe { opendir(name.as_ptr()) };

  if dir.is_null() {
    return Err(failure());
  }

  const names = new List<String>();

  loop {
    const entry = unsafe { readdir(dir) };

    if entry.is_null() {
      break;
    }

    const text = unsafe { string_from_c(entry.add(NAME_OFFSET) as *const c_char) };

    if text != "." && text != ".." {
      names.push(text);
    }
  }

  unsafe { closedir(dir); }
  Ok(names)
}

@cfg(unix)
pub fn current_dir() -> Result<String, i32> {
  var size = 256usize;

  loop {
    const buffer = new List<u8>();

    buffer.resize(size, 0);
    clear_errno();

    const found = unsafe { getcwd(buffer.as_mut_ptr() as *mut c_char, size) };

    if !found.is_null() {
      return Ok(unsafe { string_from_c(found as *const c_char) });
    }

    if errno() != ERANGE {
      return Err(failure());
    }

    size *= 2;
  }
}

/// `WIN32_FIND_DATAW`.
@cfg(windows)
@repr(C)
struct FindData {
  pub attributes: u32;
  pub created: FileTime;
  pub accessed: FileTime;
  pub written: FileTime;
  pub size_high: u32;
  pub size_low: u32;
  pub reserved0: u32;
  pub reserved1: u32;
  pub name: [u16; 260];
  pub alternate_name: [u16; 14];
}

@cfg(windows)
extern "C" {
  fn CreateFileW(name: *const u16, access: u32, share: u32, security: *mut c_void, disposition: u32, flags: u32, template_file: *mut c_void) -> *mut c_void;
  fn ReadFile(file: *mut c_void, buffer: *mut u8, size: u32, read: *mut u32, overlapped: *mut c_void) -> c_int;
  fn WriteFile(file: *mut c_void, buffer: *const u8, size: u32, written: *mut u32, overlapped: *mut c_void) -> c_int;
  fn CloseHandle(handle: *mut c_void) -> c_int;
  fn GetFileAttributesW(name: *const u16) -> u32;
  fn CreateDirectoryW(name: *const u16, security: *mut c_void) -> c_int;
  fn RemoveDirectoryW(name: *const u16) -> c_int;
  fn DeleteFileW(name: *const u16) -> c_int;
  fn MoveFileExW(from: *const u16, to: *const u16, flags: u32) -> c_int;
  fn CopyFileW(from: *const u16, to: *const u16, fail_if_exists: c_int) -> c_int;
  fn FindFirstFileW(pattern: *const u16, data: *mut FindData) -> *mut c_void;
  fn FindNextFileW(find: *mut c_void, data: *mut FindData) -> c_int;
  fn FindClose(find: *mut c_void) -> c_int;
  fn GetCurrentDirectoryW(size: u32, buffer: *mut u16) -> u32;
  fn GetLastError() -> u32;
}

/// `INVALID_HANDLE_VALUE`, -1.
@cfg(windows)
fn invalid(handle: *mut c_void) -> bool {
  handle as usize == 0xFFFF_FFFF_FFFF_FFFF
}

/// The `errno` value of the last Windows error, so that kinds and messages match other systems.
@cfg(windows)
fn failure() -> i32 {
  const error = unsafe { GetLastError() };

  if error == 2 || error == 3 || error == 15 || error == 161 {
    // ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND, ERROR_INVALID_DRIVE, ERROR_BAD_PATHNAME.
    ENOENT
  } else if error == 5 || error == 32 || error == 33 {
    // ERROR_ACCESS_DENIED, ERROR_SHARING_VIOLATION, ERROR_LOCK_VIOLATION: EACCES.
    13
  } else if error == 80 || error == 183 {
    // ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS: EEXIST.
    17
  } else if error == 87 || error == 123 {
    // ERROR_INVALID_PARAMETER, ERROR_INVALID_NAME.
    EINVAL
  } else if error == 145 {
    // ERROR_DIR_NOT_EMPTY.
    ENOTEMPTY
  } else if error == 267 {
    // ERROR_DIRECTORY.
    ENOTDIR
  } else if error == 8 || error == 14 {
    // ERROR_NOT_ENOUGH_MEMORY, ERROR_OUTOFMEMORY: ENOMEM.
    12
  } else if error == 39 || error == 112 {
    // ERROR_HANDLE_DISK_FULL, ERROR_DISK_FULL: ENOSPC.
    28
  } else {
    super::UNKNOWN
  }
}

/// `path` as NUL-terminated UTF-16, or `None` if it holds a NUL.
@cfg(windows)
fn wide_path(path: String) -> Option<List<u16>> {
  if path.contains("\0") { None } else { Some(to_utf16(path)) }
}

@cfg(windows)
pub fn path_kind(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return KIND_MISSING,
  };
  const attributes = unsafe { GetFileAttributesW(name.as_ptr()) };

  // INVALID_FILE_ATTRIBUTES, and FILE_ATTRIBUTE_DIRECTORY (0x10).
  if attributes == 0xFFFF_FFFF {
    KIND_MISSING
  } else if attributes & 0x10 != 0 {
    KIND_DIR
  } else {
    KIND_FILE
  }
}

@cfg(windows)
pub fn read_file(path: String) -> Result<List<u8>, i32> {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  // GENERIC_READ, sharing everything, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL.
  const file = unsafe { CreateFileW(name.as_ptr(), 0x8000_0000, 7, 0 as *mut c_void, 3, 0x80, 0 as *mut c_void) };

  if invalid(file) {
    return Err(failure());
  }

  const data = new List<u8>();
  var code = 0;

  loop {
    const start = data.len();
    var read = 0u32;

    data.resize(start + 4096, 0);

    const done = unsafe { ReadFile(file, data.as_mut_ptr().add(start), 4096, &mut read, 0 as *mut c_void) } != 0;

    data.resize(start + read as usize, 0);

    if !done {
      code = failure();
      break;
    }

    if read == 0 {
      break;
    }
  }

  unsafe { CloseHandle(file); }

  if code == 0 { Ok(data) } else { Err(code) }
}

@cfg(windows)
pub fn write_file(path: String, data: *const u8, len: usize, append: bool) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };
  // FILE_APPEND_DATA with OPEN_ALWAYS, or GENERIC_WRITE with CREATE_ALWAYS.
  const access = if append { 0x4u32 } else { 0x4000_0000u32 };
  const disposition = if append { 4u32 } else { 2u32 };
  const file = unsafe { CreateFileW(name.as_ptr(), access, 7, 0 as *mut c_void, disposition, 0x80, 0 as *mut c_void) };

  if invalid(file) {
    return failure();
  }

  var code = 0;
  var done = 0usize;

  while done < len {
    const left = len - done;
    const size = if left > 0x4000_0000 { 0x4000_0000u32 } else { left as u32 };
    var written = 0u32;

    if unsafe { WriteFile(file, data.add(done), size, &mut written, 0 as *mut c_void) } == 0 {
      code = failure();
      break;
    }

    done += written as usize;
  }

  if unsafe { CloseHandle(file) } == 0 && code == 0 {
    code = failure();
  }

  code
}

@cfg(windows)
pub fn create_dir(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { CreateDirectoryW(name.as_ptr(), 0 as *mut c_void) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn remove_dir(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { RemoveDirectoryW(name.as_ptr()) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn remove_file(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { DeleteFileW(name.as_ptr()) } != 0 { 0 } else { failure() }
}

/// Replaces the target, as POSIX does: MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED.
@cfg(windows)
pub fn rename_path(from: String, to: String) -> i32 {
  const source = match wide_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match wide_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { MoveFileExW(source.as_ptr(), target.as_ptr(), 3) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn copy_file(from: String, to: String) -> i32 {
  const source = match wide_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match wide_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { CopyFileW(source.as_ptr(), target.as_ptr(), 0) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn read_dir(path: String) -> Result<List<String>, i32> {
  if path.is_empty() {
    return Err(ENOENT);
  }

  // `path\*`, without doubling a trailing separator.
  const pattern = if path.ends_with("\\") || path.ends_with("/") { path + "*" } else { path + "\\*" };
  const name = match wide_path(pattern) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  var data = FindData {
    attributes: 0,
    created: FileTime { low: 0, high: 0 },
    accessed: FileTime { low: 0, high: 0 },
    written: FileTime { low: 0, high: 0 },
    size_high: 0,
    size_low: 0,
    reserved0: 0,
    reserved1: 0,
    name: [0u16; 260],
    alternate_name: [0u16; 14],
  };
  const find = unsafe { FindFirstFileW(name.as_ptr(), &mut data) };

  if invalid(find) {
    return Err(failure());
  }

  const names = new List<String>();

  loop {
    const units = new List<u16>();
    var at = 0usize;

    while at < 260 && data.name[at] != 0 {
      units.push(data.name[at]);
      at += 1;
    }

    const text = from_utf16_lossy(&units);

    if text != "." && text != ".." {
      names.push(text);
    }

    if unsafe { FindNextFileW(find, &mut data) } == 0 {
      break;
    }
  }

  unsafe { FindClose(find); }
  Ok(names)
}

@cfg(windows)
pub fn current_dir() -> Result<String, i32> {
  // Without a buffer, the size it needs with its terminator.
  const size = unsafe { GetCurrentDirectoryW(0, 0 as *mut u16) };

  if size == 0 {
    return Err(failure());
  }

  const buffer = new List<u16>();

  buffer.resize(size as usize, 0);

  const len = unsafe { GetCurrentDirectoryW(size, buffer.as_mut_ptr()) };

  if len == 0 {
    return Err(failure());
  }

  if len >= size {
    return Err(super::UNKNOWN);
  }

  Ok(from_utf16_lossy(&buffer[0..len as usize]))
}

// ---- Running programs -------------------------------------------------------------------------

/// How a program ended, and what it printed when it was captured.
pub struct Finished {
  /// Its exit code, or `None` if a signal ended it.
  pub code: Option<i32>;
  pub stdout: List<u8>;
  pub stderr: List<u8>;
}

/// `struct pollfd`, the same on every Unix system.
@cfg(unix)
@repr(C)
struct PollFd {
  pub fd: c_int;
  pub events: i16;
  pub revents: i16;
}

@cfg(unix)
const POLLIN: i16 = 1;
@cfg(unix)
const POLLOUT: i16 = 4;
@cfg(unix)
const SIGPIPE: c_int = 13;
@cfg(unix)
const X_OK: c_int = 1;

/// What one write to a pipe that `poll` found ready never blocks on: POSIX's least `PIPE_BUF`.
@cfg(unix)
const PIPE_BUF: usize = 512;

@cfg(unix)
extern "C" {
  fn close(fd: c_int) -> c_int;
  fn read(fd: c_int, buffer: *mut c_void, size: usize) -> isize;
  fn write(fd: c_int, buffer: *const c_void, size: usize) -> isize;
  fn access(path: *const c_char, mode: c_int) -> c_int;
  fn waitpid(pid: c_int, status: *mut c_int, options: c_int) -> c_int;
  fn signal(number: c_int, handler: Option<extern "C" fn(c_int)>) -> Option<extern "C" fn(c_int)>;
}

/// `nfds_t` is `unsigned long` in glibc and `unsigned int` in bionic and on Apple systems.
@cfg(target_os = "linux")
extern "C" {
  fn poll(fds: *mut PollFd, count: usize, timeout: c_int) -> c_int;
}

@cfg(any(target_os = "android", target_os = "macos", target_os = "ios"))
extern "C" {
  fn poll(fds: *mut PollFd, count: u32, timeout: c_int) -> c_int;
}

/// Waits without a time limit until one of the `count` descriptors at `fds` is ready.
@cfg(target_os = "linux")
fn wait_ready(fds: *mut PollFd, count: usize) -> c_int {
  unsafe { poll(fds, count, -1) }
}

@cfg(any(target_os = "android", target_os = "macos", target_os = "ios"))
fn wait_ready(fds: *mut PollFd, count: usize) -> c_int {
  unsafe { poll(fds, count as u32, -1) }
}

/// Linux and Android create pipes closed on `execve` in one call, and start programs with `fork`.
@cfg(any(target_os = "linux", target_os = "android"))
extern "C" {
  fn pipe2(fds: *mut c_int, flags: c_int) -> c_int;
  fn fork() -> c_int;
  fn dup2(from: c_int, to: c_int) -> c_int;
  fn chdir(path: *const c_char) -> c_int;
  fn execve(path: *const c_char, argv: *const *mut c_char, envp: *const *mut c_char) -> c_int;
  fn _exit(code: c_int);
  static environ: *const *mut c_char;
}

/// `O_CLOEXEC` on every architecture Sagitario supports.
@cfg(any(target_os = "linux", target_os = "android"))
const O_CLOEXEC: c_int = 0x80000;

/// Apple systems start programs with `posix_spawn`, whose option types are pointers there: setting
/// `FD_CLOEXEC` takes `fcntl`, which is variadic, and `POSIX_SPAWN_CLOEXEC_DEFAULT` closes every
/// descriptor the child is not given instead.
@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  fn pipe(fds: *mut c_int) -> c_int;
  fn _NSGetEnviron() -> *const *const *mut c_char;
  fn posix_spawn(pid: *mut c_int, path: *const c_char, actions: *const *mut c_void, attributes: *const *mut c_void, argv: *const *mut c_char, envp: *const *mut c_char) -> c_int;
  fn posix_spawn_file_actions_init(actions: *mut *mut c_void) -> c_int;
  fn posix_spawn_file_actions_destroy(actions: *mut *mut c_void) -> c_int;
  fn posix_spawn_file_actions_adddup2(actions: *mut *mut c_void, from: c_int, to: c_int) -> c_int;
  fn posix_spawn_file_actions_addinherit_np(actions: *mut *mut c_void, fd: c_int) -> c_int;
  fn posix_spawn_file_actions_addchdir_np(actions: *mut *mut c_void, path: *const c_char) -> c_int;
  fn posix_spawnattr_init(attributes: *mut *mut c_void) -> c_int;
  fn posix_spawnattr_destroy(attributes: *mut *mut c_void) -> c_int;
  fn posix_spawnattr_setflags(attributes: *mut *mut c_void, flags: i16) -> c_int;
}

@cfg(any(target_os = "macos", target_os = "ios"))
const POSIX_SPAWN_CLOEXEC_DEFAULT: i16 = 0x4000;

/// The environment of this program, as C's `environ`.
@cfg(any(target_os = "linux", target_os = "android"))
fn environment() -> *const *mut c_char {
  unsafe { environ }
}

/// Shared libraries on Apple systems cannot refer to `environ` directly.
@cfg(any(target_os = "macos", target_os = "ios"))
fn environment() -> *const *mut c_char {
  unsafe { *_NSGetEnviron() }
}

/// A pipe in `fds`, whose descriptors the child does not keep after `execve`.
@cfg(any(target_os = "linux", target_os = "android"))
fn open_pipe(fds: *mut c_int) -> bool {
  (unsafe { pipe2(fds, O_CLOEXEC) }) == 0
}

/// `posix_spawn` closes them in the child.
@cfg(any(target_os = "macos", target_os = "ios"))
fn open_pipe(fds: *mut c_int) -> bool {
  (unsafe { pipe(fds) }) == 0
}

@cfg(unix)
fn close_fd(fd: c_int) {
  if fd >= 0 {
    unsafe { close(fd); }
  }
}

/// The file `program` names: itself if it contains `/`, else the first executable file of that
/// name in the directories of `PATH`, where an empty directory is the current one.
@cfg(unix)
fn find_program(program: String) -> Option<CString> {
  if program.contains("/") {
    return c_path(program);
  }

  const path = variable("PATH").unwrap_or("/usr/local/bin:/usr/bin:/bin");

  for dir in path.split(":") {
    const candidate = if dir.is_empty() { `./${program}` } else { `${dir}/${program}` };

    if path_kind(candidate) == KIND_FILE {
      const name = c_path(candidate)?;

      if (unsafe { access(name.as_ptr(), X_OK) }) == 0 {
        return Some(name);
      }
    }
  }

  None
}

/// Whether the `NAME=value` entry of the environment has the name of `entry`, another one.
@cfg(unix)
fn same_name(existing: *mut c_char, entry: String) -> bool {
  const name = entry.as_ptr();
  var at = 0usize;

  loop {
    const a = unsafe { *(existing as *const u8).add(at) };
    const b = unsafe { *name.add(at) };

    // `std::process` gives names that are not empty and have no `=`.
    if b == 0x3D {
      return a == 0x3D;
    }

    if a != b {
      return false;
    }

    at += 1;
  }
}

/// The child between `fork` and `execve`, where only async-signal-safe calls may be made: nothing
/// here allocates, counts references or panics. A failure is reported as its `errno` on `report`.
@cfg(any(target_os = "linux", target_os = "android"))
fn child(program: *const c_char, argv: *const *mut c_char, envp: *const *mut c_char, dir: *const c_char, fds: *const c_int, report: c_int) {
  var target = 0;

  while target < 3 {
    const fd = unsafe { *fds.add(target as usize) };

    if fd >= 0 && (unsafe { dup2(fd, target) }) < 0 {
      exit_child(report);
    }

    target += 1;
  }

  if !dir.is_null() && (unsafe { chdir(dir) }) != 0 {
    exit_child(report);
  }

  unsafe { execve(program, argv, envp); }
  exit_child(report);
}

@cfg(any(target_os = "linux", target_os = "android"))
fn exit_child(report: c_int) {
  const error = [errno()];

  unsafe {
    write(report, error.as_ptr() as *const c_void, 4);
    _exit(127);
  }
}

/// Starts `program` with the descriptors at `fds` as its stdin, stdout and stderr (a negative one
/// is inherited), in `dir` unless it is null: the process, or the code of the failure.
@cfg(any(target_os = "linux", target_os = "android"))
fn spawn(program: *const c_char, argv: *const *mut c_char, envp: *const *mut c_char, dir: *const c_char, fds: *const c_int) -> Result<c_int, i32> {
  // The child writes the `errno` of a failure to this pipe, which `execve` closes when it works.
  var report = [-1; 2];

  if !open_pipe(report.as_mut_ptr()) {
    return Err(failure());
  }

  const pid = unsafe { fork() };

  if pid == 0 {
    child(program, argv, envp, dir, fds, report[1]);
  }

  const code = if pid < 0 { failure() } else { 0 };
  var error = [0; 1];
  var count = 0isize;

  close_fd(report[1]);

  if pid > 0 {
    loop {
      clear_errno();
      count = unsafe { read(report[0], error.as_mut_ptr() as *mut c_void, 4) };

      if count >= 0 || errno() != EINTR {
        break;
      }
    }
  }

  close_fd(report[0]);

  if pid < 0 {
    return Err(code);
  }

  if count == 4 {
    wait_child(pid);
    return Err(error[0]);
  }

  Ok(pid)
}

@cfg(any(target_os = "macos", target_os = "ios"))
fn spawn(program: *const c_char, argv: *const *mut c_char, envp: *const *mut c_char, dir: *const c_char, fds: *const c_int) -> Result<c_int, i32> {
  var actions = 0 as *mut c_void;
  var attributes = 0 as *mut c_void;
  var pid = 0;
  var code = unsafe { posix_spawn_file_actions_init(&raw mut actions) };

  if code != 0 {
    return Err(code);
  }

  code = unsafe { posix_spawnattr_init(&raw mut attributes) };

  if code == 0 {
    code = unsafe { posix_spawnattr_setflags(&raw mut attributes, POSIX_SPAWN_CLOEXEC_DEFAULT) };
  }

  var target = 0;

  while target < 3 && code == 0 {
    const fd = unsafe { *fds.add(target as usize) };

    code = if fd >= 0 {
      unsafe { posix_spawn_file_actions_adddup2(&raw mut actions, fd, target) }
    } else {
      unsafe { posix_spawn_file_actions_addinherit_np(&raw mut actions, target) }
    };
    target += 1;
  }

  if code == 0 && !dir.is_null() {
    code = unsafe { posix_spawn_file_actions_addchdir_np(&raw mut actions, dir) };
  }

  if code == 0 {
    code = unsafe { posix_spawn(&raw mut pid, program, &raw const actions, &raw const attributes, argv, envp) };
  }

  unsafe {
    posix_spawn_file_actions_destroy(&raw mut actions);
    posix_spawnattr_destroy(&raw mut attributes);
  }

  if code == 0 { Ok(pid) } else { Err(code) }
}

/// Waits for the process `pid` to end: its exit code, or `None` if a signal ended it.
@cfg(unix)
fn wait_child(pid: c_int) -> Option<i32> {
  var status = [0; 1];

  loop {
    clear_errno();

    if (unsafe { waitpid(pid, status.as_mut_ptr(), 0) }) >= 0 || errno() != EINTR {
      break;
    }
  }

  // `WIFEXITED`: no signal in the low 7 bits; `WEXITSTATUS`: the next 8 bits.
  if status[0] & 0x7F == 0 { Some((status[0] >> 8) & 0xFF) } else { None }
}

/// Reads what is available from `fd` into `bytes`: `fd`, or -1 once it is closed at the end of
/// the stream.
@cfg(unix)
fn drain(fd: c_int, bytes: List<u8>) -> c_int {
  const start = bytes.len();

  bytes.resize(start + 4096, 0);
  clear_errno();

  const count = unsafe { read(fd, bytes.as_mut_ptr().add(start) as *mut c_void, 4096) };
  const interrupted = count < 0 && errno() == EINTR;

  bytes.resize(start + if count > 0 { count as usize } else { 0 }, 0);

  if count > 0 || interrupted {
    fd
  } else {
    close_fd(fd);
    -1
  }
}

/// The C strings of `texts`, which `std::process` gives without NUL characters.
@cfg(unix)
fn c_strings(texts: List<String>) -> Result<List<CString>, i32> {
  const strings = new List<CString>();

  for text in texts {
    match c_path(text) {
      Some(found) => strings.push(found),
      None => return Err(EINVAL),
    }
  }

  Ok(strings)
}

/// A NULL-terminated array of the C strings `strings`, which must outlive it.
@cfg(unix)
fn pointers(strings: List<CString>) -> List<usize> {
  const addresses = new List<usize>();

  for text in strings {
    addresses.push(text.as_ptr() as usize);
  }

  addresses.push(0);
  addresses
}

/// Runs `argv[0]` with the arguments `argv`, the `NAME=value` entries of `vars` added to its
/// environment, in `dir`, with `input` as its stdin, capturing its stdout and stderr when
/// `capture`: how it ended, or the code of the failure to start it.
@cfg(unix)
pub fn run_process(argv: List<String>, vars: List<String>, dir: Option<String>, input: Option<String>, capture: bool) -> Result<Finished, i32> {
  const program = match find_program(argv[0]) {
    Some(found) => found,
    None => return Err(ENOENT),
  };
  const c_args = c_strings(argv)?;
  const c_vars = c_strings(vars)?;
  const arg_pointers = pointers(c_args);
  const parent = environment();
  const env_pointers = new List<usize>();

  if !vars.is_empty() {
    var index = 0usize;

    while !parent.is_null() {
      const existing = unsafe { *parent.add(index) };

      if existing.is_null() {
        break;
      }

      if !vars.iter().any((entry) => same_name(existing, entry)) {
        env_pointers.push(existing as usize);
      }

      index += 1;
    }

    for entry in c_vars {
      env_pointers.push(entry.as_ptr() as usize);
    }

    env_pointers.push(0);
  }

  const envp = if vars.is_empty() { parent } else { env_pointers.as_ptr() as *const *mut c_char };
  const c_dir: Option<CString> = match dir {
    Some(path) => match c_path(path) {
      Some(found) => Some(found),
      None => return Err(EINVAL),
    },
    None => None,
  };
  const dir_pointer = match c_dir {
    Some(path) => path.as_ptr(),
    None => 0 as *const c_char,
  };
  var stdin_pipe = [-1; 2];
  var stdout_pipe = [-1; 2];
  var stderr_pipe = [-1; 2];
  var code = 0;

  if (input.is_some() && !open_pipe(stdin_pipe.as_mut_ptr())) || (capture && (!open_pipe(stdout_pipe.as_mut_ptr()) || !open_pipe(stderr_pipe.as_mut_ptr()))) {
    code = failure();
  }

  // The child shares stdout and stderr: what this program printed must come first.
  unsafe { fflush(0 as *mut c_void); }

  const fds = [stdin_pipe[0], stdout_pipe[1], stderr_pipe[1]];
  const started = if code == 0 {
    spawn(program.as_ptr(), arg_pointers.as_ptr() as *const *mut c_char, envp, dir_pointer, fds.as_ptr())
  } else {
    Err(code)
  };

  close_fd(stdin_pipe[0]);
  close_fd(stdout_pipe[1]);
  close_fd(stderr_pipe[1]);

  const pid = match started {
    Ok(found) => found,
    Err(failed) => {
      close_fd(stdin_pipe[1]);
      close_fd(stdout_pipe[0]);
      close_fd(stderr_pipe[0]);
      return Err(failed);
    }
  };
  const stdout = new List<u8>();
  const stderr = new List<u8>();
  const text = input.unwrap_or("");
  var in_fd = stdin_pipe[1];
  var out_fd = stdout_pipe[0];
  var err_fd = stderr_pipe[0];
  var done = 0usize;

  if in_fd >= 0 && text.is_empty() {
    close_fd(in_fd);
    in_fd = -1;
  }

  // A child that stops reading would end this program with SIGPIPE; SIG_IGN is 1.
  const ignore = Some(unsafe { 1usize as extern "C" fn(c_int) });
  const writes = in_fd >= 0;
  const previous = if writes { unsafe { signal(SIGPIPE, ignore) } } else { None };
  var ready = [PollFd { fd: -1, events: 0, revents: 0 }; 3];

  // `poll` leaves out the slots of closed streams, whose descriptor is negative.
  while in_fd >= 0 || out_fd >= 0 || err_fd >= 0 {
    ready[0] = PollFd { fd: in_fd, events: POLLOUT, revents: 0 };
    ready[1] = PollFd { fd: out_fd, events: POLLIN, revents: 0 };
    ready[2] = PollFd { fd: err_fd, events: POLLIN, revents: 0 };
    clear_errno();

    if wait_ready(ready.as_mut_ptr(), 3) < 0 {
      if errno() == EINTR {
        continue;
      }

      break;
    }

    if in_fd >= 0 && ready[0].revents != 0 {
      const left = text.len() - done;
      const size = if left > PIPE_BUF { PIPE_BUF } else { left };

      clear_errno();

      const written = unsafe { write(in_fd, text.as_ptr().add(done) as *const c_void, size) };

      if written > 0 {
        done += written as usize;
      }

      // Once the child closes its stdin, the rest of the input is dropped.
      if done == text.len() || (written < 0 && errno() != EINTR) {
        close_fd(in_fd);
        in_fd = -1;
      }
    }

    if out_fd >= 0 && ready[1].revents != 0 {
      out_fd = drain(out_fd, stdout);
    }

    if err_fd >= 0 && ready[2].revents != 0 {
      err_fd = drain(err_fd, stderr);
    }
  }

  if writes {
    unsafe { signal(SIGPIPE, previous); }
  }

  close_fd(in_fd);
  close_fd(out_fd);
  close_fd(err_fd);

  Ok(Finished { code: wait_child(pid), stdout: stdout, stderr: stderr })
}

/// `SECURITY_ATTRIBUTES`.
@cfg(windows)
@repr(C)
struct SecurityAttributes {
  pub length: u32;
  pub descriptor: *mut c_void;
  pub inherit: c_int;
}

/// `STARTUPINFOW`.
@cfg(windows)
@repr(C)
struct StartupInfo {
  pub size: u32;
  pub reserved: *mut u16;
  pub desktop: *mut u16;
  pub title: *mut u16;
  pub x: u32;
  pub y: u32;
  pub x_size: u32;
  pub y_size: u32;
  pub x_count_chars: u32;
  pub y_count_chars: u32;
  pub fill_attribute: u32;
  pub flags: u32;
  pub show_window: u16;
  pub reserved2_size: u16;
  pub reserved2: *mut u8;
  pub std_input: *mut c_void;
  pub std_output: *mut c_void;
  pub std_error: *mut c_void;
}

/// `PROCESS_INFORMATION`.
@cfg(windows)
@repr(C)
struct ProcessInformation {
  pub process: *mut c_void;
  pub thread: *mut c_void;
  pub process_id: u32;
  pub thread_id: u32;
}

/// `OVERLAPPED`, for reading and writing several pipes at once without threads.
@cfg(windows)
@repr(C)
struct Overlapped {
  pub internal: usize;
  pub internal_high: usize;
  pub offset: u32;
  pub offset_high: u32;
  pub event: *mut c_void;
}

/// The two ends of a pipe to a child.
@cfg(windows)
struct PipeEnds {
  /// This program's end, opened for overlapped I/O.
  pub ours: *mut c_void;
  /// The child's end, which it inherits.
  pub theirs: *mut c_void;
}

@cfg(windows)
extern "C" {
  fn CreateNamedPipeW(name: *const u16, open_mode: u32, pipe_mode: u32, instances: u32, out_size: u32, in_size: u32, timeout: u32, security: *mut c_void) -> *mut c_void;
  fn CreateEventW(security: *mut c_void, manual_reset: c_int, signaled: c_int, name: *const u16) -> *mut c_void;
  fn GetOverlappedResult(file: *mut c_void, overlapped: *mut Overlapped, transferred: *mut u32, wait: c_int) -> c_int;
  fn CancelIo(file: *mut c_void) -> c_int;
  fn WaitForMultipleObjects(count: u32, handles: *const *mut c_void, wait_all: c_int, milliseconds: u32) -> u32;
  fn WaitForSingleObject(handle: *mut c_void, milliseconds: u32) -> u32;
  fn GetExitCodeProcess(process: *mut c_void, code: *mut u32) -> c_int;
  fn CreateProcessW(application: *const u16, command_line: *mut u16, process_security: *mut c_void, thread_security: *mut c_void, inherit_handles: c_int, flags: u32, environment: *mut c_void, directory: *const u16, startup: *mut StartupInfo, information: *mut ProcessInformation) -> c_int;
  fn GetEnvironmentStringsW() -> *mut u16;
  fn FreeEnvironmentStringsW(block: *mut u16) -> c_int;
  fn GetCurrentProcess() -> *mut c_void;
  fn GetCurrentProcessId() -> u32;
  fn GetCurrentThreadId() -> u32;
  fn DuplicateHandle(source_process: *mut c_void, source: *mut c_void, target_process: *mut c_void, target: *mut *mut c_void, access: u32, inherit: c_int, options: u32) -> c_int;
}

@cfg(windows)
const INFINITE: u32 = 0xFFFF_FFFF;
@cfg(windows)
const ERROR_IO_PENDING: u32 = 997;
@cfg(windows)
const EQUALS: u16 = 0x3D;

/// The pipes this thread has created, which name the next one.
@cfg(windows)
@thread_local
static var PIPES: u64 = 0;

/// A pipe for a child: one it writes (its stdout or stderr) when `inbound`, else its stdin.
/// Anonymous pipes cannot be overlapped, so it is a named pipe with a name of its own, as Rust's
/// `std` does.
@cfg(windows)
fn child_pipe(inbound: bool) -> Result<PipeEnds, i32> {
  const count = PIPES;

  PIPES = count + 1;

  const pid = unsafe { GetCurrentProcessId() };
  const tid = unsafe { GetCurrentThreadId() };
  const name = to_utf16(`\\\\.\\pipe\\sagitario-${pid}-${tid}-${count}`);
  // PIPE_ACCESS_INBOUND (1) or PIPE_ACCESS_OUTBOUND (2), with FILE_FLAG_OVERLAPPED and
  // FILE_FLAG_FIRST_PIPE_INSTANCE; a pipe of bytes that rejects remote clients.
  const access = if inbound { 1u32 } else { 2u32 };
  const ours = unsafe { CreateNamedPipeW(name.as_ptr(), access | 0x4000_0000 | 0x0008_0000, 8, 1, 4096, 4096, 0, 0 as *mut c_void) };

  if invalid(ours) {
    return Err(failure());
  }

  var inheritable = SecurityAttributes { length: mem::size_of<SecurityAttributes>() as u32, descriptor: 0 as *mut c_void, inherit: 1 };
  // GENERIC_WRITE or GENERIC_READ, OPEN_EXISTING.
  const theirs_access = if inbound { 0x4000_0000u32 } else { 0x8000_0000u32 };
  const theirs = unsafe { CreateFileW(name.as_ptr(), theirs_access, 0, &raw mut inheritable as *mut c_void, 3, 0, 0 as *mut c_void) };

  if invalid(theirs) {
    const code = failure();

    unsafe { CloseHandle(ours); }
    return Err(code);
  }

  Ok(PipeEnds { ours: ours, theirs: theirs })
}

/// An inheritable copy of this program's standard stream `index`, or null if it has none.
@cfg(windows)
fn inherited(index: i32) -> *mut c_void {
  const handle = unsafe { GetStdHandle((-10 - index) as u32) };
  var copy = 0 as *mut c_void;

  if handle.is_null() || invalid(handle) {
    return copy;
  }

  // DUPLICATE_SAME_ACCESS
  if (unsafe { DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &raw mut copy, 0, 1, 2) }) == 0 {
    return 0 as *mut c_void;
  }

  copy
}

/// Appends `arg` quoted so that the rules of Microsoft's C runtime (`args`) read it back.
@cfg(windows)
fn quote_arg(line: StringBuilder, arg: String) {
  if !arg.is_empty() && !arg.contains(" ") && !arg.contains("\t") && !arg.contains("\"") {
    line.append(arg);
    return;
  }

  line.append("\"");

  var slashes = 0usize;

  for c in arg.chars() {
    if c == '\\' {
      slashes += 1;
      continue;
    }

    // Backslashes before a quote are doubled, and the quote escaped.
    line.append("\\".repeat(if c == '"' { slashes * 2 + 1 } else { slashes }));
    line.append_char(c);
    slashes = 0;
  }

  // Backslashes before the closing quote are doubled.
  line.append("\\".repeat(slashes * 2));
  line.append("\"");
}

/// The command line of `argv`, whose program name is only quoted, never escaped, when it holds
/// spaces.
@cfg(windows)
fn command_line(argv: List<String>) -> String {
  const line = new StringBuilder();
  const program = argv[0];
  const spaced = program.is_empty() || program.contains(" ") || program.contains("\t");

  if spaced {
    line.append("\"");
  }

  line.append(program);

  if spaced {
    line.append("\"");
  }

  for index in 1..argv.len() {
    line.append(" ");
    quote_arg(line, argv[index]);
  }

  line.to_string()
}

/// An ASCII letter of UTF-16 in upper case.
@cfg(windows)
fn upper(c: u16) -> u16 {
  if c >= 0x61 && c <= 0x7A { c - 32 } else { c }
}

/// Whether the entry at `at` of an environment block has the name of `entry`, a `NAME=value` in
/// UTF-16: Windows names ignore ASCII case.
@cfg(windows)
fn same_wide_name(block: *const u16, at: usize, entry: List<u16>) -> bool {
  var index = 0usize;

  loop {
    const a = unit(block, at + index);
    const b = entry[index];

    if b == EQUALS {
      return a == EQUALS;
    }

    if a == 0 || upper(a) != upper(b) {
      return false;
    }

    index += 1;
  }
}

/// The environment block of the child: this program's, with the `NAME=value` entries of `vars`
/// replacing or adding variables. Entries starting with `=` are hidden variables of the shell.
@cfg(windows)
fn environment_block(vars: List<String>) -> List<u16> {
  const block = new List<u16>();
  const added = new List<List<u16>>();

  for entry in vars {
    added.push(to_utf16(entry));
  }

  const parent = unsafe { GetEnvironmentStringsW() };

  if !parent.is_null() {
    const units = parent as *const u16;
    var at = 0usize;

    while unit(units, at) != 0 {
      var end = at;

      while unit(units, end) != 0 {
        end += 1;
      }

      const replaced = unit(units, at) != EQUALS && added.iter().any((entry) => same_wide_name(units, at, entry));

      if !replaced {
        for index in at..end + 1 {
          block.push(unit(units, index));
        }
      }

      at = end + 1;
    }

    unsafe { FreeEnvironmentStringsW(parent); }
  }

  for entry in added {
    for c in entry {
      block.push(c);
    }
  }

  // The block ends with an empty entry.
  block.push(0);
  block
}

/// Writes `input` to the child's stdin `stdin` and reads its `stdout` and `stderr` into `out` and
/// `err`, all at once with overlapped I/O, until each pipe is closed; a null handle is not a pipe.
@cfg(windows)
fn communicate(stdin: *mut c_void, stdout: *mut c_void, stderr: *mut c_void, input: String, out: List<u8>, err: List<u8>) {
  var handles = [stdin, stdout, stderr];
  var events = [0 as *mut c_void; 3];
  var overlapped = [Overlapped { internal: 0, internal_high: 0, offset: 0, offset_high: 0, event: 0 as *mut c_void }; 3];
  var pending = [false; 3];
  // Room for a read of stdout, then for one of stderr.
  var buffer = [0u8; 8192];
  var done = 0usize;

  if !handles[0].is_null() && input.is_empty() {
    unsafe { CloseHandle(handles[0]); }
    handles[0] = 0 as *mut c_void;
  }

  for stream in 0..3usize {
    if !handles[stream].is_null() {
      events[stream] = unsafe { CreateEventW(0 as *mut c_void, 1, 0, 0 as *const u16) };
      overlapped[stream].event = events[stream];
    }
  }

  loop {
    // An operation on each open pipe without one.
    for stream in 0..3usize {
      if handles[stream].is_null() || pending[stream] {
        continue;
      }

      const place = &raw mut overlapped[stream] as *mut c_void;
      const started = if stream == 0 {
        const left = input.len() - done;
        const size = if left > 65536 { 65536u32 } else { left as u32 };

        unsafe { WriteFile(handles[0], input.as_ptr().add(done), size, 0 as *mut u32, place) }
      } else {
        unsafe { ReadFile(handles[stream], &raw mut buffer[(stream - 1) * 4096], 4096, 0 as *mut u32, place) }
      };

      if started != 0 || (unsafe { GetLastError() }) == ERROR_IO_PENDING {
        pending[stream] = true;
      } else {
        unsafe { CloseHandle(handles[stream]); }
        handles[stream] = 0 as *mut c_void;
      }
    }

    var waiting = [0 as *mut c_void; 3];
    var streams = [0usize; 3];
    var count = 0usize;

    for stream in 0..3usize {
      if pending[stream] {
        waiting[count] = events[stream];
        streams[count] = stream;
        count += 1;
      }
    }

    if count == 0 {
      break;
    }

    const signaled = unsafe { WaitForMultipleObjects(count as u32, waiting.as_ptr(), 0, INFINITE) } as usize;

    if signaled >= count {
      // WAIT_FAILED: the operations are cancelled, and waited for before the buffers go.
      for stream in 0..3usize {
        if pending[stream] {
          var ignored = 0u32;

          unsafe {
            CancelIo(handles[stream]);
            GetOverlappedResult(handles[stream], &raw mut overlapped[stream], &raw mut ignored, 1);
            CloseHandle(handles[stream]);
          }
          handles[stream] = 0 as *mut c_void;
          pending[stream] = false;
        }
      }

      break;
    }

    const stream = streams[signaled];
    var transferred = 0u32;
    const ok = (unsafe { GetOverlappedResult(handles[stream], &raw mut overlapped[stream], &raw mut transferred, 0) }) != 0;

    pending[stream] = false;

    var finished = !ok || transferred == 0;

    if stream == 0 {
      done += transferred as usize;
      // Once the child closes its stdin, the rest of the input is dropped.
      finished = !ok || done == input.len();
    } else {
      const bytes = if stream == 1 { out } else { err };
      const base = (stream - 1) * 4096;

      for index in 0..transferred as usize {
        bytes.push(buffer[base + index]);
      }
    }

    if finished {
      unsafe { CloseHandle(handles[stream]); }
      handles[stream] = 0 as *mut c_void;
    }
  }

  for stream in 0..3usize {
    if !events[stream].is_null() {
      unsafe { CloseHandle(events[stream]); }
    }
  }
}

/// The file a program with a separator names, as UTF-16, with `.exe` when the name alone is not a
/// file; `None` for a bare name, which `CreateProcessW` looks up in the directories of `PATH`. It
/// gives the path to `CreateProcessW` itself, which otherwise reads it from the command line and
/// finds no file in a relative path written with `/`.
@cfg(windows)
fn application_name(program: String) -> Option<List<u16>> {
  if !program.contains("/") && !program.contains("\\") {
    return None;
  }

  const native = program.replace("/", "\\");

  if path_kind(native) == KIND_FILE || native.ends_with(".exe") {
    return Some(to_utf16(native));
  }

  Some(to_utf16(native + ".exe"))
}

@cfg(windows)
pub fn run_process(argv: List<String>, vars: List<String>, dir: Option<String>, input: Option<String>, capture: bool) -> Result<Finished, i32> {
  const line = to_utf16(command_line(argv));
  const application = application_name(argv[0]);
  const environment: Option<List<u16>> = if vars.is_empty() { None } else { Some(environment_block(vars)) };
  const directory = match dir {
    Some(path) => Some(to_utf16(path)),
    None => None,
  };
  var ours = [0 as *mut c_void; 3];
  var theirs = [0 as *mut c_void; 3];
  var code = 0;

  for stream in 0..3usize {
    const piped = if stream == 0 { input.is_some() } else { capture };

    if !piped {
      theirs[stream] = inherited(stream as i32);
    } else if code == 0 {
      match child_pipe(stream != 0) {
        Ok(ends) => {
          ours[stream] = ends.ours;
          theirs[stream] = ends.theirs;
        }
        Err(failed) => {
          code = failed;
        }
      }
    }
  }

  // The child shares stdout and stderr: what this program printed must come first.
  unsafe { fflush(0 as *mut c_void); }

  var process = ProcessInformation { process: 0 as *mut c_void, thread: 0 as *mut c_void, process_id: 0, thread_id: 0 };

  if code == 0 {
    const none = 0 as *mut u16;
    // STARTF_USESTDHANDLES
    var startup = StartupInfo {
      size: mem::size_of<StartupInfo>() as u32,
      reserved: none,
      desktop: none,
      title: none,
      x: 0,
      y: 0,
      x_size: 0,
      y_size: 0,
      x_count_chars: 0,
      y_count_chars: 0,
      fill_attribute: 0,
      flags: 0x100,
      show_window: 0,
      reserved2_size: 0,
      reserved2: 0 as *mut u8,
      std_input: theirs[0],
      std_output: theirs[1],
      std_error: theirs[2],
    };
    const block = match environment {
      Some(units) => units.as_ptr() as *mut c_void,
      None => 0 as *mut c_void,
    };
    const cwd = match directory {
      Some(units) => units.as_ptr(),
      None => 0 as *const u16,
    };

    // CREATE_UNICODE_ENVIRONMENT
    const program = match application {
      Some(units) => units.as_ptr(),
      None => 0 as *const u16,
    };

    if (unsafe { CreateProcessW(program, line.as_mut_ptr(), 0 as *mut c_void, 0 as *mut c_void, 1, 0x400, block, cwd, &mut startup, &mut process) }) == 0 {
      code = failure();
    }
  }

  // The child holds its own copies of its ends.
  for stream in 0..3usize {
    if !theirs[stream].is_null() {
      unsafe { CloseHandle(theirs[stream]); }
    }
  }

  if code != 0 {
    for stream in 0..3usize {
      if !ours[stream].is_null() {
        unsafe { CloseHandle(ours[stream]); }
      }
    }

    return Err(code);
  }

  const stdout = new List<u8>();
  const stderr = new List<u8>();
  var exit = 0u32;

  communicate(ours[0], ours[1], ours[2], input.unwrap_or(""), stdout, stderr);

  unsafe {
    WaitForSingleObject(process.process, INFINITE);
    GetExitCodeProcess(process.process, &raw mut exit);
    CloseHandle(process.process);
    CloseHandle(process.thread);
  }

  Ok(Finished { code: Some(exit as i32), stdout: stdout, stderr: stderr })
}

// ---- Dynamic libraries ------------------------------------------------------------------------

/// Why a library was not loaded, when its path cannot be a C string.
const NUL_IN_PATH: String = "the path contains a NUL character";

@cfg(unix)
extern "C" {
  fn dlopen(path: *const c_char, mode: c_int) -> *mut c_void;
  fn dlerror() -> *const c_char;
  fn dlsym(library: *mut c_void, name: *const c_char) -> *mut c_void;
}

/// `RTLD_NOW | RTLD_LOCAL`: the symbols are bound when the library loads, and stay its own.
/// `RTLD_LOCAL` is 0 except on Apple systems, and 32-bit Android has `RTLD_NOW` 0.
@cfg(any(target_os = "linux", all(target_os = "android", target_pointer_width = "64")))
const LOAD_MODE: c_int = 2;
@cfg(all(target_os = "android", target_pointer_width = "32"))
const LOAD_MODE: c_int = 0;
@cfg(any(target_os = "macos", target_os = "ios"))
const LOAD_MODE: c_int = 6;

/// Loads the library at `path`, or by its name as the system finds it: the library, or the
/// system's reason.
@cfg(unix)
pub fn open_library(path: String) -> Result<*mut c_void, String> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(NUL_IN_PATH),
  };
  const library = unsafe { dlopen(name.as_ptr(), LOAD_MODE) };

  if !library.is_null() {
    return Ok(library);
  }

  const reason = unsafe { dlerror() };

  Err(if reason.is_null() { "unknown error" } else { unsafe { string_from_c(reason) } })
}

/// The function `name` of `library`, or `None`. POSIX guarantees that the data pointer `dlsym`
/// gives holds a function's address.
@cfg(unix)
pub fn library_symbol(library: *mut c_void, name: String) -> Option<unsafe extern "C" fn()> {
  const c_name = c_path(name)?;
  const address = unsafe { dlsym(library, c_name.as_ptr()) };

  if address.is_null() { None } else { Some(unsafe { address as unsafe extern "C" fn() }) }
}

@cfg(windows)
extern "C" {
  fn LoadLibraryW(name: *const u16) -> *mut c_void;
  fn GetProcAddress(library: *mut c_void, name: *const c_char) -> Option<unsafe extern "C" fn()>;
}

@cfg(windows)
pub fn open_library(path: String) -> Result<*mut c_void, String> {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(NUL_IN_PATH),
  };
  const library = unsafe { LoadLibraryW(name.as_ptr()) };

  if !library.is_null() {
    return Ok(library);
  }

  const error = unsafe { GetLastError() };

  Err(`Windows error ${error}`)
}

@cfg(windows)
pub fn library_symbol(library: *mut c_void, name: String) -> Option<unsafe extern "C" fn()> {
  const c_name = match CString::new(name) {
    Ok(found) => found,
    Err(_) => return None,
  };

  unsafe { GetProcAddress(library, c_name.as_ptr()) }
}

// ---- Locks ------------------------------------------------------------------------------------

/// Room for `pthread_mutex_t` or `pthread_cond_t` of every supported C library: glibc's, bionic's
/// and Apple's are at most 64 and 48 bytes, aligned to 8
/// (docs/adr/0087-atomic-storage-and-std-sync.md, Q570).
@cfg(unix)
@repr(C)
struct PthreadBuffer {
  pub words: [u64; 8];
}

@cfg(unix)
extern "C" {
  fn pthread_mutex_init(mutex: *mut PthreadBuffer, attributes: *const c_void) -> c_int;
  fn pthread_mutex_lock(mutex: *mut PthreadBuffer) -> c_int;
  fn pthread_mutex_unlock(mutex: *mut PthreadBuffer) -> c_int;
  fn pthread_cond_init(condition: *mut PthreadBuffer, attributes: *const c_void) -> c_int;
  fn pthread_cond_wait(condition: *mut PthreadBuffer, mutex: *mut PthreadBuffer) -> c_int;
  fn pthread_cond_broadcast(condition: *mut PthreadBuffer) -> c_int;
  /// `pthread_t` is an integer or a pointer, of the size of a pointer, on every supported system.
  fn pthread_self() -> usize;
}

/// A number for the calling thread, never 0.
@cfg(unix)
fn thread_id() -> usize {
  unsafe { pthread_self() }
}

/// A lock with a condition, for `Mutex` and `Channel`. C changes the memory of its fields, which
/// the generated C never declares `const`. They are never destroyed: Sagitario has no destructors,
/// and the default mutexes and conditions of these C libraries hold nothing to free.
@cfg(unix)
pub class Lock {
  prv const mutex: PthreadBuffer;
  prv const condition: PthreadBuffer;
  /// The thread holding the lock, or 0.
  prv const owner: Atomic<usize>;

  pub fn new(self) {
    self.mutex = PthreadBuffer { words: [0u64; 8] };
    self.condition = PthreadBuffer { words: [0u64; 8] };
    self.owner = Atomic::new(0);

    const failed = (unsafe { pthread_mutex_init(self.mutex_place(), 0 as *const c_void) }) != 0
      || (unsafe { pthread_cond_init(self.condition_place(), 0 as *const c_void) }) != 0;

    if failed {
      panic("failed to create a mutex");
    }
  }

  prv fn mutex_place(self) -> *mut PthreadBuffer {
    &raw const self.mutex as *mut PthreadBuffer
  }

  prv fn condition_place(self) -> *mut PthreadBuffer {
    &raw const self.condition as *mut PthreadBuffer
  }

  /// Takes the lock, waiting for it; panics if this thread holds it already.
  pub fn lock(self) {
    const me = thread_id();

    if self.owner.load() == me {
      panic("a thread locked a `Mutex` it already holds: the function given to `update` must not use the same mutex");
    }

    unsafe { pthread_mutex_lock(self.mutex_place()); }
    self.owner.store(me);
  }

  pub fn unlock(self) {
    self.owner.store(0);
    unsafe { pthread_mutex_unlock(self.mutex_place()); }
  }

  /// Releases the lock, which this thread holds, until another thread calls `notify_all`, then
  /// takes it again. It may also return without one.
  pub fn wait(self) {
    self.owner.store(0);
    unsafe { pthread_cond_wait(self.condition_place(), self.mutex_place()); }
    self.owner.store(thread_id());
  }

  /// Wakes every thread waiting on the lock.
  pub fn notify_all(self) {
    unsafe { pthread_cond_broadcast(self.condition_place()); }
  }
}

/// `SRWLOCK` and `CONDITION_VARIABLE`: one pointer each, which starts as zero.
@cfg(windows)
@repr(C)
struct WinLockCell {
  pub value: usize;
}

@cfg(windows)
extern "C" {
  fn AcquireSRWLockExclusive(lock: *mut WinLockCell);
  fn ReleaseSRWLockExclusive(lock: *mut WinLockCell);
  fn SleepConditionVariableSRW(condition: *mut WinLockCell, lock: *mut WinLockCell, milliseconds: u32, flags: u32) -> c_int;
  fn WakeAllConditionVariable(condition: *mut WinLockCell);
}

/// A number for the calling thread, never 0.
@cfg(windows)
fn thread_id() -> usize {
  (unsafe { GetCurrentThreadId() }) as usize
}

/// A lock with a condition, for `Mutex` and `Channel`. C changes the memory of its fields, which
/// the generated C never declares `const`; `SRWLOCK_INIT` and `CONDITION_VARIABLE_INIT` are zero,
/// and neither is destroyed.
@cfg(windows)
pub class Lock {
  prv const srw: WinLockCell;
  prv const condition: WinLockCell;
  /// The thread holding the lock, or 0.
  prv const owner: Atomic<usize>;

  pub fn new(self) {
    self.srw = WinLockCell { value: 0 };
    self.condition = WinLockCell { value: 0 };
    self.owner = Atomic::new(0);
  }

  prv fn srw_place(self) -> *mut WinLockCell {
    &raw const self.srw as *mut WinLockCell
  }

  prv fn condition_place(self) -> *mut WinLockCell {
    &raw const self.condition as *mut WinLockCell
  }

  /// Takes the lock, waiting for it; panics if this thread holds it already.
  pub fn lock(self) {
    const me = thread_id();

    if self.owner.load() == me {
      panic("a thread locked a `Mutex` it already holds: the function given to `update` must not use the same mutex");
    }

    unsafe { AcquireSRWLockExclusive(self.srw_place()); }
    self.owner.store(me);
  }

  pub fn unlock(self) {
    self.owner.store(0);
    unsafe { ReleaseSRWLockExclusive(self.srw_place()); }
  }

  /// Releases the lock, which this thread holds, until another thread calls `notify_all`, then
  /// takes it again. It may also return without one.
  pub fn wait(self) {
    self.owner.store(0);
    unsafe { SleepConditionVariableSRW(self.condition_place(), self.srw_place(), INFINITE, 0); }
    self.owner.store(thread_id());
  }

  /// Wakes every thread waiting on the lock.
  pub fn notify_all(self) {
    unsafe { WakeAllConditionVariable(self.condition_place()); }
  }
}

// ---- Threads ----------------------------------------------------------------------------------

/// What the runtime's core does for each thread, which stays C until S3
/// (docs/adr/0087-atomic-storage-and-std-sync.md, Q571).
extern "C" {
  fn sag_thread_run(thread: *mut c_void);
}

@cfg(unix)
extern "C" {
  fn pthread_create(thread: *mut usize, attributes: *const c_void, start: extern "C" fn(*mut c_void) -> *mut c_void, argument: *mut c_void) -> c_int;
  fn pthread_join(thread: usize, result: *mut *mut c_void) -> c_int;
  fn sysconf(name: c_int) -> c_long;
}

/// `_SC_NPROCESSORS_ONLN` of each C library.
@cfg(target_os = "linux")
const NPROCESSORS_ONLN: c_int = 84;
@cfg(target_os = "android")
const NPROCESSORS_ONLN: c_int = 0x61;
@cfg(any(target_os = "macos", target_os = "ios"))
const NPROCESSORS_ONLN: c_int = 58;

/// The entry of a thread of `std::thread`: `thread` is the core's.
@cfg(unix)
extern "C" fn sag_thread_entry(thread: *mut c_void) -> *mut c_void {
  unsafe { sag_thread_run(thread); }
  0 as *mut c_void
}

/// Starts the core's `thread`: the system's thread, which `join_thread` waits for. Panics if the
/// system cannot start one.
@cfg(unix)
pub fn start_thread(thread: *mut c_void) -> usize {
  var id = 0usize;

  if (unsafe { pthread_create(&raw mut id, 0 as *const c_void, sag_thread_entry, thread) }) != 0 {
    panic("failed to spawn a thread");
  }

  id
}

@cfg(unix)
pub fn join_thread(system: usize) {
  unsafe { pthread_join(system, 0 as *mut *mut c_void); }
}

/// The number of logical processors, at least 1.
@cfg(unix)
pub fn processors() -> usize {
  const count = unsafe { sysconf(NPROCESSORS_ONLN) };

  if count > 0 { count as usize } else { 1 }
}

@cfg(windows)
extern "C" {
  fn CreateThread(security: *mut c_void, stack_size: usize, start: extern "C" fn(*mut c_void) -> u32, parameter: *mut c_void, flags: u32, thread_id: *mut u32) -> *mut c_void;
  fn GetActiveProcessorCount(group: u16) -> u32;
}

@cfg(windows)
extern "C" fn sag_thread_entry(thread: *mut c_void) -> u32 {
  unsafe { sag_thread_run(thread); }
  0
}

@cfg(windows)
pub fn start_thread(thread: *mut c_void) -> usize {
  const handle = unsafe { CreateThread(0 as *mut c_void, 0, sag_thread_entry, thread, 0, 0 as *mut u32) };

  if handle.is_null() {
    panic("failed to spawn a thread");
  }

  handle as usize
}

@cfg(windows)
pub fn join_thread(system: usize) {
  const handle = system as *mut c_void;

  unsafe {
    WaitForSingleObject(handle, INFINITE);
    CloseHandle(handle);
  }
}

/// The number of logical processors of every processor group, at least 1.
@cfg(windows)
pub fn processors() -> usize {
  // ALL_PROCESSOR_GROUPS
  const count = unsafe { GetActiveProcessorCount(0xFFFF) };

  if count > 0 { count as usize } else { 1 }
}

// ---- Open files (docs/adr/0096-streams-files-and-drop.md, Q657) --------------------------------
//
// A file is a number: a descriptor on POSIX, a `HANDLE` as an integer on Windows, so that the
// `File` of `std::fs` has the same fields everywhere. `whence` of `file_seek` is 0 for the start,
// 1 for the current position and 2 for the end.

/// `EBADF`, the code of a file used after `close`.
pub const EBADF: i32 = 9;

@cfg(unix)
extern "C" {
  fn fileno(file: *mut c_void) -> c_int;
  fn dup(fd: c_int) -> c_int;
  fn fsync(fd: c_int) -> c_int;
}

@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
extern "C" {
  fn lseek(fd: c_int, offset: i64, whence: c_int) -> i64;
  fn ftruncate(fd: c_int, length: i64) -> c_int;
}

/// 32-bit Android has a 32-bit `off_t`; its `*64` functions take 64 bits.
@cfg(all(target_os = "android", target_pointer_width = "32"))
extern "C" {
  fn lseek64(fd: c_int, offset: i64, whence: c_int) -> i64;
  fn ftruncate64(fd: c_int, length: i64) -> c_int;
}

@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
fn seek_fd(fd: c_int, offset: i64, whence: c_int) -> i64 {
  unsafe { lseek(fd, offset, whence) }
}

@cfg(all(target_os = "android", target_pointer_width = "32"))
fn seek_fd(fd: c_int, offset: i64, whence: c_int) -> i64 {
  unsafe { lseek64(fd, offset, whence) }
}

@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
fn truncate_fd(fd: c_int, length: i64) -> c_int {
  unsafe { ftruncate(fd, length) }
}

@cfg(all(target_os = "android", target_pointer_width = "32"))
fn truncate_fd(fd: c_int, length: i64) -> c_int {
  unsafe { ftruncate64(fd, length) }
}

/// The `fopen` mode of a combination of options that `std::fs` checked: C has no `open` the FFI
/// can declare, since it is variadic, and C11's modes, with `x` for a file that must be new, cover
/// Rust's options but one, writing without truncating a file that may be new, which tries `r+`
/// and then a new file.
@cfg(unix)
fn open_mode(read: bool, write: bool, append: bool, truncate: bool, create_new: bool) -> String {
  if create_new {
    return if read { "w+bx" } else { "wbx" };
  }

  if append {
    return if read { "a+b" } else { "ab" };
  }

  if truncate {
    return if read { "w+b" } else { "wb" };
  }

  if write { "r+b" } else { "rb" }
}

/// Opens `path` and gives a descriptor of its own, which `fclose` of the stream leaves open.
@cfg(unix)
fn open_stream(name: CString, mode: String) -> Result<usize, i32> {
  const c_mode = CString::new(mode).unwrap();

  clear_errno();

  const stream = unsafe { fopen(name.as_ptr(), c_mode.as_ptr()) };

  if stream.is_null() {
    return Err(failure());
  }

  const fd = unsafe { dup(fileno(stream)) };
  const code = if fd < 0 { failure() } else { 0 };

  unsafe { fclose(stream); }

  if fd < 0 { Err(code) } else { Ok(fd as usize) }
}

@cfg(unix)
pub fn file_open(path: String, read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool) -> Result<usize, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };

  // `a` and `w` create the file, which `create` must ask for.
  if !create && !create_new && (append || truncate) && path_kind(path) == KIND_MISSING {
    return Err(ENOENT);
  }

  const mode = open_mode(read, write, append, truncate, create_new);

  match open_stream(name, mode) {
    Ok(fd) => Ok(fd),
    // Writing without truncating a file that may be new: a new one, unless another came first.
    Err(code) => {
      if code == ENOENT && create && mode == "r+b" {
        match open_stream(c_path(path).unwrap(), "w+bx") {
          Ok(fd) => return Ok(fd),
          Err(again) => {
            if again == EEXIST {
              return open_stream(c_path(path).unwrap(), "r+b");
            }

            return Err(again);
          }
        }
      }

      Err(code)
    }
  }
}

@cfg(unix)
pub fn file_read(file: usize, buffer: *mut u8, len: usize) -> Result<usize, i32> {
  clear_errno();

  const count = unsafe { read(file as c_int, buffer as *mut c_void, len) };

  if count < 0 { Err(failure()) } else { Ok(count as usize) }
}

@cfg(unix)
pub fn file_write(file: usize, data: *const u8, len: usize) -> Result<usize, i32> {
  clear_errno();

  const written = unsafe { write(file as c_int, data as *const c_void, len) };

  if written < 0 { Err(failure()) } else { Ok(written as usize) }
}

@cfg(unix)
pub fn file_seek(file: usize, offset: i64, whence: i32) -> Result<u64, i32> {
  clear_errno();

  const position = seek_fd(file as c_int, offset, whence as c_int);

  if position < 0 { Err(failure()) } else { Ok(position as u64) }
}

@cfg(unix)
pub fn file_sync(file: usize) -> i32 {
  clear_errno();

  if unsafe { fsync(file as c_int) } == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn file_set_len(file: usize, len: u64) -> i32 {
  clear_errno();

  if truncate_fd(file as c_int, len as i64) == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn file_close(file: usize) -> i32 {
  clear_errno();

  if unsafe { close(file as c_int) } == 0 { 0 } else { failure() }
}

@cfg(windows)
extern "C" {
  fn SetFilePointerEx(file: *mut c_void, distance: i64, position: *mut i64, method: u32) -> c_int;
  fn FlushFileBuffers(file: *mut c_void) -> c_int;
  fn SetEndOfFile(file: *mut c_void) -> c_int;
}

@cfg(windows)
fn handle_of(file: usize) -> *mut c_void {
  file as *mut c_void
}

@cfg(windows)
pub fn file_open(path: String, read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool) -> Result<usize, i32> {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  // GENERIC_READ, GENERIC_WRITE, or FILE_APPEND_DATA, whose writes go at the end.
  var access = 0u32;

  if read {
    access = access | 0x8000_0000;
  }

  if append {
    access = access | 0x4;
  } else if write {
    access = access | 0x4000_0000;
  }

  // CREATE_NEW, CREATE_ALWAYS, OPEN_ALWAYS, TRUNCATE_EXISTING or OPEN_EXISTING.
  const disposition = if create_new { 1u32 } else if create && truncate { 2u32 } else if create { 4u32 } else if truncate { 5u32 } else { 3u32 };
  // Sharing everything, FILE_ATTRIBUTE_NORMAL.
  const file = unsafe { CreateFileW(name.as_ptr(), access, 7, 0 as *mut c_void, disposition, 0x80, 0 as *mut c_void) };

  if invalid(file) { Err(failure()) } else { Ok(file as usize) }
}

@cfg(windows)
pub fn file_read(file: usize, buffer: *mut u8, len: usize) -> Result<usize, i32> {
  const size = if len > 0x4000_0000 { 0x4000_0000u32 } else { len as u32 };
  var read = 0u32;

  if unsafe { ReadFile(handle_of(file), buffer, size, &mut read, 0 as *mut c_void) } == 0 {
    // ERROR_BROKEN_PIPE: the other end closed, which is the end.
    if unsafe { GetLastError() } == 109 {
      return Ok(0);
    }

    return Err(failure());
  }

  Ok(read as usize)
}

@cfg(windows)
pub fn file_write(file: usize, data: *const u8, len: usize) -> Result<usize, i32> {
  const size = if len > 0x4000_0000 { 0x4000_0000u32 } else { len as u32 };
  var written = 0u32;

  if unsafe { WriteFile(handle_of(file), data, size, &mut written, 0 as *mut c_void) } == 0 {
    return Err(failure());
  }

  Ok(written as usize)
}

@cfg(windows)
pub fn file_seek(file: usize, offset: i64, whence: i32) -> Result<u64, i32> {
  var position = 0i64;

  // FILE_BEGIN, FILE_CURRENT and FILE_END are 0, 1 and 2, as `whence`.
  if unsafe { SetFilePointerEx(handle_of(file), offset, &mut position, whence as u32) } == 0 {
    return Err(failure());
  }

  Ok(position as u64)
}

@cfg(windows)
pub fn file_sync(file: usize) -> i32 {
  if unsafe { FlushFileBuffers(handle_of(file)) } != 0 { 0 } else { failure() }
}

/// Moves the end of the file to `len`, leaving the position where it was.
@cfg(windows)
pub fn file_set_len(file: usize, len: u64) -> i32 {
  const position = match file_seek(file, 0, 1) {
    Ok(found) => found,
    Err(code) => return code,
  };

  if let Err(code) = file_seek(file, len as i64, 0) {
    return code;
  }

  const code = if unsafe { SetEndOfFile(handle_of(file)) } != 0 { 0 } else { failure() };

  match file_seek(file, position as i64, 0) {
    Ok(_) => code,
    Err(again) => if code == 0 { again } else { code },
  }
}

@cfg(windows)
pub fn file_close(file: usize) -> i32 {
  if unsafe { CloseHandle(handle_of(file)) } != 0 { 0 } else { failure() }
}

// ---- Metadata (docs/adr/0096-streams-files-and-drop.md, Q659) ------------------------------------

/// What `std::fs` reads of a file: its kind (`KIND_*`), whether it is a symbolic link, its size,
/// whether it is read-only, and its times in nanoseconds since the Unix epoch, where the system
/// has them.
pub struct FileInfo {
  pub kind: i32;
  pub symlink: bool;
  pub size: u64;
  pub readonly: bool;
  pub accessed: Option<u64>;
  pub modified: Option<u64>;
  pub created: Option<u64>;
}

@cfg(unix)
extern "C" {
  fn lstat(path: *const c_char, info: *mut StatBuffer) -> c_int;
  fn fstat(fd: c_int, info: *mut StatBuffer) -> c_int;
  fn realpath(path: *const c_char, resolved: *mut c_char) -> *mut c_char;
}

/// Where `st_size`, `st_atim`, `st_mtim` and the time of birth are in `struct stat`, and how many
/// bytes each part of its `struct timespec` has. Linux and Android have no time of birth in it.
@cfg(any(target_os = "linux", target_os = "android"))
const SIZE_OFFSET: usize = 48;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const SIZE_OFFSET: usize = 96;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const SIZE_OFFSET: usize = 72;

@cfg(all(any(target_os = "linux", target_os = "android"), not(all(target_os = "android", target_pointer_width = "32"))))
const ACCESS_OFFSET: usize = 72;
@cfg(all(any(target_os = "linux", target_os = "android"), not(all(target_os = "android", target_pointer_width = "32"))))
const MODIFY_OFFSET: usize = 88;
@cfg(all(target_os = "android", target_pointer_width = "32"))
const ACCESS_OFFSET: usize = 72;
@cfg(all(target_os = "android", target_pointer_width = "32"))
const MODIFY_OFFSET: usize = 80;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const ACCESS_OFFSET: usize = 32;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const MODIFY_OFFSET: usize = 48;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const ACCESS_OFFSET: usize = 24;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const MODIFY_OFFSET: usize = 40;

/// The time of birth, which only the 64-bit `struct stat` of Apple's systems has; 0 for none.
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const BIRTH_OFFSET: usize = 80;
@cfg(any(target_os = "linux", target_os = "android", all(target_os = "macos", target_arch = "x86_64")))
const BIRTH_OFFSET: usize = 0;

@cfg(all(target_os = "android", target_pointer_width = "32"))
const TIME_BYTES: usize = 4;
@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
const TIME_BYTES: usize = 8;

/// The signed number of `bytes` bytes at `offset` of `info`.
@cfg(unix)
fn number_at(info: StatBuffer, offset: usize, bytes: usize) -> i64 {
  const copy = info;
  const at = unsafe { (&raw const copy as *const u8).add(offset) };

  if bytes == 8 { unsafe { *(at as *const i64) } } else { (unsafe { *(at as *const i32) }) as i64 }
}

/// The `struct timespec` at `offset`, in nanoseconds since the epoch; `None` before it.
@cfg(unix)
fn time_at(info: StatBuffer, offset: usize) -> Option<u64> {
  const seconds = number_at(info, offset, TIME_BYTES);
  const nanos = number_at(info, offset + TIME_BYTES, TIME_BYTES);

  if seconds < 0 { None } else { Some(seconds as u64 * 1_000_000_000 + nanos as u64) }
}

@cfg(unix)
fn info_of(info: StatBuffer) -> FileInfo {
  const at = unsafe { (&raw const info as *const u8).add(MODE_OFFSET) };
  const mode = if MODE_BYTES == 2 { (unsafe { *(at as *const u16) }) as u32 } else { unsafe { *(at as *const u32) } };
  // `S_IFMT`: `S_IFDIR` 0o040000, `S_IFREG` 0o100000, `S_IFLNK` 0o120000.
  const file_type = (mode >> 12) & 0xF;
  const kind = if file_type == 4 { KIND_DIR } else if file_type == 8 { KIND_FILE } else { KIND_OTHER };

  FileInfo {
    kind: kind,
    symlink: file_type == 10,
    size: number_at(info, SIZE_OFFSET, 8) as u64,
    // No one may write it: the bits 0o222 are clear.
    readonly: mode & 0o222 == 0,
    accessed: time_at(info, ACCESS_OFFSET),
    modified: time_at(info, MODIFY_OFFSET),
    created: if BIRTH_OFFSET == 0 { None } else { time_at(info, BIRTH_OFFSET) },
  }
}

/// What `path` names, following a symbolic link or not.
@cfg(unix)
pub fn metadata(path: String, follow: bool) -> Result<FileInfo, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  var info = StatBuffer { words: [0u64; 32] };

  clear_errno();

  const code = if follow { unsafe { stat(name.as_ptr(), &mut info) } } else { unsafe { lstat(name.as_ptr(), &mut info) } };

  if code != 0 { Err(failure()) } else { Ok(info_of(info)) }
}

@cfg(unix)
pub fn file_metadata(file: usize) -> Result<FileInfo, i32> {
  var info = StatBuffer { words: [0u64; 32] };

  clear_errno();

  if unsafe { fstat(file as c_int, &mut info) } != 0 { Err(failure()) } else { Ok(info_of(info)) }
}

/// The absolute path of `path`, without `.`, `..` or symbolic links. 4096 bytes is Linux's
/// `PATH_MAX`, and more than Apple's.
@cfg(unix)
pub fn canonical(path: String) -> Result<String, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  const buffer = new List<u8>();

  buffer.resize(4096, 0);
  clear_errno();

  const found = unsafe { realpath(name.as_ptr(), buffer.as_mut_ptr() as *mut c_char) };

  if found.is_null() { Err(failure()) } else { Ok(unsafe { string_from_c(found as *const c_char) }) }
}

/// `BY_HANDLE_FILE_INFORMATION`.
@cfg(windows)
@repr(C)
struct HandleInfo {
  pub attributes: u32;
  pub created: FileTime;
  pub accessed: FileTime;
  pub written: FileTime;
  pub volume: u32;
  pub size_high: u32;
  pub size_low: u32;
  pub links: u32;
  pub index_high: u32;
  pub index_low: u32;
}

/// `WIN32_FILE_ATTRIBUTE_DATA`.
@cfg(windows)
@repr(C)
struct AttributeData {
  pub attributes: u32;
  pub created: FileTime;
  pub accessed: FileTime;
  pub written: FileTime;
  pub size_high: u32;
  pub size_low: u32;
}

@cfg(windows)
extern "C" {
  fn GetFileInformationByHandle(file: *mut c_void, info: *mut HandleInfo) -> c_int;
  fn GetFileAttributesExW(name: *const u16, level: c_int, data: *mut AttributeData) -> c_int;
  fn GetFinalPathNameByHandleW(file: *mut c_void, path: *mut u16, size: u32, flags: u32) -> u32;
}

/// A `FILETIME`, 100 ns since 1601, in nanoseconds since the Unix epoch; `None` before it.
@cfg(windows)
fn nanos_of(time: FileTime) -> Option<u64> {
  const intervals = time.high as u64 * 0x1_0000_0000 + time.low as u64;
  const epoch = 116_444_736_000_000_000u64;

  if intervals < epoch { None } else { Some((intervals - epoch) * 100) }
}

/// The attributes `FILE_ATTRIBUTE_READONLY` (1), `DIRECTORY` (0x10) and `REPARSE_POINT` (0x400),
/// which a symbolic link has.
@cfg(windows)
fn info_from(attributes: u32, created: FileTime, accessed: FileTime, written: FileTime, size_high: u32, size_low: u32) -> FileInfo {
  FileInfo {
    kind: if attributes & 0x10 != 0 { KIND_DIR } else { KIND_FILE },
    symlink: attributes & 0x400 != 0,
    size: size_high as u64 * 0x1_0000_0000 + size_low as u64,
    readonly: attributes & 1 != 0,
    accessed: nanos_of(accessed),
    modified: nanos_of(written),
    created: nanos_of(created),
  }
}

@cfg(windows)
fn handle_info(file: *mut c_void) -> Result<FileInfo, i32> {
  var info = HandleInfo {
    attributes: 0,
    created: FileTime { low: 0, high: 0 },
    accessed: FileTime { low: 0, high: 0 },
    written: FileTime { low: 0, high: 0 },
    volume: 0,
    size_high: 0,
    size_low: 0,
    links: 0,
    index_high: 0,
    index_low: 0,
  };

  if unsafe { GetFileInformationByHandle(file, &mut info) } == 0 {
    return Err(failure());
  }

  Ok(info_from(info.attributes, info.created, info.accessed, info.written, info.size_high, info.size_low))
}

/// A handle that reads only the attributes of what `path` names, a directory too
/// (`FILE_FLAG_BACKUP_SEMANTICS`), following a symbolic link.
@cfg(windows)
fn attribute_handle(path: String) -> Result<*mut c_void, i32> {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  // FILE_READ_ATTRIBUTES, sharing everything, OPEN_EXISTING.
  const file = unsafe { CreateFileW(name.as_ptr(), 0x80, 7, 0 as *mut c_void, 3, 0x0200_0000, 0 as *mut c_void) };

  if invalid(file) { Err(failure()) } else { Ok(file) }
}

@cfg(windows)
pub fn metadata(path: String, follow: bool) -> Result<FileInfo, i32> {
  if follow {
    const file = attribute_handle(path)?;
    const found = handle_info(file);

    unsafe { CloseHandle(file); }

    return found;
  }

  // The link itself: `GetFileAttributesExW` does not follow it.
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  var data = AttributeData {
    attributes: 0,
    created: FileTime { low: 0, high: 0 },
    accessed: FileTime { low: 0, high: 0 },
    written: FileTime { low: 0, high: 0 },
    size_high: 0,
    size_low: 0,
  };

  // GetFileExInfoStandard.
  if unsafe { GetFileAttributesExW(name.as_ptr(), 0, &mut data) } == 0 {
    return Err(failure());
  }

  Ok(info_from(data.attributes, data.created, data.accessed, data.written, data.size_high, data.size_low))
}

@cfg(windows)
pub fn file_metadata(file: usize) -> Result<FileInfo, i32> {
  handle_info(handle_of(file))
}

/// The final path of what `path` names, as Rust's `canonicalize`: `\\?\` and the path, links
/// followed.
@cfg(windows)
pub fn canonical(path: String) -> Result<String, i32> {
  const file = attribute_handle(path)?;
  var size = 260u32;

  loop {
    const buffer = new List<u16>();

    buffer.resize(size as usize, 0);

    const len = unsafe { GetFinalPathNameByHandleW(file, buffer.as_mut_ptr(), size, 0) };

    if len == 0 {
      const code = failure();

      unsafe { CloseHandle(file); }

      return Err(code);
    }

    // Without room, the size it needs with its terminator.
    if len >= size {
      size = len + 1;
      continue;
    }

    unsafe { CloseHandle(file); }

    return Ok(from_utf16_lossy(&buffer[0..len as usize]));
  }
}
