//! `std::sys`: the C API of each system that the standard library is written on, and the code that
//! differs by system, as Rust's `std/src/sys` (docs/adr/0085-conditional-compilation-and-std-time.md,
//! Q551). Only the modules of `std` can name it.

use std::ffi::{c_char, c_int, c_void, string_from_c};
@cfg(unix)
use std::ffi::{c_long, CString};

// ---- errno ------------------------------------------------------------------------------------

@cfg(target_os = "linux")
extern "C" {
  fn __errno_location() -> *mut c_int;
}

@cfg(target_os = "android")
extern "C" {
  fn __errno() -> *mut c_int;
}

@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  fn __error() -> *mut c_int;
}

@cfg(windows)
extern "C" {
  fn _errno() -> *mut c_int;
}

/// Where C's `errno` is for this thread: a macro reaching a function whose name changes with the
/// C library.
@cfg(target_os = "linux")
fn errno_place() -> *mut c_int {
  unsafe { __errno_location() }
}

@cfg(target_os = "android")
fn errno_place() -> *mut c_int {
  unsafe { __errno() }
}

@cfg(any(target_os = "macos", target_os = "ios"))
fn errno_place() -> *mut c_int {
  unsafe { __error() }
}

@cfg(windows)
fn errno_place() -> *mut c_int {
  unsafe { _errno() }
}

/// The error of the last call to the C library that failed in this thread.
pub fn errno() -> i32 {
  unsafe { *errno_place() }
}

pub fn clear_errno() {
  unsafe { *errno_place() = 0; }
}

extern "C" {
  fn strerror(code: c_int) -> *const c_char;
}

/// The C library's description of the `errno` value `code`; invalid UTF-8 becomes U+FFFD.
pub fn error_message(code: i32) -> String {
  unsafe { string_from_c(strerror(code)) }
}

/// A call interrupted by a signal, on every Unix system.
@cfg(unix)
const EINTR: i32 = 4;

// ---- Clocks and sleeping ----------------------------------------------------------------------

/// `struct timespec`, whose `time_t` has 64 bits, except on 32-bit Android.
@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
@repr(C)
pub struct Timespec {
  pub tv_sec: i64;
  pub tv_nsec: c_long;

  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: secs as i64, tv_nsec: nanos as c_long }
  }

  /// The nanoseconds it holds, or zero for a time before 1970.
  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

/// `struct timespec` on 32-bit Android, whose `time_t` has 32 bits.
@cfg(all(target_os = "android", target_pointer_width = "32"))
@repr(C)
pub struct Timespec {
  pub tv_sec: i32;
  pub tv_nsec: c_long;

  /// At most 2^31 - 1 seconds, about 68 years.
  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: if secs > 0x7FFF_FFFF { 0x7FFF_FFFF } else { secs as i32 }, tv_nsec: nanos as c_long }
  }

  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

@cfg(unix)
const CLOCK_REALTIME: c_int = 0;

@cfg(any(target_os = "linux", target_os = "android"))
const CLOCK_MONOTONIC: c_int = 1;

@cfg(any(target_os = "macos", target_os = "ios"))
const CLOCK_MONOTONIC: c_int = 6;

@cfg(unix)
extern "C" {
  fn clock_gettime(clock: c_int, now: *mut Timespec) -> c_int;
  fn nanosleep(duration: *const Timespec, left: *mut Timespec) -> c_int;
}

/// `FILETIME`: 100-nanosecond intervals since 1601-01-01, in two halves.
@cfg(windows)
@repr(C)
pub struct FileTime {
  pub low: u32;
  pub high: u32;
}

@cfg(windows)
extern "C" {
  fn QueryPerformanceCounter(count: *mut i64) -> c_int;
  fn QueryPerformanceFrequency(frequency: *mut i64) -> c_int;
  fn GetSystemTimePreciseAsFileTime(time: *mut FileTime);
  fn Sleep(milliseconds: u32);
}

/// A monotonic clock, in nanoseconds since a start that means nothing outside the program.
@cfg(unix)
pub fn monotonic_nanos() -> u64 {
  clock(CLOCK_MONOTONIC)
}

/// The system clock, in nanoseconds since 1970-01-01 00:00:00 UTC, or zero before it.
@cfg(unix)
pub fn system_nanos() -> u64 {
  clock(CLOCK_REALTIME)
}

@cfg(unix)
fn clock(id: c_int) -> u64 {
  var now = Timespec::of(0, 0);

  if unsafe { clock_gettime(id, &mut now) } != 0 {
    return 0;
  }

  now.nanos()
}

@cfg(windows)
pub fn monotonic_nanos() -> u64 {
  var count = 0i64;
  var frequency = 1i64;

  unsafe {
    QueryPerformanceCounter(&mut count);
    QueryPerformanceFrequency(&mut frequency);
  }

  if frequency <= 0 || count < 0 {
    return 0;
  }

  const ticks = count as u64;
  const rate = frequency as u64;

  // Split so that `ticks * 10^9` cannot overflow.
  ticks / rate * 1_000_000_000 + ticks % rate * 1_000_000_000 / rate
}

@cfg(windows)
pub fn system_nanos() -> u64 {
  var now = FileTime { low: 0, high: 0 };

  unsafe { GetSystemTimePreciseAsFileTime(&mut now); }

  // The Unix epoch is 11644473600 seconds after 1601-01-01.
  const intervals = now.high as u64 * 0x1_0000_0000 + now.low as u64;
  const epoch = 116_444_736_000_000_000u64;

  if intervals < epoch { 0 } else { (intervals - epoch) * 100 }
}

/// Pauses the calling thread for at least `nanos` nanoseconds, resuming after a signal.
@cfg(unix)
pub fn sleep_nanos(nanos: u64) {
  var left = Timespec::of(nanos / 1_000_000_000, nanos % 1_000_000_000);

  loop {
    const asked = left;

    if unsafe { nanosleep(&asked, &mut left) } == 0 || errno() != EINTR {
      return;
    }
  }
}

/// In whole milliseconds, rounded up so that the program never sleeps less than asked.
@cfg(windows)
pub fn sleep_nanos(nanos: u64) {
  var millis = nanos / 1_000_000 + if nanos % 1_000_000 != 0 { 1 } else { 0 };

  while millis > 0 {
    const part = if millis > 0x7FFF_FFFF { 0x7FFF_FFFFu64 } else { millis };

    unsafe { Sleep(part as u32); }
    millis -= part;
  }
}

// ---- Arguments and environment variables ------------------------------------------------------

/// What C's `main` received, which the runtime's core passes on when the program starts
/// (`std::env`, `sag_env_init`), as Rust's `lang_start` gives them to its `std`. The address of
/// `argv` is kept as a number, so that the static is computed by the compiler.
@cfg(unix)
static var ARGC: c_int = 0;

@cfg(unix)
static var ARGV: usize = 0;

@cfg(unix)
extern "C" {
  fn getenv(name: *const c_char) -> *const c_char;
}

@cfg(unix)
pub fn set_args(argc: c_int, argv: *const *const c_char) {
  unsafe {
    ARGC = argc;
    ARGV = argv as usize;
  }
}

/// Windows reads its own command line, as UTF-16.
@cfg(windows)
pub fn set_args(_argc: c_int, _argv: *const *const c_char) {
  // C's `argv` is in the ANSI code page, not UTF-16.
}

/// The arguments C's `main` received; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn args() -> List<String> {
  const args = new List<String>();
  const count = unsafe { ARGC };
  const argv = unsafe { ARGV } as *const *const c_char;

  if argv.is_null() || count <= 0 {
    return args;
  }

  for index in 0..count as usize {
    const arg = unsafe { *argv.add(index) };

    if arg.is_null() {
      break;
    }

    args.push(unsafe { string_from_c(arg) });
  }

  args
}

/// The value of an environment variable; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn variable(name: String) -> Option<String> {
  const c_name = match CString::new(name) {
    Ok(found) => found,
    Err(_) => return None,
  };
  const value = unsafe { getenv(c_name.as_ptr()) };

  if value.is_null() { None } else { Some(unsafe { string_from_c(value) }) }
}

@cfg(windows)
extern "C" {
  fn GetCommandLineW() -> *const u16;
  fn GetEnvironmentVariableW(name: *const u16, buffer: *mut u16, size: u32) -> u32;
}

@cfg(windows)
const QUOTE: u16 = 0x22;
@cfg(windows)
const BACKSLASH: u16 = 0x5C;
@cfg(windows)
const SPACE: u16 = 0x20;
@cfg(windows)
const TAB: u16 = 0x09;

/// The code unit `at` of a NUL-terminated UTF-16 text.
@cfg(windows)
fn unit(text: *const u16, at: usize) -> u16 {
  unsafe { *text.add(at) }
}

/// The arguments, split from the command line with the rules of Microsoft's C runtime.
@cfg(windows)
pub fn args() -> List<String> {
  const args = new List<String>();
  const line = unsafe { GetCommandLineW() };

  if line.is_null() {
    return args;
  }

  const arg = new List<u16>();
  var at = 0usize;

  // The program ends at the first space, or at the closing quote; backslashes are kept.
  if unit(line, at) == QUOTE {
    at += 1;

    while unit(line, at) != 0 && unit(line, at) != QUOTE {
      arg.push(unit(line, at));
      at += 1;
    }

    if unit(line, at) == QUOTE {
      at += 1;
    }
  } else {
    while unit(line, at) != 0 && unit(line, at) != SPACE && unit(line, at) != TAB {
      arg.push(unit(line, at));
      at += 1;
    }
  }

  args.push(from_utf16_lossy(&arg));

  loop {
    while unit(line, at) == SPACE || unit(line, at) == TAB {
      at += 1;
    }

    if unit(line, at) == 0 {
      return args;
    }

    var quoted = false;

    arg.clear();

    while unit(line, at) != 0 && (quoted || (unit(line, at) != SPACE && unit(line, at) != TAB)) {
      const c = unit(line, at);

      if c == BACKSLASH {
        var slashes = 0usize;

        while unit(line, at) == BACKSLASH {
          slashes += 1;
          at += 1;
        }

        // 2n backslashes and a quote: n backslashes, and the quote delimits. 2n + 1: n
        // backslashes and a literal quote. Backslashes elsewhere are literal.
        const kept = if unit(line, at) == QUOTE { slashes / 2 } else { slashes };

        for _ in 0..kept {
          arg.push(BACKSLASH);
        }

        if unit(line, at) == QUOTE && slashes % 2 == 1 {
          arg.push(QUOTE);
          at += 1;
        }
      } else if c == QUOTE {
        if quoted && unit(line, at + 1) == QUOTE {
          arg.push(QUOTE);
          at += 2;
        } else {
          quoted = !quoted;
          at += 1;
        }
      } else {
        arg.push(c);
        at += 1;
      }
    }

    args.push(from_utf16_lossy(&arg));
  }
}

/// The value of an environment variable, read as UTF-16.
@cfg(windows)
pub fn variable(name: String) -> Option<String> {
  const wide = to_utf16(name);
  // Without a buffer, the size it needs with its terminator; 0 when the variable is not set.
  const size = unsafe { GetEnvironmentVariableW(wide.as_ptr(), 0 as *mut u16, 0) };

  if size == 0 {
    return None;
  }

  const value = new List<u16>();

  value.resize(size as usize, 0);

  const written = unsafe { GetEnvironmentVariableW(wide.as_ptr(), value.as_mut_ptr(), size) };

  // The variable grew in between.
  if written >= size {
    return None;
  }

  Some(from_utf16_lossy(&value[0..written as usize]))
}

/// UTF-16 code units as a string; an unpaired surrogate becomes U+FFFD.
@cfg(windows)
pub fn from_utf16_lossy(units: &[u16]) -> String {
  const text = new StringBuilder();
  var index = 0usize;

  while index < units.len() {
    var code = units[index] as u32;

    index += 1;

    if code >= 0xD800 && code <= 0xDBFF && index < units.len() && units[index] as u32 >= 0xDC00 && units[index] as u32 <= 0xDFFF {
      code = 0x10000 + (code - 0xD800) * 0x400 + (units[index] as u32 - 0xDC00);
      index += 1;
    } else if code >= 0xD800 && code <= 0xDFFF {
      code = 0xFFFD;
    }

    text.append_char(char::from_u32(code).unwrap_or('?'));
  }

  text.to_string()
}

/// A string as NUL-terminated UTF-16.
@cfg(windows)
pub fn to_utf16(text: String) -> List<u16> {
  const units = new List<u16>();

  for c in text.chars() {
    const code = c as u32;

    if code >= 0x10000 {
      units.push((0xD800 + (code - 0x10000) / 0x400) as u16);
      units.push((0xDC00 + (code - 0x10000) % 0x400) as u16);
    } else {
      units.push(code as u16);
    }
  }

  units.push(0);
  units
}

// ---- The standard streams ---------------------------------------------------------------------

/// C's streams, through which the runtime's core prints too, so that both write in order and the
/// C library locks them for threads (docs/adr/0086-c-globals-and-std-io.md, Q564).
@cfg(any(target_os = "linux", target_os = "android"))
extern "C" {
  static stdin: *mut c_void;
  static stdout: *mut c_void;
  static stderr: *mut c_void;
}

@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  static __stdinp: *mut c_void;
  static __stdoutp: *mut c_void;
  static __stderrp: *mut c_void;
}

@cfg(windows)
extern "C" {
  fn __acrt_iob_func(index: u32) -> *mut c_void;
}

extern "C" {
  pub fn fwrite(data: *const u8, size: usize, count: usize, stream: *mut c_void) -> usize;
  pub fn fputc(c: c_int, stream: *mut c_void) -> c_int;
  pub fn fflush(stream: *mut c_void) -> c_int;
  pub fn getc(stream: *mut c_void) -> c_int;
  pub fn fread(data: *mut u8, size: usize, count: usize, stream: *mut c_void) -> usize;
  pub fn ferror(stream: *mut c_void) -> c_int;
  pub fn clearerr(stream: *mut c_void);
}

/// C's `FILE *` of a standard stream: 0 is stdin, 1 stdout and 2 stderr.
@cfg(any(target_os = "linux", target_os = "android"))
pub fn stream(index: i32) -> *mut c_void {
  unsafe { if index == 0 { stdin } else if index == 1 { stdout } else { stderr } }
}

@cfg(any(target_os = "macos", target_os = "ios"))
pub fn stream(index: i32) -> *mut c_void {
  unsafe { if index == 0 { __stdinp } else if index == 1 { __stdoutp } else { __stderrp } }
}

@cfg(windows)
pub fn stream(index: i32) -> *mut c_void {
  unsafe { __acrt_iob_func(index as u32) }
}

@cfg(unix)
extern "C" {
  fn isatty(fd: c_int) -> c_int;
}

/// Whether the standard stream `index` is a terminal.
@cfg(unix)
pub fn is_terminal(index: i32) -> bool {
  (unsafe { isatty(index) }) != 0
}

@cfg(windows)
extern "C" {
  fn GetStdHandle(which: u32) -> *mut c_void;
  fn GetConsoleMode(console: *mut c_void, mode: *mut u32) -> c_int;
}

/// A console, which has a console mode: the C library's `_isatty` also says yes for `NUL` and
/// other character devices.
@cfg(windows)
pub fn is_terminal(index: i32) -> bool {
  // STD_INPUT_HANDLE, STD_OUTPUT_HANDLE and STD_ERROR_HANDLE are -10, -11 and -12.
  const handle = unsafe { GetStdHandle((-10 - index) as u32) };
  var mode = 0u32;

  if handle.is_null() || handle as usize == 0xFFFF_FFFF_FFFF_FFFF {
    return false;
  }

  (unsafe { GetConsoleMode(handle, &mut mode) }) != 0
}

// ---- Files and directories --------------------------------------------------------------------

/// `errno` values that `std::fs` reports itself. They are the same on every supported system,
/// except `ENOTEMPTY`.
pub const ENOENT: i32 = 2;
pub const ENOTDIR: i32 = 20;
pub const EISDIR: i32 = 21;
pub const EINVAL: i32 = 22;

@cfg(any(target_os = "linux", target_os = "android"))
pub const ENOTEMPTY: i32 = 39;
@cfg(any(target_os = "macos", target_os = "ios"))
pub const ENOTEMPTY: i32 = 66;
@cfg(windows)
pub const ENOTEMPTY: i32 = 41;

/// What a path names, as `std::fs` asks it.
pub const KIND_MISSING: i32 = 0;
pub const KIND_FILE: i32 = 1;
pub const KIND_DIR: i32 = 2;
pub const KIND_OTHER: i32 = 3;

@cfg(unix)
const EEXIST: i32 = 17;
@cfg(unix)
const ERANGE: i32 = 34;

@cfg(unix)
extern "C" {
  fn fopen(path: *const c_char, mode: *const c_char) -> *mut c_void;
  fn fclose(file: *mut c_void) -> c_int;
  fn mkdir(path: *const c_char, mode: u32) -> c_int;
  fn rmdir(path: *const c_char) -> c_int;
  fn unlink(path: *const c_char) -> c_int;
  fn rename(from: *const c_char, to: *const c_char) -> c_int;
  fn getcwd(buffer: *mut c_char, size: usize) -> *mut c_char;
  fn opendir(path: *const c_char) -> *mut c_void;
  fn readdir(dir: *mut c_void) -> *const u8;
  fn closedir(dir: *mut c_void) -> c_int;
  fn stat(path: *const c_char, info: *mut StatBuffer) -> c_int;
}

/// Room for C's `struct stat` on every system, read at the offset of its `st_mode`. On macOS for
/// Intel, `stat` and `readdir` are the symbols of 32-bit inodes, which Apple still exports: the
/// 64-bit ones are named `stat$INODE64` and `readdir$INODE64`, which C cannot name.
@cfg(unix)
@repr(C)
struct StatBuffer {
  pub words: [u64; 32];
}

/// Where `st_mode` is in `struct stat`, and how many bytes it has.
@cfg(all(any(target_os = "linux", target_os = "android"), target_arch = "x86_64"))
const MODE_OFFSET: usize = 24;
@cfg(all(any(target_os = "linux", target_os = "android"), not(target_arch = "x86_64")))
const MODE_OFFSET: usize = 16;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const MODE_OFFSET: usize = 4;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const MODE_OFFSET: usize = 8;

@cfg(any(target_os = "linux", target_os = "android"))
const MODE_BYTES: usize = 4;
@cfg(any(target_os = "macos", target_os = "ios"))
const MODE_BYTES: usize = 2;

/// Where `d_name` is in `struct dirent`.
@cfg(any(target_os = "linux", target_os = "android"))
const NAME_OFFSET: usize = 19;
@cfg(any(target_os = "ios", all(target_os = "macos", target_arch = "aarch64")))
const NAME_OFFSET: usize = 21;
@cfg(all(target_os = "macos", target_arch = "x86_64"))
const NAME_OFFSET: usize = 8;

/// `path` as a C string, or `None` if it holds a NUL.
@cfg(unix)
fn c_path(path: String) -> Option<CString> {
  match CString::new(path) {
    Ok(found) => Some(found),
    Err(_) => None,
  }
}

/// The code of the last failed call of the C library.
@cfg(unix)
fn failure() -> i32 {
  super::last_error()
}

@cfg(unix)
pub fn path_kind(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return KIND_MISSING,
  };
  var info = StatBuffer { words: [0u64; 32] };

  if unsafe { stat(name.as_ptr(), &mut info) } != 0 {
    return KIND_MISSING;
  }

  const at = unsafe { (&raw const info as *const u8).add(MODE_OFFSET) };
  const mode = if MODE_BYTES == 2 { (unsafe { *(at as *const u16) }) as u32 } else { unsafe { *(at as *const u32) } };
  // The type is the fourth octal digit from the end: `S_IFDIR` is 0o040000, `S_IFREG` 0o100000.
  const file_type = mode / 4096 % 16;

  if file_type == 4 {
    KIND_DIR
  } else if file_type == 8 {
    KIND_FILE
  } else {
    KIND_OTHER
  }
}

/// The bytes of the file at `path`, or the code of the failure.
@cfg(unix)
pub fn read_file(path: String) -> Result<List<u8>, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  const mode = CString::new("rb").unwrap();

  clear_errno();

  const file = unsafe { fopen(name.as_ptr(), mode.as_ptr()) };

  if file.is_null() {
    return Err(failure());
  }

  const data = new List<u8>();

  loop {
    const start = data.len();

    data.resize(start + 4096, 0);

    const read = unsafe { fread(data.as_mut_ptr().add(start), 1, 4096, file) };

    data.resize(start + read, 0);

    if read == 0 {
      break;
    }
  }

  const failed = unsafe { ferror(file) } != 0;
  const code = if failed { failure() } else { 0 };

  unsafe { fclose(file); }

  if failed { Err(code) } else { Ok(data) }
}

/// Writes `len` bytes at `data` to the file at `path`, creating it, replacing it or appending.
@cfg(unix)
pub fn write_file(path: String, data: *const u8, len: usize, append: bool) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };
  const mode = CString::new(if append { "ab" } else { "wb" }).unwrap();

  clear_errno();

  const file = unsafe { fopen(name.as_ptr(), mode.as_ptr()) };

  if file.is_null() {
    return failure();
  }

  var code = 0;

  if len > 0 && unsafe { fwrite(data, 1, len, file) } != len {
    code = failure();
  }

  if unsafe { fclose(file) } != 0 && code == 0 {
    code = failure();
  }

  code
}

@cfg(unix)
pub fn create_dir(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  // 0o777, less the umask.
  if unsafe { mkdir(name.as_ptr(), 511) } == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn remove_dir(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  const code = if unsafe { rmdir(name.as_ptr()) } == 0 { 0 } else { failure() };

  // Some systems report a directory that is not empty as `EEXIST`.
  if code == EEXIST { ENOTEMPTY } else { code }
}

@cfg(unix)
pub fn remove_file(path: String) -> i32 {
  const name = match c_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  if unsafe { unlink(name.as_ptr()) } == 0 { 0 } else { failure() }
}

@cfg(unix)
pub fn rename_path(from: String, to: String) -> i32 {
  const source = match c_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match c_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  clear_errno();

  if unsafe { rename(source.as_ptr(), target.as_ptr()) } == 0 { 0 } else { failure() }
}

/// Copies the bytes of the file `from` to `to`, which is created or replaced.
@cfg(unix)
pub fn copy_file(from: String, to: String) -> i32 {
  match read_file(from) {
    Ok(data) => write_file(to, data.as_ptr(), data.len(), false),
    Err(code) => code,
  }
}

/// The names in the directory `path`, without `.` and `..`; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn read_dir(path: String) -> Result<List<String>, i32> {
  const name = match c_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };

  clear_errno();

  const dir = unsafe { opendir(name.as_ptr()) };

  if dir.is_null() {
    return Err(failure());
  }

  const names = new List<String>();

  loop {
    const entry = unsafe { readdir(dir) };

    if entry.is_null() {
      break;
    }

    const text = unsafe { string_from_c(entry.add(NAME_OFFSET) as *const c_char) };

    if text != "." && text != ".." {
      names.push(text);
    }
  }

  unsafe { closedir(dir); }
  Ok(names)
}

@cfg(unix)
pub fn current_dir() -> Result<String, i32> {
  var size = 256usize;

  loop {
    const buffer = new List<u8>();

    buffer.resize(size, 0);
    clear_errno();

    const found = unsafe { getcwd(buffer.as_mut_ptr() as *mut c_char, size) };

    if !found.is_null() {
      return Ok(unsafe { string_from_c(found as *const c_char) });
    }

    if errno() != ERANGE {
      return Err(failure());
    }

    size *= 2;
  }
}

/// `WIN32_FIND_DATAW`.
@cfg(windows)
@repr(C)
struct FindData {
  pub attributes: u32;
  pub created: FileTime;
  pub accessed: FileTime;
  pub written: FileTime;
  pub size_high: u32;
  pub size_low: u32;
  pub reserved0: u32;
  pub reserved1: u32;
  pub name: [u16; 260];
  pub alternate_name: [u16; 14];
}

@cfg(windows)
extern "C" {
  fn CreateFileW(name: *const u16, access: u32, share: u32, security: *mut c_void, disposition: u32, flags: u32, template_file: *mut c_void) -> *mut c_void;
  fn ReadFile(file: *mut c_void, buffer: *mut u8, size: u32, read: *mut u32, overlapped: *mut c_void) -> c_int;
  fn WriteFile(file: *mut c_void, buffer: *const u8, size: u32, written: *mut u32, overlapped: *mut c_void) -> c_int;
  fn CloseHandle(handle: *mut c_void) -> c_int;
  fn GetFileAttributesW(name: *const u16) -> u32;
  fn CreateDirectoryW(name: *const u16, security: *mut c_void) -> c_int;
  fn RemoveDirectoryW(name: *const u16) -> c_int;
  fn DeleteFileW(name: *const u16) -> c_int;
  fn MoveFileExW(from: *const u16, to: *const u16, flags: u32) -> c_int;
  fn CopyFileW(from: *const u16, to: *const u16, fail_if_exists: c_int) -> c_int;
  fn FindFirstFileW(pattern: *const u16, data: *mut FindData) -> *mut c_void;
  fn FindNextFileW(find: *mut c_void, data: *mut FindData) -> c_int;
  fn FindClose(find: *mut c_void) -> c_int;
  fn GetCurrentDirectoryW(size: u32, buffer: *mut u16) -> u32;
  fn GetLastError() -> u32;
}

/// `INVALID_HANDLE_VALUE`, -1.
@cfg(windows)
fn invalid(handle: *mut c_void) -> bool {
  handle as usize == 0xFFFF_FFFF_FFFF_FFFF
}

/// The `errno` value of the last Windows error, so that kinds and messages match other systems.
@cfg(windows)
fn failure() -> i32 {
  const error = unsafe { GetLastError() };

  if error == 2 || error == 3 || error == 15 || error == 161 {
    // ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND, ERROR_INVALID_DRIVE, ERROR_BAD_PATHNAME.
    ENOENT
  } else if error == 5 || error == 32 || error == 33 {
    // ERROR_ACCESS_DENIED, ERROR_SHARING_VIOLATION, ERROR_LOCK_VIOLATION: EACCES.
    13
  } else if error == 80 || error == 183 {
    // ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS: EEXIST.
    17
  } else if error == 87 || error == 123 {
    // ERROR_INVALID_PARAMETER, ERROR_INVALID_NAME.
    EINVAL
  } else if error == 145 {
    // ERROR_DIR_NOT_EMPTY.
    ENOTEMPTY
  } else if error == 267 {
    // ERROR_DIRECTORY.
    ENOTDIR
  } else if error == 8 || error == 14 {
    // ERROR_NOT_ENOUGH_MEMORY, ERROR_OUTOFMEMORY: ENOMEM.
    12
  } else if error == 39 || error == 112 {
    // ERROR_HANDLE_DISK_FULL, ERROR_DISK_FULL: ENOSPC.
    28
  } else {
    super::UNKNOWN
  }
}

/// `path` as NUL-terminated UTF-16, or `None` if it holds a NUL.
@cfg(windows)
fn wide_path(path: String) -> Option<List<u16>> {
  if path.contains("\0") { None } else { Some(to_utf16(path)) }
}

@cfg(windows)
pub fn path_kind(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return KIND_MISSING,
  };
  const attributes = unsafe { GetFileAttributesW(name.as_ptr()) };

  // INVALID_FILE_ATTRIBUTES, and FILE_ATTRIBUTE_DIRECTORY (0x10).
  if attributes == 0xFFFF_FFFF {
    KIND_MISSING
  } else if attributes / 16 % 2 == 1 {
    KIND_DIR
  } else {
    KIND_FILE
  }
}

@cfg(windows)
pub fn read_file(path: String) -> Result<List<u8>, i32> {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  // GENERIC_READ, sharing everything, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL.
  const file = unsafe { CreateFileW(name.as_ptr(), 0x8000_0000, 7, 0 as *mut c_void, 3, 0x80, 0 as *mut c_void) };

  if invalid(file) {
    return Err(failure());
  }

  const data = new List<u8>();
  var code = 0;

  loop {
    const start = data.len();
    var read = 0u32;

    data.resize(start + 4096, 0);

    const done = unsafe { ReadFile(file, data.as_mut_ptr().add(start), 4096, &mut read, 0 as *mut c_void) } != 0;

    data.resize(start + read as usize, 0);

    if !done {
      code = failure();
      break;
    }

    if read == 0 {
      break;
    }
  }

  unsafe { CloseHandle(file); }

  if code == 0 { Ok(data) } else { Err(code) }
}

@cfg(windows)
pub fn write_file(path: String, data: *const u8, len: usize, append: bool) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };
  // FILE_APPEND_DATA with OPEN_ALWAYS, or GENERIC_WRITE with CREATE_ALWAYS.
  const access = if append { 0x4u32 } else { 0x4000_0000u32 };
  const disposition = if append { 4u32 } else { 2u32 };
  const file = unsafe { CreateFileW(name.as_ptr(), access, 7, 0 as *mut c_void, disposition, 0x80, 0 as *mut c_void) };

  if invalid(file) {
    return failure();
  }

  var code = 0;
  var done = 0usize;

  while done < len {
    const left = len - done;
    const size = if left > 0x4000_0000 { 0x4000_0000u32 } else { left as u32 };
    var written = 0u32;

    if unsafe { WriteFile(file, data.add(done), size, &mut written, 0 as *mut c_void) } == 0 {
      code = failure();
      break;
    }

    done += written as usize;
  }

  if unsafe { CloseHandle(file) } == 0 && code == 0 {
    code = failure();
  }

  code
}

@cfg(windows)
pub fn create_dir(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { CreateDirectoryW(name.as_ptr(), 0 as *mut c_void) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn remove_dir(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { RemoveDirectoryW(name.as_ptr()) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn remove_file(path: String) -> i32 {
  const name = match wide_path(path) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { DeleteFileW(name.as_ptr()) } != 0 { 0 } else { failure() }
}

/// Replaces the target, as POSIX does: MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED.
@cfg(windows)
pub fn rename_path(from: String, to: String) -> i32 {
  const source = match wide_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match wide_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { MoveFileExW(source.as_ptr(), target.as_ptr(), 3) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn copy_file(from: String, to: String) -> i32 {
  const source = match wide_path(from) {
    Some(found) => found,
    None => return EINVAL,
  };
  const target = match wide_path(to) {
    Some(found) => found,
    None => return EINVAL,
  };

  if unsafe { CopyFileW(source.as_ptr(), target.as_ptr(), 0) } != 0 { 0 } else { failure() }
}

@cfg(windows)
pub fn read_dir(path: String) -> Result<List<String>, i32> {
  if path.is_empty() {
    return Err(ENOENT);
  }

  // `path\*`, without doubling a trailing separator.
  const pattern = if path.ends_with("\\") || path.ends_with("/") { path + "*" } else { path + "\\*" };
  const name = match wide_path(pattern) {
    Some(found) => found,
    None => return Err(EINVAL),
  };
  var data = FindData {
    attributes: 0,
    created: FileTime { low: 0, high: 0 },
    accessed: FileTime { low: 0, high: 0 },
    written: FileTime { low: 0, high: 0 },
    size_high: 0,
    size_low: 0,
    reserved0: 0,
    reserved1: 0,
    name: [0u16; 260],
    alternate_name: [0u16; 14],
  };
  const find = unsafe { FindFirstFileW(name.as_ptr(), &mut data) };

  if invalid(find) {
    return Err(failure());
  }

  const names = new List<String>();

  loop {
    const units = new List<u16>();
    var at = 0usize;

    while at < 260 && data.name[at] != 0 {
      units.push(data.name[at]);
      at += 1;
    }

    const text = from_utf16_lossy(&units);

    if text != "." && text != ".." {
      names.push(text);
    }

    if unsafe { FindNextFileW(find, &mut data) } == 0 {
      break;
    }
  }

  unsafe { FindClose(find); }
  Ok(names)
}

@cfg(windows)
pub fn current_dir() -> Result<String, i32> {
  // Without a buffer, the size it needs with its terminator.
  const size = unsafe { GetCurrentDirectoryW(0, 0 as *mut u16) };

  if size == 0 {
    return Err(failure());
  }

  const buffer = new List<u16>();

  buffer.resize(size as usize, 0);

  const len = unsafe { GetCurrentDirectoryW(size, buffer.as_mut_ptr()) };

  if len == 0 {
    return Err(failure());
  }

  if len >= size {
    return Err(super::UNKNOWN);
  }

  Ok(from_utf16_lossy(&buffer[0..len as usize]))
}
