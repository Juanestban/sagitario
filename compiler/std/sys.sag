//! `std::sys`: the C API of each system that the standard library is written on, and the code that
//! differs by system, as Rust's `std/src/sys` (docs/adr/0085-conditional-compilation-and-std-time.md,
//! Q551). Only the modules of `std` can name it.

use std::ffi::c_int;
use std::ffi::c_char;
@cfg(unix)
use std::ffi::{c_long, CString, string_from_c};

// ---- errno ------------------------------------------------------------------------------------

@cfg(target_os = "linux")
extern "C" {
  fn __errno_location() -> *mut c_int;
}

@cfg(target_os = "android")
extern "C" {
  fn __errno() -> *mut c_int;
}

@cfg(any(target_os = "macos", target_os = "ios"))
extern "C" {
  fn __error() -> *mut c_int;
}

/// The error of the last call to the C library that failed in this thread: C's `errno`, which is
/// a macro reaching a function whose name changes with the C library.
@cfg(target_os = "linux")
pub fn errno() -> i32 {
  unsafe { *__errno_location() }
}

@cfg(target_os = "android")
pub fn errno() -> i32 {
  unsafe { *__errno() }
}

@cfg(any(target_os = "macos", target_os = "ios"))
pub fn errno() -> i32 {
  unsafe { *__error() }
}

/// A call interrupted by a signal, on every Unix system.
@cfg(unix)
const EINTR: i32 = 4;

// ---- Clocks and sleeping ----------------------------------------------------------------------

/// `struct timespec`, whose `time_t` has 64 bits, except on 32-bit Android.
@cfg(all(unix, not(all(target_os = "android", target_pointer_width = "32"))))
@repr(C)
pub struct Timespec {
  pub tv_sec: i64;
  pub tv_nsec: c_long;

  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: secs as i64, tv_nsec: nanos as c_long }
  }

  /// The nanoseconds it holds, or zero for a time before 1970.
  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

/// `struct timespec` on 32-bit Android, whose `time_t` has 32 bits.
@cfg(all(target_os = "android", target_pointer_width = "32"))
@repr(C)
pub struct Timespec {
  pub tv_sec: i32;
  pub tv_nsec: c_long;

  /// At most 2^31 - 1 seconds, about 68 years.
  pub fn of(secs: u64, nanos: u64) -> Timespec {
    Timespec { tv_sec: if secs > 0x7FFF_FFFF { 0x7FFF_FFFF } else { secs as i32 }, tv_nsec: nanos as c_long }
  }

  pub fn nanos(self) -> u64 {
    if self.tv_sec < 0 { 0 } else { self.tv_sec as u64 * 1_000_000_000 + self.tv_nsec as u64 }
  }
}

@cfg(unix)
const CLOCK_REALTIME: c_int = 0;

@cfg(any(target_os = "linux", target_os = "android"))
const CLOCK_MONOTONIC: c_int = 1;

@cfg(any(target_os = "macos", target_os = "ios"))
const CLOCK_MONOTONIC: c_int = 6;

@cfg(unix)
extern "C" {
  fn clock_gettime(clock: c_int, now: *mut Timespec) -> c_int;
  fn nanosleep(duration: *const Timespec, left: *mut Timespec) -> c_int;
}

/// `FILETIME`: 100-nanosecond intervals since 1601-01-01, in two halves.
@cfg(windows)
@repr(C)
pub struct FileTime {
  pub low: u32;
  pub high: u32;
}

@cfg(windows)
extern "C" {
  fn QueryPerformanceCounter(count: *mut i64) -> c_int;
  fn QueryPerformanceFrequency(frequency: *mut i64) -> c_int;
  fn GetSystemTimePreciseAsFileTime(time: *mut FileTime);
  fn Sleep(milliseconds: u32);
}

/// A monotonic clock, in nanoseconds since a start that means nothing outside the program.
@cfg(unix)
pub fn monotonic_nanos() -> u64 {
  clock(CLOCK_MONOTONIC)
}

/// The system clock, in nanoseconds since 1970-01-01 00:00:00 UTC, or zero before it.
@cfg(unix)
pub fn system_nanos() -> u64 {
  clock(CLOCK_REALTIME)
}

@cfg(unix)
fn clock(id: c_int) -> u64 {
  var now = Timespec::of(0, 0);

  if unsafe { clock_gettime(id, &mut now) } != 0 {
    return 0;
  }

  now.nanos()
}

@cfg(windows)
pub fn monotonic_nanos() -> u64 {
  var count = 0i64;
  var frequency = 1i64;

  unsafe {
    QueryPerformanceCounter(&mut count);
    QueryPerformanceFrequency(&mut frequency);
  }

  if frequency <= 0 || count < 0 {
    return 0;
  }

  const ticks = count as u64;
  const rate = frequency as u64;

  // Split so that `ticks * 10^9` cannot overflow.
  ticks / rate * 1_000_000_000 + ticks % rate * 1_000_000_000 / rate
}

@cfg(windows)
pub fn system_nanos() -> u64 {
  var now = FileTime { low: 0, high: 0 };

  unsafe { GetSystemTimePreciseAsFileTime(&mut now); }

  // The Unix epoch is 11644473600 seconds after 1601-01-01.
  const intervals = now.high as u64 * 0x1_0000_0000 + now.low as u64;
  const epoch = 116_444_736_000_000_000u64;

  if intervals < epoch { 0 } else { (intervals - epoch) * 100 }
}

/// Pauses the calling thread for at least `nanos` nanoseconds, resuming after a signal.
@cfg(unix)
pub fn sleep_nanos(nanos: u64) {
  var left = Timespec::of(nanos / 1_000_000_000, nanos % 1_000_000_000);

  loop {
    const asked = left;

    if unsafe { nanosleep(&asked, &mut left) } == 0 || errno() != EINTR {
      return;
    }
  }
}

/// In whole milliseconds, rounded up so that the program never sleeps less than asked.
@cfg(windows)
pub fn sleep_nanos(nanos: u64) {
  var millis = nanos / 1_000_000 + if nanos % 1_000_000 != 0 { 1 } else { 0 };

  while millis > 0 {
    const part = if millis > 0x7FFF_FFFF { 0x7FFF_FFFFu64 } else { millis };

    unsafe { Sleep(part as u32); }
    millis -= part;
  }
}

// ---- Arguments and environment variables ------------------------------------------------------

/// What C's `main` received, which the runtime's core passes on when the program starts
/// (`std::env`, `sag_env_init`), as Rust's `lang_start` gives them to its `std`. The address of
/// `argv` is kept as a number, so that the static is computed by the compiler.
@cfg(unix)
static var ARGC: c_int = 0;

@cfg(unix)
static var ARGV: usize = 0;

@cfg(unix)
extern "C" {
  fn getenv(name: *const c_char) -> *const c_char;
}

@cfg(unix)
pub fn set_args(argc: c_int, argv: *const *const c_char) {
  unsafe {
    ARGC = argc;
    ARGV = argv as usize;
  }
}

/// Windows reads its own command line, as UTF-16.
@cfg(windows)
pub fn set_args(_argc: c_int, _argv: *const *const c_char) {
  // C's `argv` is in the ANSI code page, not UTF-16.
}

/// The arguments C's `main` received; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn args() -> List<String> {
  const args = new List<String>();
  const count = unsafe { ARGC };
  const argv = unsafe { ARGV } as *const *const c_char;

  if argv.is_null() || count <= 0 {
    return args;
  }

  for index in 0..count as usize {
    const arg = unsafe { *argv.add(index) };

    if arg.is_null() {
      break;
    }

    args.push(unsafe { string_from_c(arg) });
  }

  args
}

/// The value of an environment variable; invalid UTF-8 becomes U+FFFD.
@cfg(unix)
pub fn variable(name: String) -> Option<String> {
  const c_name = match CString::new(name) {
    Ok(found) => found,
    Err(_) => return None,
  };
  const value = unsafe { getenv(c_name.as_ptr()) };

  if value.is_null() { None } else { Some(unsafe { string_from_c(value) }) }
}

@cfg(windows)
extern "C" {
  fn GetCommandLineW() -> *const u16;
  fn GetEnvironmentVariableW(name: *const u16, buffer: *mut u16, size: u32) -> u32;
}

@cfg(windows)
const QUOTE: u16 = 0x22;
@cfg(windows)
const BACKSLASH: u16 = 0x5C;
@cfg(windows)
const SPACE: u16 = 0x20;
@cfg(windows)
const TAB: u16 = 0x09;

/// The code unit `at` of a NUL-terminated UTF-16 text.
@cfg(windows)
fn unit(text: *const u16, at: usize) -> u16 {
  unsafe { *text.add(at) }
}

/// The arguments, split from the command line with the rules of Microsoft's C runtime.
@cfg(windows)
pub fn args() -> List<String> {
  const args = new List<String>();
  const line = unsafe { GetCommandLineW() };

  if line.is_null() {
    return args;
  }

  const arg = new List<u16>();
  var at = 0usize;

  // The program ends at the first space, or at the closing quote; backslashes are kept.
  if unit(line, at) == QUOTE {
    at += 1;

    while unit(line, at) != 0 && unit(line, at) != QUOTE {
      arg.push(unit(line, at));
      at += 1;
    }

    if unit(line, at) == QUOTE {
      at += 1;
    }
  } else {
    while unit(line, at) != 0 && unit(line, at) != SPACE && unit(line, at) != TAB {
      arg.push(unit(line, at));
      at += 1;
    }
  }

  args.push(from_utf16_lossy(&arg));

  loop {
    while unit(line, at) == SPACE || unit(line, at) == TAB {
      at += 1;
    }

    if unit(line, at) == 0 {
      return args;
    }

    var quoted = false;

    arg.clear();

    while unit(line, at) != 0 && (quoted || (unit(line, at) != SPACE && unit(line, at) != TAB)) {
      const c = unit(line, at);

      if c == BACKSLASH {
        var slashes = 0usize;

        while unit(line, at) == BACKSLASH {
          slashes += 1;
          at += 1;
        }

        // 2n backslashes and a quote: n backslashes, and the quote delimits. 2n + 1: n
        // backslashes and a literal quote. Backslashes elsewhere are literal.
        const kept = if unit(line, at) == QUOTE { slashes / 2 } else { slashes };

        for _ in 0..kept {
          arg.push(BACKSLASH);
        }

        if unit(line, at) == QUOTE && slashes % 2 == 1 {
          arg.push(QUOTE);
          at += 1;
        }
      } else if c == QUOTE {
        if quoted && unit(line, at + 1) == QUOTE {
          arg.push(QUOTE);
          at += 2;
        } else {
          quoted = !quoted;
          at += 1;
        }
      } else {
        arg.push(c);
        at += 1;
      }
    }

    args.push(from_utf16_lossy(&arg));
  }
}

/// The value of an environment variable, read as UTF-16.
@cfg(windows)
pub fn variable(name: String) -> Option<String> {
  const wide = to_utf16(name);
  // Without a buffer, the size it needs with its terminator; 0 when the variable is not set.
  const size = unsafe { GetEnvironmentVariableW(wide.as_ptr(), 0 as *mut u16, 0) };

  if size == 0 {
    return None;
  }

  const value = new List<u16>();

  value.resize(size as usize, 0);

  const written = unsafe { GetEnvironmentVariableW(wide.as_ptr(), value.as_mut_ptr(), size) };

  // The variable grew in between.
  if written >= size {
    return None;
  }

  Some(from_utf16_lossy(&value[0..written as usize]))
}

/// UTF-16 code units as a string; an unpaired surrogate becomes U+FFFD.
@cfg(windows)
pub fn from_utf16_lossy(units: &[u16]) -> String {
  const text = new StringBuilder();
  var index = 0usize;

  while index < units.len() {
    var code = units[index] as u32;

    index += 1;

    if code >= 0xD800 && code <= 0xDBFF && index < units.len() && units[index] as u32 >= 0xDC00 && units[index] as u32 <= 0xDFFF {
      code = 0x10000 + (code - 0xD800) * 0x400 + (units[index] as u32 - 0xDC00);
      index += 1;
    } else if code >= 0xD800 && code <= 0xDFFF {
      code = 0xFFFD;
    }

    text.append_char(char::from_u32(code).unwrap_or('?'));
  }

  text.to_string()
}

/// A string as NUL-terminated UTF-16.
@cfg(windows)
pub fn to_utf16(text: String) -> List<u16> {
  const units = new List<u16>();

  for c in text.chars() {
    const code = c as u32;

    if code >= 0x10000 {
      units.push((0xD800 + (code - 0x10000) / 0x400) as u16);
      units.push((0xDC00 + (code - 0x10000) % 0x400) as u16);
    } else {
      units.push(code as u16);
    }
  }

  units.push(0);
  units
}
