//! `std::math`: constants of `f64`, and the methods of floats as functions of `f64`
//! (docs/spec/11-standard-library.md#stdmath). `f32` has the same methods; its constants are
//! these converted with `as f32`.

/// Archimedes' constant, π.
pub const PI: f64 = 3.141592653589793;
/// The full circle constant, τ = 2π.
pub const TAU: f64 = 6.283185307179586;
/// Euler's number, e.
pub const E: f64 = 2.718281828459045;
/// √2.
pub const SQRT_2: f64 = 1.4142135623730951;
/// ln(2).
pub const LN_2: f64 = 0.6931471805599453;
/// ln(10).
pub const LN_10: f64 = 2.302585092994046;
/// The difference between `1.0` and the next larger `f64`.
pub const EPSILON: f64 = 2.220446049250313e-16;
/// The smallest finite `f64`.
pub const MIN: f64 = -1.7976931348623157e308;
/// The largest finite `f64`.
pub const MAX: f64 = 1.7976931348623157e308;
/// Positive infinity.
pub const INFINITY: f64 = 1.0 / 0.0;
/// Negative infinity.
pub const NEG_INFINITY: f64 = -1.0 / 0.0;
/// Not a number: it is not equal to anything, itself included.
pub const NAN: f64 = 0.0 / 0.0;

pub fn abs(x: f64) -> f64 {
  x.abs()
}

/// `1.0` for positive numbers, `+0.0` and infinity, `-1.0` for negative ones, `-0.0` and
/// negative infinity, and NaN for NaN.
pub fn signum(x: f64) -> f64 {
  x.signum()
}

/// The magnitude of `x` with the sign of `sign`.
pub fn copysign(x: f64, sign: f64) -> f64 {
  x.copysign(sign)
}

/// The smaller of `a` and `b`; if one of them is NaN, the other.
pub fn min(a: f64, b: f64) -> f64 {
  a.min(b)
}

/// The larger of `a` and `b`; if one of them is NaN, the other.
pub fn max(a: f64, b: f64) -> f64 {
  a.max(b)
}

/// `x` restricted to `min..=max`, or NaN if `x` is NaN; panics unless `min <= max`.
pub fn clamp(x: f64, min: f64, max: f64) -> f64 {
  x.clamp(min, max)
}

/// The point at `t` from `a` (`t == 0.0`) to `b` (`t == 1.0`): `(1 - t) * a + t * b`.
pub fn lerp(a: f64, b: f64, t: f64) -> f64 {
  a.lerp(b, t)
}

pub fn floor(x: f64) -> f64 {
  x.floor()
}

pub fn ceil(x: f64) -> f64 {
  x.ceil()
}

/// The nearest integer, halves away from zero.
pub fn round(x: f64) -> f64 {
  x.round()
}

/// The integer part, towards zero.
pub fn trunc(x: f64) -> f64 {
  x.trunc()
}

/// `x - trunc(x)`, with the sign of `x`.
pub fn fract(x: f64) -> f64 {
  x.fract()
}

pub fn is_nan(x: f64) -> bool {
  x.is_nan()
}

pub fn is_infinite(x: f64) -> bool {
  x.is_infinite()
}

pub fn is_finite(x: f64) -> bool {
  x.is_finite()
}
