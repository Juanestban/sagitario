//! `std::task`: what tasks of `async fn` wait for, and running them from synchronous code
//! (docs/spec/12-async.md#stdtask). `Task` is the prelude's; this module uses its private
//! members (docs/spec/11-standard-library.md#implementation-rules).

use std::time::Duration;

extern "C" {
  fn sag_task_timer(nanos: u64, resume: fn());
  fn sag_task_step() -> bool;
  fn sag_task_inside() -> bool;
  fn sag_task_spawn_blocking(body: fn(), done: fn());
}

/// Where the thread of `spawn_blocking` leaves what its function returned, for its task.
class Slot<T> {
  pub var value: Option<T>;

  pub fn new(self) {
    self.value = None;
  }
}

/// A task that finishes after at least `duration`. Even a zero duration lets the tasks already
/// ready run first.
pub fn sleep(duration: Duration) -> Task<()> {
  const task = new Task<()>();

  unsafe { sag_task_timer(duration.as_nanos(), () => task.complete(())) };
  task
}

/// A task that runs `body` on a new thread, and finishes with what it returns: for work that
/// would stop the other tasks of this thread. `body` is a lambda capturing only `Send` values, or
/// the name of a function, as for `thread::spawn` (docs/adr/0073-spawn-blocking.md).
pub fn spawn_blocking<T>(body: fn() -> T) -> Task<T> {
  const task = new Task<T>();
  const slot = new Slot<T>();

  // The runtime joins the thread before running the second function, which so sees the value.
  unsafe {
    sag_task_spawn_blocking(() => { slot.value = Some(body()); }, () => {
      match slot.value {
        Some(value) => task.complete(value),
        None => panic("the thread of `task::spawn_blocking` returned nothing"),
      }
    })
  };
  task
}

/// Runs the tasks of this thread until `task` finishes, and returns its result. The other tasks
/// that have not finished stay for the next `block_on`.
pub fn block_on<T>(task: Task<T>) -> T {
  if unsafe { sag_task_inside() } {
    panic("`task::block_on` cannot be called inside a task: use `await`");
  }

  while !task.is_done() {
    if !unsafe { sag_task_step() } {
      panic("`task::block_on` waits for a task that no other task, timer or `spawn_blocking` can finish");
    }
  }

  task.value()
}
