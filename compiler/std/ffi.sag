//! The part of `std::ffi` written in Sagitario (docs/spec/10-ffi.md#dynamic-libraries): loading
//! dynamic libraries at run time. The C types, `CString` and `string_from_c` are provided by the
//! compiler.

use std::ffi::c_void;
use std::sys;

/// A dynamic library loaded at run time (`LoadLibraryW`, `dlopen`). It is never unloaded, so the
/// function pointers taken from it stay valid until the program ends.
pub class Library {
  prv const handle: *mut c_void;

  prv fn new(self, handle: *mut c_void) {
    self.handle = handle;
  }

  /// Loads the library at `path`, or by its name, as the system finds it (`vulkan-1.dll`,
  /// `libvulkan.so.1`). The error is the system's reason.
  pub fn open(path: String) -> Result<Library, String> {
    match sys::open_library(path) {
      Ok(handle) => Ok(new Library(handle)),
      Err(reason) => Err(`cannot load the library "${path}": ${reason}`),
    }
  }

  /// The function `name` of the library, or `None`; convert it to its type with `as` inside
  /// `unsafe`.
  pub fn symbol(self, name: String) -> Option<unsafe extern "C" fn()> {
    sys::library_symbol(self.handle, name)
  }
}
