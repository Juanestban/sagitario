//! `std::io`: standard input and output with errors as values, and the error type of every
//! input or output operation (docs/spec/11-standard-library.md#stdio).

extern "C" {
  fn sag_io_write(stream: i32, text: String, newline: bool) -> i32;
  fn sag_io_flush() -> i32;
  fn sag_io_read_line(status: *mut i32) -> String;
  fn sag_io_read_all(status: *mut i32) -> String;
  fn sag_io_read_exact(count: usize, status: *mut i32) -> String;
  fn sag_io_is_terminal(stream: i32) -> bool;
}

/// What kind of failure an I/O error is.
pub enum ErrorKind {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  InvalidInput,
  /// The data is not valid, such as input that is not UTF-8.
  InvalidData,
  UnexpectedEof,
  Other,
}

/// A standard stream of the program.
pub enum Stream {
  Stdin,
  Stdout,
  Stderr,
}

/// Whether `stream` is connected to a terminal rather than to a file or a pipe, such as to color
/// what is written only for a person to read.
pub fn is_terminal(stream: Stream) -> bool {
  const fd = match stream {
    Stream::Stdin => 0,
    Stream::Stdout => 1,
    Stream::Stderr => 2,
  };

  unsafe { sag_io_is_terminal(fd) }
}

/// The error of an input or output operation: its kind and the operating system's message.
pub class Error impl std::prelude::Error {
  prv const error_kind: ErrorKind;
  prv const text: String;

  pub fn new(self, kind: ErrorKind, message: String) {
    self.error_kind = kind;
    self.text = message;
  }

  pub fn kind(self) -> ErrorKind {
    self.error_kind
  }

  pub fn message(self) -> String {
    self.text
  }
}

/// The error with this runtime code.
fn error_from(code: i32) -> Error {
  super::os_error(code, "")
}

/// The result of an operation that returned this runtime code, 0 on success.
fn done(code: i32) -> Result<(), Error> {
  if code == 0 { Ok(()) } else { Err(error_from(code)) }
}

/// Writes `text` to stdout.
pub fn print(text: String) -> Result<(), Error> {
  done(unsafe { sag_io_write(1, text, false) })
}

/// Writes `text` and a newline to stdout.
pub fn println(text: String) -> Result<(), Error> {
  done(unsafe { sag_io_write(1, text, true) })
}

/// Writes `text` to stderr.
pub fn eprint(text: String) -> Result<(), Error> {
  done(unsafe { sag_io_write(2, text, false) })
}

/// Writes `text` and a newline to stderr.
pub fn eprintln(text: String) -> Result<(), Error> {
  done(unsafe { sag_io_write(2, text, true) })
}

/// Writes out what stdout holds in its buffer.
pub fn flush() -> Result<(), Error> {
  done(unsafe { sag_io_flush() })
}

/// The next line of stdin without its `\n` or `\r\n`, or `None` at the end of the input. Input
/// that is not UTF-8 is an error of kind `InvalidData`.
pub fn read_line() -> Result<Option<String>, Error> {
  var status = [0i32; 1];
  const line = unsafe { sag_io_read_line(status.as_mut_ptr()) };

  if status[0] == 0 {
    Ok(Some(line))
  } else if status[0] == -1 {
    // The end of the input (`SAG_IO_END` in the runtime).
    Ok(None)
  } else {
    Err(error_from(status[0]))
  }
}

/// Exactly `count` bytes of stdin, such as a message whose length is known. An input that ends
/// before is an error of kind `UnexpectedEof`, and bytes that are not UTF-8 one of kind
/// `InvalidData`; the bytes read are lost either way.
pub fn read_exact(count: usize) -> Result<String, Error> {
  var status = [0i32; 1];
  const text = unsafe { sag_io_read_exact(count, status.as_mut_ptr()) };

  if status[0] == 0 { Ok(text) } else { Err(error_from(status[0])) }
}

/// The rest of stdin. Input that is not UTF-8 is an error of kind `InvalidData`.
pub fn read_to_string() -> Result<String, Error> {
  var status = [0i32; 1];
  const text = unsafe { sag_io_read_all(status.as_mut_ptr()) };

  if status[0] == 0 { Ok(text) } else { Err(error_from(status[0])) }
}
