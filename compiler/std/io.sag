//! `std::io`: standard input and output with errors as values, and the error type of every
//! input or output operation (docs/spec/11-standard-library.md#stdio), on C's streams in
//! `std::sys`, which the prelude's printing shares (docs/adr/0086-c-globals-and-std-io.md).

use std::ffi::c_void;
use std::sys;

/// What kind of failure an I/O error is.
pub enum ErrorKind {
  NotFound,
  PermissionDenied,
  AlreadyExists,
  InvalidInput,
  /// The data is not valid, such as input that is not UTF-8.
  InvalidData,
  UnexpectedEof,
  Other,
}

/// A standard stream of the program.
pub enum Stream {
  Stdin,
  Stdout,
  Stderr,
}

/// Whether `stream` is connected to a terminal rather than to a file or a pipe, such as to color
/// what is written only for a person to read.
pub fn is_terminal(stream: Stream) -> bool {
  const fd = match stream {
    Stream::Stdin => 0,
    Stream::Stdout => 1,
    Stream::Stderr => 2,
  };

  sys::is_terminal(fd)
}

/// The error of an input or output operation: its kind and the operating system's message.
pub class Error impl std::prelude::Error {
  prv const error_kind: ErrorKind;
  prv const text: String;

  pub fn new(self, kind: ErrorKind, message: String) {
    self.error_kind = kind;
    self.text = message;
  }

  pub fn kind(self) -> ErrorKind {
    self.error_kind
  }

  pub fn message(self) -> String {
    self.text
  }
}

/// The error with this code.
fn error_from(code: i32) -> Error {
  super::os_error(code, "")
}

/// Writes `text` and maybe a newline to the standard stream `index`.
fn write(index: i32, text: String, newline: bool) -> Result<(), Error> {
  const stream = sys::stream(index);
  const len = text.len();

  sys::clear_errno();

  if len > 0 && unsafe { sys::fwrite(text.as_ptr(), 1, len, stream) } != len {
    return Err(error_from(super::last_error()));
  }

  // `\n`, which `fputc` returns unless it fails.
  if newline && unsafe { sys::fputc(10, stream) } != 10 {
    return Err(error_from(super::last_error()));
  }

  Ok(())
}

/// Writes `text` to stdout.
pub fn print(text: String) -> Result<(), Error> {
  write(1, text, false)
}

/// Writes `text` and a newline to stdout.
pub fn println(text: String) -> Result<(), Error> {
  write(1, text, true)
}

/// Writes `text` to stderr.
pub fn eprint(text: String) -> Result<(), Error> {
  write(2, text, false)
}

/// Writes `text` and a newline to stderr.
pub fn eprintln(text: String) -> Result<(), Error> {
  write(2, text, true)
}

/// Writes out what stdout holds in its buffer.
pub fn flush() -> Result<(), Error> {
  sys::clear_errno();

  if unsafe { sys::fflush(sys::stream(1)) } == 0 { Ok(()) } else { Err(error_from(super::last_error())) }
}

/// The error of a failed read of stdin, which is ready for the next read.
fn read_error(stream: *mut c_void) -> Error {
  const code = super::last_error();

  unsafe { sys::clearerr(stream); }
  error_from(code)
}

/// The next line of stdin without its `\n` or `\r\n`, or `None` at the end of the input. Input
/// that is not UTF-8 is an error of kind `InvalidData`.
pub fn read_line() -> Result<Option<String>, Error> {
  const stream = sys::stream(0);
  const line = new List<u8>();
  var any = false;
  var c = 0;

  sys::clear_errno();

  loop {
    c = unsafe { sys::getc(stream) };

    // `EOF`, a negative value.
    if c < 0 {
      break;
    }

    any = true;

    if c == 10 {
      break;
    }

    line.push(c as u8);
  }

  if c < 0 && unsafe { sys::ferror(stream) } != 0 {
    return Err(read_error(stream));
  }

  if !any {
    return Ok(None);
  }

  if !line.is_empty() && line[line.len() - 1] == 13 {
    line.resize(line.len() - 1, 0);
  }

  Ok(Some(text_of(&line)?))
}

/// Exactly `count` bytes of stdin, such as a message whose length is known. An input that ends
/// before is an error of kind `UnexpectedEof`, and bytes that are not UTF-8 one of kind
/// `InvalidData`; the bytes read are lost either way.
pub fn read_exact(count: usize) -> Result<String, Error> {
  const stream = sys::stream(0);
  const data = new List<u8>();
  var filled = 0usize;

  data.resize(count, 0);
  sys::clear_errno();

  while filled < count {
    const read = unsafe { sys::fread(data.as_mut_ptr().add(filled), 1, count - filled, stream) };

    if read == 0 {
      break;
    }

    filled += read;
  }

  if filled < count {
    if unsafe { sys::ferror(stream) } != 0 {
      return Err(read_error(stream));
    }

    unsafe { sys::clearerr(stream); }

    return Err(error_from(super::UNEXPECTED_EOF));
  }

  text_of(&data)
}

/// The rest of stdin. Input that is not UTF-8 is an error of kind `InvalidData`.
pub fn read_to_string() -> Result<String, Error> {
  const stream = sys::stream(0);
  const data = new List<u8>();

  sys::clear_errno();

  loop {
    const start = data.len();

    data.resize(start + 4096, 0);

    const read = unsafe { sys::fread(data.as_mut_ptr().add(start), 1, 4096, stream) };

    data.resize(start + read, 0);

    if read == 0 {
      break;
    }
  }

  if unsafe { sys::ferror(stream) } != 0 {
    return Err(read_error(stream));
  }

  text_of(&data)
}

/// `bytes` as a string, or an error of kind `InvalidData` if they are not UTF-8.
fn text_of(bytes: &[u8]) -> Result<String, Error> {
  match super::utf8(bytes) {
    Some(text) => Ok(text),
    None => Err(error_from(super::INVALID_DATA)),
  }
}

// ---- Streams (docs/adr/0096-streams-files-and-drop.md, Q656) ------------------------------------

/// A source of bytes, as Rust's `Read`: files, buffers and, with record 10, sockets. `read` fills
/// the start of `buffer` and gives how many bytes it put there, `0` at the end.
pub interface Read {
  fn read(self, buffer: &mut [u8]) -> Result<usize, Error>;

  /// Every byte left.
  fn read_to_end(self) -> Result<List<u8>, Error> {
    const data = new List<u8>();
    const chunk = new List<u8>();

    chunk.resize(4096, 0);

    loop {
      const count = self.read(&mut chunk)?;

      if count == 0 {
        break;
      }

      for index in 0..count {
        data.push(chunk[index]);
      }
    }

    Ok(data)
  }

  /// Every byte left, as text; bytes that are not UTF-8 are an error of kind `InvalidData`.
  fn read_to_string(self) -> Result<String, Error> {
    const data = self.read_to_end()?;

    match super::utf8(&data) {
      Some(text) => Ok(text),
      None => Err(super::os_error(super::INVALID_DATA, "")),
    }
  }

  /// Exactly as many bytes as `buffer` holds; an end before is an error of kind `UnexpectedEof`.
  fn read_exact(self, buffer: &mut [u8]) -> Result<(), Error> {
    var done = 0usize;
    const chunk = new List<u8>();

    while done < buffer.len() {
      chunk.resize(buffer.len() - done, 0);

      const count = self.read(&mut chunk)?;

      if count == 0 {
        return Err(super::os_error(super::UNEXPECTED_EOF, ""));
      }

      for index in 0..count {
        buffer[done + index] = chunk[index];
      }

      done += count;
    }

    Ok(())
  }
}

/// A destination of bytes, as Rust's `Write`. `write` takes the start of `bytes` and gives how
/// many it took; `flush` writes out what a buffer holds.
pub interface Write {
  fn write(self, bytes: &[u8]) -> Result<usize, Error>;
  fn flush(self) -> Result<(), Error>;

  /// Every byte, in as many writes as it takes; a write that takes none is an error.
  fn write_all(self, bytes: &[u8]) -> Result<(), Error> {
    var done = 0usize;

    while done < bytes.len() {
      const count = self.write(&bytes[done..bytes.len()])?;

      if count == 0 {
        return Err(new Error(ErrorKind::Other, "failed to write whole buffer"));
      }

      done += count;
    }

    Ok(())
  }

  /// The bytes of `text`, which Rust writes with `write!`.
  fn write_str(self, text: String) -> Result<(), Error> {
    const bytes: List<u8> = text.bytes().collect();

    self.write_all(&bytes)
  }
}

/// Where `seek` moves to, as Rust's: from the start, the end or the current position.
pub enum SeekFrom {
  Start(u64),
  End(i64),
  Current(i64),
}
