//! `std::env`: the program's command-line arguments and environment variables
//! (docs/spec/11-standard-library.md#stdenv), read from each system in `std::sys`, and the
//! target it was compiled for.

use std::ffi::{c_char, c_int};
use std::io;
use std::sys;

/// Called by the runtime's core when the program starts, with what C's `main` received, which
/// is where Unix gives the arguments (docs/adr/0085-conditional-compilation-and-std-time.md,
/// Q552); every program compiles this module.
@export("sag_env_init")
extern "C" fn core_init(argc: c_int, argv: *const *const c_char) {
  sys::set_args(argc, argv);
}

/// The command-line arguments, starting with the program as the operating system started it.
/// Bytes that are not valid UTF-8 are replaced by U+FFFD.
pub fn args() -> List<String> {
  sys::args()
}

/// The value of the environment variable `name`, or `None` if it is not set. Bytes that are not
/// valid UTF-8 are replaced by U+FFFD.
pub fn variable(name: String) -> Option<String> {
  // No system has such a name.
  if name.is_empty() || name.contains("=") || name.contains("\0") {
    return None;
  }

  sys::variable(name)
}

/// Whether a system could have a variable named `name`.
fn valid_name(name: String) -> bool {
  !name.is_empty() && !name.contains("=") && !name.contains("\0")
}

/// Every environment variable, as its name and its value, in the order of the environment.
/// Bytes that are not valid UTF-8 are replaced by U+FFFD.
pub fn vars() -> List<(String, String)> {
  sys::variables()
}

/// Sets the environment variable `name` to `value`, for this program and the programs it starts
/// (docs/adr/0097-processes-and-environment.md, Q668). Panics if `name` is empty or holds `=` or
/// a NUL, if `value` holds a NUL, or if the system refuses it, as Rust's.
///
/// It is `unsafe`, as in Rust 2024: another thread, or C code, may read the environment at the
/// same time, which systems other than Windows do not make safe.
pub unsafe fn set_var(name: String, value: String) {
  const result = if valid_name(name) && !value.contains("\0") { sys::set_variable(name, value) } else { Err(sys::EINVAL) };

  if let Err(code) = result {
    panic(super::os_error(code, `failed to set environment variable "${name}"`).message());
  }
}

/// Removes the environment variable `name`; one that is not set is no error. Panics as `set_var`
/// does, and is `unsafe` for the same reason.
pub unsafe fn remove_var(name: String) {
  const result = if valid_name(name) { sys::remove_variable(name) } else { Err(sys::EINVAL) };

  if let Err(code) = result {
    panic(super::os_error(code, `failed to remove environment variable "${name}"`).message());
  }
}

/// Makes `path` the current working directory of this program, which `fs::current_dir` gives.
pub fn set_current_dir(path: String) -> Result<(), io::Error> {
  match sys::set_current_dir(path) {
    Ok(_) => Ok(()),
    Err(code) => Err(super::os_error(code, `cannot change the current directory to "${path}"`)),
  }
}

/// The full path of this program's file.
pub fn current_exe() -> Result<String, io::Error> {
  match sys::current_exe() {
    Ok(path) => Ok(path),
    Err(code) => Err(super::os_error(code, "cannot find the path of this program")),
  }
}

/// The directory for temporary files: `TMPDIR`, else `/tmp` (`/data/local/tmp` on Android), as
/// Rust's.
@cfg(unix)
pub fn temp_dir() -> String {
  match sys::variable("TMPDIR") {
    Some(dir) => dir,
    None => if OS == "android" { "/data/local/tmp" } else { "/tmp" },
  }
}

/// The directory for temporary files Windows gives (`GetTempPathW`), ending in `\`: `TMP`,
/// `TEMP` or `USERPROFILE`, else the directory of Windows.
@cfg(windows)
pub fn temp_dir() -> String {
  match sys::temp_dir() {
    Ok(dir) => dir,
    Err(code) => panic(super::os_error(code, "cannot find the directory for temporary files").message()),
  }
}

/// The home directory of the user: `HOME` unless it is empty, else the one of the system's
/// database of users, as Rust's; `None` if neither has one.
@cfg(unix)
pub fn home_dir() -> Option<String> {
  match sys::variable("HOME") {
    Some(dir) if !dir.is_empty() => Some(dir),
    _ => sys::user_home(),
  }
}

/// The home directory of the user: `USERPROFILE` unless it is empty; `None` without it.
@cfg(windows)
pub fn home_dir() -> Option<String> {
  match sys::variable("USERPROFILE") {
    Some(dir) if !dir.is_empty() => Some(dir),
    _ => None,
  }
}

// ---- The target, as Rust's `std::env::consts` --------------------------------------------------

/// The operating system the program was compiled for: `"linux"`, `"macos"`, `"windows"`,
/// `"android"` or `"ios"`.
@cfg(target_os = "linux")
pub const OS: String = "linux";
@cfg(target_os = "macos")
pub const OS: String = "macos";
@cfg(target_os = "windows")
pub const OS: String = "windows";
@cfg(target_os = "android")
pub const OS: String = "android";
@cfg(target_os = "ios")
pub const OS: String = "ios";

/// The processor the program was compiled for: `"x86_64"`, `"aarch64"` or `"arm"`.
@cfg(target_arch = "x86_64")
pub const ARCH: String = "x86_64";
@cfg(target_arch = "aarch64")
pub const ARCH: String = "aarch64";
@cfg(target_arch = "arm")
pub const ARCH: String = "arm";

/// The family of the operating system: `"unix"` or `"windows"`.
@cfg(unix)
pub const FAMILY: String = "unix";
@cfg(windows)
pub const FAMILY: String = "windows";
