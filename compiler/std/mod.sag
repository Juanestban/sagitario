//! `std` itself (docs/spec/11-standard-library.md#implementation-rules): helpers shared by the
//! standard library modules, which reach them through `super::`. Programs cannot name them.

use std::io;
use std::io::ErrorKind;
use std::sys;

/// The codes of failures that have no `errno` value, which are negative.
const INVALID_DATA: i32 = -2;
const UNKNOWN: i32 = -3;
const UNEXPECTED_EOF: i32 = -4;

/// The code of the last failed call to the C library: its `errno`, or an unknown error.
fn last_error() -> i32 {
  const code = sys::errno();

  if code > 0 { code } else { UNKNOWN }
}

/// The error with this code (an `errno` value, or one of the codes above), described as
/// `context: system message`, or by the system message alone without a context. The values of
/// `errno` are the same on every supported system.
fn os_error(code: i32, context: String) -> io::Error {
  const kind = if code == INVALID_DATA {
    ErrorKind::InvalidData
  } else if code == UNEXPECTED_EOF {
    ErrorKind::UnexpectedEof
  } else if code == 2 {
    // ENOENT
    ErrorKind::NotFound
  } else if code == 1 || code == 13 {
    // EPERM, EACCES
    ErrorKind::PermissionDenied
  } else if code == 17 {
    // EEXIST
    ErrorKind::AlreadyExists
  } else if code == 22 {
    // EINVAL
    ErrorKind::InvalidInput
  } else {
    ErrorKind::Other
  };
  const message = if code == INVALID_DATA {
    "stream did not contain valid UTF-8"
  } else if code == UNEXPECTED_EOF {
    "failed to fill whole buffer"
  } else if code > 0 {
    sys::error_message(code)
  } else {
    "input/output error"
  };

  if context.is_empty() { new io::Error(kind, message) } else { new io::Error(kind, `${context}: ${message}`) }
}

/// The length of the UTF-8 sequence at `bytes[at]`: positive for a whole character, or minus the
/// length of the maximal ill-formed prefix that one U+FFFD replaces, as Rust's
/// `String::from_utf8_lossy` does. Overlong forms, surrogates and code points past U+10FFFF are
/// ill-formed.
fn sequence(bytes: &[u8], at: usize) -> isize {
  const first = bytes[at];
  var low = 0x80u8;
  var high = 0xBFu8;
  var need = 0usize;

  if first < 0x80 {
    return 1;
  } else if first >= 0xC2 && first <= 0xDF {
    need = 1;
  } else if first == 0xE0 {
    need = 2;
    low = 0xA0;
  } else if first == 0xED {
    need = 2;
    high = 0x9F;
  } else if first >= 0xE1 && first <= 0xEF {
    need = 2;
  } else if first == 0xF0 {
    need = 3;
    low = 0x90;
  } else if first == 0xF4 {
    need = 3;
    high = 0x8F;
  } else if first >= 0xF1 && first <= 0xF3 {
    need = 3;
  } else {
    return -1;
  }

  for offset in 1..need + 1 {
    const least = if offset == 1 { low } else { 0x80u8 };
    const most = if offset == 1 { high } else { 0xBFu8 };

    if at + offset >= bytes.len() || bytes[at + offset] < least || bytes[at + offset] > most {
      return -(offset as isize);
    }
  }

  (need + 1) as isize
}

/// The character of the whole sequence of `count` bytes at `bytes[at]`.
fn decode(bytes: &[u8], at: usize, count: usize) -> char {
  const first = bytes[at] as u32;
  var code = if count == 1 { first } else if count == 2 { first - 0xC0 } else if count == 3 { first - 0xE0 } else { first - 0xF0 };

  for offset in 1..count {
    code = code * 64 + (bytes[at + offset] as u32 - 0x80);
  }

  char::from_u32(code).unwrap_or('?')
}

/// The text of `bytes`, or `None` if they are not valid UTF-8.
fn utf8(bytes: &[u8]) -> Option<String> {
  const text = new StringBuilder();
  var index = 0usize;

  while index < bytes.len() {
    const count = sequence(bytes, index);

    if count < 0 {
      return None;
    }

    text.append_char(decode(bytes, index, count as usize));
    index += count as usize;
  }

  Some(text.to_string())
}

/// The text of `bytes`, with each ill-formed sequence replaced by U+FFFD.
fn utf8_lossy(bytes: &[u8]) -> String {
  const text = new StringBuilder();
  var index = 0usize;

  while index < bytes.len() {
    const count = sequence(bytes, index);

    if count < 0 {
      text.append_char(char::from_u32(0xFFFD).unwrap_or('?'));
      index += (-count) as usize;
    } else {
      text.append_char(decode(bytes, index, count as usize));
      index += count as usize;
    }
  }

  text.to_string()
}
