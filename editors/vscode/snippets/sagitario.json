{
  "main": {
    "prefix": "main",
    "description": "The entry point of a program",
    "body": ["pub fn main() {", "  $0", "}"]
  },
  "main returning Result": {
    "prefix": "mainr",
    "description": "An entry point that can fail with an error",
    "body": ["use std::io;", "", "pub fn main() -> Result<(), io::Error> {", "  $0", "  Ok(())", "}"]
  },
  "async main": {
    "prefix": "asyncmain",
    "description": "An asynchronous entry point, which can await tasks",
    "body": ["pub async fn main() {", "  $0", "}"]
  },
  "async fn": {
    "prefix": "asyncfn",
    "description": "An asynchronous function: calling it gives a Task<T> to await",
    "body": ["async fn ${1:name}(${2}) -> ${3:()} {", "  $0", "}"]
  },
  "fn": {
    "prefix": "fn",
    "description": "A function",
    "body": ["fn ${1:name}(${2}) -> ${3:()} {", "  $0", "}"]
  },
  "pub fn": {
    "prefix": "pfn",
    "description": "A public function or method",
    "body": ["pub fn ${1:name}(${2}) -> ${3:()} {", "  $0", "}"]
  },
  "static": {
    "prefix": "static",
    "description": "A static: one value for the whole program, computed on its first use",
    "body": ["static ${1:NAME}: ${2:AtomicI64} = ${3:new AtomicI64(0)};$0"]
  },
  "static var": {
    "prefix": "staticvar",
    "description": "A mutable global, read and written inside `unsafe`",
    "body": ["static var ${1:NAME}: ${2:i32} = ${3:0};$0"]
  },
  "thread local": {
    "prefix": "threadlocal",
    "description": "A mutable global with one value per thread, used without `unsafe`",
    "body": ["@thread_local", "static var ${1:NAME}: ${2:i32} = ${3:0};$0"]
  },
  "struct": {
    "prefix": "struct",
    "description": "A struct: a value type, copied when assigned",
    "body": ["pub struct ${1:Name} {", "  pub ${2:field}: ${3:i32};$0", "}"]
  },
  "cfg": {
    "prefix": "cfg",
    "description": "Keep the next item only on some systems",
    "body": ["@cfg(${1|windows,unix,target_os = \"linux\",target_os = \"macos\",target_os = \"android\",target_os = \"ios\"|})"]
  },
  "class": {
    "prefix": "class",
    "description": "A class with a constructor: a reference type",
    "body": [
      "pub class ${1:Name} {",
      "  pub var ${2:field}: ${3:i32};",
      "",
      "  pub fn new(self, ${2:field}: ${3:i32}) {",
      "    self.${2:field} = ${2:field};",
      "  }$0",
      "}"
    ]
  },
  "enum": {
    "prefix": "enum",
    "description": "An enum",
    "body": ["pub enum ${1:Name} {", "  ${2:First},", "  ${3:Second},$0", "}"]
  },
  "interface": {
    "prefix": "interface",
    "description": "An interface",
    "body": ["pub interface ${1:Name} {", "  fn ${2:method}(self) -> ${3:String};$0", "}"]
  },
  "impl for": {
    "prefix": "implfor",
    "description": "An interface implemented for a type in its own block",
    "body": ["impl ${1:Interface} for ${2:Type} {", "  fn ${3:method}(self) -> ${4:String} {", "    $0", "  }", "}"]
  },
  "impl Eq": {
    "prefix": "impleq",
    "description": "Implement Eq: `==` and `!=` call `equals`",
    "body": [
      "impl Eq for ${1:Type} {",
      "  fn equals(self, other: ${1:Type}) -> bool {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "impl Display": {
    "prefix": "impldisplay",
    "description": "Implement Display: format strings interpolate the text of `to_string`",
    "body": [
      "impl Display for ${1:Type} {",
      "  fn to_string(self) -> String {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "impl Ord": {
    "prefix": "implord",
    "description": "Implement Ord beside Eq: `<`, `<=`, `>` and `>=` call `compare`",
    "body": [
      "impl Ord for ${1:Type} {",
      "  fn compare(self, other: ${1:Type}) -> Ordering {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "impl an operator": {
    "prefix": "implop",
    "description": "Overload an arithmetic operator: Add (+), Sub (-), Mul (*), Div (/) or Rem (%)",
    "body": [
      "impl ${1|Add,Sub,Mul,Div,Rem|}<${2:Type}, ${2:Type}> for ${2:Type} {",
      "  fn ${3|add,sub,mul,div,rem|}(self, other: ${2:Type}) -> ${2:Type} {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "impl Neg": {
    "prefix": "implneg",
    "description": "Overload unary minus: `-value` calls `neg`",
    "body": [
      "impl Neg<${1:Type}> for ${1:Type} {",
      "  fn neg(self) -> ${1:Type} {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "implfrom": {
    "prefix": "implfrom",
    "description": "A conversion: `Type::from(value)` and `value.into()`",
    "body": [
      "impl From<${1:Source}> for ${2:Type} {",
      "  fn from(value: ${1:Source}) -> ${2:Type} {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "impltryfrom": {
    "prefix": "impltryfrom",
    "description": "A conversion that can fail: `Type::try_from(value)` and `value.try_into()`",
    "body": [
      "impl TryFrom<${1:Source}, ${2:String}> for ${3:Type} {",
      "  fn try_from(value: ${1:Source}) -> Result<${3:Type}, ${2:String}> {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "implindex": {
    "prefix": "implindex",
    "description": "Indexing: `value[index]` and, with `IndexMut`, `value[index] = new`",
    "body": [
      "impl Index<${1:usize}, ${2:Out}> for ${3:Type} {",
      "  fn index(self, index: ${1:usize}) -> ${2:Out} {",
      "    $0",
      "  }",
      "}",
      "",
      "impl IndexMut<${1:usize}, ${2:Out}> for ${3:Type} {",
      "  fn index_set(self, index: ${1:usize}, value: ${2:Out}) {",
      "  }",
      "}"
    ]
  },
  "impldefault": {
    "prefix": "impldefault",
    "description": "The value a type starts from: `Type::default()` and `T::default()`",
    "body": [
      "impl Default for ${1:Type} {",
      "  fn default() -> ${1:Type} {",
      "    $0",
      "  }",
      "}"
    ]
  },
  "default": {
    "prefix": "default",
    "description": "A struct whose fields start from their defaults: `Name::default()`, `Name { field: 1, ..Name::default() }`",
    "body": [
      "@default",
      "struct ${1:Name} {",
      "  pub ${2:field}: ${3:i32};",
      "}"
    ]
  },
  "match": {
    "prefix": "match",
    "description": "A match expression",
    "body": ["match ${1:value} {", "  ${2:pattern} => ${3:result},", "  _ => ${4:other},$0", "}"]
  },
  "if let": {
    "prefix": "iflet",
    "description": "An if let expression",
    "body": ["if let ${1:Some(value)} = ${2:option} {", "  $0", "}"]
  },
  "while let": {
    "prefix": "whilelet",
    "description": "A while let loop",
    "body": ["while let ${1:Some(value)} = ${2:option} {", "  $0", "}"]
  },
  "for": {
    "prefix": "for",
    "description": "A for loop over a range",
    "body": ["for ${1:i} in ${2:0}..${3:n} {", "  $0", "}"]
  },
  "for in": {
    "prefix": "forin",
    "description": "A for loop over a collection",
    "body": ["for ${1:item} in ${2:items} {", "  $0", "}"]
  },
  "assert": {
    "prefix": "assert",
    "description": "Panics, at this line, unless the condition holds",
    "body": "assert(${1:condition});$0"
  },
  "assert_eq": {
    "prefix": "asserteq",
    "description": "Panics, at this line, unless both values are equal, showing them",
    "body": "assert_eq(${1:left}, ${2:right});$0"
  },
  "for tuple": {
    "prefix": "fortuple",
    "description": "A for loop taking each tuple apart",
    "body": ["for (${1:key}, ${2:value}) in ${3:pairs} {", "  $0", "}"]
  },
  "const tuple": {
    "prefix": "consttuple",
    "description": "A declaration taking a tuple apart",
    "body": "const (${1:a}, ${2:b}) = ${3:value};$0"
  },
  "if": {
    "prefix": "if",
    "description": "An if expression",
    "body": ["if ${1:condition} {", "  $0", "}"]
  },
  "if else": {
    "prefix": "ifelse",
    "description": "An if expression with an else branch",
    "body": ["if ${1:condition} {", "  $2", "} else {", "  $0", "}"]
  },
  "println": {
    "prefix": "println",
    "description": "Print a line with interpolated values",
    "body": ["println(f\"${1:text}\");$0"]
  },
  "format string": {
    "prefix": "fstr",
    "description": "A format string: the expressions between braces are interpolated",
    "body": "f\"${1:text} {${2:value}}\"$0"
  },
  "use": {
    "prefix": "use",
    "description": "Import a module",
    "body": ["use ${1:std}::${2:fs};$0"]
  },
  "extern \"C\" block": {
    "prefix": "extern",
    "description": "Declare C functions, called inside `unsafe`",
    "body": [
      "use std::ffi::{c_char, c_int};",
      "",
      "extern \"C\" {",
      "  fn ${1:name}(${2:text: *const c_char}) -> ${3:c_int};$0",
      "}"
    ]
  },
  "extern static": {
    "prefix": "externstatic",
    "description": "Declare a global variable of C, used inside `unsafe`",
    "body": ["extern \"C\" {", "  static ${1:var }${2:name}: ${3:c_int};", "}$0"]
  },
  "extern \"C\" fn": {
    "prefix": "externfn",
    "description": "A function with the C ABI, exported under its own name",
    "body": ["extern \"C\" fn ${1:name}(${2}) -> ${3:i32} {", "  $0", "}"]
  },
  "@export extern \"C\" fn": {
    "prefix": "export",
    "description": "A function with the C ABI, exported under the given symbol",
    "body": [
      "@export(\"${1:symbol}\")",
      "pub extern \"C\" fn ${2:name}(${3}) -> ${4:i32} {",
      "  $0",
      "}"
    ]
  },
  "@repr(C) struct": {
    "prefix": "reprc",
    "description": "A struct with the C layout, which can cross the FFI boundary",
    "body": ["@repr(C)", "pub struct ${1:Name} {", "  pub ${2:field}: ${3:i32};$0", "}"]
  },
  "@repr(C) union": {
    "prefix": "union",
    "description": "A union with the C layout: its fields share their memory",
    "body": ["@repr(C)", "pub union ${1:Name} {", "  pub ${2:field}: ${3:i32};$0", "}"]
  },
  "@repr(i32) enum": {
    "prefix": "reprenum",
    "description": "An enum laid out as an integer, for C",
    "body": ["@repr(${1:i32})", "pub enum ${2:Name} {", "  ${3:First} = ${4:0},", "  ${5:Second},$0", "}"]
  },
  "extern \"C\" fn type": {
    "prefix": "cfn",
    "description": "The type of a C function pointer",
    "body": ["extern \"C\" fn(${1:i32}) -> ${2:i32}"]
  },
  "unsafe": {
    "prefix": "unsafe",
    "description": "An unsafe block: calls to C functions and raw pointers",
    "body": ["unsafe { $0 }"]
  },
  "CString": {
    "prefix": "cstring",
    "description": "A NUL-terminated copy of a string, to pass to C with as_ptr()",
    "body": ["const ${1:text} = CString::new(${2:\"text\"}).unwrap();$0"]
  },
  "dynamic library": {
    "prefix": "library",
    "description": "Load a C function from a dynamic library at run time",
    "body": [
      "const library = Library::open(\"${1:libname.so}\").unwrap();",
      "const symbol = library.symbol(\"${2:function}\").unwrap();",
      "const ${2:function} = unsafe { symbol as unsafe extern \"C\" fn(${3:c_int}) -> ${4:c_int} };$0"
    ]
  }
}
