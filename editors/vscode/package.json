{
  "name": "sagitario",
  "displayName": "Sagitario",
  "description": "Syntax highlighting, snippets and file icons for the Sagitario programming language.",
  "version": "0.1.0",
  "publisher": "sagitario",
  "license": "(MIT OR Apache-2.0)",
  "icon": "icons/sagitario.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "sagitario",
    "sag"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Juanestban/sagitario"
  },
  "contributes": {
    "languages": [
      {
        "id": "sagitario",
        "aliases": [
          "Sagitario",
          "sagitario"
        ],
        "extensions": [
          ".sag"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/sag-file.svg",
          "dark": "./icons/sag-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "sagitario",
        "scopeName": "source.sagitario",
        "path": "./syntaxes/sagitario.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sagitario",
        "path": "./snippets/sagitario.json"
      }
    ]
  },
  "scripts": {
    "package": "vsce package --out sagitario.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
