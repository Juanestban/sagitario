{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sagitario",
  "scopeName": "source.sagitario",
  "fileTypes": [
    "sag"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#use"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.sagitario",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.documentation.module.sagitario",
          "match": "//!.*$"
        },
        {
          "name": "comment.line.double-slash.sagitario",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.sagitario",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "use": {
      "begin": "\\b(use)\\b",
      "end": ";",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.use.sagitario"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.sagitario"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.operator.cast.sagitario",
          "match": "\\bas\\b"
        },
        {
          "name": "variable.language.sagitario",
          "match": "\\b(pkg|super|self)\\b"
        },
        {
          "name": "constant.other.sagitario",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z])"
        },
        {
          "name": "entity.name.type.sagitario",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "entity.name.namespace.sagitario",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        },
        {
          "name": "punctuation.separator.namespace.sagitario",
          "match": "::"
        },
        {
          "name": "punctuation.separator.comma.sagitario",
          "match": ","
        }
      ]
    },
    "attributes": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "punctuation.definition.attribute.sagitario"
        },
        "2": {
          "name": "entity.other.attribute-name.sagitario"
        }
      }
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.sagitario",
          "match": "\\\\(?:[nrt\\\\0\"\\'`$]|x[0-7][0-9A-Fa-f]|u\\{[0-9A-Fa-f]{1,6}\\})"
        },
        {
          "name": "invalid.illegal.escape.sagitario",
          "match": "\\\\."
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.char.sagitario",
          "match": "'(?:[^'\\\\\\n]|\\\\(?:[nrt\\\\0\"\\'`$]|x[0-7][0-9A-Fa-f]|u\\{[0-9A-Fa-f]{1,6}\\}))'",
          "captures": {
            "0": {
              "patterns": [
                {
                  "include": "#escapes"
                }
              ]
            }
          }
        },
        {
          "name": "string.quoted.double.sagitario",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sagitario"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sagitario"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.template.sagitario",
          "begin": "`",
          "end": "`",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sagitario"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sagitario"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.sagitario",
      "contentName": "source.sagitario",
      "begin": "\\$\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.sagitario"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.sagitario"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sagitario",
          "match": "\\b0x[0-9A-Fa-f_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.octal.sagitario",
          "match": "\\b0o[0-7_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.binary.sagitario",
          "match": "\\b0b[01_]+(?:[iu](?:8|16|32|64|size))?\\b"
        },
        {
          "name": "constant.numeric.float.sagitario",
          "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*(?:[eE][+-]?\\d[\\d_]*)?|[eE][+-]?\\d[\\d_]*)(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.float.sagitario",
          "match": "\\b\\d[\\d_]*(?:f32|f64)\\b"
        },
        {
          "name": "constant.numeric.integer.sagitario",
          "match": "\\b\\d[\\d_]*(?:[iu](?:8|16|32|64|size))?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.sagitario"
            },
            "2": {
              "name": "entity.name.function.sagitario"
            }
          }
        },
        {
          "match": "\\b(struct|enum|class|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.sagitario"
            },
            "2": {
              "name": "entity.name.type.sagitario"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Z][A-Z0-9_]*)\\b(?![a-z])",
          "captures": {
            "1": {
              "name": "storage.type.sagitario"
            },
            "2": {
              "name": "variable.other.constant.declaration.sagitario constant.other.sagitario"
            }
          }
        },
        {
          "match": "\\b(const|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.sagitario"
            },
            "2": {
              "name": "variable.other.readwrite.declaration.sagitario"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sagitario",
          "match": "\\b(if|else|match|for|in|while|loop|break|continue|return|await)\\b"
        },
        {
          "name": "keyword.other.let.sagitario",
          "match": "\\blet\\b"
        },
        {
          "name": "storage.type.function.sagitario",
          "match": "\\bfn\\b"
        },
        {
          "name": "storage.type.sagitario",
          "match": "\\b(struct|enum|class|interface|const|var)\\b"
        },
        {
          "name": "storage.modifier.sagitario",
          "match": "\\b(pub|prv|abstract|override|extern|unsafe|weak|impl|extends|where|async)\\b"
        },
        {
          "name": "keyword.other.use.sagitario",
          "match": "\\buse\\b"
        },
        {
          "name": "keyword.operator.cast.sagitario",
          "match": "\\bas\\b"
        },
        {
          "name": "keyword.operator.new.sagitario",
          "match": "\\bnew\\b"
        },
        {
          "name": "variable.language.self.sagitario",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.type.self.sagitario",
          "match": "\\bSelf\\b"
        },
        {
          "name": "variable.language.sagitario",
          "match": "\\b(zod|super|pkg)\\b"
        },
        {
          "name": "constant.language.boolean.sagitario",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.sagitario",
          "match": "\\b(i8|i16|i32|i64|isize|u8|u16|u32|u64|usize|f32|f64|bool|char)\\b"
        },
        {
          "name": "constant.other.symbol.variant.sagitario",
          "match": "\\b(Some|None|Ok|Err)\\b"
        },
        {
          "name": "constant.other.sagitario",
          "match": "\\b[A-Z][A-Z0-9_]*[A-Z0-9]\\b(?![a-z])"
        },
        {
          "name": "entity.name.type.sagitario",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "paths": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.sagitario"
        },
        "2": {
          "name": "punctuation.separator.namespace.sagitario"
        }
      }
    },
    "calls": {
      "patterns": [
        {
          "name": "support.function.builtin.sagitario",
          "match": "\\b(print|println|eprintln|panic|include_str)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.sagitario",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b(?=\\s*(?:<[^<>()]*>\\s*)?\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.sagitario",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.range.sagitario",
          "match": "\\.\\.=?"
        },
        {
          "name": "keyword.operator.comparison.sagitario",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.logical.sagitario",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.sagitario",
          "match": "[+\\-*/%]?="
        },
        {
          "name": "keyword.operator.try.sagitario",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.arithmetic.sagitario",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.sagitario",
          "match": "[<>]"
        },
        {
          "name": "keyword.operator.reference.sagitario",
          "match": "&"
        }
      ]
    },
    "variables": {
      "name": "variable.other.readwrite.sagitario",
      "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.namespace.sagitario",
          "match": "::"
        },
        {
          "name": "punctuation.terminator.statement.sagitario",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.sagitario",
          "match": ","
        },
        {
          "name": "punctuation.accessor.sagitario",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.colon.sagitario",
          "match": ":"
        }
      ]
    }
  }
}
