//! Runs the benchmarks of `benchmarks/` in every language whose toolchain is installed, from the
//! root of the repository (docs/adr/0090-benchmarks.md):
//!
//!     sag run tools/bench.sag -- [names] [--runs N] [--langs sag,rust,c,cs,js,py] [--sag path]
//!
//! Each program is built optimized, run once to warm up and `N` times (5 by default), once when
//! the warm-up takes more than 5 seconds; every language must print the same output. The median
//! wall time of each, its size and the versions of the toolchains go to
//! `benchmarks/results/<date>-<os>-<arch>.json`.

use std::env;
use std::fs;
use std::io;
use std::path;
use std::process;
use std::process::Command;
use std::time::{Instant, SystemTime};

const USAGE: String = "Usage: sag run tools/bench.sag -- [names] [--runs N] [--langs sag,rust,c,cs,js,py] [--sag path]";

/// Every language of the suite, by the name of its source file `main.<name>`.
const LANGUAGES: String = "sag rust c cs js py";

/// A warm-up longer than this, in seconds, is followed by a single timed run.
const SLOW: f64 = 5.0;

@cfg(windows)
const OS: String = "windows";
@cfg(target_os = "linux")
const OS: String = "linux";
@cfg(target_os = "macos")
const OS: String = "macos";
@cfg(any(target_os = "android", target_os = "ios"))
const OS: String = "mobile";

@cfg(target_arch = "x86_64")
const ARCH: String = "x86_64";
@cfg(target_arch = "aarch64")
const ARCH: String = "aarch64";
@cfg(not(any(target_arch = "x86_64", target_arch = "aarch64")))
const ARCH: String = "other";

@cfg(windows)
const EXE: String = ".exe";
@cfg(unix)
const EXE: String = "";

/// What the command line asks for.
struct Options {
  pub names: List<String>;
  pub runs: usize;
  pub langs: List<String>;
  pub sag: String;
}

/// A language that can run: its name and the version of its toolchain.
struct Toolchain {
  pub lang: String;
  pub version: String;
  /// The program that runs it: the compiler, or the interpreter of `js` and `py`.
  pub tool: String;
}

/// How a built benchmark runs: a program, with arguments before those of the benchmark.
struct Invocation {
  pub program: String;
  pub prefix: List<String>;
  /// The file whose size is the size of the program.
  pub artifact: String;
}

/// One language's result on one benchmark.
struct Measured {
  pub lang: String;
  pub times: List<f64>;
  pub median: f64;
  pub size: usize;
}

/// One run of a program: its time in seconds and its output, with `\r\n` as `\n`.
struct Run {
  pub seconds: f64;
  pub output: String;
}

fn options() -> Result<Options, String> {
  const args = env::args();
  const names: List<String> = new List();
  var runs = 5usize;
  var langs = LANGUAGES.split(" ");
  var sag = env::variable("SAG").unwrap_or("sag");
  var index = 1usize;

  while index < args.len() {
    const arg = args[index];

    if arg == "--runs" || arg == "--langs" || arg == "--sag" {
      if index + 1 >= args.len() {
        return Err(f"`{arg}` needs a value\n{USAGE}");
      }

      const value = args[index + 1];

      if arg == "--runs" {
        runs = match value.parse_u32() {
          Ok(found) => found as usize,
          Err(_) => return Err(f"`--runs` takes a number, not `{value}`"),
        };
      } else if arg == "--langs" {
        langs = value.split(",");

        for lang in langs {
          if !LANGUAGES.split(" ").contains(lang) {
            return Err(f"unknown language `{lang}`: the languages are {LANGUAGES}");
          }
        }
      } else {
        sag = value;
      }

      index += 2;
    } else if arg.starts_with("--") {
      return Err(f"unknown option `{arg}`\n{USAGE}");
    } else {
      names.push(arg);
      index += 1;
    }
  }

  if runs == 0 {
    return Err("`--runs` must be at least 1");
  }

  Ok(Options { names: names, runs: runs, langs: langs, sag: sag })
}

/// The first line a command prints, or `None` if it cannot run.
fn first_line(program: String, arg: String) -> Option<String> {
  match new Command(program).arg(arg).output() {
    Ok(output) => {
      if !output.status.success() {
        return None;
      }

      const text = if output.stdout.trim().is_empty() { output.stderr } else { output.stdout };

      Some(text.lines().first().unwrap_or("").trim())
    }
    Err(_) => None,
  }
}

/// The toolchain of `lang`, or `None` when it is not installed.
fn toolchain(lang: String, options: Options) -> Option<Toolchain> {
  const tools = if lang == "sag" {
    List::from([options.sag])
  } else if lang == "rust" {
    List::from(["rustc"])
  } else if lang == "c" {
    // As `sag` finds its C compiler.
    List::from([env::variable("SAG_CC").unwrap_or("clang")])
  } else if lang == "cs" {
    List::from(["dotnet"])
  } else if lang == "js" {
    List::from(["node"])
  } else {
    List::from(["python3", "python"])
  };

  for tool in tools {
    if let Some(version) = first_line(tool, "--version") {
      return Some(Toolchain { lang: lang, version: version, tool: tool });
    }
  }

  None
}

/// The target framework of a .NET SDK version such as `10.0.201`: `net10.0`.
fn framework(version: String) -> String {
  const parts = version.split(".");

  if parts.len() >= 2 { f"net{parts[0]}.{parts[1]}" } else { "net8.0" }
}

fn output_of(command: Command) -> Result<(), String> {
  match command.output() {
    Ok(output) => if output.status.success() { Ok(()) } else { Err(output.stdout + output.stderr) },
    Err(error) => Err(error.message()),
  }
}

/// Builds the program of `chain` from `source` in `out_dir`: how it runs, or the compiler's output.
fn build(chain: Toolchain, source: String, out_dir: String, options: Options) -> Result<Invocation, String> {
  const lang = chain.lang;
  const program = path::join(out_dir, lang + EXE);
  const none: List<String> = new List();

  if lang == "sag" {
    output_of(new Command(options.sag).args(List::from(["build", "--release", source, "--output", program])))?;
  } else if lang == "rust" {
    output_of(new Command(chain.tool).args(List::from(["-C", "opt-level=3", "-o", program, source])))?;
  } else if lang == "c" {
    // The optimization `sag build --release` gives its C.
    const c = new Command(chain.tool).args(List::from(["-O2", "-o", program, source]));

    output_of(if OS == "windows" { c } else { c.arg("-lm") })?;
  } else if lang == "cs" {
    const project_dir = path::join(out_dir, "cs");
    const root = fs::current_dir().map_err((error) => error.message())?;
    const project = f"<Project Sdk=\"Microsoft.NET.Sdk\">\n  <PropertyGroup>\n    <OutputType>Exe</OutputType>\n    <TargetFramework>{framework(chain.version)}</TargetFramework>\n    <Nullable>enable</Nullable>\n    <AssemblyName>bench</AssemblyName>\n    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>\n    <InvariantGlobalization>true</InvariantGlobalization>\n  </PropertyGroup>\n  <ItemGroup>\n    <Compile Include=\"{path::join(root, source)}\" />\n  </ItemGroup>\n</Project>\n";
    const project_file = path::join(project_dir, "bench.csproj");
    const built = path::join(project_dir, "out");

    fs::create_dir_all(project_dir).map_err((error) => error.message())?;
    fs::write(project_file, project).map_err((error) => error.message())?;
    output_of(new Command(chain.tool).args(List::from(["build", project_file, "-c", "Release", "-o", built, "--nologo", "-v", "q"])))?;

    const exe = path::join(built, "bench" + EXE);

    return Ok(Invocation { program: exe, prefix: none, artifact: path::join(built, "bench.dll") });
  } else {
    // Interpreted: the interpreter runs the source.
    return Ok(Invocation { program: chain.tool, prefix: List::from([source]), artifact: source });
  }

  Ok(Invocation { program: program, prefix: none, artifact: program })
}

/// The arguments a benchmark takes, from its `args` file.
fn benchmark_args(dir: String) -> List<String> {
  const words: List<String> = new List();

  if let Ok(text) = fs::read_to_string(path::join(dir, "args")) {
    for word in text.trim().split(" ") {
      if !word.is_empty() {
        words.push(word);
      }
    }
  }

  words
}

fn run(invocation: Invocation, args: List<String>) -> Result<Run, String> {
  const all: List<String> = new List();

  for arg in invocation.prefix {
    all.push(arg);
  }

  for arg in args {
    all.push(arg);
  }

  const start = Instant::now();

  match new Command(invocation.program).args(all).output() {
    Ok(output) => {
      const seconds = start.elapsed().as_secs_f64();

      if !output.status.success() {
        return Err(f"exited with {output.status.code.unwrap_or(-1)}: {output.stderr.trim()}");
      }

      Ok(Run { seconds: seconds, output: output.stdout.replace("\r\n", "\n") })
    }
    Err(error) => Err(error.message()),
  }
}

fn median(times: List<f64>) -> f64 {
  const sorted: List<f64> = new List();

  for time in times {
    sorted.push(time);
  }

  sorted.sort_by((a, b) => a.total_compare(b));

  const middle = sorted.len() / 2;

  if sorted.len() % 2 == 1 { sorted[middle] } else { (sorted[middle - 1] + sorted[middle]) / 2.0 }
}

/// The date of `seconds` since 1970-01-01 in UTC, as `YYYY-MM-DD` (Howard Hinnant's algorithm).
fn date(seconds: u64) -> String {
  const days = (seconds / 86400) as i64 + 719468;
  const era = days / 146097;
  const day_of_era = days - era * 146097;
  const year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
  const day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
  const month_index = (5 * day_of_year + 2) / 153;
  const day = day_of_year - (153 * month_index + 2) / 5 + 1;
  const month = if month_index < 10 { month_index + 3 } else { month_index - 9 };
  const year = year_of_era + era * 400 + if month <= 2 { 1 } else { 0 };

  f"{year:04}-{month:02}-{day:02}"
}

/// `text` as a JSON string.
fn json(text: String) -> String {
  const out = new StringBuilder();

  out.append_char('"');

  for c in text.chars() {
    if c == '"' || c == '\\' {
      out.append_char('\\');
      out.append_char(c);
    } else if c == '\n' {
      out.append("\\n");
    } else if (c as u32) < 0x20 {
      out.append(f"\\u{c as u32:04x}");
    } else {
      out.append_char(c);
    }
  }

  out.append_char('"');
  out.to_string()
}

/// One benchmark in every language available: their results, or the reason it failed.
fn benchmark(name: String, options: Options, chains: List<Toolchain>) -> Result<List<Measured>, String> {
  const dir = path::join("benchmarks", name);
  const out_dir = path::join(path::join("build", "bench"), name);
  const args = benchmark_args(dir);
  const results: List<Measured> = new List();
  var expected: Option<String> = None;
  var expected_lang = "";

  fs::create_dir_all(out_dir).map_err((error) => error.message())?;

  for chain in chains {
    const lang = chain.lang;
    const source = path::join(dir, "main." + (if lang == "rust" { "rs" } else { lang }));

    if !fs::is_file(source) {
      continue;
    }

    const invocation = build(chain, source, out_dir, options).map_err((message) => f"{lang} does not build:\n{message}")?;
    // A first run warms up the caches of the system, and gives the output to compare.
    const warm = run(invocation, args).map_err((message) => f"{lang} {message}")?;

    match expected {
      Some(text) => {
        if text != warm.output {
          return Err(f"{lang} prints something other than {expected_lang}:\n{warm.output}");
        }
      }
      None => {
        expected = Some(warm.output);
        expected_lang = lang;
      }
    }

    const runs = if warm.seconds > SLOW { 1usize } else { options.runs };
    const times: List<f64> = new List();

    for _ in 0..runs {
      times.push(run(invocation, args).map_err((message) => f"{lang} {message}")?.seconds);
    }

    const size = match fs::read(invocation.artifact) {
      Ok(bytes) => bytes.len(),
      Err(_) => 0,
    };

    results.push(Measured { lang: lang, times: times, median: median(times), size: size });
  }

  Ok(results)
}

fn main() -> Result<(), io::Error> {
  const options = match options() {
    Ok(found) => found,
    Err(message) => {
      io::eprintln(message)?;
      process::exit(2);
    }
  };
  const versions: List<String> = new List();
  const chains: List<Toolchain> = new List();

  for lang in options.langs {
    match toolchain(lang, options) {
      Some(found) => {
        chains.push(found);
        versions.push(f"    {json(lang)}: {json(found.version)}");
      }
      None => io::eprintln(f"skipping {lang}: its toolchain is not installed")?,
    }
  }

  const names = if options.names.is_empty() { fs::read_dir("benchmarks")? } else { options.names };
  const entries: List<String> = new List();

  for name in names {
    if !fs::is_dir(path::join("benchmarks", name)) || name == "results" {
      continue;
    }

    io::println(f"{name}")?;

    match benchmark(name, options, chains) {
      Ok(results) => {
        const fastest = results.iter().fold(0.0, (best, result) => if best == 0.0 || result.median < best { result.median } else { best });
        const languages: List<String> = new List();

        for result in results {
          const ratio = if fastest > 0.0 { result.median / fastest } else { 1.0 };
          const times = result.times.iter().map((time) => f"{time:.6}").collect();

          io::println(f"  {result.lang:<6} {result.median * 1000.0:>10.1} ms  {ratio:>6.2}x  {result.size / 1024:>6} KiB")?;
          languages.push(f"        {json(result.lang)}: {{ \"median\": {result.median:.6}, \"times\": [{times.join(", ")}], \"size\": {result.size} }}");
        }

        entries.push(f"    {json(name)}: {{\n" + languages.join(",\n") + "\n    }");
      }
      Err(message) => {
        io::eprintln(f"  failed: {message}")?;
        process::exit(1);
      }
    }
  }

  const day = date(SystemTime::now().since_unix_epoch().as_secs());
  const file = path::join(path::join("benchmarks", "results"), f"{day}-{OS}-{ARCH}.json");
  const text = f"{{\n  \"date\": {json(day)},\n  \"os\": {json(OS)},\n  \"arch\": {json(ARCH)},\n  \"runs\": {options.runs},\n  \"toolchains\": {{\n" + versions.join(",\n") + "\n  },\n  \"benchmarks\": {\n" + entries.join(",\n") + "\n  }\n}\n";

  fs::create_dir_all(path::join("benchmarks", "results"))?;
  fs::write(file, text)?;
  io::println(f"results in {file}")?;

  Ok(())
}
