// binary-trees: builds and walks many complete binary trees, as the Computer Language Benchmarks
// Game writes it. Allocation and reference counting. The argument is the depth of the largest.
use std::env;

class Node {
  pub const left: Option<Node>;
  pub const right: Option<Node>;

  pub fn new(self, left: Option<Node>, right: Option<Node>) {
    self.left = left;
    self.right = right;
  }

  /// The number of nodes of the tree.
  pub fn check(self) -> u64 {
    const left = match self.left {
      Some(node) => node.check(),
      None => 0,
    };
    const right = match self.right {
      Some(node) => node.check(),
      None => 0,
    };

    1 + left + right
  }
}

fn tree(depth: u32) -> Node {
  if depth == 0 {
    return new Node(None, None);
  }

  new Node(Some(tree(depth - 1)), Some(tree(depth - 1)))
}

fn main() {
  const args = env::args();
  const requested = if args.len() > 1 { args[1].parse_u32().unwrap_or(10) } else { 10 };
  const min_depth = 4u32;
  const max_depth = if requested < min_depth + 2 { min_depth + 2 } else { requested };

  println(f"stretch tree of depth {max_depth + 1}\t check: {tree(max_depth + 1).check()}");

  const long_lived = tree(max_depth);
  var depth = min_depth;

  while depth <= max_depth {
    const iterations = 1u64 << (max_depth - depth + min_depth);
    var check = 0u64;

    for _ in 0..iterations {
      check += tree(depth).check();
    }

    println(f"{iterations}\t trees of depth {depth}\t check: {check}");
    depth += 2;
  }

  println(f"long lived tree of depth {max_depth}\t check: {long_lived.check()}");
}
