// map-count: counts how often each of 100000 keys comes, in a hash map of integers. The argument
// is the number of keys drawn by the generator MINSTD (`x = x * 48271 % 2147483647`), the same
// in every language.
use std::env;

fn main() {
  const args = env::args();
  const count = if args.len() > 1 { args[1].parse_u64().unwrap_or(1000) } else { 1000 };
  const counts = new Map<u64, u64>();
  var seed = 42u64;

  for _ in 0..count {
    seed = seed * 48271 % 2147483647;

    const key = seed % 100000;

    counts.insert(key, counts.get(key).unwrap_or(0) + 1);
  }

  // The largest count, at its smallest key.
  var most = 0u64;
  var most_key = 0u64;

  for entry in counts {
    if entry.value > most || (entry.value == most && entry.key < most_key) {
      most = entry.value;
      most_key = entry.key;
    }
  }

  var small = 0u64;

  for key in 0..100u64 {
    small += counts.get(key).unwrap_or(0);
  }

  println(f"keys {counts.len()} most {most} at {most_key} small {small}");
}
