// spectral-norm: the largest eigenvalue of an infinite matrix by the power method, as the Computer
// Language Benchmarks Game writes it. Numeric loops over lists. The argument is the size.
use std::env;

fn a(i: usize, j: usize) -> f64 {
  1.0 / (((i + j) * (i + j + 1) / 2 + i + 1) as f64)
}

fn mul_av(v: List<f64>, out: List<f64>) {
  const n = v.len();

  for i in 0..n {
    var sum = 0.0;

    for j in 0..n {
      sum += a(i, j) * v[j];
    }

    out[i] = sum;
  }
}

fn mul_atv(v: List<f64>, out: List<f64>) {
  const n = v.len();

  for i in 0..n {
    var sum = 0.0;

    for j in 0..n {
      sum += a(j, i) * v[j];
    }

    out[i] = sum;
  }
}

fn mul_atav(v: List<f64>, out: List<f64>, tmp: List<f64>) {
  mul_av(v, tmp);
  mul_atv(tmp, out);
}

fn main() {
  const args = env::args();
  const n = if args.len() > 1 { args[1].parse_u64().unwrap_or(100) as usize } else { 100 };
  const u: List<f64> = new List();
  const v: List<f64> = new List();
  const tmp: List<f64> = new List();

  u.resize(n, 1.0);
  v.resize(n, 0.0);
  tmp.resize(n, 0.0);

  for _ in 0..10 {
    mul_atav(u, v, tmp);
    mul_atav(v, u, tmp);
  }

  var vbv = 0.0;
  var vv = 0.0;

  for i in 0..n {
    vbv += u[i] * v[i];
    vv += v[i] * v[i];
  }

  println(f"{(vbv / vv).sqrt():.9}");
}
